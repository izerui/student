<UserObject id="e108" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({a\ne 0,\ b\ne 0}\)&lt;/span&gt;&lt;br&gt;【代入】零指数、负指数的定义" 类型="推导" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="R12" target="P41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7175" y="5067"/></Array><mxPoint x="108" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e110" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({a&amp;gt;0,\ b&amp;gt;0}\)&lt;/span&gt;&lt;br&gt;【推广】由整数指数推广；有理、实数指数课本说明运算律仍成立" 类型="推导" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P41" target="P05"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7175" y="5440"/></Array><mxPoint x="179" y="-2" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e122" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：夹角公式要求非零向量&lt;/span&gt;&lt;br&gt;【展开】前两式用分配律，与完全平方、平方差同型&lt;br&gt;垂直、夹角：由数量积的定义变形" 类型="推导" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="S05" target="P49"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="12326" y="8482"/><mxPoint x="12178" y="8703"/></Array><mxPoint x="149" y="70" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e123" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔结构前提〕：\({a}\) 为 \({A}\) 的对边&lt;/span&gt;&lt;br&gt;【向量】\({\overrightarrow{BC}=\overrightarrow{AC}-\overrightarrow{AB}}\)，用 \({|\vec a-\vec b|^2}\) 展开&lt;br&gt;\({|\overrightarrow{BC}|^2=b^2+c^2-2bc\cos A}\)" 类型="推导" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P49" target="P22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="12194" y="9311"/></Array><mxPoint x="125" y="-5" as="offset"/></mxGeometry></mxCell></UserObject>
