<mxCell id="bg2" value="▍地基：实数运算律 · 初中几何 · 计数原理 · 数学归纳法（直接承认，不依赖别的起点）" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontStyle=1;fillColor=#37474F;fontColor=#FFFFFF;strokeColor=none;align=left;spacingLeft=14;" vertex="1" parent="bg"><mxGeometry x="9400" y="310" width="958" height="40" as="geometry"/></mxCell>
