<UserObject id="e40" label="【前提】用 \({\sin^2\alpha+\cos^2\alpha=1}\) 换成单一函数" 类型="前提" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#90A4AE;strokeWidth=2;endSize=7;fontColor=#607D8B;" edge="1" parent="1" source="R13" target="R18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="12554" y="5878"/><mxPoint x="13779" y="6004"/></Array><mxPoint x="-270" y="-296" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e47" label="【前提】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{a}{r}\right)^2+\left(\dfrac{b}{r}\right)^2=1}\)&lt;/span&gt;，故有 \({\varphi}\)" 类型="前提" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#90A4AE;strokeWidth=2;endSize=7;fontColor=#607D8B;" edge="1" parent="1" source="R13" target="P17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="12272" y="5180"/><mxPoint x="12126" y="5542"/><mxPoint x="12043" y="5578"/><mxPoint x="12126" y="5878"/></Array><mxPoint x="6" y="-271" as="offset"/></mxGeometry></mxCell></UserObject>
