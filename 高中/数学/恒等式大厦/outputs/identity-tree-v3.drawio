<mxCell id="bg90" value="恒等式大厦" style="text;html=1;fontFamily=PingFang SC;fontSize=40;fontStyle=1;fontColor=#263238;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2200" y="-120" width="1900" height="60" as="geometry"/></mxCell>
<mxCell id="bg91" value="从 12 个起点（运算律、指数与对数、单位圆、数量积、复数、计数原理、数列、导数等）出发，不跳步推出高中全部恒等式&lt;br&gt;主干：源头 → 变形 → 结论；变形手法写在线上【方法】里。橙色 = 要加条件：〔定义域〕〔结构前提〕〔符号分支〕三类，各自独立" style="text;html=1;fontFamily=PingFang SC;fontSize=16;fontColor=#455A64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2200" y="-50" width="1900" height="80" as="geometry"/></mxCell>
<mxCell id="bg92" value="&lt;b style=&quot;font-size:20px&quot;&gt;图例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2200" y="60" width="1900" height="1060" as="geometry"/></mxCell>
<mxCell id="bg93" value="【定义】【公理】【原理】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="116" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg94" value="紫色：起点，直接承认（定义、公理、课本给出）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="116" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg95" value="★ 结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="186" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg96" value="绿色：对所有取值都成立的恒等式，不需要任何条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="186" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg97" value="中间结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="256" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg98" value="白底：推导中的一步，不需要条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="256" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg99" value="★ 结论（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="326" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg100" value="橙色：要加条件才成立；标题上方橙色标签写明条件类别和内容" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="326" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg101" value="中间结果（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="396" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg102" value="淡橙：有条件的中间一步" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="396" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg103" value="看到：……（问题）" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=12;fontColor=#004D40;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="466" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg104" value="青绿：问题节点（应用层）——看到什么 → 解题路径 ①②③ → 注意" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="466" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg105" value="两层：推导层（深灰，公式怎么来的）与应用层（青绿，看到什么、用哪个工具、怎么用）同样重要；drawio 里用“标签（tags）”可只显示推导层或应用层" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="536" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg106" value="连线：深色实线 = 推导，越粗越是主干；线上写【方法】和关键一步" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="592" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg107" value="青绿线 = 应用：工具 → 问题，线上写【怎么用】+ 例子；紫色线 = 【定义】：起点建立在哪个更底层的起点之上" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="648" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg108" value="⚡ 第一反应：工具节点里写“看到什么信号，就想到它”" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="704" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg109" value="浅灰线 = 前提：引用别处已推出的结论，线上写【前提】；远处的前提写进节点“⇐ 前提”" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="760" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg110" value="▼ 加条件：从这一步起要带上条件，后面的结论都带着它；“★ 跨树”= 跨分区的推导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="816" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg111" value="✗ = 去掉条件的反例；“⋯ 同源 / 互逆 / 配合”写在节点里，不画成推导线" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="872" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg112" value="⇒ 用于：本图下游〔坐标〕、其他大厦和章节的用途、问题节点（正推之后用在哪里）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="928" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg113" value="〔编号 · 坐标〕：S 起点、R 不加条件、P 加条件；按图边字母（列）和数字（行）找格子" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="984" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg114" value="★ 越多越重要；灰色“拓展”可先跳过；“同见不等式大厦 / 二次函数大厦 编号”= 两张图重合的结论" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1040" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg115" value="&lt;b style=&quot;font-size:20px&quot;&gt;三类条件（各自独立，互不包含、互不推出）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1170" width="1900" height="550" as="geometry"/></mxCell>
<mxCell id="bg116" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔定义域〕不满足时某一边没有意义&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1226" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg117" value="▸ 分式：分母 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1272" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg118" value="▸ 对数：真数 \({&amp;gt;0}\)，底数 \({&amp;gt;0}\) 且 \({\ne 1}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1272" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg119" value="▸ 正切：\({\cos\alpha\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1272" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg120" value="▸ 下标与组合数：\({n\ge 2}\)、\({0\le k\le n}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1306" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg121" value="▸ 根式：被开方数 \({\ge 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1306" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg122" value="▸ 分数指数幂：底数 \({&amp;gt;0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1306" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg123" value="▸ 整数指数：底数 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1340" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg124" value="▸ 约分：约掉的因式 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1340" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg125" value="▸ 实根：\({\Delta\ge 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1340" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg126" value="▸ 求导：函数在该点可导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1374" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg127" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔结构前提〕两边都有意义，但只对某种结构成立&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1418" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg128" value="▸ 等差数列" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1464" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg129" value="▸ 等比数列" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1464" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg130" value="▸ 差比数列（等差×等比）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1464" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg131" value="▸ 同一三角形的边与对角" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1498" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg132" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔符号分支〕两边都有意义，但符号或角要按范围选定&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1542" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg133" value="▸ 半角 ±" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1588" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg134" value="▸ 已知一值求其余的 ±" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1588" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg135" value="▸ \({\sqrt{a^2}=|a|}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1588" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg136" value="▸ 辅助角 \({\varphi}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1622" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg137" value="▸ 复数辐角" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1622" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg138" value="反例：〔定义域〕说明哪一边没有意义；〔结构前提〕〔符号分支〕给“两边有意义但不相等”的数值" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontColor=#B71C1C;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1666" width="1840" height="30" as="geometry"/></mxCell>
<mxCell id="bg139" value="&lt;b style=&quot;font-size:20px&quot;&gt;工具箱 ① 公式卡：名称 · 公式 · 条件 · ⚡ 第一反应 · ⇒ 用于 · ⋯ 配合（内容取自对应节点）&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#0D47A1;align=left;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1770" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="bgframe" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F1F8FE;strokeColor=#64B5F6;strokeWidth=2;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1820" width="1900" height="6516" as="geometry"/></mxCell>
<mxCell id="bg140" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍代数&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1850" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg141" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R02〔H2〕 平方差&lt;/b&gt;&lt;br&gt;\({a^2-b^2=(a+b)(a-b)}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到两个平方相减，或“和×差” → 平方差&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 韦达定理：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{(-b)^2-\Delta}{4a^2}=\dfrac{c}{a}}\)&lt;/span&gt;〔P03 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 共轭与模：与平方差同型〔R23 · M8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 分母有理化：分母用平方差〔P44 · H6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 海伦公式：平方差分解〔P48 · K8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 分式化简求值：【用平方差分解】〔Q11 · L2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 整式化简、简便计算：【凑成“和×差”】〔Q12 · H2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：分母有理化〔P44 · H6〕、共轭〔R23 · M8〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1890" width="905" height="226" as="geometry"/></mxCell>
<mxCell id="bg142" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R03〔H2〕 完全平方&lt;/b&gt;&lt;br&gt;\({(a\pm b)^2=a^2\pm 2ab+b^2}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({a^2\pm 2ab+b^2}\) 三项 → 写成完全平方&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两数和（差）的立方：【展开】\({(a+b)^2(a+b)}\) 差：【代换】\({b\to -b}\)〔R05 · G2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 互换式：【移项】展开后移项〔R07 · G3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 配方：【配方法】提出 \({a}\)，补上 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{b}{2a}\right)^2}\)&lt;/span&gt; 再减去〔P01 · H2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 同角关系的常用变形：完全平方〔R38 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 比较大小、证明不等式：【作差后配成完全平方定号】〔Q14 · G2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：配方〔P01 · H2〕、\({(\sin\alpha\pm\cos\alpha)^2}\)〔R38 · L6〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="2130" width="905" height="206" as="geometry"/></mxCell>
<mxCell id="bg143" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R04〔F2〕 三数和的平方&lt;/b&gt;&lt;br&gt;\({(a+b+c)^2=a^2+b^2+c^2+2ab+2bc+2ca}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 互换式：【移项】三元式〔R07 · G3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({a+b}\)、\({ab}\)（或 \({a+b+c}\) 等），求对称式：【三数和的平方移项】〔Q10 · G3〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="2350" width="905" height="106" as="geometry"/></mxCell>
<mxCell id="bg144" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R05〔G2〕 两数和（差）的立方&lt;/b&gt;&lt;br&gt;\({(a\pm b)^3=a^3\pm 3a^2b+3ab^2\pm b^3}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 互换式：【移项】立方式〔R07 · G3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 平方和：【累加相消】\({(k+1)^3-k^3=3k^2+3k+1}\)，\({k}\) 从 1 加到 \({n}\) &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(n+1)^3-1=3\sum k^2+\dfrac{3n(n+1)}{2}+n}\)&lt;/span&gt;，解出 \({\sum k^2}\)〔R31 · D3〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="2470" width="905" height="106" as="geometry"/></mxCell>
<mxCell id="bg145" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R06〔H2〕 立方和（差）&lt;/b&gt;&lt;br&gt;\({a^3\pm b^3=(a\pm b)(a^2\mp ab+b^2)}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到两个立方相加减 → 立方公式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 高次式分解、降次：【直接套立方公式】〔Q06 · J2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 分式化简求值：【用立方差分解】〔Q11 · L2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 高次式分解&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="2590" width="905" height="146" as="geometry"/></mxCell>
<mxCell id="bg146" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R07〔G3〕 互换式&lt;/b&gt;&lt;br&gt;\({a^2+b^2=(a+b)^2-2ab}\)，\({a^3+b^3=(a+b)^3-3ab(a+b)}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到平方和 \({a^2+b^2}\)、对称式（交换 \({a,b}\) 不变）→ 化成 \({a+b}\) 与 \({ab}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两根的对称式：互换式〔P45 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({a+b}\)、\({ab}\)（或 \({a+b+c}\) 等），求对称式：【化成 \({a+b}\) 与 \({ab}\)】〔Q10 · G3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：韦达〔P03 · H3〕→ 两根的对称式〔P45 · H3〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="2750" width="905" height="146" as="geometry"/></mxCell>
<mxCell id="bg147" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R08〔J2〕 因式分解&lt;/b&gt;&lt;br&gt;\({x^2+(p+q)x+pq=(x+p)(x+q)}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到二次式要拆开 → 先试十字相乘&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求方程 \({ax^2+bx+c=0}\) 的根：【分解后令每个因式 \({=0}\)】〔Q01 · K2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解二次不等式：【分解后看区间正负】〔Q02 · L2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求二次函数的零点：【分解就是交点式】〔Q03 · L2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 含参数的二次式：【把参数拆进因式】〔Q04 · J2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 高次式分解、降次：【提出一个根，剩下的再十字相乘】〔Q06 · J2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 比较大小、证明不等式：【作差后因式分解定号】〔Q14 · G2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 二次三项式因式分解：【十字相乘】〔Q65 · K2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解一元二次、高次方程；不等式大厦 R25（穿根法）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：约分〔P42 · L2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="2910" width="905" height="266" as="geometry"/></mxCell>
<mxCell id="bg148" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P01〔H2〕 配方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({ax^2+bx+c=a\left(x+\dfrac{b}{2a}\right)^2+\dfrac{4ac-b^2}{4a}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到求二次式的最值、值域 → 配方&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求根公式：【开平方】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(x+\dfrac{b}{2a}\right)^2=\dfrac{\Delta}{4a^2}}\)&lt;/span&gt;〔P02 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求方程 \({ax^2+bx+c=0}\) 的根：【配成平方再开方】〔Q01 · K2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求二次式的最值、值域：【配方读顶点】〔Q08 · G3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求二次式的最值；不等式大厦 R23&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="3190" width="905" height="202" as="geometry"/></mxCell>
<mxCell id="bg149" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P02〔H3〕 求根公式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=\dfrac{-b\pm\sqrt{\Delta}}{2a}}\)&lt;/span&gt;，\({\Delta=b^2-4ac}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({\Delta\ge 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：十字相乘拆不开 → 求根公式（先看 \({\Delta}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 韦达定理：【代入】两根相加；两根相乘用平方差〔P03 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 交点式：【因式分解】求出两根后写成 \({a(x-x_1)(x-x_2)}\)（另一路）〔P04 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求方程 \({ax^2+bx+c=0}\) 的根：【十字相乘拆不开时用】〔Q01 · K2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 二次式对一切 \({x}\) 恒成立：【用判别式定参数范围】〔Q07 · G3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 二次三项式因式分解：【求两根再写交点式】〔Q65 · K2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解方程、二次函数零点&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="3406" width="905" height="242" as="geometry"/></mxCell>
<mxCell id="bg150" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P03〔H3〕 韦达定理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_1+x_2=-\dfrac{b}{a}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_1x_2=\dfrac{c}{a}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a\ne 0}\)，\({x_1,x_2}\) 为两实根（\({\Delta\ge 0}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：不解方程求两根的式子 → 韦达&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 交点式：【展开】右边展开，用韦达对比系数〔P04 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两根的对称式：【代入】韦达代入互换式〔P45 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知两根，写方程或解析式：【用两根之和、之积写方程】〔Q05 · H4〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 不解方程求两根的式子：【两根和、积代入】〔Q09 · J3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 根的符号、根的分布：【韦达加判别式列条件】〔Q15 · J3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 二次函数大厦 R11（根的符号）；不等式大厦 R34&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：互换式〔R07 · G3〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="3662" width="905" height="262" as="geometry"/></mxCell>
<mxCell id="bg151" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P45〔H3〕 两根的对称式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({|x_1-x_2|=\dfrac{\sqrt{\Delta}}{|a|}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({x_1,x_2}\) 为两实根（\({\Delta\ge 0}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({x_1^2+x_2^2}\)、\({|x_1-x_2|}\) → 韦达代入互换式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 不解方程求两根的式子：【代入对称式公式】〔Q09 · J3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解析几何中的弦长：【联立后求 \({|x_1-x_2|}\)，再乘 \({\sqrt{1+k^2}}\)】〔Q16 · H4〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解析几何——联立消元后求弦长、中点&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：弦长 \({|AB|=\sqrt{1+k^2}\,|x_1-x_2|}\)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="3938" width="905" height="202" as="geometry"/></mxCell>
<mxCell id="bg152" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P42〔L2〕 分式运算&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b}\pm\dfrac{c}{d}=\dfrac{ad\pm bc}{bd}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕分母 \({\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到分式 → 先因式分解，再约分、通分&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两角和差的正切：分子、分母同除非零式〔P14 · N5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 弦化切（齐次式）：分子、分母同除非零式〔P47 · J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 裂项：通分〔R30 · E2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等比求和：两边除以 \({1-q}\)〔P31 · B2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数除法：分式化简（分母 \({\ne 0}\)）〔P23 · N8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 商的求导法则：分式化简（分母 \({\ne 0}\)）〔P38 · D5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 分式化简求值：【先分解再约分】〔Q11 · L2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 裂项、复数除法、商的求导、弦化切&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="4154" width="905" height="282" as="geometry"/></mxCell>
<mxCell id="bg153" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍指数、根式、对数&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1235" y="1850" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg154" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P41〔F5〕 整数指数幂运算律&lt;/b&gt;&lt;br&gt;\({a^m\div a^n=a^{m-n}}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{-n}=\dfrac{1}{a^n}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a\ne 0,\ b\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到负指数、零指数 → &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{-n}=\dfrac{1}{a^n}}\)&lt;/span&gt;，\({a^0=1}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 实数指数运算律：【推广】由整数指数推广；有理、实数指数课本说明运算律仍成立〔P05 · F5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等比通项：\({q^0=1}\)，\({q\cdot q^{n-2}=q^{n-1}}\)〔P29 · B2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="1890" width="905" height="162" as="geometry"/></mxCell>
<mxCell id="bg155" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P05〔F5〕 实数指数运算律&lt;/b&gt;&lt;br&gt;\({a^ra^s=a^{r+s}}\)，\({(a^r)^s=a^{rs}}\)，\({(ab)^r=a^rb^r}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a&amp;gt;0,\ b&amp;gt;0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到分数、实数指数 → 先化成同底（底数 \({&amp;gt;0}\)），再用指数运算律&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数运算律：【设】\({M=a^p}\)，\({N=a^q}\)：积 \({a^pa^q=a^{p+q}}\)；商 \({a^p\div a^q=a^{p-q}}\)；幂 \({(a^p)^n=a^{pn}}\)，再取对数〔P07 · F5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 一般指数、对数求导的由来：【代换】\({a^x=e^{x\ln a}}\)，用链式法则〔P40 · B5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 根式运算：【特例】取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({r=\dfrac{1}{2}}\)&lt;/span&gt;；算术平方根非负〔P43 · H5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 指数式、根式化简求值：【同底合并】〔Q17 · G5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{\frac{1}{2}}+a^{-\frac{1}{2}}}\)&lt;/span&gt;，求 \({a+a^{-1}}\) 等：【整体平方】〔Q18 · G5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解指数方程：【化同底后换元】〔Q20 · G5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="2066" width="905" height="226" as="geometry"/></mxCell>
<mxCell id="bg156" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P43〔H5〕 根式运算&lt;/b&gt;&lt;br&gt;\({\sqrt{a}\sqrt{b}=\sqrt{ab}}\)，\({\sqrt{a^2}=|a|}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕被开方数 \({\ge 0}\)；〔符号分支〕开方要定号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到根号 → 化成分数指数幂；开偶次方要带绝对值&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 分母有理化：【同乘】分子、分母同乘 \({\sqrt{a}-\sqrt{b}}\)〔P44 · H6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知一个三角函数值求其余：\({\sqrt{a^2}=|a|}\)，开方要定号〔P46 · L5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求根公式：开平方〔P02 · H3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 半角：开平方要定号〔P16 · M6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 指数式、根式化简求值：【根式化分数指数】〔Q17 · G5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 含根式的化简、有理化：【开方定号】〔Q23 · H6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数的模；含根式的化简&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：已知一值求其余〔P46 · L5〕、升幂后开方〔R19 · M6〕都要定号&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="2306" width="905" height="266" as="geometry"/></mxCell>
<mxCell id="bg157" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P44〔H6〕 分母有理化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\sqrt{a}+\sqrt{b}}=\dfrac{\sqrt{a}-\sqrt{b}}{a-b}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a,b\ge 0,\ a\ne b}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：分母是根式的和或差 → 乘它的“共轭”，用平方差&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 裂项的其他形式：【同乘】根式形用分母有理化〔P53 · E2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 含根式的化简、有理化：【乘共轭有理化】〔Q23 · H6〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="2586" width="905" height="162" as="geometry"/></mxCell>
<mxCell id="bg158" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P06〔E5〕 对数恒等式&lt;/b&gt;&lt;br&gt;\({a^{\log_a N}=N}\)，\({\log_a 1=0}\)，\({\log_a a=1}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a&amp;gt;0,\ a\ne 1,\ N&amp;gt;0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({a^{\log_a N}}\) 或 \({\log_a a^b}\) → 直接等于 \({N}\)、\({b}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数运算律：指数式与对数式互化〔P07 · F5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 指数函数与对数函数互为反函数：【逆运算】指数式与对数式互化〔P10 · E5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 一般指数、对数求导的由来：\({a=e^{\ln a}}\)〔P40 · B5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数式化简求值：【直接取值】〔Q19 · F6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 比较指数、对数的大小：【找中间值】〔Q22 · E5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="2762" width="905" height="206" as="geometry"/></mxCell>
<mxCell id="bg159" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P07〔F5〕 对数运算律&lt;/b&gt;&lt;br&gt;\({\log_a(MN)=\log_a M+\log_a N}\)，\({\log_a M^n=n\log_a M}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({M&amp;gt;0,\ N&amp;gt;0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到同底对数相加减 → 合成积、商的对数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 换底公式：【设】\({\log_a b=x\Rightarrow a^x=b}\)，两边取 \({\log_c}\) \({x\log_c a=\log_c b}\)；\({a\ne 1\Rightarrow\log_c a\ne 0}\)，两边同除〔P08 · F6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数式化简求值：【合成积的对数】〔Q19 · F6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解对数方程：【合并后去对数】〔Q21 · F6〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="2982" width="905" height="166" as="geometry"/></mxCell>
<mxCell id="bg160" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P08〔F6〕 换底公式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a b=\dfrac{\log_c b}{\log_c a}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a,c&amp;gt;0}\) 且 \({\ne 1}\)，\({b&amp;gt;0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到底数不同的对数 → 换成同底（常换成 lg 或 ln）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 换底推论：【代入】都换成以 \({c}\) 为底〔P09 · F6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 一般指数、对数求导的由来：【代换】换底：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a x=\dfrac{\ln x}{\ln a}}\)&lt;/span&gt;〔P40 · B5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数式化简求值：【换成同底】〔Q19 · F6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数式化简&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="3162" width="905" height="202" as="geometry"/></mxCell>
<mxCell id="bg161" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P09〔F6〕 换底推论&lt;/b&gt;&lt;br&gt;\({\log_a b\cdot\log_b a=1}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_{a^m}b^n=\dfrac{n}{m}\log_a b}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕底数 \({&amp;gt;0}\) 且 \({\ne 1}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({\log_a b\cdot\log_b c}\) 连乘 → 链式相消&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数式化简求值：【链式相消】〔Q19 · F6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 比较指数、对数的大小：【互为倒数】〔Q22 · E5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({a^x=b^y=c}\) 型，求 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}+\dfrac{1}{y}}\)&lt;/span&gt; 等：【倒数关系再合并】〔Q24 · E5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 对数式化简求值&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="3378" width="905" height="202" as="geometry"/></mxCell>
<mxCell id="bg162" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍三角&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1235" y="3610" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg163" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R13〔K4〕 勾股恒等式&lt;/b&gt;&lt;br&gt;\({\sin^2\alpha+\cos^2\alpha=1}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({\sin^2}\)、\({\cos^2}\) 同时出现，或已知一个求另一个 → 勾股恒等式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 正切与余弦：【同除】两边除以 \({\cos^2\alpha}\)〔P12 · K5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 倍角：用 \({\sin^2\alpha+\cos^2\alpha=1}\) 换成单一函数〔R18 · M5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 辅助角：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{a}{r}\right)^2+\left(\dfrac{b}{r}\right)^2=1}\)&lt;/span&gt;，故有 \({\varphi}\)〔P17 · L5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知一个三角函数值求其余：【移项】【开平方】〔P46 · L5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 同角关系的常用变形：\({\sin^2\alpha+\cos^2\alpha=1}\) 合并〔R38 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 弦化切（齐次式）：\({1=\sin^2\alpha+\cos^2\alpha}\)〔P47 · J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 证明三角恒等式：【“1”的代换】〔Q67 · J5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="3650" width="905" height="226" as="geometry"/></mxCell>
<mxCell id="bg164" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P11〔J4〕 商数关系&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{\sin\alpha}{\cos\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({\cos\alpha\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 tan 与 sin、cos 混在一起 → 切化弦&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 正切与余弦：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sin\alpha}{\cos\alpha}=\tan\alpha}\)&lt;/span&gt;〔P12 · K5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 弦化切（齐次式）：【同除】分子、分母同除 \({\cos\alpha}\)；二次式先用“1”的代换再同除 \({\cos^2\alpha}\)〔P47 · J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知一个三角函数值，求其余：【切化弦】〔Q25 · L5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角式化简求值（角不同、名不同、次数高）：【切化弦】〔Q66 · N5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 证明三角恒等式：【切化弦、通分】〔Q67 · J5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="3890" width="905" height="222" as="geometry"/></mxCell>
<mxCell id="bg165" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P12〔K5〕 正切与余弦&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1+\tan^2\alpha=\dfrac{1}{\cos^2\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({\cos\alpha\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({1+\tan^2\alpha}\) 或 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\cos^2\alpha}}\)&lt;/span&gt; → 互化&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({\tan\alpha}\) 求 \({\cos^2\alpha}\)；不等式大厦 P16&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="4126" width="905" height="142" as="geometry"/></mxCell>
<mxCell id="bg166" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R14〔L4〕 诱导公式（sin、cos 对任意实数 \({\alpha}\) 成立）&lt;/b&gt;&lt;br&gt;\({\sin(\pi-\alpha)=\sin\alpha}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\left(\dfrac{\pi}{2}-\alpha\right)=\sin\alpha}\)&lt;/span&gt; 等六组&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({\pi\pm\alpha}\)、&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{2}\pm\alpha}\)&lt;/span&gt;、\({-\alpha}\) → 诱导公式化成锐角&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 tan 的诱导公式：【相除】sin 式除以 cos 式〔P13 · M5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两角差的余弦：\({\alpha-\beta=\pm\theta+2k\pi}\)，由 ①③ 得 \({\cos(\alpha-\beta)=\cos\theta}\)〔R16 · L5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 其余和差角：诱导公式 ③⑤〔R17 · M5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角形内角关系：【代换】\({A+B=\pi-C}\)，用 ④ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{A+B}{2}=\dfrac{\pi}{2}-\dfrac{C}{2}}\)&lt;/span&gt;，用 ⑤〔P19 · L7〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角形面积：诱导公式 ④〔P20 · J8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 诱导公式化简求值：【化成锐角】〔Q28 · M5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="4282" width="905" height="222" as="geometry"/></mxCell>
<mxCell id="bg167" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R16〔L5〕 两角差的余弦&lt;/b&gt;&lt;br&gt;\({\cos(\alpha-\beta)=\cos\alpha\cos\beta+\sin\alpha\sin\beta}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到两角差的余弦，或能把角拆成已知角的差 → 两角差余弦&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 其余和差角：【代换】\({\beta\to -\beta}\) 得 \({\cos(\alpha+\beta)}\) &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin(\alpha+\beta)=\cos\left[\left(\dfrac{\pi}{2}-\alpha\right)-\beta\right]}\)&lt;/span&gt; 再展开〔R17 · M5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 给值求值（已知 \({\alpha}\)、\({\alpha+\beta}\) 的值求 \({\beta}\) 的值）：【配角】〔Q30 · L5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="4518" width="905" height="126" as="geometry"/></mxCell>
<mxCell id="bg168" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R17〔M5〕 其余和差角&lt;/b&gt;&lt;br&gt;\({\sin(\alpha\pm\beta)=\sin\alpha\cos\beta\pm\cos\alpha\sin\beta}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到两角和差，或角能拆成已知角的和差 → 和差角公式（拆角配角）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两角和差的正切：【相除】分子、分母同除 \({\cos\alpha\cos\beta}\)〔P14 · N5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 倍角：【特例】令 \({\beta=\alpha}\)〔R18 · M5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 积化和差：【相加减】两个和差角公式相加或相减〔R20 · N5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 辅助角：【提取】提出 \({r=\sqrt{a^2+b^2}}\)，倒用 sin 和角公式〔P17 · L5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角形式乘法：【和角】实部 \({\cos(\theta_1+\theta_2)}\)，虚部 \({\sin(\theta_1+\theta_2)}\)〔R26 · O8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求 \({15^\circ}\)、\({75^\circ}\) 等非特殊角的值：【拆成特殊角】〔Q29 · M5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角式化简求值（角不同、名不同、次数高）：【和差角展开】〔Q66 · N5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="4658" width="905" height="226" as="geometry"/></mxCell>
<mxCell id="bg169" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P14〔N5〕 两角和差的正切&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan(\alpha\pm\beta)=\dfrac{\tan\alpha\pm\tan\beta}{1\mp\tan\alpha\tan\beta}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕三个 tan 都有定义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 tan 的和差，或 \({\tan\alpha+\tan\beta}\) 与 \({\tan\alpha\tan\beta}\) 同时出现 → 正切和角&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 正切倍角：【特例】令 \({\beta=\alpha}\)〔P15 · N6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 含 tan 的和角求值：【正切和角变形】〔Q33 · N6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解析几何——两直线夹角 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\theta=\left|\dfrac{k_2-k_1}{1+k_1k_2}\right|}\)&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="4898" width="905" height="182" as="geometry"/></mxCell>
<mxCell id="bg170" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R18〔M5〕 倍角&lt;/b&gt;&lt;br&gt;\({\sin 2\alpha=2\sin\alpha\cos\alpha}\)，\({\cos 2\alpha=2\cos^2\alpha-1=1-2\sin^2\alpha}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({2\alpha}\) 与 \({\alpha}\) 同时出现 → 倍角&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 降幂：【移项】再两边除以 2〔R19 · M6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 万能公式：【同除】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha=\dfrac{2\sin\frac{\alpha}{2}\cos\frac{\alpha}{2}}{\sin^2\frac{\alpha}{2}+\cos^2\frac{\alpha}{2}}}\)&lt;/span&gt;，同除 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos^2\dfrac{\alpha}{2}}\)&lt;/span&gt;〔P18 · M6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 同角关系的常用变形：【展开】完全平方展开；\({2\sin\alpha\cos\alpha=\sin 2\alpha}\)〔R38 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角式化简求值（角不同、名不同、次数高）：【倍角逆用】〔Q66 · N5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角函数的图像与性质&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="5094" width="905" height="186" as="geometry"/></mxCell>
<mxCell id="bg171" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R19〔M6〕 降幂&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos^2\alpha=\dfrac{1+\cos 2\alpha}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin^2\alpha=\dfrac{1-\cos 2\alpha}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：求周期、最值、单调性时看到 \({\sin^2}\)、\({\cos^2}\) → 降幂；看到 \({1\pm\cos 2\alpha}\) → 升幂&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 半角：【代换】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\to\dfrac{\alpha}{2}}\)&lt;/span&gt; 后开平方 tan 式：前式分子、分母同乘 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({2\cos\dfrac{\alpha}{2}}\)&lt;/span&gt;，后式同乘 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({2\sin\dfrac{\alpha}{2}}\)&lt;/span&gt;〔P16 · M6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角函数的最值、周期、单调区间：【先降幂再辅助角】〔Q31 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 化简 \({\sqrt{1\pm\sin 2\alpha}}\)、\({\sqrt{1\pm\cos 2\alpha}}\)：【升幂】〔Q32 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：\({\sqrt{1+\cos 2\alpha}=\sqrt{2}|\cos\alpha|}\)，开方要用〔P43 · H5〕定号&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="5294" width="905" height="182" as="geometry"/></mxCell>
<mxCell id="bg172" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P16〔M6〕 半角&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\dfrac{\alpha}{2}=\dfrac{\sin\alpha}{1+\cos\alpha}=\dfrac{1-\cos\alpha}{\sin\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔符号分支〕± 由 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\alpha}{2}}\)&lt;/span&gt; 所在象限定&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：求 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\alpha}{2}}\)&lt;/span&gt; 的三角函数值 → 半角（定号）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求 \({15^\circ}\)、\({75^\circ}\) 等非特殊角的值：【用半角】〔Q29 · M5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求半角的三角函数值：【无 ± 的有理式】〔Q35 · M6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求 \({15^\circ}\)、\({22.5^\circ}\) 等的值&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="5490" width="905" height="182" as="geometry"/></mxCell>
<mxCell id="bg173" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R20〔N5〕 积化和差&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\cos\beta=\dfrac{1}{2}[\sin(\alpha+\beta)+\sin(\alpha-\beta)]}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到两个三角函数相乘要化成和 → 积化和差&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 和差化积：【代换】令 \({\alpha+\beta=\theta}\)，\({\alpha-\beta=\varphi}\)〔R21 · O6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角函数的积与和互化（求值、证明）：【积化和差】〔Q34 · O6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角式的积和互化、证明&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="5686" width="905" height="162" as="geometry"/></mxCell>
<mxCell id="bg174" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R21〔O6〕 和差化积&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\theta+\sin\varphi=2\sin\dfrac{\theta+\varphi}{2}\cos\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到两个三角函数相加减要化成积 → 和差化积&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角函数的积与和互化（求值、证明）：【和差化积】〔Q34 · O6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角式的积和互化、证明&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="5862" width="905" height="142" as="geometry"/></mxCell>
<mxCell id="bg175" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P17〔L5〕 辅助角&lt;/b&gt;&lt;br&gt;\({a\sin x+b\cos x=\sqrt{a^2+b^2}\sin(x+\varphi)}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({a,b}\) 不全为 0；〔符号分支〕\({\varphi}\) 由 \({a,b}\) 正负定&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到同角的 \({a\sin\omega x+b\cos\omega x}\) → 辅助角化成一个正弦&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角函数的最值、周期、单调区间：【辅助角】〔Q31 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角形中求边、周长、面积的最值或范围：【辅助角求最值】〔Q42 · J9〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：先降幂〔R19 · M6〕、倍角〔R18 · M5〕，再辅助角&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="6018" width="905" height="166" as="geometry"/></mxCell>
<mxCell id="bg176" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P47〔J5〕 弦化切（齐次式）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a\sin\alpha+b\cos\alpha}{c\sin\alpha+d\cos\alpha}=\dfrac{a\tan\alpha+b}{c\tan\alpha+d}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({\cos\alpha\ne 0}\)，分母 \({\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：已知 \({\tan\alpha}\) 求 sin、cos 的齐次式 → 弦化切&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({\tan\alpha}\)，求 sin、cos 的齐次式：【同除 \({\cos\alpha}\)】〔Q26 · J5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="6198" width="905" height="142" as="geometry"/></mxCell>
<mxCell id="bg177" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R38〔L6〕 同角关系的常用变形&lt;/b&gt;&lt;br&gt;\({(\sin\alpha\pm\cos\alpha)^2=1\pm\sin 2\alpha}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({\sin\alpha\pm\cos\alpha}\) 与 \({\sin\alpha\cos\alpha}\) → 两边平方互求&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({\sin\alpha\pm\cos\alpha}\)，求 \({\sin\alpha\cos\alpha}\) 或 \({\sin 2\alpha}\)：【两边平方】〔Q27 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 化简 \({\sqrt{1\pm\sin 2\alpha}}\)、\({\sqrt{1\pm\cos 2\alpha}}\)：【配成完全平方】〔Q32 · L6〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="6354" width="905" height="126" as="geometry"/></mxCell>
<mxCell id="bg178" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍向量与解三角形&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="4466" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg179" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R15〔K7〕 数量积坐标式&lt;/b&gt;&lt;br&gt;\({\vec a\cdot\vec b=x_1x_2+y_1y_2}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：已知坐标求数量积 → 坐标式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两角差的余弦：【数量积】\({\overrightarrow{OA}=(\cos\alpha,\sin\alpha)}\)，\({\overrightarrow{OB}=(\cos\beta,\sin\beta)}\) 按坐标 \({=\cos\alpha\cos\beta+\sin\alpha\sin\beta}\)；按定义 \({=\cos\theta}\)〔R16 · L5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 数量积的运算公式：坐标运算〔P49 · K8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 向量的模、夹角、垂直：【坐标判垂直】〔Q41 · L8〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="4506" width="905" height="146" as="geometry"/></mxCell>
<mxCell id="bg180" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P49〔K8〕 数量积的运算公式&lt;/b&gt;&lt;br&gt;\({|\vec a\pm\vec b|^2=|\vec a|^2\pm 2\vec a\cdot\vec b+|\vec b|^2}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕夹角公式要求 \({\vec a,\vec b\ne\vec 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：模 → 平方；夹角 → &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta=\dfrac{\vec a\cdot\vec b}{|\vec a||\vec b|}}\)&lt;/span&gt;；垂直 → \({\vec a\cdot\vec b=0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 余弦定理：【向量】\({\overrightarrow{BC}=\overrightarrow{AC}-\overrightarrow{AB}}\)，用 \({|\vec a-\vec b|^2}\) 展开 \({|\overrightarrow{BC}|^2=b^2+c^2-2bc\cos A}\)〔P22 · K8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 向量的模、夹角、垂直：【平方求模】〔Q41 · L8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解析几何中的垂直、夹角&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="4666" width="905" height="166" as="geometry"/></mxCell>
<mxCell id="bg181" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P20〔J8〕 三角形面积&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S=\dfrac{1}{2}ab\sin C}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕\({a,b}\) 夹角 \({C}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：求三角形面积 → &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}ab\sin C}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 正弦定理：【面积法】三式相等，同除 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}abc}\)&lt;/span&gt; \({=2R}\)：作直径 \({BD}\)，\({\angle BCD=90^\circ}\)，\({\angle BDC}\) 与 \({A}\) 相等或互补，\({a=2R\sin\angle BDC=2R\sin A}\) \({A=90^\circ}\) 时 \({BC}\) 就是直径，\({a=2R}\) 直接成立〔P21 · J8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 海伦公式：【代入】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S^2=\dfrac{1}{4}a^2b^2(1-\cos^2C)}\)&lt;/span&gt;，\({\cos C}\) 用余弦定理推论，两次平方差〔P48 · K8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求三角形面积：【两边夹角】〔Q38 · J8〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="4846" width="905" height="202" as="geometry"/></mxCell>
<mxCell id="bg182" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P21〔J8〕 正弦定理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{\sin A}=\dfrac{b}{\sin B}=\dfrac{c}{\sin C}=2R}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕同一三角形的边与对角&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：已知两角一边，或边角混在一起（各项中边的次数相同）→ 正弦定理边角互化&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解三角形——已知两角一边，或边角混在一起：【边角互化】〔Q37 · H9〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 判断三角形的形状：【边化角】〔Q39 · J9〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角形中求边、周长、面积的最值或范围：【边化角】〔Q42 · J9〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 不等式大厦 R13（三角形中求最值）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：余弦定理〔P22 · K8〕做边角互化&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="5062" width="905" height="222" as="geometry"/></mxCell>
<mxCell id="bg183" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P22〔K8〕 余弦定理&lt;/b&gt;&lt;br&gt;\({a^2=b^2+c^2-2bc\cos A}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos A=\dfrac{b^2+c^2-a^2}{2bc}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕\({a}\) 为 \({A}\) 的对边，\({b,c}\) 夹 \({A}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：已知三边，或两边及夹角 → 余弦定理&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 海伦公式：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos C=\dfrac{a^2+b^2-c^2}{2ab}}\)&lt;/span&gt;〔P48 · K8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 解三角形——已知三边，或两边及夹角：【代入求边、求角】〔Q36 · K8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 判断三角形的形状：【看边的关系】〔Q39 · J9〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="5298" width="905" height="182" as="geometry"/></mxCell>
<mxCell id="bg184" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍复数&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="5510" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg185" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R23〔M8〕 共轭与模&lt;/b&gt;&lt;br&gt;\({z\bar z=|z|^2}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：求 \({|z|}\)、\({z\bar z}\) → 共轭相乘&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数除法：【分母实数化】分子、分母同乘 \({c-di}\)〔P23 · N8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 模的乘法：【代入】\({|z_1z_2|^2=z_1z_2\cdot\overline{z_1z_2}=(z_1\bar z_1)(z_2\bar z_2)}\)，再开方〔R25 · M8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数的模、共轭、几何意义：【共轭相乘】〔Q44 · M8〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="5550" width="905" height="146" as="geometry"/></mxCell>
<mxCell id="bg186" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P23〔N8〕 复数除法&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a+bi}{c+di}=\dfrac{(ac+bd)+(bc-ad)i}{c^2+d^2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({c+di\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：复数除法 → 分母实数化&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数四则运算：【分母实数化】〔Q43 · N8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数计算&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="5710" width="905" height="162" as="geometry"/></mxCell>
<mxCell id="bg187" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R26〔O8〕 三角形式乘法&lt;/b&gt;&lt;br&gt;模相乘、辐角相加&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：三角形式相乘 → 模相乘、辐角相加&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 三角形式除法：【逆运算】商乘 \({z_2}\) 等于 \({z_1}\)〔P25 · O8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 棣莫弗公式：【归纳法】\({n=k}\) 成立时再乘一次〔R27 · O8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数的三角形式与乘除：【模乘辐角加】〔Q46 · N8〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="5886" width="905" height="146" as="geometry"/></mxCell>
<mxCell id="bg188" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R27〔O8〕 棣莫弗公式&lt;/b&gt;&lt;br&gt;\({[r(\cos\theta+i\sin\theta)]^n=r^n(\cos n\theta+i\sin n\theta)}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：复数的高次幂 → 先看能否用 \({(1\pm i)^2=\pm 2i}\) 或 \({i^n}\) 的周期；不行再化三角形式用棣莫弗&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数的高次幂：【棣莫弗】〔Q45 · N8〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 复数的乘方、方根&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="6046" width="905" height="126" as="geometry"/></mxCell>
<mxCell id="bg189" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍数列&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="6202" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg190" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P26〔C2〕 等差通项&lt;/b&gt;&lt;br&gt;\({a_n=a_1+(n-1)d}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕等差数列&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：已知等差数列的两项 → \({a_n=a_m+(n-m)d}\) 求公差&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等差下标性质：【代入】两边都等于 \({2a_1+(m+n-2)d}\)〔P27 · C2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等差、等比数列的基本量（知三求二）：【列方程】〔Q49 · D2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 递推 \({a_{n+1}=pa_n+q}\) 或 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a_{n+1}=\dfrac{a_n}{ka_n+1}}\)&lt;/span&gt;，求通项：【取倒数构造等差】〔Q68 · C2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="6242" width="905" height="166" as="geometry"/></mxCell>
<mxCell id="bg191" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P28〔C3〕 等差求和&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_n=\dfrac{n(a_1+a_n)}{2}=na_1+\dfrac{n(n-1)}{2}d}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕等差数列&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：等差求和：知首末项用 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{n(a_1+a_n)}{2}}\)&lt;/span&gt;；项数为奇数的前 \({n}\) 项和（如 \({S_9=9a_5}\)）想到 \({S_{2n-1}=(2n-1)a_n}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 自然数求和：【特例】\({a_1=1}\)，\({d=1}\)〔R29 · C3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 片段和：等差：【作差】相邻片段和相减〔P54 · C3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等差、等比数列的基本量（知三求二）：【代入求和】〔Q49 · D2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等差、等比的性质速算：【\({S_{2n-1}=(2n-1)a_n}\)】〔Q50 · D3〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="6422" width="905" height="202" as="geometry"/></mxCell>
<mxCell id="bg192" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P29〔B2〕 等比通项&lt;/b&gt;&lt;br&gt;\({a_n=a_1q^{n-1}}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕等比数列&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：已知等比数列的两项 → \({a_n=a_mq^{n-m}}\) 求公比&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等比下标性质：【代入】两边都等于 \({a_1^2q^{m+n-2}}\)〔P30 · B2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等比求和：【错位相减】\({S_n-qS_n=a_1-a_1q^n}\)，两边除以 \({1-q}\)〔P31 · B2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 片段和：等比：【作比】\({S_{2m}-S_m=q^mS_m}\)（每项乘 \({q^m}\)）〔P54 · C3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等差、等比数列的基本量（知三求二）：【列方程】〔Q49 · D2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 递推 \({a_{n+1}=pa_n+q}\) 或 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a_{n+1}=\dfrac{a_n}{ka_n+1}}\)&lt;/span&gt;，求通项：【构造等比】〔Q68 · C2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({S_n}\) 与 \({a_n}\) 的关系式（如 \({S_n=2a_n-1}\)），求通项：【按等比写通项】〔Q69 · A2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="6638" width="905" height="226" as="geometry"/></mxCell>
<mxCell id="bg193" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P31〔B2〕 等比求和&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_n=\dfrac{a_1(1-q^n)}{1-q}}\)&lt;/span&gt;（\({q\ne 1}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕等比数列；〔定义域〕\({q\ne 1}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：等比求和 → 先看 \({q}\) 是否为 1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 差比数列求和（错位相减）：【错位相减】\({S-qS=\sum q^{k-1}-nq^n}\)，再用等比求和〔P52 · B3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等差、等比数列的基本量（知三求二）：【代入求和】〔Q49 · D2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 差比数列求和&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="6878" width="905" height="182" as="geometry"/></mxCell>
<mxCell id="bg194" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P51〔B2〕 等差中项、等比中项&lt;/b&gt;&lt;br&gt;\({2b=a+c}\)；\({b^2=ac}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔结构前提〕等差、等比&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：三个数成等差或等比 → 中项（等比中项 \({G^2=ab}\)，要求 \({ab&amp;gt;0}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 等差、等比的性质速算：【中项】〔Q50 · D3〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="7074" width="905" height="126" as="geometry"/></mxCell>
<mxCell id="bg195" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P32〔A2〕 \({a_n}\) 与 \({S_n}\)&lt;/b&gt;&lt;br&gt;\({a_n=S_n-S_{n-1}}\)（\({n\ge 2}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({n\ge 2}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：给出 \({S_n}\) 求 \({a_n}\) → 作差，\({n=1}\) 单独验证&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({S_n}\)，求 \({a_n}\)：【作差】〔Q48 · A2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({S_n}\) 与 \({a_n}\) 的关系式（如 \({S_n=2a_n-1}\)），求通项：【两式相减】〔Q69 · A2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 已知 \({S_n}\) 求 \({a_n}\)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="7214" width="905" height="166" as="geometry"/></mxCell>
<mxCell id="bg196" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R30〔E2〕 裂项&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k(k+1)}=\dfrac{1}{k}-\dfrac{1}{k+1}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：通项是 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k(k+1)}}\)&lt;/span&gt; → 裂项相消&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 裂项的其他形式：【推广】通分验证〔P53 · E2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 通项是分式或根式差的数列求和：【裂项】〔Q52 · D2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 数列和的不等式（放缩证明）：【放缩后裂项】〔Q55 · E2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：累加相消〔R28 · D2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="7394" width="905" height="182" as="geometry"/></mxCell>
<mxCell id="bg197" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P53〔E2〕 裂项的其他形式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k(k+d)}=\dfrac{1}{d}\left(\dfrac{1}{k}-\dfrac{1}{k+d}\right)}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({d\ne 0}\)；根式形 \({k\ge 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：通项是 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{a_ka_{k+1}}}\)&lt;/span&gt; 或 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\sqrt{k}+\sqrt{k+1}}}\)&lt;/span&gt; → 裂项&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 通项是分式或根式差的数列求和：【裂项】〔Q52 · D2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="7590" width="905" height="142" as="geometry"/></mxCell>
<mxCell id="bg198" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R31〔D3〕 平方和&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sum k^2=\dfrac{n(n+1)(2n+1)}{6}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({1^2+2^2+\cdots}\) → 平方和公式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 通项是多项式（或几部分之和）的数列求和：【拆成平方和加自然数和】〔Q53 · C3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 数列求和、放缩估计&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="7746" width="905" height="142" as="geometry"/></mxCell>
<mxCell id="bg199" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R32〔C3〕 立方和&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sum k^3=\left[\dfrac{n(n+1)}{2}\right]^2}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({1^3+2^3+\cdots}\) → 立方和公式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 数列求和&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-2170" y="7902" width="905" height="122" as="geometry"/></mxCell>
<mxCell id="bg200" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍计数&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1235" y="6510" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg201" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P33〔N2〕 排列数&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({A_n^m=\dfrac{n!}{(n-m)!}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({m\le n}\)（自然数）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：从 \({n}\) 个中选 \({m}\) 个排成一列（有序）→ 排列数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 组合数：【分步计数】先选 \({m}\) 个再排列：\({A_n^m=C_n^m\cdot m!}\)〔P34 · N2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 计数（排队、选人）：【有序】〔Q59 · N2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="6550" width="905" height="162" as="geometry"/></mxCell>
<mxCell id="bg202" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P34〔N2〕 组合数&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({C_n^m=\dfrac{n!}{m!(n-m)!}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({0\le m\le n}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：只选不排（无序）→ 组合数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 组合数性质：【对应】选出 \({m}\) 个 ⟺ 留下 \({n-m}\) 个 【分类计数】某个指定元素选或不选〔P35 · M2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 二项式定理：【分步计数】\({n}\) 个 \({(a+b)}\) 相乘，每个括号选 \({a}\) 或 \({b}\) 恰好选 \({k}\) 个 \({b}\) 有 \({C_n^k}\) 种〔R33 · N2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 组合数的提取：【代入】公式化简；或【双计数】选 \({k}\) 人委员会再选主席〔P36 · N2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 计数（排队、选人）：【无序】〔Q59 · N2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="6726" width="905" height="202" as="geometry"/></mxCell>
<mxCell id="bg203" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P35〔M2〕 组合数性质&lt;/b&gt;&lt;br&gt;\({C_n^m=C_n^{n-m}}\)，\({C_{n+1}^m=C_n^m+C_n^{m-1}}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕下标范围见各式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：组合数化简 → 对称性、杨辉三角递推&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 组合数化简、求和、证明：【杨辉递推、对称】〔Q58 · M2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 组合数化简、证明&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="6942" width="905" height="146" as="geometry"/></mxCell>
<mxCell id="bg204" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R33〔N2〕 二项式定理&lt;/b&gt;&lt;br&gt;\({(a+b)^n=\sum C_n^ka^{n-k}b^k}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 \({(a+b)^n}\) 展开、求某一项 → 通项 \({T_{k+1}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 二项式系数性质：【赋值】令 \({a=b=1}\)；令 \({a=1,\ b=-1}\) 得交错和为 0〔R34 · M2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 两数和（差）的立方：【特例】\({n=3}\)（另一路）〔R05 · G2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 正整数幂求导的由来：【二项式展开】\({(x+\Delta x)^n}\)〔R35 · C4〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 展开式的各项系数和：【赋值】令 \({x=1,\ -1,\ 0}\)〔R39 · N2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求展开式的特定项、常数项、某项系数：【写通项】〔Q56 · N2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 近似计算、整除与余数：【展开取前几项】〔Q60 · O2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;&quot;&gt;⋯ 配合：区分二项式系数〔R34 · M2〕与项的系数〔R39 · N2〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="7102" width="905" height="226" as="geometry"/></mxCell>
<mxCell id="bg205" value="&lt;b style=&quot;font-size:14px;&quot;&gt;R34〔M2〕 二项式系数性质&lt;/b&gt;&lt;br&gt;\({\sum C_n^k=2^n}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：求二项式系数和 → \({2^n}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求展开式的系数和：【二项式系数和】〔Q57 · N3〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="7342" width="905" height="106" as="geometry"/></mxCell>
<mxCell id="bg206" value="&lt;b style=&quot;font-size:16px;color:#0D47A1;&quot;&gt;▍导数&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1235" y="7478" width="905" height="32" as="geometry"/></mxCell>
<mxCell id="bg207" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P37〔C4〕 和、差、积的求导法则&lt;/b&gt;&lt;br&gt;\({(uv)'=u'v+uv'}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({u,v}\) 在该点可导&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到函数的和、差、积 → 和差积法则&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 商的求导法则：\({u,v}\) 可导，配凑手法同积法则〔P38 · D5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求导数：【积法则】〔Q61 · C5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 判断单调性、求极值和最值：【求导看正负】〔Q63 · B5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 含参数的函数求单调区间：【求导后分类】〔Q70 · C5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 切线、单调性、极值&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="7518" width="905" height="206" as="geometry"/></mxCell>
<mxCell id="bg208" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P38〔D5〕 商的求导法则&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{u}{v}\right)'=\dfrac{u'v-uv'}{v^2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕\({u,v}\) 可导，\({v(x)\ne 0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到分式函数 → 商法则&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 常用导数：【商法则】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{1}{x}\right)'=\dfrac{0\cdot x-1}{x^2}}\)&lt;/span&gt;，\({x&amp;lt;0}\) 时同样成立〔P55 · C5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求导数：【商法则】〔Q61 · C5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 不等式大厦 P05（构造函数判单调）；切线、单调性、极值&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="7738" width="905" height="182" as="geometry"/></mxCell>
<mxCell id="bg209" value="&lt;b style=&quot;font-size:14px;&quot;&gt;P55〔C5〕 常用导数&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{1}{x}\right)'=-\dfrac{1}{x^2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\sqrt{x})'=\dfrac{1}{2\sqrt{x}}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#E65100;&quot;&gt;条件：〔定义域〕各式括号内&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：看到 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}}\)&lt;/span&gt;、\({\sqrt{x}}\)、\({e^{ax+b}}\)、\({\ln(ax+b)}\) → 常用导数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求导数：【常用导数（含复合）】〔Q61 · C5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="7934" width="905" height="142" as="geometry"/></mxCell>
<mxCell id="bg210" value="&lt;b style=&quot;font-size:14px;&quot;&gt;S12〔B5〕 【课本给出】导数表与链式法则&lt;/b&gt;&lt;br&gt;\({y'_x=f'(u)\cdot g'(x)}\)（链式法则）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#00695C;font-weight:bold;&quot;&gt;⚡ 第一反应：求基本初等函数的导数 → 查表；复合函数 → 链式法则&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 \({(\ln x)'}\) 的由来：链式法则；\({\ln x}\) 可导由导数表给出〔P39 · A5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 常用导数：【特例】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha=-1,\ \dfrac{1}{2}}\)&lt;/span&gt;；【链式法则】\({u=ax+b}\)〔P55 · C5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 一般指数、对数求导的由来：链式法则；\({(e^x)'=e^x}\)〔P40 · B5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求导数：【链式法则】〔Q61 · C5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 求曲线在某点的切线方程：【求斜率再点斜式】〔Q62 · A5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;&quot;&gt;▸ 用在 过某点作曲线的切线（点不一定在曲线上）：【设切点】〔Q71 · B5〕&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0D47A1;arcSize=8;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="bg"><mxGeometry x="-1235" y="8090" width="905" height="206" as="geometry"/></mxCell>
<mxCell id="bg211" value="&lt;b style=&quot;font-size:20px&quot;&gt;工具箱 ② 常用数值：直接查表，不画线&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#0D47A1;align=left;" vertex="1" parent="bg"><mxGeometry x="-2200" y="8376" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="bg212" value="&lt;b&gt;T1 特殊角三角函数值&lt;/b&gt;&lt;br&gt;\({\alpha}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\pi}{6}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\pi}{4}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\pi}{3}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\pi}{2}}\)&lt;/span&gt;&lt;br&gt;\({\sin}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{1}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\sqrt{2}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\sqrt{3}}{2}}\)&lt;/span&gt;，\({1}\)&lt;br&gt;\({\cos}\)：\({1}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\sqrt{3}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\sqrt{2}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{1}{2}}\)&lt;/span&gt;，\({0}\)&lt;br&gt;\({\tan}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\sqrt{3}}{3}}\)&lt;/span&gt;，\({1}\)，\({\sqrt{3}}\)，不存在&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin 15^\circ=\cos 75^\circ=\frac{\sqrt{6}-\sqrt{2}}{4}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos 15^\circ=\sin 75^\circ=\frac{\sqrt{6}+\sqrt{2}}{4}}\)&lt;/span&gt;&lt;br&gt;\({\tan 15^\circ=2-\sqrt{3}}\)，\({\tan 75^\circ=2+\sqrt{3}}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="8426" width="841" height="215" as="geometry"/></mxCell>
<mxCell id="bg213" value="&lt;b&gt;T2 杨辉三角 n=0～6&lt;/b&gt;&lt;br&gt;1 ｜ 1 1 ｜ 1 2 1 ｜ 1 3 3 1&lt;br&gt;1 4 6 4 1 ｜ 1 5 10 10 5 1&lt;br&gt;1 6 15 20 15 6 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1329" y="8426" width="841" height="107" as="geometry"/></mxCell>
<mxCell id="bg214" value="&lt;b&gt;T3 常用对数&lt;/b&gt;&lt;br&gt;\({\lg 2\approx 0.3010}\)，\({\lg 3\approx 0.4771}\)，\({\lg 5\approx 0.6990}\)&lt;br&gt;\({\ln 2\approx 0.693}\)，\({\ln 3\approx 1.099}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1329" y="8553" width="841" height="86" as="geometry"/></mxCell>
<mxCell id="bg215" value="&lt;b&gt;T4 诱导公式口诀&lt;/b&gt;&lt;br&gt;“奇变偶不变，符号看象限”&lt;br&gt;把 \({\alpha}\) 看作锐角定符号；记忆口诀，不是条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1329" y="8659" width="841" height="86" as="geometry"/></mxCell>
<mxCell id="bg216" value="&lt;b&gt;T5 平方 11～20&lt;/b&gt;&lt;br&gt;121，144，169，196，225&lt;br&gt;256，289，324，361，400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="8661" width="841" height="86" as="geometry"/></mxCell>
<mxCell id="bg217" value="&lt;b&gt;T6 立方 1～10&lt;/b&gt;&lt;br&gt;1，8，27，64，125&lt;br&gt;216，343，512，729，1000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1329" y="8765" width="841" height="86" as="geometry"/></mxCell>
<mxCell id="bg218" value="&lt;b&gt;T7 \({2^1}\)～\({2^{10}}\)&lt;/b&gt;&lt;br&gt;2，4，8，16，32&lt;br&gt;64，128，256，512，1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="8767" width="841" height="86" as="geometry"/></mxCell>
<mxCell id="bg219" value="&lt;b&gt;T8 常见勾股数&lt;/b&gt;&lt;br&gt;(3,4,5)　(5,12,13)　(8,15,17)&lt;br&gt;(7,24,25)　(20,21,29)　(9,40,41)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1329" y="8871" width="841" height="86" as="geometry"/></mxCell>
<mxCell id="bg220" value="&lt;b&gt;T9 常用近似值&lt;/b&gt;&lt;br&gt;\({\sqrt{2}\approx 1.414}\)，\({\sqrt{3}\approx 1.732}\)，\({\sqrt{5}\approx 2.236}\)&lt;br&gt;\({\pi\approx 3.1416}\)，\({e\approx 2.718}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="8873" width="841" height="86" as="geometry"/></mxCell>
<mxCell id="bg221" value="&lt;b&gt;T10 基本导数表&lt;/b&gt;&lt;br&gt;\({C'=0}\)，\({(x^n)'=nx^{n-1}}\)&lt;br&gt;\({(\sin x)'=\cos x}\)，\({(\cos x)'=-\sin x}\)&lt;br&gt;\({(e^x)'=e^x}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln x)'=\frac{1}{x}}\)&lt;/span&gt;（\({x&amp;gt;0}\)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1329" y="8977" width="841" height="116" as="geometry"/></mxCell>
<mxCell id="bg222" value="&lt;b style=&quot;font-size:20px&quot;&gt;问题目录（反推）：看到什么 → 先查 → 去图里的问题节点〔编号 · 坐标〕&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#00695C;align=left;" vertex="1" parent="bg"><mxGeometry x="-2200" y="9153" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="bg223" value="&lt;b&gt;▍① 代数&lt;/b&gt;&lt;br&gt;▸ 求方程 \({ax^2+bx+c=0}\) 的根 → 先查：\({a\ne 0}\)；\({\Delta&amp;lt;0}\) 无实根 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q01〔K2〕&lt;/b&gt;&lt;br&gt;▸ 解二次不等式 → 先查：\({\Delta\le 0}\) 时单独看 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q02〔L2〕&lt;/b&gt;&lt;br&gt;▸ 求二次函数的零点 → 先查：\({\Delta&amp;lt;0}\) 时无零点 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q03〔L2〕&lt;/b&gt;&lt;br&gt;▸ 含参数的二次式 → 先查：两根相等的参数值单独看 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q04〔J2〕&lt;/b&gt;&lt;br&gt;▸ 已知两根，写方程或解析式 → 先查：二次项系数 \({a\ne 0}\) 要保留 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q05〔H4〕&lt;/b&gt;&lt;br&gt;▸ 高次式分解、降次 → 先查：整数根试不出时，未必不能分解 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q06〔J2〕&lt;/b&gt;&lt;br&gt;▸ 二次式对一切 \({x}\) 恒成立 → 先查：\({a}\) 含参数时先讨论 \({a=0}\)；整数范围分解不出来不代表无实根，要看 \({\Delta}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q07〔G3〕&lt;/b&gt;&lt;br&gt;▸ 求二次式的最值、值域 → 先查：限定区间时看对称轴位置 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q08〔G3〕&lt;/b&gt;&lt;br&gt;▸ 不解方程求两根的式子 → 先查：先验 \({\Delta\ge 0}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q09〔J3〕&lt;/b&gt;&lt;br&gt;▸ 已知 \({a+b}\)、\({ab}\)（或 \({a+b+c}\) 等），求对称式 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q10〔G3〕&lt;/b&gt;&lt;br&gt;▸ 分式化简求值 → 先查：约掉的因式 \({\ne 0}\)，化简后标注取值限制 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q11〔L2〕&lt;/b&gt;&lt;br&gt;▸ 整式化简、简便计算 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q12〔H2〕&lt;/b&gt;&lt;br&gt;▸ 证明代数恒等式 → 先查：每一步要等价 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q13〔K2〕&lt;/b&gt;&lt;br&gt;▸ 比较大小、证明不等式 → 先查：因式的正负要逐个判断 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q14〔G2〕&lt;/b&gt;&lt;br&gt;▸ 根的符号、根的分布 → 先查：两正根要同时满足三个条件 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q15〔J3〕&lt;/b&gt;&lt;br&gt;▸ 解析几何中的弦长 → 先查：消元后二次项系数 \({\ne 0}\) 且 \({\Delta&amp;gt;0}\)；斜率不存在时直接用 \({|y_1-y_2|}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q16〔H4〕&lt;/b&gt;&lt;br&gt;▸ 二次三项式因式分解 → 先查：\({\Delta&amp;lt;0}\) 时在实数范围内不能分解；\({ax^2+bx+c=a(x-x_1)(x-x_2)}\)，不要漏 \({a}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q65〔K2〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="9203" width="935" height="352" as="geometry"/></mxCell>
<mxCell id="bg224" value="&lt;b&gt;▍② 指数、根式与对数&lt;/b&gt;&lt;br&gt;▸ 指数式、根式化简求值 → 先查：底数 \({a&amp;gt;0}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q17〔G5〕&lt;/b&gt;&lt;br&gt;▸ 已知 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{\frac{1}{2}}+a^{-\frac{1}{2}}}\)&lt;/span&gt;，求 \({a+a^{-1}}\) 等 → 先查：开方时注意正负 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q18〔G5〕&lt;/b&gt;&lt;br&gt;▸ 对数式化简求值 → 先查：真数 \({&amp;gt;0}\)，底数 \({&amp;gt;0}\) 且 \({\ne 1}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q19〔F6〕&lt;/b&gt;&lt;br&gt;▸ 解指数方程 → 先查：换元后 \({t&amp;gt;0}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q20〔G5〕&lt;/b&gt;&lt;br&gt;▸ 解对数方程 → 先查：合并后定义域可能变大，必须检验 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q21〔F6〕&lt;/b&gt;&lt;br&gt;▸ 比较指数、对数的大小 → 先查：底数 \({&amp;gt;1}\) 与 \({0&amp;lt;}\) 底数 \({&amp;lt;1}\) 单调性相反 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q22〔E5〕&lt;/b&gt;&lt;br&gt;▸ 含根式的化简、有理化 → 先查：去绝对值看正负 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q23〔H6〕&lt;/b&gt;&lt;br&gt;▸ 已知 \({a^x=b^y=c}\) 型，求 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}+\dfrac{1}{y}}\)&lt;/span&gt; 等 → 先查：\({c\ne 1}\)（否则 \({x=0}\)，没有倒数） → &lt;b style=&quot;color:#004D40;&quot;&gt;Q24〔E5〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="9203" width="935" height="206" as="geometry"/></mxCell>
<mxCell id="bg225" value="&lt;b&gt;▍③ 三角&lt;/b&gt;&lt;br&gt;▸ 已知一个三角函数值，求其余 → 先查：先定 \({\alpha}\) 所在象限；象限未知时分两种情况讨论 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q25〔L5〕&lt;/b&gt;&lt;br&gt;▸ 已知 \({\tan\alpha}\)，求 sin、cos 的齐次式 → 先查：\({\cos\alpha\ne 0}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q26〔J5〕&lt;/b&gt;&lt;br&gt;▸ 已知 \({\sin\alpha\pm\cos\alpha}\)，求 \({\sin\alpha\cos\alpha}\) 或 \({\sin 2\alpha}\) → 先查：反过来开方时按象限定号 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q27〔L6〕&lt;/b&gt;&lt;br&gt;▸ 诱导公式化简求值 → 先查：“把 \({\alpha}\) 看作锐角”只是判断符号的办法，公式对任意 \({\alpha}\) 成立 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q28〔M5〕&lt;/b&gt;&lt;br&gt;▸ 求 \({15^\circ}\)、\({75^\circ}\) 等非特殊角的值 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q29〔M5〕&lt;/b&gt;&lt;br&gt;▸ 给值求值（已知 \({\alpha}\)、\({\alpha+\beta}\) 的值求 \({\beta}\) 的值） → 先查：先由角的范围定出所需正弦、余弦的符号 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q30〔L5〕&lt;/b&gt;&lt;br&gt;▸ 三角函数的最值、周期、单调区间 → 先查：\({\varphi}\) 由 \({a,b}\) 的正负定 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q31〔L6〕&lt;/b&gt;&lt;br&gt;▸ 化简 \({\sqrt{1\pm\sin 2\alpha}}\)、\({\sqrt{1\pm\cos 2\alpha}}\) → 先查：按 \({\alpha}\) 的范围去绝对值 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q32〔L6〕&lt;/b&gt;&lt;br&gt;▸ 含 tan 的和角求值 → 先查：\({\tan(\alpha+\beta)}\) 要有定义 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q33〔N6〕&lt;/b&gt;&lt;br&gt;▸ 三角函数的积与和互化（求值、证明） → &lt;b style=&quot;color:#004D40;&quot;&gt;Q34〔O6〕&lt;/b&gt;&lt;br&gt;▸ 求半角的三角函数值 → 先查：sin、cos 半角按 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\alpha}{2}}\)&lt;/span&gt; 的象限定号 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q35〔M6〕&lt;/b&gt;&lt;br&gt;▸ 三角式化简求值（角不同、名不同、次数高） → 先查：一看角、二看名、三看次数；降幂会把角变成 \({2\alpha}\)，降幂后再统一角；常以辅助角〔P17〕收尾 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q66〔N5〕&lt;/b&gt;&lt;br&gt;▸ 证明三角恒等式 → 先查：从一边连等推到另一边，或两边分别化到同一式；不把结论当条件用；注意 \({\alpha}\) 使各式有意义 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q67〔J5〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="9429" width="935" height="288" as="geometry"/></mxCell>
<mxCell id="bg226" value="&lt;b&gt;▍③a 向量与解三角形（三角的卫星城）&lt;/b&gt;&lt;br&gt;▸ 解三角形——已知三边，或两边及夹角 → 先查：求角用推论 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos A=\dfrac{b^2+c^2-a^2}{2bc}}\)&lt;/span&gt;，角唯一 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q36〔K8〕&lt;/b&gt;&lt;br&gt;▸ 解三角形——已知两角一边，或边角混在一起 → 先查：已知 \({a,b,A}\) 求 \({B}\)：\({\sin B}\) 对应锐角、钝角两个值；\({a\ge b}\) 时只取锐角，\({a&amp;lt;b}\) 时两个都要检验 \({A+B&amp;lt;\pi}\)，可能两解（例 \({a=\sqrt{3}}\)，\({b=2}\)，\({A=45^\circ}\) 有两解） → &lt;b style=&quot;color:#004D40;&quot;&gt;Q37〔H9〕&lt;/b&gt;&lt;br&gt;▸ 求三角形面积 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q38〔J8〕&lt;/b&gt;&lt;br&gt;▸ 判断三角形的形状 → 先查：两边同除时注意除数 \({\ne 0}\)；\({\sin 2A=\sin 2B}\) 有两种情况；\({a^2+b^2&amp;gt;c^2}\) 只说明 \({C}\) 是锐角，判断锐角三角形看最大边所对的角 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q39〔J9〕&lt;/b&gt;&lt;br&gt;▸ 三角形中的三角式化简 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q40〔L7〕&lt;/b&gt;&lt;br&gt;▸ 向量的模、夹角、垂直 → 先查：求夹角要非零向量；夹角为锐角 \({\iff\vec a\cdot\vec b&amp;gt;0}\) 且不同向，钝角同理要排除反向 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q41〔L8〕&lt;/b&gt;&lt;br&gt;▸ 三角形中求边、周长、面积的最值或范围 → 先查：角的范围要由三角形条件定出 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q42〔J9〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="9575" width="935" height="198" as="geometry"/></mxCell>
<mxCell id="bg227" value="&lt;b&gt;▍③b 复数（三角的卫星城）&lt;/b&gt;&lt;br&gt;▸ 复数四则运算 → 先查：\({i^2=-1}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q43〔N8〕&lt;/b&gt;&lt;br&gt;▸ 复数的模、共轭、几何意义 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q44〔M8〕&lt;/b&gt;&lt;br&gt;▸ 复数的高次幂 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q45〔N8〕&lt;/b&gt;&lt;br&gt;▸ 复数的三角形式与乘除 → 先查：辐角可加 \({2k\pi}\)；三角形式要求 \({r&amp;gt;0}\)，写成 \({\cos\theta+i\sin\theta}\)（同角、中间是加号） → &lt;b style=&quot;color:#004D40;&quot;&gt;Q46〔N8〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="9737" width="935" height="118" as="geometry"/></mxCell>
<mxCell id="bg228" value="&lt;b&gt;▍④ 数列&lt;/b&gt;&lt;br&gt;▸ 已知递推关系，求通项 → 先查：\({n=1}\) 单独验证 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q47〔D2〕&lt;/b&gt;&lt;br&gt;▸ 已知 \({S_n}\)，求 \({a_n}\) → 先查：以 \({n=1}\) 代入验证为准；\({S_n}\) 是 \({n}\) 的多项式且常数项 \({\ne 0}\) 时首项必须分开写（\({S_n=2^n-1}\) 这类可能不用分开） → &lt;b style=&quot;color:#004D40;&quot;&gt;Q48〔A2〕&lt;/b&gt;&lt;br&gt;▸ 等差、等比数列的基本量（知三求二） → 先查：等比求和先看 \({q}\) 是否为 1 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q49〔D2〕&lt;/b&gt;&lt;br&gt;▸ 等差、等比的性质速算 → 先查：先确认是等差还是等比 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q50〔D3〕&lt;/b&gt;&lt;br&gt;▸ 通项是“等差 × 等比”的数列求和 → 先查：中间等比部分的项数（常为 \({n-1}\) 项）、最后一项的符号、最后除以 \({1-q}\)；\({q=1}\) 单独算 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q51〔B3〕&lt;/b&gt;&lt;br&gt;▸ 通项是分式或根式差的数列求和 → 先查：看清首尾剩下哪几项；裂项后核对系数（如 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}}\)&lt;/span&gt;） → &lt;b style=&quot;color:#004D40;&quot;&gt;Q52〔D2〕&lt;/b&gt;&lt;br&gt;▸ 通项是多项式（或几部分之和）的数列求和 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q53〔C3〕&lt;/b&gt;&lt;br&gt;▸ 已知前 \({m}\)、\({2m}\) 项和，求前 \({3m}\) 项和 → 先查：等比数列片段和为 0 时不成等比 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q54〔C3〕&lt;/b&gt;&lt;br&gt;▸ 数列和的不等式（放缩证明） → 先查：从第几项开始放缩要说清 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q55〔E2〕&lt;/b&gt;&lt;br&gt;▸ 递推 \({a_{n+1}=pa_n+q}\) 或 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a_{n+1}=\dfrac{a_n}{ka_n+1}}\)&lt;/span&gt;，求通项 → 先查：构造出的新数列首项不能为 0 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q68〔C2〕&lt;/b&gt;&lt;br&gt;▸ 已知 \({S_n}\) 与 \({a_n}\) 的关系式（如 \({S_n=2a_n-1}\)），求通项 → 先查：相减只对 \({n\ge 2}\) 成立，\({n=1}\) 由原式单独求 \({a_1}\) → &lt;b style=&quot;color:#004D40;&quot;&gt;Q69〔A2〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="9793" width="935" height="260" as="geometry"/></mxCell>
<mxCell id="bg229" value="&lt;b&gt;▍⑤ 计数&lt;/b&gt;&lt;br&gt;▸ 求展开式的特定项、常数项、某项系数 → 先查：\({T_{k+1}}\) 是第 \({k+1}\) 项；系数要连同符号和常数一起算 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q56〔N2〕&lt;/b&gt;&lt;br&gt;▸ 求展开式的系数和 → 先查：区分“项的系数”和“二项式系数” → &lt;b style=&quot;color:#004D40;&quot;&gt;Q57〔N3〕&lt;/b&gt;&lt;br&gt;▸ 组合数化简、求和、证明 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q58〔M2〕&lt;/b&gt;&lt;br&gt;▸ 计数（排队、选人） → 先查：特殊元素、特殊位置优先 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q59〔N2〕&lt;/b&gt;&lt;br&gt;▸ 近似计算、整除与余数 → 先查：求余数时余数要非负，展开后为负要加上除数调整 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q60〔O2〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="9875" width="935" height="136" as="geometry"/></mxCell>
<mxCell id="bg230" value="&lt;b&gt;▍⑥ 导数（卫星城，接指数对数、计数）&lt;/b&gt;&lt;br&gt;▸ 求导数 → 先查：链式法则别漏乘内层导数；商法则分子是 \({u'v-uv'}\)，顺序不能反 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q61〔C5〕&lt;/b&gt;&lt;br&gt;▸ 求曲线在某点的切线方程 → 先查：“在点处”与“过点”不同：过点时切点要设出来 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q62〔A5〕&lt;/b&gt;&lt;br&gt;▸ 判断单调性、求极值和最值 → 先查：先写定义域；极值点处导数为 0，但导数为 0 不一定是极值点 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q63〔B5〕&lt;/b&gt;&lt;br&gt;▸ 构造函数证明不等式 → 先查：先写定义域（如 \({x&amp;gt;0}\)） → &lt;b style=&quot;color:#004D40;&quot;&gt;Q64〔A5〕&lt;/b&gt;&lt;br&gt;▸ 含参数的函数求单调区间 → 先查：先写定义域；分类的分界点要不重不漏 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q70〔C5〕&lt;/b&gt;&lt;br&gt;▸ 过某点作曲线的切线（点不一定在曲线上） → 先查：“过点”可能有多条切线；“在点处”则该点就是切点 → &lt;b style=&quot;color:#004D40;&quot;&gt;Q71〔B5〕&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="10031" width="935" height="154" as="geometry"/></mxCell>
<mxCell id="bg231" value="&lt;b style='font-size:20px'&gt;方法索引：按方法复习，到〔坐标〕找推导线&lt;/b&gt;&lt;br&gt;正推（由因导果）= 综合法：沿箭头往下读；反推（执果索因）= 分析法：从问题目录往回查&lt;br&gt;&lt;b&gt;展开&lt;/b&gt;（17 处）：用分配律把乘积逐项乘开　R01〔H2〕、R02〔H2〕、R03〔H2〕、R04〔F2〕、R05〔G2〕、R06〔H2〕、P04〔H3〕、R09〔J2〕、R10〔K2〕、R11〔K2〕、R15〔K7〕、R22〔M7〕、R23〔M8〕、R26〔O8〕、R35〔C4〕、R38〔L6〕、P49〔K8〕&lt;br&gt;&lt;b&gt;代入&lt;/b&gt;（13 处）：把已知式代进去　P03〔H3〕、P06〔E5〕、P09〔F6〕、R13〔K4〕、R24〔N7〕、R25〔M8〕、P27〔C2〕、P30〔B2〕、P36〔N2〕、P45〔H3〕、P41〔F5〕、P48〔K8〕、P51〔B2〕&lt;br&gt;&lt;b&gt;代换&lt;/b&gt;（10 处）：把某个量换成另一个式子（如 \({b\to -b}\)）　R03〔H2〕、R05〔G2〕、R06〔H2〕、P07〔F5〕、P08〔F6〕、R17〔M5〕、P16〔M6〕、R21〔O6〕、P19〔L7〕、P40〔B5〕&lt;br&gt;&lt;b&gt;特例&lt;/b&gt;（5 处）：取特殊值得到特殊情形　R18〔M5〕、P15〔N6〕、R29〔C3〕、P43〔H5〕、P55〔C5〕&lt;br&gt;&lt;b&gt;分步计数&lt;/b&gt;（3 处）：分步乘法原理　P33〔N2〕、P34〔N2〕、R33〔N2〕&lt;br&gt;&lt;b&gt;同除&lt;/b&gt;（3 处）：两边同除一个非零式　P12〔K5〕、P18〔M6〕、P47〔J5〕&lt;br&gt;&lt;b&gt;移项&lt;/b&gt;（3 处）：等式两边同加减　R07〔G3〕、R19〔M6〕、P46〔L5〕&lt;br&gt;&lt;b&gt;通分&lt;/b&gt;（3 处）：化成同分母　R30〔E2〕、P38〔D5〕、P42〔L2〕&lt;br&gt;&lt;b&gt;作差&lt;/b&gt;（2 处）：两式相减　P32〔A2〕、P54〔C3〕&lt;br&gt;&lt;b&gt;向量&lt;/b&gt;（2 处）：用向量运算推几何关系　R16〔L5〕、P22〔K8〕&lt;br&gt;&lt;b&gt;定义&lt;/b&gt;（2 处）：直接用定义　P11〔J4〕、P20〔J8〕&lt;br&gt;&lt;b&gt;开平方&lt;/b&gt;（2 处）：两边开平方　P02〔H3〕、P46〔L5〕&lt;br&gt;&lt;b&gt;归纳法&lt;/b&gt;（2 处）：数学归纳法　R27〔O8〕、R32〔C3〕&lt;br&gt;&lt;b&gt;推广&lt;/b&gt;（2 处）：由特殊范围推到一般范围　P05〔F5〕、P53〔E2〕&lt;br&gt;&lt;b&gt;相除&lt;/b&gt;（2 处）：两式相除（如切化弦）　P13〔M5〕、P14〔N5〕&lt;br&gt;&lt;b&gt;累乘&lt;/b&gt;（2 处）：逐项相乘　P29〔B2〕、P50〔D2〕&lt;br&gt;&lt;b&gt;累加相消&lt;/b&gt;（2 处）：相邻项抵消　R31〔D3〕、P50〔D2〕&lt;br&gt;&lt;b&gt;赋值&lt;/b&gt;（2 处）：给字母赋特殊值　R34〔M2〕、R39〔N2〕&lt;br&gt;&lt;b&gt;逆用&lt;/b&gt;（2 处）：把公式从右往左读　R08〔J2〕、R36〔J2〕&lt;br&gt;&lt;b&gt;逆运算&lt;/b&gt;（2 处）：利用互逆运算互化　P10〔E5〕、P25〔O8〕&lt;br&gt;&lt;b&gt;配凑&lt;/b&gt;（2 处）：加一项减一项　P37〔C4〕、P38〔D5〕&lt;br&gt;&lt;b&gt;链式法则&lt;/b&gt;（2 处）：复合函数求导　P39〔A5〕、P55〔C5〕&lt;br&gt;&lt;b&gt;错位相减&lt;/b&gt;（2 处）：乘公比后相减　P31〔B2〕、P52〔B3〕&lt;br&gt;&lt;b&gt;倒序相加&lt;/b&gt;（1 处）：正写倒写相加　P28〔C3〕&lt;br&gt;&lt;b&gt;分母实数化&lt;/b&gt;（1 处）：乘共轭使分母为实数　P23〔N8〕&lt;br&gt;&lt;b&gt;分类计数&lt;/b&gt;（1 处）：分类加法原理　P35〔M2〕&lt;br&gt;&lt;b&gt;分类讨论&lt;/b&gt;（1 处）：按正负等情况分开处理　R37〔K2〕&lt;br&gt;&lt;b&gt;双计数&lt;/b&gt;（1 处）：同一件事两种数法　P36〔N2〕&lt;br&gt;&lt;b&gt;同乘&lt;/b&gt;（1 处）：分子分母同乘一个式子　P44〔H6〕&lt;br&gt;&lt;b&gt;对应&lt;/b&gt;（1 处）：一一对应计数　P35〔M2〕&lt;br&gt;&lt;b&gt;对称&lt;/b&gt;（1 处）：终边对称点的坐标关系　R14〔L4〕&lt;br&gt;&lt;b&gt;按定义&lt;/b&gt;（1 处）：回到定义计算　R35〔C4〕&lt;br&gt;&lt;b&gt;提取&lt;/b&gt;（1 处）：提出公因式　P17〔L5〕&lt;br&gt;&lt;b&gt;数个数&lt;/b&gt;（1 处）：数因数的个数　R12〔F4〕&lt;br&gt;&lt;b&gt;数形结合（单位圆）&lt;/b&gt;（1 处）　P24〔O7〕&lt;br&gt;&lt;b&gt;相加减&lt;/b&gt;（1 处）：两式相加或相减　R20〔N5〕&lt;br&gt;&lt;b&gt;累加&lt;/b&gt;（1 处）：逐项相加　P26〔C2〕&lt;br&gt;&lt;b&gt;结合律&lt;/b&gt;（1 处）：重新加括号　R28〔D2〕&lt;br&gt;&lt;b&gt;配方&lt;/b&gt;（1 处）：配成完全平方　P01〔H2〕&lt;br&gt;&lt;b&gt;面积法&lt;/b&gt;（1 处）：同一面积的不同算法　P21〔J8〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#8D6E63;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#3E2723;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fontSize=13;" vertex="1" parent="bg"><mxGeometry x="-2200" y="10245" width="1900" height="1124" as="geometry"/></mxCell>
<mxCell id="tr0" value="地基 → ① 代数&lt;br&gt;S01→R01、S01→R36、S01→R37&lt;br&gt;S01→P42" style="html=1;rounded=1;curved=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#546E7A;strokeWidth=5;opacity=80;endArrow=block;endSize=10;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#37474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="11416" y="494" as="sourcePoint"/><mxPoint x="13650" y="2556" as="targetPoint"/><Array as="points"><mxPoint x="11636" y="494"/><mxPoint x="11636" y="908"/><mxPoint x="13870" y="908"/><mxPoint x="13870" y="2556"/></Array><mxPoint x="500" y="824" as="offset"/></mxGeometry></mxCell>
<mxCell id="tr1" value="地基 → ② 指数、根式与对数&lt;br&gt;S01→R12（前提）" style="html=1;rounded=1;curved=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#546E7A;strokeWidth=5;opacity=80;endArrow=block;endSize=10;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#37474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="9388" y="494" as="sourcePoint"/><mxPoint x="9978" y="5693" as="targetPoint"/><Array as="points"><mxPoint x="9168" y="494"/><mxPoint x="9168" y="924"/><mxPoint x="6934" y="924"/><mxPoint x="6934" y="4205"/><mxPoint x="10198" y="4205"/><mxPoint x="10198" y="5693"/></Array><mxPoint x="3264" y="1340" as="offset"/></mxGeometry></mxCell>
<mxCell id="tr2" value="① 代数 → ③a 向量与解三角形（三角的卫星城）&lt;br&gt;R01→R15（前提）、R02→P48（前提）" style="html=1;rounded=1;curved=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#546E7A;strokeWidth=5;opacity=80;endArrow=block;endSize=10;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#37474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="13650" y="2556" as="sourcePoint"/><mxPoint x="13748" y="9352" as="targetPoint"/><Array as="points"><mxPoint x="13886" y="2556"/><mxPoint x="13886" y="4221"/><mxPoint x="17161" y="4221"/><mxPoint x="17161" y="7866"/><mxPoint x="13968" y="7866"/><mxPoint x="13968" y="9352"/></Array><mxPoint x="-3193" y="2704" as="offset"/></mxGeometry></mxCell>
<mxCell id="tr3" value="③a 向量与解三角形（三角的卫星城） → ③ 三角&lt;br&gt;R15→R16" style="html=1;rounded=1;curved=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#546E7A;strokeWidth=5;opacity=80;endArrow=block;endSize=10;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#37474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="13748" y="9352" as="sourcePoint"/><mxPoint x="16941" y="6035" as="targetPoint"/><Array as="points"><mxPoint x="13984" y="9352"/><mxPoint x="13984" y="7882"/><mxPoint x="17161" y="7882"/><mxPoint x="17161" y="6035"/></Array><mxPoint x="1408" y="-923" as="offset"/></mxGeometry></mxCell>
<mxCell id="tr4" value="③ 三角 → ③a 向量与解三角形（三角的卫星城）&lt;br&gt;R14→P19、S04→P20、R14→P20（前提）" style="html=1;rounded=1;curved=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#546E7A;strokeWidth=5;opacity=80;endArrow=block;endSize=10;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#37474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="16941" y="6035" as="sourcePoint"/><mxPoint x="13748" y="9352" as="targetPoint"/><Array as="points"><mxPoint x="17177" y="6035"/><mxPoint x="17177" y="7850"/><mxPoint x="13952" y="7850"/><mxPoint x="13952" y="9352"/></Array><mxPoint x="-1785" y="751" as="offset"/></mxGeometry></mxCell>
<mxCell id="tr5" value="① 代数 → ③b 复数（三角的卫星城）&lt;br&gt;R01→R22（前提）、R02→R23（前提）、P42→P23（前提）" style="html=1;rounded=1;curved=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#546E7A;strokeWidth=5;opacity=80;endArrow=block;endSize=10;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#37474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="13650" y="2556" as="sourcePoint"/><mxPoint x="17689" y="8930" as="targetPoint"/><Array as="points"><mxPoint x="13854" y="2556"/><mxPoint x="13854" y="4189"/><mxPoint x="17161" y="4189"/><mxPoint x="17161" y="7898"/><mxPoint x="17909" y="7898"/><mxPoint x="17909" y="8930"/></Array><mxPoint x="748" y="3942" as="offset"/></mxGeometry></mxCell>
<mxCell id="tr6" value="② 指数、根式与对数 → ③b 复数（三角的卫星城）&lt;br&gt;R12→R24（前提）" style="html=1;rounded=1;curved=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#546E7A;strokeWidth=5;opacity=80;endArrow=block;endSize=10;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#37474F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="9978" y="5693" as="sourcePoint"/><mxPoint x="17689" y="8930" as="targetPoint"/><Array as="points"><mxPoint x="10214" y="5693"/><mxPoint x="10214" y="7834"/><mxPoint x="17925" y="7834"/><mxPoint x="17925" y="8930"/></Array><mxPoint x="4378" y="548" as="offset"/></mxGeometry></mxCell>
