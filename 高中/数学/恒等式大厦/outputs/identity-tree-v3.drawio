<UserObject id="e52" label="【面积法】三式相等，同除 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}abc}\)&lt;/span&gt;&lt;br&gt;\({=2R}\)：作直径 \({BD}\)，\({\angle BCD=90^\circ}\)，\({\angle BDC}\) 与 \({A}\) 相等或互补，\({a=2R\sin\angle BDC=2R\sin A}\)&lt;br&gt;\({A=90^\circ}\) 时 \({BC}\) 就是直径，\({a=2R}\) 直接成立" 类型="推导" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P20" target="P21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10699" y="9746"/><mxPoint x="10697" y="9803"/></Array><mxPoint x="280" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
