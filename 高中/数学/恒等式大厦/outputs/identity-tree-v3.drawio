<UserObject id="e35" label="【前提】\({\alpha-\beta=\pm\theta+2k\pi}\)，由 ①③ 得 \({\cos(\alpha-\beta)=\cos\theta}\)" 类型="前提" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#90A4AE;strokeWidth=2;endSize=7;fontColor=#607D8B;" edge="1" parent="1" source="R14" target="R16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="13792" y="5202"/></Array><mxPoint x="171" y="-23" as="offset"/></mxGeometry></mxCell></UserObject>
