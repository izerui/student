<UserObject id="e87" label="【分步计数】\({n}\) 个 \({(a+b)}\) 相乘，每个括号选 \({a}\) 或 \({b}\)&lt;br&gt;恰好选 \({k}\) 个 \({b}\) 有 \({C_n^k}\) 种" 类型="推导" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P34" target="R33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15443" y="1779"/></Array><mxPoint x="159" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e94" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({u,v}\) 在该点可导&lt;/span&gt;&lt;br&gt;【配凑】\({u(x+\Delta x)v(x+\Delta x)-u(x)v(x)}\)&lt;br&gt;\({=[u(x+\Delta x)-u(x)]v(x+\Delta x)+u(x)[v(x+\Delta x)-v(x)]}\)&lt;br&gt;\({v}\) 可导 \({\Rightarrow v}\) 连续（课本承认）" 类型="推导" tags="推导层"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="S08" target="P37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3776" y="4696"/></Array><mxPoint x="182" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
