<mxCell id="bg4" value="▍① 代数：运算律 → 分配律展开 → 乘法公式、因式分解 → 配方、求根公式、韦达定理" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontStyle=1;fillColor=#37474F;fontColor=#FFFFFF;strokeColor=none;align=left;spacingLeft=14;" vertex="1" parent="bg"><mxGeometry x="7456" y="1394" width="916" height="40" as="geometry"/></mxCell>
