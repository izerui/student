<mxCell id="bg95" value="恒等式大厦" style="text;html=1;fontFamily=PingFang SC;fontSize=40;fontStyle=1;fontColor=#263238;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2200" y="-120" width="1900" height="60" as="geometry"/></mxCell>
<mxCell id="bg96" value="从 20 个起点（运算律、集合、指数与对数、单位圆、数量积、复数、计数原理、数列、导数、函数、坐标法、空间向量、体积、概率）出发，不跳步推出高中全部恒等式与公式&lt;br&gt;主干：源头 → 变形 → 结论；变形手法写在线上【方法】里。橙色 = 要加条件：〔定义域〕〔结构前提〕〔符号分支〕三类，各自独立" style="text;html=1;fontFamily=PingFang SC;fontSize=16;fontColor=#455A64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2200" y="-50" width="1900" height="80" as="geometry"/></mxCell>
<mxCell id="bg97" value="&lt;b style=&quot;font-size:20px&quot;&gt;图例与条件&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2200" y="60" width="1900" height="1926" as="geometry"/></mxCell>
<mxCell id="bg98" value="【定义】【公理】【原理】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="116" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg99" value="紫色：起点，直接承认（定义、公理、课本给出）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="116" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg100" value="★ 结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="186" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg101" value="绿色：对所有取值都成立的恒等式，不需要任何条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="186" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg102" value="中间结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="256" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg103" value="白底：推导中的一步，不需要条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="256" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg104" value="★ 结论（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="326" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg105" value="橙色：要加条件才成立；标题上方橙色标签写明条件类别和内容" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="326" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg106" value="中间结果（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="396" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg107" value="淡橙：有条件的中间一步" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="396" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg108" value="看到：……（问题）" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=12;fontColor=#004D40;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="466" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg109" value="青绿：问题节点（应用层）——看到什么 → 解题路径 ①②③ → 注意" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="466" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg110" value="三层：工具箱（能用什么）、方法（往哪走）、题型入口（从哪进），分工见“方法”一栏开头的表" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="536" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg111" value="两层：推导层（深灰，公式怎么来的）与应用层（青绿，看到什么、用哪个工具、怎么用）同样重要；drawio 里用“标签（tags）”可只显示推导层或应用层" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="592" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg112" value="连线：深色实线 = 推导，越粗越是主干；线上一步一行：【动作】+ 这一步的式子（变形前 ⇒ 变形后），理由放括号；用到的工具写「工具名」；动作属于哪一类方法，到“方法”栏查" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="648" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg113" value="青绿线 = 应用：工具 → 问题，线上写【怎么用】+ 例子；紫色线 = 【定义】：起点建立在哪个更底层的起点之上" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="704" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg114" value="⚡ 第一反应：工具节点里写“看到什么信号，就想到它”" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="760" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg115" value="浅灰线 = 工具：这一步用到的已有公式、定理，线上写「工具名」和怎么用；跨区的写进节点“⇐ 工具「工具名」”" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="816" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg116" value="▼ 加条件：从这一步起要带上条件，后面的结论都带着它；“★ 跨树”= 跨分区的推导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="872" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg117" value="✗ = 去掉条件的反例；“⋯ 同源 / 互逆 / 配合”写在节点里，不画成推导线" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="928" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg118" value="⇒ 用于：本图下游〔坐标〕、其他大厦和章节的用途、问题节点（正推之后用在哪里）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="984" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg119" value="〔编号 · 坐标〕：S 起点、R 不加条件、P 加条件；按图边字母（列）和数字（行）找格子" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1040" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg120" value="棕色“解法”= 写不成一个公式、由几种方法配合工具组成的流程（如因式分解的几种手法）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1096" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg121" value="★ 越多越重要；灰色“拓展”可先跳过；“同见不等式大厦 / 二次函数大厦 编号”= 两张图重合的结论" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1152" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg122" value="&lt;b style=&quot;font-size:17px&quot;&gt;三类条件（各自独立，互不包含、互不推出）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1232" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg123" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔定义域〕不满足时某一边没有意义&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1288" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg124" value="▸ 分式：分母 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1334" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg125" value="▸ 对数：真数 \({&amp;gt;0}\)，底数 \({&amp;gt;0}\) 且 \({\ne 1}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1334" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg126" value="▸ 正切：\({\cos\alpha\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1334" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg127" value="▸ 下标与组合数：\({n\ge 2}\)、\({0\le k\le n}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1368" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg128" value="▸ 根式：被开方数 \({\ge 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1368" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg129" value="▸ 分数指数幂：底数 \({&amp;gt;0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1368" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg130" value="▸ 整数指数：底数 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1402" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg131" value="▸ 约分：约掉的因式 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1402" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg132" value="▸ 实根：\({\Delta\ge 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1402" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg133" value="▸ 求导：函数在该点可导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1436" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg134" value="▸ 奇偶性：定义域关于原点对称" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1436" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg135" value="▸ 斜率：\({x_1\ne x_2}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1436" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg136" value="▸ 圆：\({D^2+E^2-4F&amp;gt;0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1470" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg137" value="▸ 法向量：\({\vec n\ne\vec 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1470" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg138" value="▸ 条件概率：\({P(A)&amp;gt;0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1470" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg139" value="▸ 无穷递缩等比：\({|q|&amp;lt;1}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1504" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg140" value="▸ 反三角：\({|a|\le 1}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1504" width="590" height="30" as="geometry"/></mxCell>
