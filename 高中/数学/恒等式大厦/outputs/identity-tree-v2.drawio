<UserObject id="e75" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({q\ne 1}\)&lt;/span&gt;&lt;br&gt;【错位相减】\({S_n-qS_n=a_1-a_1q^n}\)，两边除以 \({1-q}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P29" target="P31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1785" y="4273"/></Array><mxPoint x="152" y="26" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e84" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({m\le n}\)&lt;/span&gt;&lt;br&gt;【分步计数】第 1 位 \({n}\) 种，第 2 位 \({n-1}\) 种……相乘" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="S07" target="P33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5324" y="566"/></Array><mxPoint x="159" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e85" label="【分步计数】先选 \({m}\) 个再排列：\({A_n^m=C_n^m\cdot m!}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P33" target="P34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5324" y="841"/></Array><mxPoint x="142" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e87" label="【分步计数】\({n}\) 个 \({(a+b)}\) 相乘，每个括号选 \({a}\) 或 \({b}\)&lt;br&gt;恰好选 \({k}\) 个 \({b}\) 有 \({C_n^k}\) 种" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P34" target="R33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5324" y="1113"/></Array><mxPoint x="159" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e94" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({u,v}\) 在该点可导&lt;/span&gt;&lt;br&gt;【配凑】\({u(x+\Delta x)v(x+\Delta x)-u(x)v(x)}\)&lt;br&gt;\({=[u(x+\Delta x)-u(x)]v(x+\Delta x)+u(x)[v(x+\Delta x)-v(x)]}\)&lt;br&gt;\({v}\) 可导 \({\Rightarrow v}\) 连续（课本承认）" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="S08" target="P37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5373" y="5204"/><mxPoint x="5373" y="5285"/></Array><mxPoint x="182" y="23" as="offset"/></mxGeometry></mxCell></UserObject>
