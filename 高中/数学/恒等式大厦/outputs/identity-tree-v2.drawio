<UserObject id="e123" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔结构前提〕：\({a}\) 为 \({A}\) 的对边&lt;/span&gt;&lt;br&gt;【向量】\({\overrightarrow{BC}=\overrightarrow{AC}-\overrightarrow{AB}}\)，用 \({|\vec a-\vec b|^2}\) 展开&lt;br&gt;\({|\overrightarrow{BC}|^2=b^2+c^2-2bc\cos A}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P49" target="P22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="9363" y="1020"/></Array><mxPoint x="125" y="12" as="offset"/></mxGeometry></mxCell></UserObject>
