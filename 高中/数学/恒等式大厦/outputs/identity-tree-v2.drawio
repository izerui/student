<mxCell id="bg81" value="从 12 个起点（运算律、指数与对数、单位圆、数量积、复数、计数原理、数列、导数等）出发，不跳步推出高中全部恒等式&lt;br&gt;主干：源头 → 变形 → 结论；变形手法写在线上【方法】里。橙色 = 要加条件：〔定义域〕〔结构前提〕〔符号分支〕三类，各自独立" style="text;html=1;fontFamily=PingFang SC;fontSize=16;fontColor=#455A64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2200" y="-50" width="1900" height="80" as="geometry"/></mxCell>
<mxCell id="bg82" value="&lt;b style=&quot;font-size:20px&quot;&gt;图例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2200" y="60" width="1900" height="822" as="geometry"/></mxCell>
<mxCell id="bg83" value="【定义】【公理】【原理】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="116" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg84" value="紫色：起点，直接承认（定义、公理、课本给出）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="116" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg85" value="★ 结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="186" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg86" value="绿色：对所有取值都成立的恒等式，不需要任何条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="186" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg87" value="中间结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="256" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg88" value="白底：推导中的一步，不需要条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="256" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg89" value="★ 结论（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="326" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg90" value="橙色：要加条件才成立；标题上方橙色标签写明条件类别和内容" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="326" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg91" value="中间结果（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="396" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg92" value="淡橙：有条件的中间一步" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="396" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg93" value="连线：深色实线 = 推导，越粗越是主干；线上写【方法】和关键一步" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="466" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg94" value="浅灰线 = 前提：引用别处已推出的结论，线上写【前提】；远处的前提写进节点“⇐ 前提”" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="522" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg95" value="▼ 加条件：从这一步起要带上条件，后面的结论都带着它；“★ 跨树”= 跨分区的推导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="578" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg96" value="✗ = 去掉条件的反例；“⋯ 同源 / 互逆 / 配合”写在节点里，不画成推导线" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="634" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg97" value="⇒ 用于：本图下游〔坐标〕、其他大厦和章节的用途、题型入口编号（正推之后用在哪里）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="690" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg98" value="〔编号 · 坐标〕：S 起点、R 不加条件、P 加条件；按图边字母（列）和数字（行）找格子" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="746" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg99" value="★ 越多越重要；灰色“拓展”可先跳过；“同见不等式大厦 / 二次函数大厦 编号”= 两张图重合的结论" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="802" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg100" value="&lt;b style=&quot;font-size:20px&quot;&gt;三类条件（各自独立，互不包含、互不推出）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2200" y="932" width="1900" height="516" as="geometry"/></mxCell>
<mxCell id="bg101" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔定义域〕不满足时某一边没有意义&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="988" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg102" value="▸ 分式：分母 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1034" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg103" value="▸ 对数：真数 \({&amp;gt;0}\)，底数 \({&amp;gt;0}\) 且 \({\ne 1}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1034" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg104" value="▸ 正切：\({\cos\alpha\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1034" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg105" value="▸ 下标与组合数：\({n\ge 2}\)、\({0\le k\le n}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1068" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg106" value="▸ 根式：被开方数 \({\ge 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1068" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg107" value="▸ 分数指数幂：底数 \({&amp;gt;0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1068" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg108" value="▸ 整数指数：底数 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1102" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg109" value="▸ 约分：约掉的因式 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1102" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg110" value="▸ 求导：函数在该点可导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1102" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg111" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔结构前提〕两边都有意义，但只对某种结构成立&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1146" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg112" value="▸ 等差数列" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1192" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg113" value="▸ 等比数列" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1192" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg114" value="▸ 差比数列（等差×等比）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1192" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg115" value="▸ 方程有两实根（\({\Delta\ge 0}\)）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1226" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg116" value="▸ 同一三角形的边与对角" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1226" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg117" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔符号分支〕两边都有意义，但符号或角要按范围选定&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1270" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg118" value="▸ 半角 ±" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1316" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg119" value="▸ 已知一值求其余的 ±" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1316" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg120" value="▸ \({\sqrt{a^2}=|a|}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1316" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg121" value="▸ 辅助角 \({\varphi}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1350" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg122" value="▸ 复数辐角" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1350" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg123" value="反例：〔定义域〕说明哪一边没有意义；〔结构前提〕〔符号分支〕给“两边有意义但不相等”的数值" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontColor=#B71C1C;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1394" width="1840" height="30" as="geometry"/></mxCell>
<mxCell id="bg124" value="&lt;b style=&quot;font-size:20px&quot;&gt;公式与工具箱：不画线，按编号查&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#0D47A1;align=left;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1498" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="bg125" value="&lt;b&gt;T1 特殊角三角函数值&lt;/b&gt;&lt;br&gt;\({\alpha}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{6}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{4}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{3}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{2}}\)&lt;/span&gt;&lt;br&gt;\({\sin}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{2}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，\({1}\)&lt;br&gt;\({\cos}\)：\({1}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{2}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}}\)&lt;/span&gt;，\({0}\)&lt;br&gt;\({\tan}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{3}}{3}}\)&lt;/span&gt;，\({1}\)，\({\sqrt{3}}\)，不存在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1548" width="935" height="220" as="geometry"/></mxCell>
<mxCell id="bg126" value="&lt;b&gt;T2 杨辉三角 n=0～6&lt;/b&gt;&lt;br&gt;1 ｜ 1 1 ｜ 1 2 1 ｜ 1 3 3 1&lt;br&gt;1 4 6 4 1 ｜ 1 5 10 10 5 1&lt;br&gt;1 6 15 20 15 6 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="1548" width="935" height="220" as="geometry"/></mxCell>
<mxCell id="bg127" value="&lt;b&gt;T3 常用对数&lt;/b&gt;&lt;br&gt;\({\lg 2\approx 0.3010}\)，\({\lg 3\approx 0.4771}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1792" width="935" height="104" as="geometry"/></mxCell>
<mxCell id="bg128" value="&lt;b&gt;T4 诱导公式口诀&lt;/b&gt;&lt;br&gt;“奇变偶不变，符号看象限”&lt;br&gt;把 \({\alpha}\) 看作锐角定符号；记忆口诀，不是条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="1792" width="935" height="104" as="geometry"/></mxCell>
<mxCell id="bg129" value="&lt;b style=&quot;font-size:20px&quot;&gt;题型入口：看到什么 → 反推到哪 → 先查什么 → 去这里查&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#00695C;align=left;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1960" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="bg130" value="&lt;b&gt;入口① 看到 \({a^2-b^2}\)、\({a^3\pm b^3}\)、平方和结构&lt;/b&gt;&lt;br&gt;反推：因式分解或互换式&lt;br&gt;先查：先看能否倒用乘法公式&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 平方差 &lt;b&gt;〔R02 · B2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 立方和（差） &lt;b&gt;〔R06 · C2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 互换式 &lt;b&gt;〔R07 · A3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 因式分解 &lt;b&gt;〔R08 · C2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="2010" width="613" height="192" as="geometry"/></mxCell>
<mxCell id="bg131" value="&lt;b&gt;入口② 看到 已知 \({a+b}\)、\({ab}\)，求 \({a^2+b^2}\)、\({a^3+b^3}\)、\({|a-b|}\)&lt;/b&gt;&lt;br&gt;反推：互换式&lt;br&gt;先查：若 \({a,b}\) 是方程的根，先用韦达&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 互换式 &lt;b&gt;〔R07 · A3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根的对称式 &lt;b&gt;〔P45 · B3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2010" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg132" value="&lt;b&gt;入口③ 看到 二次三项式分解&lt;/b&gt;&lt;br&gt;反推：十字相乘；不行就用求根公式求两根&lt;br&gt;先查：先提公因式；\({\Delta&amp;lt;0}\) 时在实数范围内不能分解&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 因式分解 &lt;b&gt;〔R08 · C2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求根公式 &lt;b&gt;〔P02 · B3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 交点式 &lt;b&gt;〔P04 · B3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="2010" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg133" value="&lt;b&gt;入口④ 看到 两根的对称式 \({x_1^2+x_2^2}\)、\({|x_1-x_2|}\)&lt;/b&gt;&lt;br&gt;反推：韦达代入互换式&lt;br&gt;先查：先验 \({\Delta\ge 0}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P03 · B3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根的对称式 &lt;b&gt;〔P45 · B3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2188" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg134" value="&lt;b&gt;入口⑤ 看到 含分式、根式、绝对值的化简&lt;/b&gt;&lt;br&gt;反推：去括号、通分约分、有理化&lt;br&gt;先查：约掉的因式 \({\ne 0}\)；\({\sqrt{a^2}=|a|}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 去括号与合并同类项 &lt;b&gt;〔R36 · C1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 分式运算 &lt;b&gt;〔P42 · D1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根式运算 &lt;b&gt;〔P43 · F4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 分母有理化 &lt;b&gt;〔P44 · F5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 绝对值运算 &lt;b&gt;〔R37 · C1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="2207" width="613" height="211" as="geometry"/></mxCell>
<mxCell id="bg135" value="&lt;b&gt;入口⑥ 看到 指数、对数式化简求值&lt;/b&gt;&lt;br&gt;反推：统一底数（换底）&lt;br&gt;先查：底数 \({&amp;gt;0}\) 且 \({\ne 1}\)，真数 \({&amp;gt;0}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 整数指数幂运算律 &lt;b&gt;〔P41 · F3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 实数指数运算律 &lt;b&gt;〔P05 · F4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对数运算律 &lt;b&gt;〔P07 · F4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 换底公式 &lt;b&gt;〔P08 · F4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对数恒等式 &lt;b&gt;〔P06 · G4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 换底推论 &lt;b&gt;〔P09 · F5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="2226" width="613" height="230" as="geometry"/></mxCell>
<mxCell id="bg136" value="&lt;b&gt;入口⑦ 看到 已知一个三角函数值求其余&lt;/b&gt;&lt;br&gt;反推：勾股恒等式开方&lt;br&gt;先查：按象限定号&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 已知一个三角函数值求其余 &lt;b&gt;〔P46 · O2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 勾股恒等式 &lt;b&gt;〔R13 · N1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 商数关系 &lt;b&gt;〔P11 · M1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2366" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg137" value="&lt;b&gt;入口⑧ 看到 已知 \({\sin\alpha\pm\cos\alpha}\)，求 \({\sin\alpha\cos\alpha}\)&lt;/b&gt;&lt;br&gt;反推：两边平方&lt;br&gt;先查：开方时注意符号&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 同角关系的常用变形 &lt;b&gt;〔R38 · K3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 倍角 &lt;b&gt;〔R18 · K3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="2442" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg138" value="&lt;b&gt;入口⑨ 看到 已知 \({\tan\alpha}\)，求 \({\sin}\)、\({\cos}\) 的齐次式&lt;/b&gt;&lt;br&gt;反推：弦化切&lt;br&gt;先查：\({\cos\alpha\ne 0}\)；二次式先用“1”的代换&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 弦化切（齐次式） &lt;b&gt;〔P47 · N2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 商数关系 &lt;b&gt;〔P11 · M1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="2480" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg139" value="&lt;b&gt;入口⑩ 看到 三角化简求值：角不同、名不同、次数高&lt;/b&gt;&lt;br&gt;反推：拆角配角用和差角；切化弦；降幂&lt;br&gt;先查：有 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\pi}{2}\pm\alpha}\)&lt;/span&gt;、\({\pi\pm\alpha}\) 先用诱导公式&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 其余和差角 &lt;b&gt;〔R17 · J2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 诱导公式（sin、cos 对任意实数 \({\alpha}\) 成立） &lt;b&gt;〔R14 · L1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 商数关系 &lt;b&gt;〔P11 · M1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 降幂 &lt;b&gt;〔R19 · K3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两角和差的正切 &lt;b&gt;〔P14 · H3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2563" width="613" height="224" as="geometry"/></mxCell>
<mxCell id="bg140" value="&lt;b&gt;入口⑪ 看到 求三角函数的最值、周期&lt;/b&gt;&lt;br&gt;反推：化成 \({A\sin(\omega x+\varphi)+k}\)&lt;br&gt;先查：定 \({\varphi}\) 看 \({a,b}\) 的正负&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 降幂 &lt;b&gt;〔R19 · K3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 倍角 &lt;b&gt;〔R18 · K3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 辅助角 &lt;b&gt;〔P17 · J3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="2620" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg141" value="&lt;b&gt;入口⑫ 看到 化简 \({\sqrt{1\pm\cos 2\alpha}}\)、\({\sqrt{1\pm\sin 2\alpha}}\)&lt;/b&gt;&lt;br&gt;反推：升幂或配成完全平方&lt;br&gt;先查：开方后带绝对值，按象限去掉&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 降幂 &lt;b&gt;〔R19 · K3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 同角关系的常用变形 &lt;b&gt;〔R38 · K3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根式运算 &lt;b&gt;〔P43 · F4〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="2658" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg142" value="&lt;b&gt;入口⑬ 看到 三角函数的积与和互化&lt;/b&gt;&lt;br&gt;反推：积化和差、和差化积&lt;br&gt;先查：—&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 积化和差 &lt;b&gt;〔R20 · J3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 和差化积 &lt;b&gt;〔R21 · J3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2811" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg143" value="&lt;b&gt;入口⑭ 看到 求 \({15^\circ}\)、\({75^\circ}\)、\({22.5^\circ}\) 等的值&lt;/b&gt;&lt;br&gt;反推：拆成特殊角的和差，或用半角&lt;br&gt;先查：半角按象限定号&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两角差的余弦 &lt;b&gt;〔R16 · J2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 其余和差角 &lt;b&gt;〔R17 · J2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 半角 &lt;b&gt;〔P16 · K3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="2817" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg144" value="&lt;b&gt;入口⑮ 看到 解三角形&lt;/b&gt;&lt;br&gt;反推：两边夹角或三边：余弦定理；两角一边：正弦定理&lt;br&gt;先查：求面积用 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{1}{2}ab\sin C}\)&lt;/span&gt;；内角和化简&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 余弦定理 &lt;b&gt;〔P22 · K2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 正弦定理 &lt;b&gt;〔P21 · M2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形面积 &lt;b&gt;〔P20 · M2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形内角关系 &lt;b&gt;〔P19 · L2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 海伦公式 &lt;b&gt;〔P48 · L2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="2855" width="613" height="224" as="geometry"/></mxCell>
<mxCell id="bg145" value="&lt;b&gt;入口⑯ 看到 判断三角形的形状&lt;/b&gt;&lt;br&gt;反推：边角互化，化成只含边或只含角&lt;br&gt;先查：两边同除时注意除数 \({\ne 0}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 正弦定理 &lt;b&gt;〔P21 · M2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 余弦定理 &lt;b&gt;〔P22 · K2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形内角关系 &lt;b&gt;〔P19 · L2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2989" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg146" value="&lt;b&gt;入口⑰ 看到 向量的模、夹角、垂直&lt;/b&gt;&lt;br&gt;反推：平方后用数量积&lt;br&gt;先查：求夹角要非零向量&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 数量积的运算公式 &lt;b&gt;〔P49 · K1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 数量积坐标式 &lt;b&gt;〔R15 · J1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="3014" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg147" value="&lt;b&gt;入口⑱ 看到 复数计算、高次幂&lt;/b&gt;&lt;br&gt;反推：除法分母实数化；高次幂用周期或棣莫弗&lt;br&gt;先查：化三角形式时按 \({a,b}\) 正负定辐角&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 复数除法 &lt;b&gt;〔P23 · H5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({i^n}\) 以 4 为周期 &lt;b&gt;〔R24 · J5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 棣莫弗公式 &lt;b&gt;〔R27 · K5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形式 &lt;b&gt;〔P24 · J5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形式除法 &lt;b&gt;〔P25 · J5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 模的乘法 &lt;b&gt;〔R25 · J5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="3103" width="613" height="230" as="geometry"/></mxCell>
<mxCell id="bg148" value="&lt;b&gt;入口⑲ 看到 求通项：差是 \({f(n)}\)、比是 \({g(n)}\)、已知 \({S_n}\)&lt;/b&gt;&lt;br&gt;反推：累加、累乘、作差&lt;br&gt;先查：\({n=1}\) 单独验证&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 累加法、累乘法（求通项） &lt;b&gt;〔P50 · B4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({a_n}\) 与 \({S_n}\) &lt;b&gt;〔P32 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等差通项 &lt;b&gt;〔P26 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等比通项 &lt;b&gt;〔P29 · B5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="3186" width="613" height="192" as="geometry"/></mxCell>
<mxCell id="bg149" value="&lt;b&gt;入口⑳ 看到 等差、等比的性质速算&lt;/b&gt;&lt;br&gt;反推：下标性质、中项、片段和&lt;br&gt;先查：先确认是等差或等比&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等差下标性质 &lt;b&gt;〔P27 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等比下标性质 &lt;b&gt;〔P30 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等差中项、等比中项 &lt;b&gt;〔P51 · A5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等差求和 &lt;b&gt;〔P28 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 片段和 &lt;b&gt;〔P54 · B6〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="3192" width="613" height="211" as="geometry"/></mxCell>
<mxCell id="bg150" value="&lt;b&gt;入口㉑ 看到 数列求和&lt;/b&gt;&lt;br&gt;反推：公式；等差×等比错位相减；裂项；倒序相加&lt;br&gt;先查：等比先看 \({q}\) 是否为 1&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等差求和 &lt;b&gt;〔P28 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等比求和 &lt;b&gt;〔P31 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 差比数列求和（错位相减） &lt;b&gt;〔P52 · B5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 裂项 &lt;b&gt;〔R30 · C4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 裂项的其他形式 &lt;b&gt;〔P53 · C5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="3357" width="613" height="211" as="geometry"/></mxCell>
<mxCell id="bg151" value="&lt;b&gt;入口㉒ 看到 \({1^2+2^2+\cdots}\)、\({1^3+2^3+\cdots}\)&lt;/b&gt;&lt;br&gt;反推：自然数幂和公式&lt;br&gt;先查：—&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 自然数求和 &lt;b&gt;〔R29 · A6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 平方和 &lt;b&gt;〔R31 · A6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 立方和 &lt;b&gt;〔R32 · A6〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="3402" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg152" value="&lt;b&gt;入口㉓ 看到 展开式的特定项、常数项&lt;/b&gt;&lt;br&gt;反推：通项 \({T_{k+1}}\)，令次数满足条件&lt;br&gt;先查：\({T_{k+1}}\) 是第 \({k+1}\) 项&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二项式定理 &lt;b&gt;〔R33 · F2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="3427" width="613" height="135" as="geometry"/></mxCell>
<mxCell id="bg153" value="&lt;b&gt;入口㉔ 看到 展开式的系数和&lt;/b&gt;&lt;br&gt;反推：赋值 \({x=1,\ -1,\ 0}\)&lt;br&gt;先查：区分项的系数与二项式系数&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 展开式的各项系数和 &lt;b&gt;〔R39 · F2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二项式系数性质 &lt;b&gt;〔R34 · F2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="3586" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg154" value="&lt;b&gt;入口㉕ 看到 组合数化简、证明&lt;/b&gt;&lt;br&gt;反推：组合数公式、杨辉三角递推&lt;br&gt;先查：下标范围 \({0\le m\le n}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 组合数性质 &lt;b&gt;〔P35 · E2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 组合数的提取 &lt;b&gt;〔P36 · F2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 组合数 &lt;b&gt;〔P34 · F2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 排列数 &lt;b&gt;〔P33 · F1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="3592" width="613" height="192" as="geometry"/></mxCell>
<mxCell id="bg155" value="&lt;b&gt;入口㉖ 看到 求导&lt;/b&gt;&lt;br&gt;反推：识别和、积、商、复合结构&lt;br&gt;先查：先确认可导，商还要分母 \({\ne 0}\)；底数不是 \({e}\) 时换到 \({e}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 和、差、积的求导法则 &lt;b&gt;〔P37 · F6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 商的求导法则 &lt;b&gt;〔P38 · F6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【课本给出】导数表与链式法则 &lt;b&gt;〔S12 · G6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 常用导数 &lt;b&gt;〔P55 · G6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 一般指数、对数求导的由来 &lt;b&gt;〔P40 · G6〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="3599" width="613" height="211" as="geometry"/></mxCell>
<mxCell id="bg156" value="&lt;b&gt;入口㉗ 看到 证明恒等式&lt;/b&gt;&lt;br&gt;反推：从繁到简、左右化归、作差为 0&lt;br&gt;先查：每一步都要等价&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 去括号与合并同类项 &lt;b&gt;〔R36 · C1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 多项式乘法 &lt;b&gt;〔R01 · B1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 勾股恒等式 &lt;b&gt;〔R13 · N1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="3764" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg157" value="&lt;b style='font-size:20px'&gt;方法索引：按方法复习，到〔坐标〕找推导线&lt;/b&gt;&lt;br&gt;正推（由因导果）= 综合法：沿箭头往下读；反推（执果索因）= 分析法：从题型入口往回查&lt;br&gt;&lt;b&gt;展开&lt;/b&gt;（17 处）：用分配律把乘积逐项乘开　R01〔B1〕、R02〔B2〕、R03〔B2〕、R04〔A2〕、R05〔A2〕、R06〔C2〕、P04〔B3〕、R09〔D2〕、R10〔D2〕、R11〔E2〕、R15〔J1〕、R22〔J5〕、R23〔J5〕、R26〔J5〕、R35〔E6〕、R38〔K3〕、P49〔K1〕&lt;br&gt;&lt;b&gt;代入&lt;/b&gt;（13 处）：把已知式代进去　P03〔B3〕、P06〔G4〕、P09〔F5〕、R13〔N1〕、R24〔J5〕、R25〔J5〕、P27〔B5〕、P30〔B5〕、P36〔F2〕、P45〔B3〕、P41〔F3〕、P48〔L2〕、P51〔A5〕&lt;br&gt;&lt;b&gt;代换&lt;/b&gt;（10 处）：把某个量换成另一个式子（如 \({b\to -b}\)）　R03〔B2〕、R05〔A2〕、R06〔C2〕、P07〔F4〕、P08〔F4〕、R17〔J2〕、P16〔K3〕、R21〔J3〕、P19〔L2〕、P40〔G6〕&lt;br&gt;&lt;b&gt;特例&lt;/b&gt;（5 处）：取特殊值得到特殊情形　R18〔K3〕、P15〔H3〕、R29〔A6〕、P43〔F4〕、P55〔G6〕&lt;br&gt;&lt;b&gt;分步计数&lt;/b&gt;（3 处）：分步乘法原理　P33〔F1〕、P34〔F2〕、R33〔F2〕&lt;br&gt;&lt;b&gt;同除&lt;/b&gt;（3 处）：两边同除一个非零式　P12〔N2〕、P18〔K3〕、P47〔N2〕&lt;br&gt;&lt;b&gt;移项&lt;/b&gt;（3 处）：等式两边同加减　R07〔A3〕、R19〔K3〕、P46〔O2〕&lt;br&gt;&lt;b&gt;通分&lt;/b&gt;（3 处）：化成同分母　R30〔C4〕、P38〔F6〕、P42〔D1〕&lt;br&gt;&lt;b&gt;作差&lt;/b&gt;（2 处）：两式相减　P32〔B5〕、P54〔B6〕&lt;br&gt;&lt;b&gt;向量&lt;/b&gt;（2 处）：用向量运算推几何关系　R16〔J2〕、P22〔K2〕&lt;br&gt;&lt;b&gt;定义&lt;/b&gt;（2 处）：直接用定义　P11〔M1〕、P20〔M2〕&lt;br&gt;&lt;b&gt;开平方&lt;/b&gt;（2 处）：两边开平方　P02〔B3〕、P46〔O2〕&lt;br&gt;&lt;b&gt;归纳法&lt;/b&gt;（2 处）：数学归纳法　R27〔K5〕、R32〔A6〕&lt;br&gt;&lt;b&gt;推广&lt;/b&gt;（2 处）：由特殊范围推到一般范围　P05〔F4〕、P53〔C5〕&lt;br&gt;&lt;b&gt;相除&lt;/b&gt;（2 处）：两式相除（如切化弦）　P13〔L2〕、P14〔H3〕&lt;br&gt;&lt;b&gt;累乘&lt;/b&gt;（2 处）：逐项相乘　P29〔B5〕、P50〔B4〕&lt;br&gt;&lt;b&gt;累加相消&lt;/b&gt;（2 处）：相邻项抵消　R31〔A6〕、P50〔B4〕&lt;br&gt;&lt;b&gt;赋值&lt;/b&gt;（2 处）：给字母赋特殊值　R34〔F2〕、R39〔F2〕&lt;br&gt;&lt;b&gt;逆用&lt;/b&gt;（2 处）：把公式从右往左读　R08〔C2〕、R36〔C1〕&lt;br&gt;&lt;b&gt;逆运算&lt;/b&gt;（2 处）：利用互逆运算互化　P10〔G4〕、P25〔J5〕&lt;br&gt;&lt;b&gt;配凑&lt;/b&gt;（2 处）：加一项减一项　P37〔F6〕、P38〔F6〕&lt;br&gt;&lt;b&gt;链式法则&lt;/b&gt;（2 处）：复合函数求导　P39〔G6〕、P55〔G6〕&lt;br&gt;&lt;b&gt;错位相减&lt;/b&gt;（2 处）：乘公比后相减　P31〔B5〕、P52〔B5〕&lt;br&gt;&lt;b&gt;倒序相加&lt;/b&gt;（1 处）：正写倒写相加　P28〔B5〕&lt;br&gt;&lt;b&gt;分母实数化&lt;/b&gt;（1 处）：乘共轭使分母为实数　P23〔H5〕&lt;br&gt;&lt;b&gt;分类计数&lt;/b&gt;（1 处）：分类加法原理　P35〔E2〕&lt;br&gt;&lt;b&gt;分类讨论&lt;/b&gt;（1 处）：按正负等情况分开处理　R37〔C1〕&lt;br&gt;&lt;b&gt;双计数&lt;/b&gt;（1 处）：同一件事两种数法　P36〔F2〕&lt;br&gt;&lt;b&gt;同乘&lt;/b&gt;（1 处）：分子分母同乘一个式子　P44〔F5〕&lt;br&gt;&lt;b&gt;对应&lt;/b&gt;（1 处）：一一对应计数　P35〔E2〕&lt;br&gt;&lt;b&gt;对称&lt;/b&gt;（1 处）：终边对称点的坐标关系　R14〔L1〕&lt;br&gt;&lt;b&gt;按定义&lt;/b&gt;（1 处）：回到定义计算　R35〔E6〕&lt;br&gt;&lt;b&gt;提取&lt;/b&gt;（1 处）：提出公因式　P17〔J3〕&lt;br&gt;&lt;b&gt;数个数&lt;/b&gt;（1 处）：数因数的个数　R12〔F3〕&lt;br&gt;&lt;b&gt;数形结合（单位圆）&lt;/b&gt;（1 处）　P24〔J5〕&lt;br&gt;&lt;b&gt;相加减&lt;/b&gt;（1 处）：两式相加或相减　R20〔J3〕&lt;br&gt;&lt;b&gt;累加&lt;/b&gt;（1 处）：逐项相加　P26〔B5〕&lt;br&gt;&lt;b&gt;结合律&lt;/b&gt;（1 处）：重新加括号　R28〔B4〕&lt;br&gt;&lt;b&gt;配方&lt;/b&gt;（1 处）：配成完全平方　P01〔B2〕&lt;br&gt;&lt;b&gt;面积法&lt;/b&gt;（1 处）：同一面积的不同算法　P21〔M2〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#8D6E63;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#3E2723;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fontSize=13;" vertex="1" parent="bg"><mxGeometry x="-2200" y="4001" width="1900" height="1124" as="geometry"/></mxCell>
<UserObject id="e64" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【和角】实部 \({\cos(\theta_1+\theta_2)}\)，虚部 \({\sin(\theta_1+\theta_2)}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R17" target="R26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="13752" y="1670"/><mxPoint x="13752" y="4350"/></Array><mxPoint x="0" y="-286" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e68" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【结合律】相邻项抵消" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S01" target="R28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4476" y="513"/><mxPoint x="4476" y="3509"/></Array><mxPoint x="0" y="-253" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e79" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【累加相消】\({(k+1)^3-k^3=3k^2+3k+1}\)，\({k}\) 从 1 加到 \({n}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(n+1)^3-1=3\sum k^2+\dfrac{3n(n+1)}{2}+n}\)&lt;/span&gt;，解出 \({\sum k^2}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R05" target="R31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-4" y="1671"/><mxPoint x="-4" y="5486"/></Array><mxPoint x="0" y="-242" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e93" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【二项式展开】\({(x+\Delta x)^n}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R33" target="R35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4508" y="1308"/><mxPoint x="4508" y="5441"/></Array><mxPoint x="0" y="-246" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e97" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【链式法则】对 \({\ln(e^x)=x}\) 两边求导：\({(\ln)'(e^x)\cdot e^x=1}\)&lt;br&gt;令 \({u=e^x}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln u)'=\dfrac{1}{u}}\)&lt;/span&gt;，\({u}\) 取遍 \({(0,+\infty)}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P10" target="P39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7271" y="3591"/><mxPoint x="7271" y="5441"/></Array><mxPoint x="0" y="-134" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e99" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【代换】\({a^x=e^{x\ln a}}\)，用链式法则" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P05" target="P40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7287" y="3232"/><mxPoint x="7287" y="5785"/></Array><mxPoint x="0" y="638" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e100" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【代换】换底：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a x=\dfrac{\ln x}{\ln a}}\)&lt;/span&gt;" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P08" target="P40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7303" y="3926"/><mxPoint x="7303" y="5785"/></Array><mxPoint x="0" y="170" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="S01" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S01&lt;/span&gt;&lt;br&gt;【公理】运算律、等式性质与绝对值&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;交换律、结合律；分配律 \({a(b+c)=ab+ac}\)&lt;br&gt;等式两边同加、同乘一个数仍相等；同除一个非零数仍相等&lt;br&gt;减 \({b}\) 即加 \({-b}\)；除以 \({b}\)（\({b\ne 0}\)）即乘 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{b}}\)&lt;/span&gt;&lt;br&gt;绝对值：\({a\ge 0}\) 时 \({|a|=a}\)，\({a&amp;lt;0}\) 时 \({|a|=-a}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;起点：实数运算的基本规定，所有恒等式的地基&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R01〔B1〕、R12〔F3〕、R28〔B4〕、R36〔C1〕、R37〔C1〕、P42〔D1〕&lt;/span&gt;&lt;/div&gt;" 编号="S01" 类型="起点" 条件="无条件" 分区="① 代数" 坐标="B1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1493" y="410" width="557" height="206" as="geometry"/></mxCell></UserObject>
<UserObject id="R01" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R01&lt;/span&gt;&lt;br&gt;★★★ 多项式乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+b)(c+d)=ac+ad+bc+bd}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;枢纽：本图所有“展开”都从这里出发&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R02〔B2〕、R03〔B2〕、R04〔A2〕、R06〔C2〕、R08〔C2〕、R09〔D2〕、R10〔D2〕、R11〔E2〕、R15〔J1〕、R22〔J5〕、R33〔F2〕；入口㉗&lt;/span&gt;&lt;/div&gt;" 编号="R01" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="B1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1461" y="802" width="620" height="144" as="geometry"/></mxCell></UserObject>
<UserObject id="R36" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R36&lt;/span&gt;&lt;br&gt;★ 去括号与合并同类项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a-(b-c)=a-b+c}\)，\({-(a+b)=-a-b}\)&lt;br&gt;\({ma+na=(m+n)a}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：一切化简、解方程；入口⑤㉗&lt;/span&gt;&lt;/div&gt;" 编号="R36" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="C1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2139" y="812" width="324" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="R37" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R37&lt;/span&gt;&lt;br&gt;★ 绝对值运算&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|ab|=|a||b|}\)，\({|a|^2=a^2}\)；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left|\dfrac{a}{b}\right|=\dfrac{|a|}{|b|}}\)&lt;/span&gt;（\({b\ne 0}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：复数模的乘法〔R25 · J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：不等式大厦 R09（绝对值界）；入口⑤&lt;/span&gt;&lt;/div&gt;" 编号="R37" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="C1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2522" y="804" width="357" height="140" as="geometry"/></mxCell></UserObject>
<UserObject id="P42" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕分母 \({\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P42&lt;/span&gt;&lt;br&gt;★ 分式运算&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;约分 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{ac}{bc}=\dfrac{a}{b}}\)&lt;/span&gt;（\({c\ne 0}\)）；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b}\pm\dfrac{c}{d}=\dfrac{ad\pm bc}{bd}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b}\cdot\dfrac{c}{d}=\dfrac{ac}{bd}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b}\div\dfrac{c}{d}=\dfrac{ad}{bc}}\)&lt;/span&gt;（\({c\ne 0}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{x^2-1}{x-1}=x+1}\)&lt;/span&gt; 只在 \({x\ne 1}\) 时成立：约掉的因式不能为 0&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：裂项、复数除法、商的求导、弦化切；入口⑤&lt;/span&gt;&lt;/div&gt;" 编号="P42" 类型="结论（有条件）" 条件="〔定义域〕分母 $\ne 0$" 分区="① 代数" 坐标="D1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2937" y="756" width="423" height="236" as="geometry"/></mxCell></UserObject>
<UserObject id="R02" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R02&lt;/span&gt;&lt;br&gt;★ 平方差&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^2-b^2=(a+b)(a-b)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P03、P25&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：分母有理化〔P44 · F5〕、共轭〔R23 · J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P03〔B3〕、R23〔J5〕、P44〔F5〕、P48〔L2〕；入口①&lt;/span&gt;&lt;/div&gt;" 编号="R02" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="B2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1548" y="1157" width="447" height="144" as="geometry"/></mxCell></UserObject>
<UserObject id="R03" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R03&lt;/span&gt;&lt;br&gt;★★ 完全平方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a\pm b)^2=a^2\pm 2ab+b^2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R37、R49&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：配方〔P01 · B2〕、\({(\sin\alpha\pm\cos\alpha)^2}\)〔R38 · K3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R05〔A2〕、R07〔A3〕、P01〔B2〕、R38〔K3〕&lt;/span&gt;&lt;/div&gt;" 编号="R03" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="B2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1091" y="1157" width="399" height="144" as="geometry"/></mxCell></UserObject>
<UserObject id="R04" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R04&lt;/span&gt;&lt;br&gt;三数和的平方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+b+c)^2=a^2+b^2+c^2+2ab+2bc+2ca}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R64&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R07〔A3〕&lt;/span&gt;&lt;/div&gt;" 编号="R04" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="A2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="1377" width="317" height="139" as="geometry"/></mxCell></UserObject>
<UserObject id="R05" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R05&lt;/span&gt;&lt;br&gt;★ 两数和（差）的立方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a\pm b)^3=a^3\pm 3a^2b+3ab^2\pm b^3}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R07〔A3〕、R31〔A6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：【特例】\({n=3}\)（另一路）〔R33 · F2〕&lt;/span&gt;&lt;/div&gt;" 编号="R05" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="A2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="529" y="1611" width="274" height="120" as="geometry"/></mxCell></UserObject>
<UserObject id="R06" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R06&lt;/span&gt;&lt;br&gt;★ 立方和（差）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^3\pm b^3=(a\pm b)(a^2\mp ab+b^2)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P27、R25&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：高次式分解；入口①&lt;/span&gt;&lt;/div&gt;" 编号="R06" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="C2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2053" y="1168" width="259" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="R07" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R07&lt;/span&gt;&lt;br&gt;★ 互换式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^2+b^2=(a+b)^2-2ab}\)&lt;br&gt;\({(a-b)^2=(a+b)^2-4ab}\)&lt;br&gt;\({a^3+b^3=(a+b)^3-3ab(a+b)}\)&lt;br&gt;\({a^2+b^2+c^2=(a+b+c)^2-2(ab+bc+ca)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R60、R52&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：韦达〔P03 · B3〕→ 两根的对称式〔P45 · B3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P45〔B3〕；入口①②&lt;/span&gt;&lt;/div&gt;" 编号="R07" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="A3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="500" y="1922" width="332" height="210" as="geometry"/></mxCell></UserObject>
<UserObject id="R08" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R08&lt;/span&gt;&lt;br&gt;因式分解&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;提公因式：分配律倒用&lt;br&gt;公式法：平方差、完全平方、立方和（差）倒用&lt;br&gt;十字相乘：\({acx^2+(ad+bc)x+bd=(ax+b)(cx+d)}\)&lt;br&gt;特例 \({x^2+(p+q)x+pq=(x+p)(x+q)}\)：找两数乘得常数项、加得一次项系数&lt;br&gt;分组分解；顺序：一提、二套、三检查&lt;br&gt;十字相乘不行时，用求根公式〔P02〕求两根，写成交点式〔P04〕&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：约分〔P42 · D1〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：解一元二次、高次方程；不等式大厦 R25（穿根法）；入口①③&lt;/span&gt;&lt;/div&gt;" 编号="R08" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="C2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2370" y="1118" width="495" height="223" as="geometry"/></mxCell></UserObject>
<UserObject id="P01" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P01&lt;/span&gt;&lt;br&gt;★★ 配方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({ax^2+bx+c=a\left(x+\dfrac{b}{2a}\right)^2+\dfrac{4ac-b^2}{4a}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{b}{2a}}\)&lt;/span&gt; 无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R17；同见二次函数大厦 R01&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P02〔B3〕；求二次式的最值；不等式大厦 R23&lt;/span&gt;&lt;/div&gt;" 编号="P01" 类型="结论（有条件）" 条件="〔定义域〕$a\ne 0$" 分区="① 代数" 坐标="B2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1099" y="1552" width="383" height="218" as="geometry"/></mxCell></UserObject>
<UserObject id="P02" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\Delta\ge 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P02&lt;/span&gt;&lt;br&gt;求根公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({ax^2+bx+c=0}\)（\({a\ne 0}\)）的根 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=\dfrac{-b\pm\sqrt{\Delta}}{2a}}\)&lt;/span&gt;，\({\Delta=b^2-4ac}\)&lt;br&gt;\({\Delta&amp;gt;0}\) 两根，\({\Delta=0}\) 一个（重根），\({\Delta&amp;lt;0}\) 无实根&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({\Delta&amp;lt;0}\) 时 \({\sqrt{\Delta}}\) 在实数范围内无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见二次函数大厦 J05&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P03〔B3〕、P04〔B3〕；解方程、二次函数零点；入口③&lt;/span&gt;&lt;/div&gt;" 编号="P02" 类型="中间结果（有条件）" 条件="〔定义域〕$\Delta\ge 0$" 分区="① 代数" 坐标="B3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1017" y="1910" width="418" height="236" as="geometry"/></mxCell></UserObject>
<UserObject id="P03" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({x_1,x_2}\) 是方程的两根&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P03&lt;/span&gt;&lt;br&gt;★★ 韦达定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_1+x_2=-\dfrac{b}{a}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_1x_2=\dfrac{c}{a}}\)&lt;/span&gt;（重根算两个）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({x^2-3x+2=0}\) 的根是 1、2；误把 1、3 当两根：\({1+3=4\ne 3}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R52；同见二次函数大厦 J06&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：互换式〔R07 · A3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P04〔B3〕、P45〔B3〕；二次函数大厦 R11（根的符号）；不等式大厦 R34；入口④&lt;/span&gt;&lt;/div&gt;" 编号="P03" 类型="结论（有条件）" 条件="〔结构前提〕$x_1,x_2$ 是方程的两根" 分区="① 代数" 坐标="B3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="921" y="2271" width="610" height="222" as="geometry"/></mxCell></UserObject>
<UserObject id="P04" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({\Delta\ge 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P04&lt;/span&gt;&lt;br&gt;交点式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({ax^2+bx+c=a(x-x_1)(x-x_2)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见二次函数大厦 P01&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：不等式大厦 R34（三个二次）；入口③&lt;/span&gt;&lt;/div&gt;" 编号="P04" 类型="中间结果（有条件）" 条件="〔结构前提〕$\Delta\ge 0$" 分区="① 代数" 坐标="B3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1580" y="2662" width="303" height="155" as="geometry"/></mxCell></UserObject>
<UserObject id="P45" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({x_1,x_2}\) 是两实根（\({\Delta\ge 0}\)）&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P45&lt;/span&gt;&lt;br&gt;★★ 两根的对称式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({x_1^2+x_2^2=(x_1+x_2)^2-2x_1x_2}\)；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x_1}+\dfrac{1}{x_2}=\dfrac{x_1+x_2}{x_1x_2}}\)&lt;/span&gt;（\({c\ne 0}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({|x_1-x_2|=\sqrt{(x_1+x_2)^2-4x_1x_2}=\dfrac{\sqrt{\Delta}}{|a|}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({x^2+x+1=0}\) 无实根，硬套得 \({x_1^2+x_2^2=(-1)^2-2=-1}\)，实数平方和不可能为负&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：弦长 \({|AB|=\sqrt{1+k^2}\,|x_1-x_2|}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：解析几何——联立消元后求弦长、中点；入口②④&lt;/span&gt;&lt;/div&gt;" 编号="P45" 类型="结论（有条件）" 条件="〔结构前提〕$x_1,x_2$ 是两实根（$\Delta\ge 0$）" 分区="① 代数" 坐标="B3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="931" y="2619" width="591" height="240" as="geometry"/></mxCell></UserObject>
<UserObject id="R09" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R09&lt;/span&gt;&lt;br&gt;\({x^n-y^n}\) 的分解&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({x^n-y^n=(x-y)(x^{n-1}+x^{n-2}y+\cdots+y^{n-1})}\)（\({n}\) 为正整数）&lt;br&gt;\({n=2,3}\) 即平方差、立方差&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P31〔B5〕；高次式分解&lt;/span&gt;&lt;/div&gt;" 编号="R09" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="D2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2923" y="1170" width="403" height="118" as="geometry"/></mxCell></UserObject>
<UserObject id="R10" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R10&lt;/span&gt;&lt;br&gt;三元立方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^3+b^3+c^3-3abc=(a+b+c)(a^2+b^2+c^2-ab-bc-ca)}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({=\dfrac{1}{2}(a+b+c)\left[(a-b)^2+(b-c)^2+(c-a)^2\right]}\)&lt;/span&gt;&lt;br&gt;推论：\({a+b+c=0\Rightarrow a^3+b^3+c^3=3abc}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：已知 \({a+b+c=0}\) 的求值&lt;/span&gt;&lt;/div&gt;" 编号="R10" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="D2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3384" y="1140" width="415" height="178" as="geometry"/></mxCell></UserObject>
<UserObject id="R11" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R11&lt;/span&gt;&lt;br&gt;拉格朗日恒等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a^2+b^2)(c^2+d^2)=(ac+bd)^2+(ad-bc)^2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R66：由 \({(ad-bc)^2\ge 0}\) 得柯西不等式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：模的乘法 \({|z_1z_2|=|z_1||z_2|}\)〔R25 · J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：不等式大厦 R66（柯西不等式）&lt;/span&gt;&lt;/div&gt;" 编号="R11" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="E2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3856" y="1160" width="366" height="139" as="geometry"/></mxCell></UserObject>
<UserObject id="S02" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S02&lt;/span&gt;&lt;br&gt;【定义】乘方与指数幂&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^n}\)：\({n}\) 个 \({a}\) 相乘（\({n}\) 为正整数）&lt;br&gt;\({a^0=1}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{-n}=\dfrac{1}{a^n}}\)&lt;/span&gt;（\({a\ne 0}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{\frac{m}{n}}=\sqrt[n]{a^m}}\)&lt;/span&gt;（\({a&amp;gt;0}\)；\({m,n}\) 为正整数，\({n&amp;gt;1}\)）&lt;br&gt;无理数指数幂（\({a&amp;gt;0}\)）课本承认&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R12〔F3〕、P41〔F3〕&lt;/span&gt;&lt;/div&gt;" 编号="S02" 类型="起点" 条件="无条件" 分区="② 指数、根式与对数" 坐标="F3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5452" y="2267" width="327" height="202" as="geometry"/></mxCell></UserObject>
<UserObject id="S03" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S03&lt;/span&gt;&lt;br&gt;【定义】对数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a&amp;gt;0}\)，\({a\ne 1}\)，\({N&amp;gt;0}\) 时：\({a^b=N\iff b=\log_a N}\)&lt;br&gt;\({\lg N=\log_{10}N}\)，\({\ln N=\log_e N}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P06〔G4〕&lt;/span&gt;&lt;/div&gt;" 编号="S03" 类型="起点" 条件="无条件" 分区="② 指数、根式与对数" 坐标="G3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6015" y="2847" width="358" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="R12" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R12&lt;/span&gt;&lt;br&gt;★ 指数运算律（正整数指数）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^m\cdot a^n=a^{m+n}}\)，\({(a^m)^n=a^{mn}}\)，\({(ab)^n=a^nb^n}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R24〔J5〕、P41〔F3〕；指数函数性质、比大小（不等式大厦 P04）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：结合律、交换律重排〔S01 · B1〕&lt;/span&gt;&lt;/div&gt;" 编号="R12" 类型="结论" 条件="无条件" 分区="② 指数、根式与对数" 坐标="F3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5357" y="2582" width="517" height="120" as="geometry"/></mxCell></UserObject>
<UserObject id="P41" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a\ne 0,\ b\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P41&lt;/span&gt;&lt;br&gt;★ 整数指数幂运算律&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^m\div a^n=a^{m-n}}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{a}{b}\right)^n=\dfrac{a^n}{b^n}}\)&lt;/span&gt;&lt;br&gt;\({m,n}\) 为整数时，正整数指数的三条运算律仍成立&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=0}\)：\({0^{-1}}\) 无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P05〔F4〕；入口⑥&lt;/span&gt;&lt;/div&gt;" 编号="P41" 类型="结论（有条件）" 条件="〔定义域〕$a\ne 0,\ b\ne 0$" 分区="② 指数、根式与对数" 坐标="F3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5448" y="2808" width="334" height="200" as="geometry"/></mxCell></UserObject>
<UserObject id="P05" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a&amp;gt;0,\ b&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P05&lt;/span&gt;&lt;br&gt;★ 实数指数运算律&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^ra^s=a^{r+s}}\)，\({(a^r)^s=a^{rs}}\)，\({(ab)^r=a^rb^r}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a^r}{a^s}=a^{r-s}}\)&lt;/span&gt;（\({r,s\in\mathbb{R}}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 底数为负：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(-8)^{\frac{2}{6}}=\sqrt[6]{64}=2}\)&lt;/span&gt;，而 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(-8)^{\frac{1}{3}}=-2}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P07〔F4〕、P40〔G6〕、P43〔F4〕；入口⑥&lt;/span&gt;&lt;/div&gt;" 编号="P05" 类型="结论（有条件）" 条件="〔定义域〕$a&gt;0,\ b&gt;0$" 分区="② 指数、根式与对数" 坐标="F4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5380" y="3134" width="470" height="196" as="geometry"/></mxCell></UserObject>
<UserObject id="P43" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕被开方数 \({\ge 0}\)；〔符号分支〕开方要定号&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P43&lt;/span&gt;&lt;br&gt;★ 根式运算&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sqrt{a}\cdot\sqrt{b}=\sqrt{ab}}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{a}}{\sqrt{b}}=\sqrt{\dfrac{a}{b}}}\)&lt;/span&gt;（\({a\ge 0}\)，\({b&amp;gt;0}\)）&lt;br&gt;\({(\sqrt{a})^2=a}\)（\({a\ge 0}\)）；\({\sqrt{a^2}=|a|}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=-3}\)：\({\sqrt{(-3)^2}=3\ne -3}\)；\({\sqrt{(-2)(-8)}=4}\)，但 \({\sqrt{-2}}\) 无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：已知一值求其余〔P46 · O2〕、升幂后开方〔R19 · K3〕都要定号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P44〔F5〕、P46〔O2〕；复数的模；含根式的化简；入口⑤⑫&lt;/span&gt;&lt;/div&gt;" 编号="P43" 类型="结论（有条件）" 条件="〔定义域〕被开方数 $\ge 0$；〔符号分支〕开方要定号" 分区="② 指数、根式与对数" 坐标="F4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4762" y="3480" width="494" height="222" as="geometry"/></mxCell></UserObject>
<UserObject id="P44" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a,b\ge 0,\ a\ne b}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P44&lt;/span&gt;&lt;br&gt;分母有理化&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\sqrt{a}+\sqrt{b}}=\dfrac{\sqrt{a}-\sqrt{b}}{a-b}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P25、P54（根式裂项）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P53〔C5〕；入口⑤&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：分母用平方差〔R02 · B2〕&lt;/span&gt;&lt;/div&gt;" 编号="P44" 类型="中间结果（有条件）" 条件="〔定义域〕$a,b\ge 0,\ a\ne b$" 分区="② 指数、根式与对数" 坐标="F5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4877" y="3839" width="265" height="193" as="geometry"/></mxCell></UserObject>
<UserObject id="P06" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a&amp;gt;0,\ a\ne 1,\ N&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P06&lt;/span&gt;&lt;br&gt;★ 对数恒等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{\log_a N}=N}\)，\({\log_a a^b=b}\)&lt;br&gt;\({\log_a 1=0}\)，\({\log_a a=1}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({N=-2}\) 时 \({\log_a N}\) 无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P07〔F4〕、P10〔G4〕；入口⑥&lt;/span&gt;&lt;/div&gt;" 编号="P06" 类型="结论（有条件）" 条件="〔定义域〕$a&gt;0,\ a\ne 1,\ N&gt;0$" 分区="② 指数、根式与对数" 坐标="G4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6050" y="3141" width="289" height="182" as="geometry"/></mxCell></UserObject>
<UserObject id="P07" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({M&amp;gt;0,\ N&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P07&lt;/span&gt;&lt;br&gt;★★ 对数运算律&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\log_a(MN)=\log_a M+\log_a N}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a\dfrac{M}{N}=\log_a M-\log_a N}\)&lt;/span&gt;&lt;br&gt;\({\log_a M^n=n\log_a M}\)（\({n\in\mathbb{R}}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({\log_2[(-2)(-4)]=3}\) 有意义，\({\log_2(-2)}\) 无意义；\({\log_a x^2=2\log_a|x|}\)（\({x\ne 0}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P21、P04&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P08〔F4〕；入口⑥&lt;/span&gt;&lt;/div&gt;" 编号="P07" 类型="结论（有条件）" 条件="〔定义域〕$M&gt;0,\ N&gt;0$" 分区="② 指数、根式与对数" 坐标="F4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5314" y="3469" width="602" height="244" as="geometry"/></mxCell></UserObject>
<UserObject id="P08" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a,c&amp;gt;0}\) 且 \({\ne 1}\)，\({b&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P08&lt;/span&gt;&lt;br&gt;★ 换底公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a b=\dfrac{\log_c b}{\log_c a}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P09〔F5〕、P40〔G6〕；对数式化简；入口⑥&lt;/span&gt;&lt;/div&gt;" 编号="P08" 类型="结论（有条件）" 条件="〔定义域〕$a,c&gt;0$ 且 $\ne 1$，$b&gt;0$" 分区="② 指数、根式与对数" 坐标="F4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5430" y="3848" width="371" height="156" as="geometry"/></mxCell></UserObject>
<UserObject id="P09" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕底数 \({&amp;gt;0}\) 且 \({\ne 1}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P09&lt;/span&gt;&lt;br&gt;换底推论&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\log_a b\cdot\log_b a=1}\)（\({a,b&amp;gt;0}\) 且 \({\ne 1}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_{a^m}b^n=\dfrac{n}{m}\log_a b}\)&lt;/span&gt;（\({m\ne 0}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：对数式化简求值；入口⑥&lt;/span&gt;&lt;/div&gt;" 编号="P09" 类型="中间结果（有条件）" 条件="〔定义域〕底数 $&gt;0$ 且 $\ne 1$" 分区="② 指数、根式与对数" 坐标="F5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5464" y="4124" width="302" height="194" as="geometry"/></mxCell></UserObject>
<UserObject id="P10" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a&amp;gt;0,\ a\ne 1}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P10&lt;/span&gt;&lt;br&gt;★ 指数函数与对数函数互为反函数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({y=a^x}\) 与 \({y=\log_a x}\) 的图像关于 \({y=x}\) 对称&lt;br&gt;\({\log_a(a^x)=x}\)（\({x\in\mathbb{R}}\)），\({a^{\log_a x}=x}\)（\({x&amp;gt;0}\)）&lt;br&gt;特例：\({e^x}\) 与 \({\ln x}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 互逆：指数式 ⟷ 对数式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P39〔G6〕；指数、对数函数的图像与性质&lt;/span&gt;&lt;/div&gt;" 编号="P10" 类型="结论（有条件）" 条件="〔定义域〕$a&gt;0,\ a\ne 1$" 分区="② 指数、根式与对数" 坐标="G4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6018" y="3489" width="352" height="204" as="geometry"/></mxCell></UserObject>
<UserObject id="S04" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S04&lt;/span&gt;&lt;br&gt;【定义】三角函数（单位圆）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;角 \({\alpha}\) 终边与单位圆交于 \({P(x,y)}\)&lt;br&gt;\({\sin\alpha=y}\)，\({\cos\alpha=x}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{y}{x}}\)&lt;/span&gt;（\({x\ne 0}\)）&lt;br&gt;终边相同的角 \({\alpha+2k\pi}\)（\({k\in\mathbb{Z}}\)）三角函数值相同&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R13〔N1〕、P11〔M1〕、R14〔L1〕、P20〔M2〕、P24〔J5〕&lt;/span&gt;&lt;/div&gt;" 编号="S04" 类型="起点" 条件="无条件" 分区="③ 三角" 坐标="M1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="10916" y="412" width="478" height="162" as="geometry"/></mxCell></UserObject>
<UserObject id="S05" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S05&lt;/span&gt;&lt;br&gt;【定义】向量数量积&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\vec a\cdot\vec b=|\vec a||\vec b|\cos\theta}\)（\({\theta\in[0,\pi]}\) 为夹角）&lt;br&gt;交换律、数乘结合律、分配律（课本给出）&lt;br&gt;单位正交基：\({\vec i\cdot\vec i=\vec j\cdot\vec j=1}\)，\({\vec i\cdot\vec j=0}\)&lt;br&gt;加减（三角形法则）：\({\overrightarrow{AB}+\overrightarrow{BC}=\overrightarrow{AC}}\)；坐标：\({\vec a=x\vec i+y\vec j}\) 记作 \({(x,y)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R15〔J1〕、P49〔K1〕&lt;/span&gt;&lt;/div&gt;" 编号="S05" 类型="起点" 条件="无条件" 分区="③ 三角" 坐标="K1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8657" y="410" width="480" height="166" as="geometry"/></mxCell></UserObject>
<UserObject id="S06" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S06&lt;/span&gt;&lt;br&gt;【定义】复数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({i^2=-1}\)；\({z=a+bi}\)（\({a,b\in\mathbb{R}}\)）；\({a+bi=c+di\iff a=c}\) 且 \({b=d}\)&lt;br&gt;\({z}\) ↔ 点 \({(a,b)}\) ↔ 向量；模 \({|z|=\sqrt{a^2+b^2}}\)，共轭 \({\bar z=a-bi}\)&lt;br&gt;加、乘按多项式运算，运算律照常成立&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R22〔J5〕、R24〔J5〕、P24〔J5〕&lt;/span&gt;&lt;/div&gt;" 编号="S06" 类型="起点" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="J4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7763" y="3663" width="495" height="144" as="geometry"/></mxCell></UserObject>
<UserObject id="S11" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S11&lt;/span&gt;&lt;br&gt;【承认】欧拉公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({e^{i\theta}=\cos\theta+i\sin\theta}\)；\({\theta=\pi}\) 时 \({e^{i\pi}+1=0}\)&lt;br&gt;要用级数或复变函数才能证明，高中只承认&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：三角形式乘法“辐角相加”与 \({e^ae^b=e^{a+b}}\) 是同一件事〔R26 · J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：拓展——复数的乘方、三角恒等式的另一种推法&lt;/span&gt;&lt;/div&gt;" 编号="S11" 类型="起点" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8143" y="4562" width="478" height="144" as="geometry"/></mxCell></UserObject>
<UserObject id="R13" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R13&lt;/span&gt;&lt;br&gt;★★★ 勾股恒等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin^2\alpha+\cos^2\alpha=1}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R01、R02、R03&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P12〔N2〕、R18〔K3〕、P17〔J3〕、P46〔O2〕、R38〔K3〕、P47〔N2〕；入口⑦㉗&lt;/span&gt;&lt;/div&gt;" 编号="R13" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="N1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="11699" y="789" width="619" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="P11" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\cos\alpha\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P11&lt;/span&gt;&lt;br&gt;商数关系&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{\sin\alpha}{\cos\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha=\dfrac{\pi}{2}}\)&lt;/span&gt;：\({\cos\alpha=0}\)，两边都无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P12〔N2〕、P47〔N2〕；入口⑦⑨⑩&lt;/span&gt;&lt;/div&gt;" 编号="P11" 类型="中间结果（有条件）" 条件="〔定义域〕$\cos\alpha\ne 0$" 分区="③ 三角" 坐标="M1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="11358" y="754" width="284" height="191" as="geometry"/></mxCell></UserObject>
<UserObject id="P12" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\cos\alpha\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P12&lt;/span&gt;&lt;br&gt;正切与余弦&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1+\tan^2\alpha=\dfrac{1}{\cos^2\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P16&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：已知 \({\tan\alpha}\) 求 \({\cos^2\alpha}\)；不等式大厦 P16&lt;/span&gt;&lt;/div&gt;" 编号="P12" 类型="中间结果（有条件）" 条件="〔定义域〕$\cos\alpha\ne 0$" 分区="③ 三角" 坐标="N2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="11693" y="1172" width="336" height="173" as="geometry"/></mxCell></UserObject>
<UserObject id="R14" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R14&lt;/span&gt;&lt;br&gt;★★ 诱导公式（sin、cos 对任意实数 \({\alpha}\) 成立）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;① \({\alpha+2k\pi}\)：值不变&lt;br&gt;② \({\sin(\pi+\alpha)=-\sin\alpha}\)，\({\cos(\pi+\alpha)=-\cos\alpha}\)&lt;br&gt;③ \({\sin(-\alpha)=-\sin\alpha}\)，\({\cos(-\alpha)=\cos\alpha}\)&lt;br&gt;④ \({\sin(\pi-\alpha)=\sin\alpha}\)，\({\cos(\pi-\alpha)=-\cos\alpha}\)&lt;br&gt;⑤ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\left(\dfrac{\pi}{2}-\alpha\right)=\cos\alpha}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\left(\dfrac{\pi}{2}-\alpha\right)=\sin\alpha}\)&lt;/span&gt;&lt;br&gt;⑥ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\left(\dfrac{\pi}{2}+\alpha\right)=\cos\alpha}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\left(\dfrac{\pi}{2}+\alpha\right)=-\sin\alpha}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;口诀“奇变偶不变，符号看象限”（把 \({\alpha}\) 看作锐角定符号）只用于记忆，不是条件&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P13〔L2〕、R16〔J2〕、R17〔J2〕、P19〔L2〕、P20〔M2〕；入口⑩&lt;/span&gt;&lt;/div&gt;" 编号="R14" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="L1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="10359" y="716" width="535" height="268" as="geometry"/></mxCell></UserObject>
<UserObject id="P13" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕两边的 tan 都有定义&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P13&lt;/span&gt;&lt;br&gt;tan 的诱导公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\tan(\pi+\alpha)=\tan\alpha}\)，\({\tan(-\alpha)=-\tan\alpha}\)，\({\tan(\pi-\alpha)=-\tan\alpha}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\left(\dfrac{\pi}{2}-\alpha\right)=\dfrac{1}{\tan\alpha}}\)&lt;/span&gt;（&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\ne\dfrac{k\pi}{2}}\)&lt;/span&gt;）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：含 tan 的化简求值&lt;/span&gt;&lt;/div&gt;" 编号="P13" 类型="中间结果（有条件）" 条件="〔定义域〕两边的 tan 都有定义" 分区="③ 三角" 坐标="L2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="10277" y="1172" width="448" height="173" as="geometry"/></mxCell></UserObject>
<UserObject id="P46" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔符号分支〕± 由 \({\alpha}\) 所在象限定&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P46&lt;/span&gt;&lt;br&gt;★ 已知一个三角函数值求其余&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin\alpha=\pm\sqrt{1-\cos^2\alpha}}\)，\({\cos\alpha=\pm\sqrt{1-\sin^2\alpha}}\)，再 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{\sin\alpha}{\cos\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\alpha=\dfrac{3}{5}}\)&lt;/span&gt; 且 \({\alpha}\) 在第四象限：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha=-\dfrac{4}{5}}\)&lt;/span&gt;，取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({+\dfrac{4}{5}}\)&lt;/span&gt; 就错&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口⑦&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：\({\sqrt{a^2}=|a|}\)，开方要定号〔P43 · F4〕&lt;/span&gt;&lt;/div&gt;" 编号="P46" 类型="结论（有条件）" 条件="〔符号分支〕± 由 $\alpha$ 所在象限定" 分区="③ 三角" 坐标="O2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="12714" y="1161" width="487" height="216" as="geometry"/></mxCell></UserObject>
<UserObject id="R38" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R38&lt;/span&gt;&lt;br&gt;★ 同角关系的常用变形&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(\sin\alpha\pm\cos\alpha)^2=1\pm 2\sin\alpha\cos\alpha=1\pm\sin 2\alpha}\)&lt;br&gt;“1”的代换：\({1=\sin^2\alpha+\cos^2\alpha}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口⑧⑫&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：\({\sin^2\alpha+\cos^2\alpha=1}\) 合并〔R13 · N1〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：完全平方〔R03 · B2〕&lt;/span&gt;&lt;/div&gt;" 编号="R38" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="K3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9595" y="2418" width="374" height="162" as="geometry"/></mxCell></UserObject>
<UserObject id="P47" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\cos\alpha\ne 0}\)，分母 \({\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P47&lt;/span&gt;&lt;br&gt;弦化切（齐次式）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a\sin\alpha+b\cos\alpha}{c\sin\alpha+d\cos\alpha}=\dfrac{a\tan\alpha+b}{c\tan\alpha+d}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\cos\alpha=\dfrac{\tan\alpha}{1+\tan^2\alpha}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin^2\alpha=\dfrac{\tan^2\alpha}{1+\tan^2\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha=\dfrac{\pi}{2}}\)&lt;/span&gt; 时 \({\cos\alpha=0}\)，不能同除&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口⑨&lt;/span&gt;&lt;/div&gt;" 编号="P47" 类型="中间结果（有条件）" 条件="〔定义域〕$\cos\alpha\ne 0$，分母 $\ne 0$" 分区="③ 三角" 坐标="N2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="12087" y="1144" width="334" height="230" as="geometry"/></mxCell></UserObject>
<UserObject id="R15" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R15&lt;/span&gt;&lt;br&gt;★★ 数量积坐标式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\vec a=(x_1,y_1)}\)，\({\vec b=(x_2,y_2)\Rightarrow\vec a\cdot\vec b=x_1x_2+y_1y_2}\)&lt;br&gt;\({|\vec a|^2=x_1^2+y_1^2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R16&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R16〔J2〕；入口⑰&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：与多项式乘法同样逐项展开〔R01 · B1〕&lt;/span&gt;&lt;/div&gt;" 编号="R15" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="J1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8545" y="778" width="341" height="164" as="geometry"/></mxCell></UserObject>
<UserObject id="R16" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R16&lt;/span&gt;&lt;br&gt;★★★ 两角差的余弦&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\cos(\alpha-\beta)=\cos\alpha\cos\beta+\sin\alpha\sin\beta}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R17〔J2〕；入口⑭&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：\({\alpha-\beta=\pm\theta+2k\pi}\)，由 ①③ 得 \({\cos(\alpha-\beta)=\cos\theta}\)〔R14 · L1〕&lt;/span&gt;&lt;/div&gt;" 编号="R16" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="J2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8616" y="1209" width="302" height="120" as="geometry"/></mxCell></UserObject>
<UserObject id="R17" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R17&lt;/span&gt;&lt;br&gt;★★ 其余和差角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\cos(\alpha+\beta)=\cos\alpha\cos\beta-\sin\alpha\sin\beta}\)&lt;br&gt;\({\sin(\alpha\pm\beta)=\sin\alpha\cos\beta\pm\cos\alpha\sin\beta}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P14〔H3〕、R18〔K3〕、R20〔J3〕、P17〔J3〕、R26〔J5〕；入口⑩⑭&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：诱导公式 ③⑤〔R14 · L1〕&lt;/span&gt;&lt;/div&gt;" 编号="R17" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="J2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8500" y="1599" width="534" height="142" as="geometry"/></mxCell></UserObject>
<UserObject id="P14" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕三个 tan 都有定义&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P14&lt;/span&gt;&lt;br&gt;两角和差的正切&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan(\alpha\pm\beta)=\dfrac{\tan\alpha\pm\tan\beta}{1\mp\tan\alpha\tan\beta}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha=\beta=\dfrac{\pi}{4}}\)&lt;/span&gt;：\({\tan(\alpha+\beta)}\) 无定义，右边分母 \({1-1=0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P15〔H3〕；解析几何——两直线夹角 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\theta=\left|\dfrac{k_2-k_1}{1+k_1k_2}\right|}\)&lt;/span&gt;；入口⑩&lt;/span&gt;&lt;/div&gt;" 编号="P14" 类型="中间结果（有条件）" 条件="〔定义域〕三个 tan 都有定义" 分区="③ 三角" 坐标="H3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7557" y="1942" width="465" height="230" as="geometry"/></mxCell></UserObject>
<UserObject id="R18" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R18&lt;/span&gt;&lt;br&gt;★★ 倍角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin 2\alpha=2\sin\alpha\cos\alpha}\)&lt;br&gt;\({\cos 2\alpha=\cos^2\alpha-\sin^2\alpha=2\cos^2\alpha-1=1-2\sin^2\alpha}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R02&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R19〔K3〕、P18〔K3〕、R38〔K3〕；三角函数的图像与性质；入口⑧⑪&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：用 \({\sin^2\alpha+\cos^2\alpha=1}\) 换成单一函数〔R13 · N1〕&lt;/span&gt;&lt;/div&gt;" 编号="R18" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="K3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9106" y="1985" width="526" height="164" as="geometry"/></mxCell></UserObject>
<UserObject id="P15" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\tan\alpha}\)、\({\tan 2\alpha}\) 有定义&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P15&lt;/span&gt;&lt;br&gt;正切倍角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan 2\alpha=\dfrac{2\tan\alpha}{1-\tan^2\alpha}}\)&lt;/span&gt;&lt;br&gt;即 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\ne\dfrac{\pi}{2}+k\pi}\)&lt;/span&gt; 且 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\ne\dfrac{\pi}{4}+\dfrac{k\pi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：已知 \({\tan\alpha}\) 求 \({\tan 2\alpha}\)&lt;/span&gt;&lt;/div&gt;" 编号="P15" 类型="中间结果（有条件）" 条件="〔定义域〕$\tan\alpha$、$\tan 2\alpha$ 有定义" 分区="③ 三角" 坐标="H3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7646" y="2383" width="287" height="191" as="geometry"/></mxCell></UserObject>
<UserObject id="R19" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R19&lt;/span&gt;&lt;br&gt;降幂&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos^2\alpha=\dfrac{1+\cos 2\alpha}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin^2\alpha=\dfrac{1-\cos 2\alpha}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\cos\alpha=\dfrac{1}{2}\sin 2\alpha}\)&lt;/span&gt;&lt;br&gt;升幂：\({1+\cos 2\alpha=2\cos^2\alpha}\)，\({1-\cos 2\alpha=2\sin^2\alpha}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：\({\sqrt{1+\cos 2\alpha}=\sqrt{2}|\cos\alpha|}\)，开方要用〔P43 · F4〕定号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P16〔K3〕；入口⑩⑪⑫&lt;/span&gt;&lt;/div&gt;" 编号="R19" 类型="中间结果" 条件="无条件" 分区="③ 三角" 坐标="K3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8747" y="2370" width="395" height="217" as="geometry"/></mxCell></UserObject>
<UserObject id="P16" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔符号分支〕± 由 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\alpha}{2}}\)&lt;/span&gt; 所在象限定&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P16&lt;/span&gt;&lt;br&gt;★ 半角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\dfrac{\alpha}{2}=\pm\sqrt{\dfrac{1-\cos\alpha}{2}}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\dfrac{\alpha}{2}=\pm\sqrt{\dfrac{1+\cos\alpha}{2}}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({\alpha=300^\circ}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos 150^\circ=-\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，取正号得 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({+\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，错&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\dfrac{\alpha}{2}=\dfrac{\sin\alpha}{1+\cos\alpha}=\dfrac{1-\cos\alpha}{\sin\alpha}}\)&lt;/span&gt;（无 ±；前式 \({\cos\alpha\ne -1}\)，后式 \({\sin\alpha\ne 0}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：求 \({15^\circ}\)、\({22.5^\circ}\) 等的值；入口⑭&lt;/span&gt;&lt;/div&gt;" 编号="P16" 类型="结论（有条件）" 条件="〔符号分支〕± 由 $\frac{\alpha}{2}$ 所在象限定" 分区="③ 三角" 坐标="K3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8664" y="2809" width="562" height="254" as="geometry"/></mxCell></UserObject>
<UserObject id="R20" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R20&lt;/span&gt;&lt;br&gt;积化和差&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\cos\beta=\dfrac{1}{2}[\sin(\alpha+\beta)+\sin(\alpha-\beta)]}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\alpha\cos\beta=\dfrac{1}{2}[\cos(\alpha+\beta)+\cos(\alpha-\beta)]}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\sin\beta=-\dfrac{1}{2}[\cos(\alpha+\beta)-\cos(\alpha-\beta)]}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R21〔J3〕；三角式的积和互化、证明；入口⑬&lt;/span&gt;&lt;/div&gt;" 编号="R20" 类型="中间结果" 条件="无条件" 分区="③ 三角" 坐标="J3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8080" y="1950" width="348" height="214" as="geometry"/></mxCell></UserObject>
<UserObject id="R21" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R21&lt;/span&gt;&lt;br&gt;和差化积&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\theta+\sin\varphi=2\sin\dfrac{\theta+\varphi}{2}\cos\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\theta-\sin\varphi=2\cos\dfrac{\theta+\varphi}{2}\sin\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta+\cos\varphi=2\cos\dfrac{\theta+\varphi}{2}\cos\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta-\cos\varphi=-2\sin\dfrac{\theta+\varphi}{2}\sin\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 互逆：积化和差〔R20 · J3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：三角式的积和互化、证明；入口⑬&lt;/span&gt;&lt;/div&gt;" 编号="R21" 类型="中间结果" 条件="无条件" 分区="③ 三角" 坐标="J3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8108" y="2342" width="292" height="274" as="geometry"/></mxCell></UserObject>
<UserObject id="P17" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a,b}\) 不全为 0；〔符号分支〕\({\varphi}\) 由 \({a,b}\) 正负定&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P17&lt;/span&gt;&lt;br&gt;★★ 辅助角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a\sin x+b\cos x=\sqrt{a^2+b^2}\,\sin(x+\varphi)}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\varphi=\dfrac{a}{\sqrt{a^2+b^2}}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\varphi=\dfrac{b}{\sqrt{a^2+b^2}}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=b=-1}\) 应取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\varphi=\dfrac{5\pi}{4}}\)&lt;/span&gt;；只看 \({\tan\varphi=1}\) 取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{4}}\)&lt;/span&gt;，得 \({\sin x+\cos x}\)，错&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R13&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：先降幂〔R19 · K3〕、倍角〔R18 · K3〕，再辅助角&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口⑪&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{a}{r}\right)^2+\left(\dfrac{b}{r}\right)^2=1}\)&lt;/span&gt;，故有 \({\varphi}\)〔R13 · N1〕&lt;/span&gt;&lt;/div&gt;" 编号="P17" 类型="结论（有条件）" 条件="〔定义域〕$a,b$ 不全为 0；〔符号分支〕$\varphi$ 由 $a,b$ 正负定" 分区="③ 三角" 坐标="J3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8486" y="1926" width="562" height="282" as="geometry"/></mxCell></UserObject>
<UserObject id="P18" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\alpha\ne\pi+2k\pi}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P18&lt;/span&gt;&lt;br&gt;万能公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({t=\tan\dfrac{\alpha}{2}}\)&lt;/span&gt;：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha=\dfrac{2t}{1+t^2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\alpha=\dfrac{1-t^2}{1+t^2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{2t}{1-t^2}}\)&lt;/span&gt;（还要 \({t^2\ne 1}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：三角式化成有理式（换元）&lt;/span&gt;&lt;/div&gt;" 编号="P18" 类型="中间结果（有条件）" 条件="〔定义域〕$\alpha\ne\pi+2k\pi$" 分区="③ 三角" 坐标="K3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9201" y="2383" width="336" height="191" as="geometry"/></mxCell></UserObject>
<UserObject id="P19" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({A+B+C=\pi}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P19&lt;/span&gt;&lt;br&gt;三角形内角关系&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin(A+B)=\sin C}\)，\({\cos(A+B)=-\cos C}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\dfrac{A+B}{2}=\cos\dfrac{C}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：三角形中的化简；入口⑮⑯&lt;/span&gt;&lt;/div&gt;" 编号="P19" 类型="中间结果（有条件）" 条件="〔结构前提〕$A+B+C=\pi$" 分区="③ 三角" 坐标="L2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9905" y="1172" width="314" height="173" as="geometry"/></mxCell></UserObject>
<UserObject id="P20" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({a,b}\) 夹角 \({C}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P20&lt;/span&gt;&lt;br&gt;三角形面积&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S=\dfrac{1}{2}ab\sin C=\dfrac{1}{2}bc\sin A=\dfrac{1}{2}ca\sin B}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 直角边 \({a=b=1}\)、\({C=90^\circ}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S=\dfrac{1}{2}}\)&lt;/span&gt;；误用非夹角 \({A=45^\circ}\) 得 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{2}}{4}}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P21〔M2〕、P48〔L2〕；入口⑮&lt;/span&gt;&lt;/div&gt;" 编号="P20" 类型="中间结果（有条件）" 条件="〔结构前提〕$a,b$ 夹角 $C$" 分区="③ 三角" 坐标="M2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="10783" y="1163" width="454" height="191" as="geometry"/></mxCell></UserObject>
<UserObject id="P21" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕同一三角形的边与对角&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P21&lt;/span&gt;&lt;br&gt;★★ 正弦定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{\sin A}=\dfrac{b}{\sin B}=\dfrac{c}{\sin C}=2R}\)&lt;/span&gt;（\({R}\) 为外接圆半径）&lt;br&gt;推论：\({a=2R\sin A}\)，\({a:b:c=\sin A:\sin B:\sin C}\)（边角互化）&lt;br&gt;拓展：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S=\dfrac{abc}{4R}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=2}\)，\({b=1}\)，\({A=B=60^\circ}\) 不来自同一三角形：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{\sin A}\ne\dfrac{b}{\sin B}}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：余弦定理〔P22 · K2〕做边角互化&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：不等式大厦 R13（三角形中求最值）；入口⑮⑯&lt;/span&gt;&lt;/div&gt;" 编号="P21" 类型="结论（有条件）" 条件="〔结构前提〕同一三角形的边与对角" 分区="③ 三角" 坐标="M2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="10770" y="1520" width="479" height="280" as="geometry"/></mxCell></UserObject>
<UserObject id="P22" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({a}\) 为 \({A}\) 的对边，\({b,c}\) 夹 \({A}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P22&lt;/span&gt;&lt;br&gt;★★ 余弦定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^2=b^2+c^2-2bc\cos A}\)（其余两式同理）&lt;br&gt;推论 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos A=\dfrac{b^2+c^2-a^2}{2bc}}\)&lt;/span&gt;（已知三边求角）；\({A=90^\circ}\) 时即勾股定理&lt;br&gt;拓展：射影定理 \({a=b\cos C+c\cos B}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=2}\)，\({b=c=1}\)，\({A=60^\circ}\)：右边 \({=1}\)，左边 \({=4}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：勾股恒等式〔R13 · N1〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P48〔L2〕；入口⑮⑯&lt;/span&gt;&lt;/div&gt;" 编号="P22" 类型="结论（有条件）" 条件="〔结构前提〕$a$ 为 $A$ 的对边，$b,c$ 夹 $A$" 分区="③ 三角" 坐标="K2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9116" y="1137" width="487" height="244" as="geometry"/></mxCell></UserObject>
<UserObject id="P48" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({a,b,c}\) 为三角形三边&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P48&lt;/span&gt;&lt;br&gt;海伦公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({S=\sqrt{p(p-a)(p-b)(p-c)}}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({p=\dfrac{a+b+c}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口⑮&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：平方差分解〔R02 · B2〕&lt;/span&gt;&lt;/div&gt;" 编号="P48" 类型="中间结果（有条件）" 条件="〔结构前提〕$a,b,c$ 为三角形三边" 分区="③ 三角" 坐标="L2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="10383" y="1584" width="304" height="172" as="geometry"/></mxCell></UserObject>
<UserObject id="P49" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕后两式要求 \({\vec a,\vec b\ne\vec 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P49&lt;/span&gt;&lt;br&gt;★★ 数量积的运算公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|\vec a\pm\vec b|^2=|\vec a|^2\pm 2\vec a\cdot\vec b+|\vec b|^2}\)；\({(\vec a+\vec b)\cdot(\vec a-\vec b)=|\vec a|^2-|\vec b|^2}\)&lt;br&gt;\({\vec a\perp\vec b\iff\vec a\cdot\vec b=0}\)；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta=\dfrac{\vec a\cdot\vec b}{|\vec a||\vec b|}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({\vec b=\vec 0}\) 时夹角无定义，\({\cos\theta}\) 的分母为 0&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R16、R27&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：完全平方〔R03 · B2〕、平方差〔R02 · B2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P22〔K2〕；解析几何中的垂直、夹角；入口⑰&lt;/span&gt;&lt;/div&gt;" 编号="P49" 类型="结论（有条件）" 条件="〔定义域〕后两式要求 $\vec a,\vec b\ne\vec 0$" 分区="③ 三角" 坐标="K1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9146" y="728" width="437" height="244" as="geometry"/></mxCell></UserObject>
<UserObject id="R22" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R22&lt;/span&gt;&lt;br&gt;复数乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+bi)(c+di)=(ac-bd)+(ad+bc)i}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R23〔J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：多项式乘法展开〔R01 · B1〕&lt;/span&gt;&lt;/div&gt;" 编号="R22" 类型="中间结果" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7862" y="4008" width="296" height="117" as="geometry"/></mxCell></UserObject>
<UserObject id="R23" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R23&lt;/span&gt;&lt;br&gt;★ 共轭与模&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({z\bar z=|z|^2=a^2+b^2}\)；\({z+\bar z=2a}\)，\({z-\bar z=2bi}\)&lt;br&gt;\({\overline{z_1\pm z_2}=\bar z_1\pm\bar z_2}\)，\({\overline{z_1z_2}=\bar z_1\bar z_2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P23〔H5〕、R25〔J5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：与平方差同型〔R02 · B2〕&lt;/span&gt;&lt;/div&gt;" 编号="R23" 类型="结论" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7801" y="4289" width="342" height="142" as="geometry"/></mxCell></UserObject>
<UserObject id="P23" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({c+di\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P23&lt;/span&gt;&lt;br&gt;复数除法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a+bi}{c+di}=\dfrac{(ac+bd)+(bc-ad)i}{c^2+d^2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({c=d=0}\) 时分母为 0&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：复数计算；入口⑱&lt;/span&gt;&lt;/div&gt;" 编号="P23" 类型="中间结果（有条件）" 条件="〔定义域〕$c+di\ne 0$" 分区="③ 三角（续）复数分支" 坐标="H5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7557" y="4548" width="244" height="173" as="geometry"/></mxCell></UserObject>
<UserObject id="R24" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R24&lt;/span&gt;&lt;br&gt;\({i^n}\) 以 4 为周期&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({i^1=i}\)，\({i^2=-1}\)，\({i^3=-i}\)，\({i^4=1}\)；\({i^{n+4}=i^n}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：复数的高次幂；入口⑱&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：指数运算律〔R12 · F3〕&lt;/span&gt;&lt;/div&gt;" 编号="R24" 类型="中间结果" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8216" y="3997" width="338" height="138" as="geometry"/></mxCell></UserObject>
<UserObject id="R25" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R25&lt;/span&gt;&lt;br&gt;模的乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|z_1z_2|=|z_1||z_2|}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：拉格朗日恒等式〔R11 · E2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：复数求模；入口⑱&lt;/span&gt;&lt;/div&gt;" 编号="R25" 类型="中间结果" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7859" y="4564" width="226" height="139" as="geometry"/></mxCell></UserObject>
<UserObject id="P24" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({z\ne 0}\)；〔符号分支〕\({\theta}\) 由 \({a,b}\) 正负定&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P24&lt;/span&gt;&lt;br&gt;★ 三角形式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({z=a+bi=r(\cos\theta+i\sin\theta)}\)，\({r=|z|}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta=\dfrac{a}{r}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\theta=\dfrac{b}{r}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({z=-1-i}\)：只看 \({\tan\theta=1}\) 取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{4}}\)&lt;/span&gt;，得 \({1+i\ne z}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R26〔J5〕；入口⑱&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：单位圆定义〔S04 · M1〕&lt;/span&gt;&lt;/div&gt;" 编号="P24" 类型="结论（有条件）" 条件="〔定义域〕$z\ne 0$；〔符号分支〕$\theta$ 由 $a,b$ 正负定" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8624" y="3947" width="402" height="238" as="geometry"/></mxCell></UserObject>
<UserObject id="R26" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R26&lt;/span&gt;&lt;br&gt;★★ 三角形式乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({r_1(\cos\theta_1+i\sin\theta_1)\cdot r_2(\cos\theta_2+i\sin\theta_2)}\)&lt;br&gt;\({=r_1r_2[\cos(\theta_1+\theta_2)+i\sin(\theta_1+\theta_2)]}\)&lt;br&gt;模相乘，辐角相加&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P25〔J5〕、R27〔K5〕&lt;/span&gt;&lt;/div&gt;" 编号="R26" 类型="结论" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8652" y="4278" width="346" height="144" as="geometry"/></mxCell></UserObject>
<UserObject id="P25" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({z_2\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P25&lt;/span&gt;&lt;br&gt;三角形式除法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{z_1}{z_2}=\dfrac{r_1}{r_2}[\cos(\theta_1-\theta_2)+i\sin(\theta_1-\theta_2)]}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：复数计算；入口⑱&lt;/span&gt;&lt;/div&gt;" 编号="P25" 类型="中间结果（有条件）" 条件="〔定义域〕$z_2\ne 0$" 分区="③ 三角（续）复数分支" 坐标="J5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8679" y="4548" width="292" height="173" as="geometry"/></mxCell></UserObject>
<UserObject id="R27" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R27&lt;/span&gt;&lt;br&gt;★ 棣莫弗公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({[r(\cos\theta+i\sin\theta)]^n=r^n(\cos n\theta+i\sin n\theta)}\)（\({n}\) 为正整数）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;教材必修四 10.3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：复数的乘方、方根；入口⑱&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：数学归纳法〔S10 · B6〕&lt;/span&gt;&lt;/div&gt;" 编号="R27" 类型="结论" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="K5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9029" y="4573" width="464" height="142" as="geometry"/></mxCell></UserObject>
<UserObject id="S09" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S09&lt;/span&gt;&lt;br&gt;【定义】数列&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({S_n=a_1+a_2+\cdots+a_n}\)&lt;br&gt;等差：\({a_{n+1}-a_n=d}\)（常数）&lt;br&gt;等比：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a_{n+1}}{a_n}=q}\)&lt;/span&gt;（常数，\({a_n\ne 0}\)，\({q\ne 0}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P26〔B5〕、P29〔B5〕、P32〔B5〕、P51〔A5〕&lt;/span&gt;&lt;/div&gt;" 编号="S09" 类型="起点" 条件="无条件" 分区="④ 数列" 坐标="B4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1238" y="3717" width="399" height="162" as="geometry"/></mxCell></UserObject>
<UserObject id="S10" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S10&lt;/span&gt;&lt;br&gt;【工具】数学归纳法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({n=n_0}\) 成立；\({n=k}\) 成立 \({\Rightarrow n=k+1}\) 成立&lt;br&gt;\({\Rightarrow}\) 对一切 \({n\ge n_0}\) 成立&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P23（伯努利归纳步）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R27〔K5〕、R32〔A6〕&lt;/span&gt;&lt;/div&gt;" 编号="S10" 类型="起点" 条件="无条件" 分区="④ 数列" 坐标="B6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1522" y="5112" width="327" height="144" as="geometry"/></mxCell></UserObject>
<UserObject id="R28" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R28&lt;/span&gt;&lt;br&gt;★ 累加相消&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(b_2-b_1)+(b_3-b_2)+\cdots+(b_{n+1}-b_n)=b_{n+1}-b_1}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R30〔C4〕、R31〔A6〕、P50〔B4〕&lt;/span&gt;&lt;/div&gt;" 编号="R28" 类型="结论" 条件="无条件" 分区="④ 数列" 坐标="B4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1768" y="3459" width="375" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="P50" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({n\ge 2}\)，\({n=1}\) 单独验证&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P50&lt;/span&gt;&lt;br&gt;★★ 累加法、累乘法（求通项）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a_{n+1}-a_n=f(n)\Rightarrow a_n=a_1+\displaystyle\sum_{k=1}^{n-1}f(k)}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a_{n+1}}{a_n}=g(n)\Rightarrow a_n=a_1\displaystyle\prod_{k=1}^{n-1}g(k)}\)&lt;/span&gt;（\({a_n\ne 0}\)）&lt;br&gt;等差、等比的通项是 \({f(n)=d}\)、\({g(n)=q}\) 的特例&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P26〔B5〕、P29〔B5〕；入口⑲&lt;/span&gt;&lt;/div&gt;" 编号="P50" 类型="结论（有条件）" 条件="〔定义域〕$n\ge 2$，$n=1$ 单独验证" 分区="④ 数列" 坐标="B4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1776" y="3685" width="358" height="226" as="geometry"/></mxCell></UserObject>
<UserObject id="P51" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差、等比&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P51&lt;/span&gt;&lt;br&gt;等差中项、等比中项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a,b,c}\) 成等差 \({\iff 2b=a+c}\)&lt;br&gt;\({a,b,c}\) 成等比 \({\Rightarrow b^2=ac}\)（反过来还要 \({a,b,c\ne 0}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({0,0,0}\) 满足 \({b^2=ac}\)，但不是等比数列&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口⑳&lt;/span&gt;&lt;/div&gt;" 编号="P51" 类型="中间结果（有条件）" 条件="〔结构前提〕等差、等比" 分区="④ 数列" 坐标="A5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="460" y="4061" width="360" height="197" as="geometry"/></mxCell></UserObject>
<UserObject id="P26" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P26&lt;/span&gt;&lt;br&gt;★ 等差通项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_n=a_1+(n-1)d}\)，\({a_n=a_m+(n-m)d}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P27〔B5〕；入口⑲&lt;/span&gt;&lt;/div&gt;" 编号="P26" 类型="结论（有条件）" 条件="〔结构前提〕等差数列" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1292" y="4091" width="291" height="138" as="geometry"/></mxCell></UserObject>
<UserObject id="P27" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P27&lt;/span&gt;&lt;br&gt;等差下标性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({m+n=p+q\Rightarrow a_m+a_n=a_p+a_q}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 1, 2, 4, 7 不是等差：\({a_1+a_4=8}\)，\({a_2+a_3=6}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P28〔B5〕；入口⑳&lt;/span&gt;&lt;/div&gt;" 编号="P27" 类型="中间结果（有条件）" 条件="〔结构前提〕等差数列" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="872" y="4418" width="343" height="155" as="geometry"/></mxCell></UserObject>
<UserObject id="P28" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P28&lt;/span&gt;&lt;br&gt;★★ 等差求和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_n=\dfrac{n(a_1+a_n)}{2}=na_1+\dfrac{n(n-1)}{2}d}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_n=\dfrac{d}{2}n^2+\left(a_1-\dfrac{d}{2}\right)n}\)&lt;/span&gt;：关于 \({n}\) 的二次式，常数项为 0&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 1, 2, 4, 7：\({S_4=14}\)，而 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{4\times(1+7)}{2}=16}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R29〔A6〕、P54〔B6〕；入口⑳㉑&lt;/span&gt;&lt;/div&gt;" 编号="P28" 类型="结论（有条件）" 条件="〔结构前提〕等差数列" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="847" y="4734" width="393" height="236" as="geometry"/></mxCell></UserObject>
<UserObject id="R29" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R29&lt;/span&gt;&lt;br&gt;自然数求和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1+2+\cdots+n=\dfrac{n(n+1)}{2}}\)&lt;/span&gt;&lt;br&gt;\({a_k=k}\) 本身是等差数列，无需另加条件&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R31〔A6〕、R32〔A6〕；入口㉒&lt;/span&gt;&lt;/div&gt;" 编号="R29" 类型="中间结果" 条件="无条件" 分区="④ 数列" 坐标="A6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="5105" width="275" height="157" as="geometry"/></mxCell></UserObject>
<UserObject id="P29" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等比数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P29&lt;/span&gt;&lt;br&gt;★ 等比通项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_n=a_1q^{n-1}}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P30〔B5〕、P31〔B5〕；入口⑲&lt;/span&gt;&lt;/div&gt;" 编号="P29" 类型="结论（有条件）" 条件="〔结构前提〕等比数列" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1641" y="4091" width="289" height="138" as="geometry"/></mxCell></UserObject>
<UserObject id="P30" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等比数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P30&lt;/span&gt;&lt;br&gt;等比下标性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({m+n=p+q\Rightarrow a_ma_n=a_pa_q}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 1, 2, 4, 7：\({a_1a_4=7}\)，\({a_2a_3=8}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：等比数列的性质速算；入口⑳&lt;/span&gt;&lt;/div&gt;" 编号="P30" 类型="中间结果（有条件）" 条件="〔结构前提〕等比数列" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1274" y="4418" width="258" height="155" as="geometry"/></mxCell></UserObject>
<UserObject id="P31" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等比数列；〔定义域〕\({q\ne 1}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P31&lt;/span&gt;&lt;br&gt;★★ 等比求和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({q\ne 1}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_n=\dfrac{a_1(1-q^n)}{1-q}}\)&lt;/span&gt;；\({q=1}\)：\({S_n=na_1}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({q=1}\) 时分母为 0&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P13&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P52〔B5〕、P54〔B6〕；差比数列求和；入口㉑&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：【因式分解】\({1-q^n=(1-q)(1+q+\cdots+q^{n-1})}\)（另一路）〔R09 · D2〕&lt;/span&gt;&lt;/div&gt;" 编号="P31" 类型="结论（有条件）" 条件="〔结构前提〕等比数列；〔定义域〕$q\ne 1$" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1590" y="4395" width="391" height="220" as="geometry"/></mxCell></UserObject>
<UserObject id="P54" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差、等比&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P54&lt;/span&gt;&lt;br&gt;片段和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;等差：\({S_m,\ S_{2m}-S_m,\ S_{3m}-S_{2m}}\) 成等差（公差 \({m^2d}\)）&lt;br&gt;等比：片段和都不为 0 时成等比（公比 \({q^m}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({q=-1}\)，\({m=2}\)：片段和都是 0，\({0,0,0}\) 不是等比数列&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口⑳&lt;/span&gt;&lt;/div&gt;" 编号="P54" 类型="中间结果（有条件）" 条件="〔结构前提〕等差、等比" 分区="④ 数列" 坐标="B6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1093" y="5096" width="371" height="176" as="geometry"/></mxCell></UserObject>
<UserObject id="P32" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({n\ge 2}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P32&lt;/span&gt;&lt;br&gt;\({a_n}\) 与 \({S_n}\)&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_1=S_1}\)；\({n\ge 2}\) 时 \({a_n=S_n-S_{n-1}}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({S_n=n^2+1}\)：\({a_1=2}\)，而 \({2n-1}\) 在 \({n=1}\) 时得 1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：已知 \({S_n}\) 求 \({a_n}\)；入口⑲&lt;/span&gt;&lt;/div&gt;" 编号="P32" 类型="中间结果（有条件）" 条件="〔定义域〕$n\ge 2$" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="878" y="4082" width="356" height="155" as="geometry"/></mxCell></UserObject>
<UserObject id="P52" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({c_n=a_nb_n}\)，等差×等比；〔定义域〕\({q\ne 1}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P52&lt;/span&gt;&lt;br&gt;★ 差比数列求和（错位相减）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;例：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\displaystyle\sum_{k=1}^{n}k\,q^{k-1}=\dfrac{1-(n+1)q^n+nq^{n+1}}{(1-q)^2}}\)&lt;/span&gt;&lt;br&gt;核对 \({n=1}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1-2q+q^2}{(1-q)^2}=1}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({q=1}\) 时分母为 0，应为 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sum k=\dfrac{n(n+1)}{2}}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：等比求和〔P31 · B5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口㉑&lt;/span&gt;&lt;/div&gt;" 编号="P52" 类型="结论（有条件）" 条件="〔结构前提〕$c_n=a_nb_n$，等差×等比；〔定义域〕$q\ne 1$" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1575" y="4721" width="424" height="262" as="geometry"/></mxCell></UserObject>
<UserObject id="R30" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R30&lt;/span&gt;&lt;br&gt;★ 裂项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k(k+1)}=\dfrac{1}{k}-\dfrac{1}{k+1}}\)&lt;/span&gt;（\({k}\) 为正整数）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\displaystyle\sum_{k=1}^{n}\dfrac{1}{k(k+1)}=1-\dfrac{1}{n+1}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P24&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：累加相消〔R28 · B4〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P53〔C5〕；入口㉑&lt;/span&gt;&lt;/div&gt;" 编号="R30" 类型="结论" 条件="无条件" 分区="④ 数列" 坐标="C4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2192" y="3695" width="285" height="206" as="geometry"/></mxCell></UserObject>
<UserObject id="P53" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({d\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P53&lt;/span&gt;&lt;br&gt;★ 裂项的其他形式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k(k+d)}=\dfrac{1}{d}\left(\dfrac{1}{k}-\dfrac{1}{k+d}\right)}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\sqrt{k}+\sqrt{k+1}}=\sqrt{k+1}-\sqrt{k}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P25、P54、P55&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口㉑&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：【同乘】根式形用分母有理化〔P44 · F5〕&lt;/span&gt;&lt;/div&gt;" 编号="P53" 类型="结论（有条件）" 条件="〔定义域〕$d\ne 0$" 分区="④ 数列" 坐标="C5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2215" y="4051" width="239" height="238" as="geometry"/></mxCell></UserObject>
<UserObject id="R31" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R31&lt;/span&gt;&lt;br&gt;★ 平方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1^2+2^2+\cdots+n^2=\dfrac{n(n+1)(2n+1)}{6}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：数列求和、放缩估计；入口㉒&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：累加相消〔R28 · B4〕&lt;/span&gt;&lt;/div&gt;" 编号="R31" 类型="结论" 条件="无条件" 分区="④ 数列" 坐标="A6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="5417" width="282" height="138" as="geometry"/></mxCell></UserObject>
<UserObject id="R32" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R32&lt;/span&gt;&lt;br&gt;立方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1^3+2^3+\cdots+n^3=\left[\dfrac{n(n+1)}{2}\right]^2=(1+2+\cdots+n)^2}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：平方和〔R31 · A6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：数列求和；入口㉒&lt;/span&gt;&lt;/div&gt;" 编号="R32" 类型="中间结果" 条件="无条件" 分区="④ 数列" 坐标="A6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="724" y="5397" width="347" height="157" as="geometry"/></mxCell></UserObject>
<UserObject id="S07" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S07&lt;/span&gt;&lt;br&gt;【原理】两个计数原理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;分类加法：各类方法数相加&lt;br&gt;分步乘法：各步方法数相乘&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P33〔F1〕&lt;/span&gt;&lt;/div&gt;" 编号="S07" 类型="起点" 条件="无条件" 分区="⑤ 计数" 坐标="F1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5214" y="410" width="220" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="P33" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({m\le n}\)（自然数）&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P33&lt;/span&gt;&lt;br&gt;排列数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({A_n^m=n(n-1)\cdots(n-m+1)=\dfrac{n!}{(n-m)!}}\)&lt;/span&gt;（\({0!=1}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P34〔F2〕；入口㉕&lt;/span&gt;&lt;/div&gt;" 编号="P33" 类型="中间结果（有条件）" 条件="〔定义域〕$m\le n$（自然数）" 分区="⑤ 计数" 坐标="F1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5152" y="658" width="343" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="P34" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({0\le m\le n}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P34&lt;/span&gt;&lt;br&gt;★★ 组合数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({C_n^m=\dfrac{A_n^m}{m!}=\dfrac{n!}{m!(n-m)!}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P35〔E2〕、R33〔F2〕、P36〔F2〕；入口㉕&lt;/span&gt;&lt;/div&gt;" 编号="P34" 类型="结论（有条件）" 条件="〔定义域〕$0\le m\le n$" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5137" y="922" width="374" height="156" as="geometry"/></mxCell></UserObject>
<UserObject id="P35" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({1\le m\le n}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P35&lt;/span&gt;&lt;br&gt;组合数性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({C_n^m=C_n^{n-m}}\)&lt;br&gt;\({C_{n+1}^m=C_n^m+C_n^{m-1}}\)（杨辉三角的递推）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：组合数化简、证明；入口㉕&lt;/span&gt;&lt;/div&gt;" 编号="P35" 类型="中间结果（有条件）" 条件="〔定义域〕$1\le m\le n$" 分区="⑤ 计数" 坐标="E2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4762" y="1210" width="277" height="176" as="geometry"/></mxCell></UserObject>
<UserObject id="R33" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R33&lt;/span&gt;&lt;br&gt;★★★ 二项式定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(a+b)^n=\displaystyle\sum_{k=0}^{n}C_n^k a^{n-k}b^k}\)&lt;/span&gt;（\({n}\) 为正整数）&lt;br&gt;通项 \({T_{k+1}=C_n^k a^{n-k}b^k}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P26（伯努利不等式）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：区分二项式系数〔R34 · F2〕与项的系数〔R39 · F2〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R34〔F2〕、R05〔A2〕、R35〔E6〕、R39〔F2〕；入口㉓&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：多项式乘法逐项展开〔R01 · B1〕&lt;/span&gt;&lt;/div&gt;" 编号="R33" 类型="结论" 条件="无条件" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5097" y="1204" width="453" height="208" as="geometry"/></mxCell></UserObject>
<UserObject id="R34" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R34&lt;/span&gt;&lt;br&gt;二项式系数性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({C_n^0+C_n^1+\cdots+C_n^n=2^n}\)&lt;br&gt;奇数项系数和 = 偶数项系数和 \({=2^{n-1}}\)&lt;br&gt;注意：二项式系数 \({C_n^k}\) 不等于项的系数〔R39〕&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口㉔&lt;/span&gt;&lt;/div&gt;" 编号="R34" 类型="中间结果" 条件="无条件" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4915" y="1506" width="312" height="160" as="geometry"/></mxCell></UserObject>
<UserObject id="R39" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R39&lt;/span&gt;&lt;br&gt;★ 展开式的各项系数和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({f(x)=a_0+a_1x+\cdots+a_nx^n}\)：\({a_0+a_1+\cdots+a_n=f(1)}\)，\({a_0-a_1+a_2-\cdots=f(-1)}\)&lt;br&gt;偶次项系数和 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({=\dfrac{f(1)+f(-1)}{2}}\)&lt;/span&gt;，奇次项 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({=\dfrac{f(1)-f(-1)}{2}}\)&lt;/span&gt;，常数项 \({a_0=f(0)}\)&lt;br&gt;例 \({(2x-1)^5}\)：各项系数和 \({=1}\)，二项式系数和 \({=2^5=32}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口㉔&lt;/span&gt;&lt;/div&gt;" 编号="R39" 类型="结论" 条件="无条件" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5285" y="1505" width="584" height="162" as="geometry"/></mxCell></UserObject>
<UserObject id="P36" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({1\le k\le n}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P36&lt;/span&gt;&lt;br&gt;组合数的提取&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({kC_n^k=nC_{n-1}^{k-1}}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：组合数求和；入口㉕&lt;/span&gt;&lt;/div&gt;" 编号="P36" 类型="中间结果（有条件）" 条件="〔定义域〕$1\le k\le n$" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5609" y="1231" width="220" height="134" as="geometry"/></mxCell></UserObject>
<UserObject id="S08" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S08&lt;/span&gt;&lt;br&gt;【定义】导数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f'(x_0)=\displaystyle\lim_{\Delta x\to 0}\dfrac{f(x_0+\Delta x)-f(x_0)}{\Delta x}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：R35〔E6〕、P37〔F6〕、P38〔F6〕&lt;/span&gt;&lt;/div&gt;" 编号="S08" 类型="起点" 条件="无条件" 分区="⑥ 导数" 坐标="F6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5221" y="4982" width="320" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="S12" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S12&lt;/span&gt;&lt;br&gt;【课本给出】导数表与链式法则&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({C'=0}\)；\({(\sin x)'=\cos x}\)，\({(\cos x)'=-\sin x}\)；\({(e^x)'=e^x}\)（\({x\in\mathbb{R}}\)）&lt;br&gt;\({(x^\alpha)'=\alpha x^{\alpha-1}}\)（\({\alpha}\) 为任意实数时取 \({x&amp;gt;0}\)；\({\alpha}\) 为正整数时 \({x\in\mathbb{R}}\)）&lt;br&gt;\({(a^x)'=a^x\ln a}\)（\({a&amp;gt;0}\)，\({x\in\mathbb{R}}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\log_a x)'=\dfrac{1}{x\ln a}}\)&lt;/span&gt;（\({a&amp;gt;0,\ a\ne 1,\ x&amp;gt;0}\)）；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln x)'=\dfrac{1}{x}}\)&lt;/span&gt;（\({x&amp;gt;0}\)）&lt;br&gt;有定义不等于可导：\({\sqrt{x}}\) 在 \({x=0}\) 有定义，但没有有限导数&lt;br&gt;链式法则：\({g}\) 在 \({x}\) 处可导、\({f}\) 在 \({u=g(x)}\) 处可导 \({\Rightarrow y'_x=f'(u)\cdot g'(x)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;课本直接给出（链式法则课本写“可以证明”）；下面的 R35、P39、P40 只说明由来&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P39〔G6〕、P55〔G6〕；入口㉖&lt;/span&gt;&lt;/div&gt;" 编号="S12" 类型="起点" 条件="无条件" 分区="⑥ 导数" 坐标="G6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6469" y="4918" width="548" height="250" as="geometry"/></mxCell></UserObject>
<UserObject id="S13" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S13&lt;/span&gt;&lt;br&gt;【初中定理】圆周角定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;同弧所对的圆周角相等；直径所对的圆周角是直角&lt;br&gt;圆内接四边形对角互补（课本承认）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P21〔M2〕&lt;/span&gt;&lt;/div&gt;" 编号="S13" 类型="起点" 条件="无条件" 分区="③ 三角" 坐标="M2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="11295" y="1198" width="340" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="R35" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R35&lt;/span&gt;&lt;br&gt;正整数幂求导的由来&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(x^n)'=nx^{n-1}}\)（\({n}\) 为正整数，\({x\in\mathbb{R}}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：多项式函数求导&lt;/span&gt;&lt;/div&gt;" 编号="R35" 类型="中间结果" 条件="无条件" 分区="⑥ 导数" 坐标="E6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4762" y="5393" width="262" height="97" as="geometry"/></mxCell></UserObject>
<UserObject id="P37" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({u,v}\) 在该点可导&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P37&lt;/span&gt;&lt;br&gt;★★ 和、差、积的求导法则&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(u\pm v)'=u'\pm v'}\)&lt;br&gt;\({(uv)'=u'v+uv'}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({u=|x|}\)，\({v=-|x|}\)，\({x=0}\)：\({(u+v)'=0}\)，右边 \({u'}\)、\({v'}\) 不存在&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P38〔F6〕；切线、单调性、极值；入口㉖&lt;/span&gt;&lt;/div&gt;" 编号="P37" 类型="结论（有条件）" 条件="〔定义域〕$u,v$ 在该点可导" 分区="⑥ 导数" 坐标="F6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5149" y="5350" width="465" height="182" as="geometry"/></mxCell></UserObject>
<UserObject id="P38" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({u,v}\) 可导，\({v(x)\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P38&lt;/span&gt;&lt;br&gt;★ 商的求导法则&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{u}{v}\right)'=\dfrac{u'v-uv'}{v^2}}\)&lt;/span&gt;（同时得出 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{u}{v}}\)&lt;/span&gt; 可导）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({v(x)=0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{u}{v}}\)&lt;/span&gt; 在该点无定义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：不等式大厦 P05（构造函数判单调）；切线、单调性、极值；入口㉖&lt;/span&gt;&lt;/div&gt;" 编号="P38" 类型="结论（有条件）" 条件="〔定义域〕$u,v$ 可导，$v(x)\ne 0$" 分区="⑥ 导数" 坐标="F6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5527" y="5687" width="509" height="196" as="geometry"/></mxCell></UserObject>
<UserObject id="P39" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({x&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P39&lt;/span&gt;&lt;br&gt;\({(\ln x)'}\) 的由来&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln x)'=\dfrac{1}{x}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：P40〔G6〕&lt;/span&gt;&lt;/div&gt;" 编号="P39" 类型="中间结果（有条件）" 条件="〔定义域〕$x&gt;0$" 分区="⑥ 导数" 坐标="G6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6251" y="5365" width="220" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="P40" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a&amp;gt;0,\ a\ne 1}\)；对数式 \({x&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P40&lt;/span&gt;&lt;br&gt;一般指数、对数求导的由来&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a^x)'=a^x\ln a}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\log_a x)'=\dfrac{1}{x\ln a}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：一般指数、对数函数求导；入口㉖&lt;/span&gt;&lt;/div&gt;" 编号="P40" 类型="中间结果（有条件）" 条件="〔定义域〕$a&gt;0,\ a\ne 1$；对数式 $x&gt;0$" 分区="⑥ 导数" 坐标="G6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6210" y="5709" width="303" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="P55" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕各式括号内&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P55&lt;/span&gt;&lt;br&gt;★ 常用导数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{1}{x}\right)'=-\dfrac{1}{x^2}}\)&lt;/span&gt;（\({x\ne 0}\)）；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\sqrt{x})'=\dfrac{1}{2\sqrt{x}}}\)&lt;/span&gt;（\({x&amp;gt;0}\)）&lt;br&gt;\({(e^{ax+b})'=ae^{ax+b}}\)；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({[\ln(ax+b)]'=\dfrac{a}{ax+b}}\)&lt;/span&gt;（\({ax+b&amp;gt;0}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({(\sqrt{x})'}\) 在 \({x=0}\) 处不存在&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#00695C;font-weight:normal;&quot;&gt;⇒ 用于：入口㉖&lt;/span&gt;&lt;/div&gt;" 编号="P55" 类型="结论（有条件）" 条件="〔定义域〕各式括号内" 分区="⑥ 导数" 坐标="G6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6529" y="5321" width="428" height="240" as="geometry"/></mxCell></UserObject>
