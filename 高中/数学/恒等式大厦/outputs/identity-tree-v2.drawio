<UserObject id="e46" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕〔符号分支〕：\({a,b}\) 不全为 0；\({\varphi}\) 看 \({a,b}\) 正负&lt;/span&gt;&lt;br&gt;【提取】提出 \({r=\sqrt{a^2+b^2}}\)，倒用 sin 和角公式" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="R17" target="P17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8767" y="1772"/></Array><mxPoint x="196" y="45" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e52" label="【面积法】三式相等，同除 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}abc}\)&lt;/span&gt;&lt;br&gt;\({=2R}\)：作直径 \({BD}\)，\({\angle BDC}\) 与 \({A}\) 相等或互补，\({a=2R\sin A}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="P20" target="P21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="11010" y="1400"/></Array><mxPoint x="186" y="19" as="offset"/></mxGeometry></mxCell></UserObject>
