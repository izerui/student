<UserObject id="e34" label="【数量积】\({\overrightarrow{OA}=(\cos\alpha,\sin\alpha)}\)，\({\overrightarrow{OB}=(\cos\beta,\sin\beta)}\)&lt;br&gt;按坐标 \({=\cos\alpha\cos\beta+\sin\alpha\sin\beta}\)；按定义 \({=\cos\theta}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="R15" target="R16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8593" y="971"/><mxPoint x="8599" y="1142"/></Array><mxPoint x="154" y="-16" as="offset"/></mxGeometry></mxCell></UserObject>
