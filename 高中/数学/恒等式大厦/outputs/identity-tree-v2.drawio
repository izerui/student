<UserObject id="e108" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({a\ne 0,\ b\ne 0}\)&lt;/span&gt;&lt;br&gt;【代入】零指数、负指数的定义" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;" edge="1" parent="1" source="R12" target="P41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5615" y="2714"/></Array><mxPoint x="108" y="6" as="offset"/></mxGeometry></mxCell></UserObject>
