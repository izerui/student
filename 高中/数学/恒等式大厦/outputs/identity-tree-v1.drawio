<mxCell id="bg83" value="恒等式大厦" style="text;html=1;fontFamily=PingFang SC;fontSize=40;fontStyle=1;fontColor=#263238;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2200" y="-120" width="1900" height="60" as="geometry"/></mxCell>
<mxCell id="bg84" value="从 12 个起点（运算律、指数与对数、单位圆、数量积、复数、计数原理、数列、导数等）出发，不跳步推出高中全部恒等式&lt;br&gt;主干：源头 → 变形 → 结论；变形手法写在线上【方法】里。橙色 = 要加条件：〔定义域〕〔结构前提〕〔符号分支〕三类，各自独立" style="text;html=1;fontFamily=PingFang SC;fontSize=16;fontColor=#455A64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2200" y="-50" width="1900" height="80" as="geometry"/></mxCell>
<mxCell id="bg85" value="&lt;b style=&quot;font-size:20px&quot;&gt;图例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2200" y="60" width="1900" height="766" as="geometry"/></mxCell>
<mxCell id="bg86" value="【定义】【公理】【原理】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="116" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg87" value="紫色：起点，直接承认（定义、公理、课本给出）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="116" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg88" value="★ 结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="186" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg89" value="绿色：对所有取值都成立的恒等式，不需要任何条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="186" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg90" value="中间结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="256" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg91" value="白底：推导中的一步，不需要条件" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="256" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg92" value="★ 结论（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="326" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg93" value="橙色：要加条件才成立；标题上方橙色标签写明条件类别和内容" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="326" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg94" value="中间结果（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="bg"><mxGeometry x="-2170" y="396" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="bg95" value="淡橙：有条件的中间一步" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1830" y="396" width="1500" height="54" as="geometry"/></mxCell>
<mxCell id="bg96" value="连线：深色实线 = 推导，越粗越是主干；线上写【方法】和关键一步" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="466" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg97" value="浅灰线 = 前提：引用别处已推出的结论，线上写【前提】；远处的前提写进节点“⇐ 前提”" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="522" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg98" value="▼ 加条件：从这一步起要带上条件，后面的结论都带着它；“★ 跨树”= 跨分区的推导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="578" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg99" value="✗ = 去掉条件的反例；“⋯ 同源 / 互逆”写在节点里，不画成推导线" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="634" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg100" value="〔编号 · 坐标〕：S 起点、R 不加条件、P 加条件；按图边字母（列）和数字（行）找格子" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="690" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg101" value="★ 越多越重要；灰色“拓展”可先跳过；“同见不等式大厦 / 二次函数大厦 编号”= 两张图重合的结论" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2170" y="746" width="1840" height="50" as="geometry"/></mxCell>
<mxCell id="bg102" value="&lt;b style=&quot;font-size:20px&quot;&gt;三类条件（各自独立，互不包含、互不推出）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2200" y="876" width="1900" height="482" as="geometry"/></mxCell>
<mxCell id="bg103" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔定义域〕不满足时某一边没有意义&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="932" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg104" value="▸ 分式：分母 \({\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="978" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg105" value="▸ 对数：真数 \({&amp;gt;0}\)，底数 \({&amp;gt;0}\) 且 \({\ne 1}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="978" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg106" value="▸ 正切：\({\cos\alpha\ne 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="978" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg107" value="▸ 下标与组合数：\({n\ge 2}\)、\({0\le k\le n}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1012" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg108" value="▸ 根式：被开方数 \({\ge 0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1012" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg109" value="▸ 分数指数幂：底数 \({&amp;gt;0}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1012" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg110" value="▸ 求导：函数在该点可导" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1046" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg111" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔结构前提〕两边都有意义，但只对某种结构成立&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1090" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg112" value="▸ 等差数列" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1136" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg113" value="▸ 等比数列" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1136" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg114" value="▸ 方程有两根（\({\Delta\ge 0}\)）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1136" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg115" value="▸ 同一三角形的边与对角" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1170" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg116" value="&lt;b style=&quot;color:#E65100;&quot;&gt;〔符号分支〕两边都有意义，但符号或角要按范围选定&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontSize=15;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1214" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="bg117" value="▸ 半角 ±" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-2150" y="1260" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg118" value="▸ 辅助角 \({\varphi}\)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-1550" y="1260" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg119" value="▸ 复数辐角" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;" vertex="1" parent="bg"><mxGeometry x="-950" y="1260" width="590" height="30" as="geometry"/></mxCell>
<mxCell id="bg120" value="反例：〔定义域〕说明哪一边没有意义；〔结构前提〕〔符号分支〕给“两边有意义但不相等”的数值" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;whiteSpace=wrap;fontSize=14;fontColor=#37474F;fontColor=#B71C1C;" vertex="1" parent="bg"><mxGeometry x="-2170" y="1304" width="1840" height="30" as="geometry"/></mxCell>
<mxCell id="bg121" value="&lt;b style=&quot;font-size:20px&quot;&gt;公式与工具箱：不画线，按编号查&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#0D47A1;align=left;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1408" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="bg122" value="&lt;b&gt;T1 特殊角三角函数值&lt;/b&gt;&lt;br&gt;\({\alpha}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{6}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{4}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{3}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{2}}\)&lt;/span&gt;&lt;br&gt;\({\sin}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{2}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，\({1}\)&lt;br&gt;\({\cos}\)：\({1}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{2}}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{2}}\)&lt;/span&gt;，\({0}\)&lt;br&gt;\({\tan}\)：\({0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{3}}{3}}\)&lt;/span&gt;，\({1}\)，\({\sqrt{3}}\)，不存在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1458" width="935" height="220" as="geometry"/></mxCell>
<mxCell id="bg123" value="&lt;b&gt;T2 杨辉三角 n=0～6&lt;/b&gt;&lt;br&gt;1 ｜ 1 1 ｜ 1 2 1 ｜ 1 3 3 1&lt;br&gt;1 4 6 4 1 ｜ 1 5 10 10 5 1&lt;br&gt;1 6 15 20 15 6 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="1458" width="935" height="220" as="geometry"/></mxCell>
<mxCell id="bg124" value="&lt;b&gt;T3 常用对数&lt;/b&gt;&lt;br&gt;\({\lg 2\approx 0.3010}\)，\({\lg 3\approx 0.4771}\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1702" width="935" height="104" as="geometry"/></mxCell>
<mxCell id="bg125" value="&lt;b&gt;T4 诱导公式口诀&lt;/b&gt;&lt;br&gt;“奇变偶不变，符号看象限”&lt;br&gt;把 \({\alpha}\) 看作锐角定符号；记忆口诀，不是条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="bg"><mxGeometry x="-1235" y="1702" width="935" height="104" as="geometry"/></mxCell>
<mxCell id="bg126" value="&lt;b style=&quot;font-size:20px&quot;&gt;题型入口：看到什么 → 反推到哪 → 先查什么 → 去这里查&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#00695C;align=left;" vertex="1" parent="bg"><mxGeometry x="-2200" y="1870" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="bg127" value="&lt;b&gt;看到 \({a^2-b^2}\)、\({a^3\pm b^3}\)、平方和&lt;/b&gt;&lt;br&gt;反推：因式分解或互换式&lt;br&gt;先查：先看能否倒用乘法公式&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 平方差 &lt;b&gt;〔R02 · A2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 立方和（差） &lt;b&gt;〔R06 · B2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 互换式 &lt;b&gt;〔R07 · B3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 因式分解 &lt;b&gt;〔R08 · C2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="1920" width="613" height="192" as="geometry"/></mxCell>
<mxCell id="bg128" value="&lt;b&gt;看到 已知 \({a+b}\)、\({ab}\) 求 \({a^2+b^2}\)、\({a^3+b^3}\)&lt;/b&gt;&lt;br&gt;反推：互换式&lt;br&gt;先查：若 \({a,b}\) 是方程的根，先用韦达&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 互换式 &lt;b&gt;〔R07 · B3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P03 · A3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="1920" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg129" value="&lt;b&gt;看到 指数、对数式化简求值&lt;/b&gt;&lt;br&gt;反推：统一底数（换底）&lt;br&gt;先查：先看真数 \({&amp;gt;0}\)、底数 \({&amp;gt;0}\) 且 \({\ne 1}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 换底公式 &lt;b&gt;〔P08 · F5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对数运算律 &lt;b&gt;〔P07 · F5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对数恒等式 &lt;b&gt;〔P06 · G4〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="1920" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg130" value="&lt;b&gt;看到 三角式：角不同、名不同、次数高&lt;/b&gt;&lt;br&gt;反推：拆角配角用和差角；切化弦；降幂&lt;br&gt;先查：有 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\pi}{2}\pm\alpha}\)&lt;/span&gt;、\({\pi\pm\alpha}\) 先用诱导公式&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 其余和差角 &lt;b&gt;〔R17 · M3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 商数关系 &lt;b&gt;〔P11 · K2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 降幂 &lt;b&gt;〔R19 · L4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 诱导公式（sin、cos 对任意实数 \({\alpha}\) 成立） &lt;b&gt;〔R14 · L2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2098" width="613" height="205" as="geometry"/></mxCell>
<mxCell id="bg131" value="&lt;b&gt;看到 求三角函数最值、周期&lt;/b&gt;&lt;br&gt;反推：化成 \({A\sin(\omega x+\varphi)+k}\)&lt;br&gt;先查：定 \({\varphi}\) 时看 \({a,b}\) 的正负&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 降幂 &lt;b&gt;〔R19 · L4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 倍角 &lt;b&gt;〔R18 · M3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 辅助角 &lt;b&gt;〔P17 · M3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="2117" width="613" height="173" as="geometry"/></mxCell>
<mxCell id="bg132" value="&lt;b&gt;看到 解三角形：边角混在一起&lt;/b&gt;&lt;br&gt;反推：两边夹角或三边：余弦定理；两角一边：正弦定理&lt;br&gt;先查：求面积用 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{1}{2}ab\sin C}\)&lt;/span&gt;；用内角和化简&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 余弦定理 &lt;b&gt;〔P22 · N2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 正弦定理 &lt;b&gt;〔P21 · L3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形面积 &lt;b&gt;〔P20 · L2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形内角关系 &lt;b&gt;〔P19 · M2〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="2136" width="613" height="205" as="geometry"/></mxCell>
<mxCell id="bg133" value="&lt;b&gt;看到 数列求和&lt;/b&gt;&lt;br&gt;反推：等差、等比用公式；等差×等比错位相减；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{1}{k(k+1)}}\)&lt;/span&gt; 裂项&lt;br&gt;先查：等比先看 \({q}\) 是否为 1；已知 \({S_n}\) 求 \({a_n}\) 时 \({n=1}\) 单独算&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等差求和 &lt;b&gt;〔P28 · B6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等比求和 &lt;b&gt;〔P31 · C6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 裂项 &lt;b&gt;〔R30 · A5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({a_n}\) 与 \({S_n}\) &lt;b&gt;〔P32 · C5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-914" y="2314" width="613" height="221" as="geometry"/></mxCell>
<mxCell id="bg134" value="&lt;b&gt;看到 展开式求某项系数、系数和&lt;/b&gt;&lt;br&gt;反推：通项 \({T_{k+1}}\)；系数和用赋值&lt;br&gt;先查：注意 \({T_{k+1}}\) 是第 \({k+1}\) 项&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二项式定理 &lt;b&gt;〔R33 · F2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二项式系数性质 &lt;b&gt;〔R34 · F3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2327" width="613" height="154" as="geometry"/></mxCell>
<mxCell id="bg135" value="&lt;b&gt;看到 复数计算、高次幂&lt;/b&gt;&lt;br&gt;反推：除法分母实数化；高次幂用周期或棣莫弗&lt;br&gt;先查：化三角形式时按 \({a,b}\) 正负定辐角&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 复数除法 &lt;b&gt;〔P23 · J7〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({i^n}\) 以 4 为周期 &lt;b&gt;〔R24 · K6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 棣莫弗公式 &lt;b&gt;〔R27 · M7〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角形式 &lt;b&gt;〔P24 · L6〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2200" y="2365" width="613" height="192" as="geometry"/></mxCell>
<mxCell id="bg136" value="&lt;b&gt;看到 求导&lt;/b&gt;&lt;br&gt;反推：识别积、商、复合结构&lt;br&gt;先查：先确认各部分可导，商还要分母 \({\ne 0}\)；底数不是 \({e}\) 时换到 \({e}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 和、差、积的求导法则 &lt;b&gt;〔P37 · G7〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 商的求导法则 &lt;b&gt;〔P38 · G8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【课本给出】导数表与链式法则 &lt;b&gt;〔S12 · H7〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 一般指数、对数求导的由来 &lt;b&gt;〔P40 · H8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1557" y="2505" width="613" height="208" as="geometry"/></mxCell>
<mxCell id="bg137" value="&lt;b style='font-size:20px'&gt;方法索引：按方法复习，到〔坐标〕找推导线&lt;/b&gt;&lt;br&gt;正推（由因导果）= 综合法：沿箭头往下读；反推（执果索因）= 分析法：从题型入口往回查&lt;br&gt;&lt;b&gt;展开&lt;/b&gt;（15 处）：用分配律把乘积逐项乘开　R01〔B2〕、R02〔A2〕、R03〔A2〕、R04〔C2〕、R05〔B2〕、R06〔B2〕、P04〔A4〕、R09〔C2〕、R10〔D2〕、R11〔E2〕、R15〔N2〕、R22〔K6〕、R23〔K6〕、R26〔L6〕、R35〔F7〕&lt;br&gt;&lt;b&gt;代换&lt;/b&gt;（10 处）：把某个量换成另一个式子（如 \({b\to -b}\)）　R03〔A2〕、R05〔B2〕、R06〔B2〕、P07〔F5〕、P08〔F5〕、R17〔M3〕、P16〔L4〕、R21〔O4〕、P19〔M2〕、P40〔H8〕&lt;br&gt;&lt;b&gt;代入&lt;/b&gt;（9 处）：把已知式代进去　P03〔A3〕、P06〔G4〕、P09〔F6〕、R13〔K2〕、R24〔K6〕、R25〔K7〕、P27〔B6〕、P30〔B6〕、P36〔G2〕&lt;br&gt;&lt;b&gt;分步计数&lt;/b&gt;（3 处）：分步乘法原理　P33〔F2〕、P34〔F2〕、R33〔F2〕&lt;br&gt;&lt;b&gt;特例&lt;/b&gt;（3 处）：取特殊值得到特殊情形　R18〔M3〕、P15〔N4〕、R29〔B6〕&lt;br&gt;&lt;b&gt;同除&lt;/b&gt;（2 处）：两边同除一个非零式　P12〔J2〕、P18〔M4〕&lt;br&gt;&lt;b&gt;向量&lt;/b&gt;（2 处）：用向量运算推几何关系　R16〔M2〕、P22〔N2〕&lt;br&gt;&lt;b&gt;定义&lt;/b&gt;（2 处）：直接用定义　P11〔K2〕、P20〔L2〕&lt;br&gt;&lt;b&gt;归纳法&lt;/b&gt;（2 处）：数学归纳法　R27〔M7〕、R32〔B7〕&lt;br&gt;&lt;b&gt;相除&lt;/b&gt;（2 处）：两式相除（如切化弦）　P13〔L2〕、P14〔N3〕&lt;br&gt;&lt;b&gt;移项&lt;/b&gt;（2 处）：等式两边同加减　R07〔B3〕、R19〔L4〕&lt;br&gt;&lt;b&gt;逆运算&lt;/b&gt;（2 处）：利用互逆运算互化　P10〔G5〕、P25〔L7〕&lt;br&gt;&lt;b&gt;通分&lt;/b&gt;（2 处）：化成同分母　R30〔A5〕、P38〔G8〕&lt;br&gt;&lt;b&gt;配凑&lt;/b&gt;（2 处）：加一项减一项　P37〔G7〕、P38〔G8〕&lt;br&gt;&lt;b&gt;作差&lt;/b&gt;（1 处）：两式相减　P32〔C5〕&lt;br&gt;&lt;b&gt;倒序相加&lt;/b&gt;（1 处）：正写倒写相加　P28〔B6〕&lt;br&gt;&lt;b&gt;分母实数化&lt;/b&gt;（1 处）：乘共轭使分母为实数　P23〔J7〕&lt;br&gt;&lt;b&gt;分类计数&lt;/b&gt;（1 处）：分类加法原理　P35〔F2〕&lt;br&gt;&lt;b&gt;双计数&lt;/b&gt;（1 处）：同一件事两种数法　P36〔G2〕&lt;br&gt;&lt;b&gt;对应&lt;/b&gt;（1 处）：一一对应计数　P35〔F2〕&lt;br&gt;&lt;b&gt;对称&lt;/b&gt;（1 处）：终边对称点的坐标关系　R14〔L2〕&lt;br&gt;&lt;b&gt;开平方&lt;/b&gt;（1 处）：两边开平方　P02〔A3〕&lt;br&gt;&lt;b&gt;按定义&lt;/b&gt;（1 处）：回到定义计算　R35〔F7〕&lt;br&gt;&lt;b&gt;推广&lt;/b&gt;（1 处）：由特殊范围推到一般范围　P05〔F4〕&lt;br&gt;&lt;b&gt;提取&lt;/b&gt;（1 处）：提出公因式　P17〔M3〕&lt;br&gt;&lt;b&gt;数个数&lt;/b&gt;（1 处）：数因数的个数　R12〔F4〕&lt;br&gt;&lt;b&gt;数形结合（单位圆）&lt;/b&gt;（1 处）　P24〔L6〕&lt;br&gt;&lt;b&gt;相加减&lt;/b&gt;（1 处）：两式相加或相减　R20〔O3〕&lt;br&gt;&lt;b&gt;累乘&lt;/b&gt;（1 处）：逐项相乘　P29〔C5〕&lt;br&gt;&lt;b&gt;累加&lt;/b&gt;（1 处）：逐项相加　P26〔B5〕&lt;br&gt;&lt;b&gt;累加相消&lt;/b&gt;（1 处）：相邻项抵消　R31〔A7〕&lt;br&gt;&lt;b&gt;结合律&lt;/b&gt;（1 处）：重新加括号　R28〔A5〕&lt;br&gt;&lt;b&gt;赋值&lt;/b&gt;（1 处）：给字母赋特殊值　R34〔F3〕&lt;br&gt;&lt;b&gt;逆用&lt;/b&gt;（1 处）：把公式从右往左读　R08〔C2〕&lt;br&gt;&lt;b&gt;配方&lt;/b&gt;（1 处）：配成完全平方　P01〔A2〕&lt;br&gt;&lt;b&gt;链式法则&lt;/b&gt;（1 处）：复合函数求导　P39〔H7〕&lt;br&gt;&lt;b&gt;错位相减&lt;/b&gt;（1 处）：乘公比后相减　P31〔C6〕&lt;br&gt;&lt;b&gt;面积法&lt;/b&gt;（1 处）：同一面积的不同算法　P21〔L3〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#8D6E63;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#3E2723;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fontSize=13;" vertex="1" parent="bg"><mxGeometry x="-2200" y="2777" width="1900" height="1054" as="geometry"/></mxCell>
<UserObject id="e66" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【和角】实部 \({\cos(\theta_1+\theta_2)}\)，虚部 \({\sin(\theta_1+\theta_2)}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R17" target="R26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="9682" y="1497"/><mxPoint x="9682" y="3990"/></Array><mxPoint x="0" y="-762" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e70" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【结合律】相邻项抵消" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S01" target="R28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-4" y="491"/><mxPoint x="-4" y="3010"/></Array><mxPoint x="0" y="-64" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e82" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【累加相消】\({(k+1)^3-k^3=3k^2+3k+1}\)，\({k}\) 从 1 加到 \({n}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(n+1)^3-1=3\sum k^2+\dfrac{3n(n+1)}{2}+n}\)&lt;/span&gt;，解出 \({\sum k^2}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R05" target="R31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-20" y="1358"/><mxPoint x="-20" y="4401"/></Array><mxPoint x="0" y="535" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e96" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【二项式展开】\({(x+\Delta x)^n}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R33" target="R35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3302" y="1217"/><mxPoint x="3302" y="4751"/></Array><mxPoint x="0" y="-186" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e100" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【链式法则】对 \({\ln(e^x)=x}\) 两边求导：\({(\ln)'(e^x)\cdot e^x=1}\)&lt;br&gt;令 \({u=e^x}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln u)'=\dfrac{1}{u}}\)&lt;/span&gt;，\({u}\) 取遍 \({(0,+\infty)}\)" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#263238;strokeWidth=4;fontStyle=1;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P10" target="P39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5683" y="3034"/><mxPoint x="5683" y="4751"/></Array><mxPoint x="0" y="156" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e102" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【代换】\({a^x=e^{x\ln a}}\)，用链式法则" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P05" target="P40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5699" y="2723"/><mxPoint x="5699" y="5055"/></Array><mxPoint x="0" y="887" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e103" label="&lt;span style=&quot;color:#6A1B9A;font-weight:bold;&quot;&gt;★ 跨树&lt;/span&gt;&lt;br&gt;【代换】换底：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a x=\dfrac{\ln x}{\ln a}}\)&lt;/span&gt;" 类型="推导"><mxCell style="html=1;rounded=1;curved=0;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="P08" target="P40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5715" y="3338"/><mxPoint x="5715" y="5055"/></Array><mxPoint x="0" y="476" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="S01" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S01&lt;/span&gt;&lt;br&gt;【公理】运算律与等式性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;交换律、结合律；分配律 \({a(b+c)=ab+ac}\)&lt;br&gt;等式两边同加、同乘一个数仍相等；同除一个非零数仍相等&lt;br&gt;减 \({b}\) 即加 \({-b}\)；除以 \({b}\)（\({b\ne 0}\)）即乘 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{b}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;起点：实数运算的基本规定，所有恒等式的地基&lt;/span&gt;&lt;/div&gt;" 编号="S01" 类型="起点" 条件="无条件" 分区="① 代数" 坐标="B1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="713" y="410" width="394" height="162" as="geometry"/></mxCell></UserObject>
<UserObject id="R01" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R01&lt;/span&gt;&lt;br&gt;★★★ 多项式乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+b)(c+d)=ac+ad+bc+bd}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;枢纽：本图所有“展开”都从这里出发&lt;/span&gt;&lt;/div&gt;" 编号="R01" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="B2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="777" y="685" width="267" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="R02" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R02&lt;/span&gt;&lt;br&gt;★ 平方差&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^2-b^2=(a+b)(a-b)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P03、P25&lt;/span&gt;&lt;/div&gt;" 编号="R02" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="A2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="940" width="220" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="R03" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R03&lt;/span&gt;&lt;br&gt;★★ 完全平方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a\pm b)^2=a^2\pm 2ab+b^2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R37、R49&lt;/span&gt;&lt;/div&gt;" 编号="R03" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="A2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="528" y="940" width="220" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="R04" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R04&lt;/span&gt;&lt;br&gt;三数和的平方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+b+c)^2=a^2+b^2+c^2+2ab+2bc+2ca}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R64&lt;/span&gt;&lt;/div&gt;" 编号="R04" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="C2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1303" y="1106" width="317" height="118" as="geometry"/></mxCell></UserObject>
<UserObject id="R05" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R05&lt;/span&gt;&lt;br&gt;★ 两数和（差）的立方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a\pm b)^3=a^3\pm 3a^2b+3ab^2\pm b^3}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：【特例】\({n=3}\)（另一路）〔R33 · F2〕&lt;/span&gt;&lt;/div&gt;" 编号="R05" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="B2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="856" y="1319" width="274" height="98" as="geometry"/></mxCell></UserObject>
<UserObject id="R06" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R06&lt;/span&gt;&lt;br&gt;★ 立方和（差）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^3\pm b^3=(a\pm b)(a^2\mp ab+b^2)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P27、R25&lt;/span&gt;&lt;/div&gt;" 编号="R06" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="B2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="979" y="940" width="259" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="R07" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R07&lt;/span&gt;&lt;br&gt;★ 互换式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^2+b^2=(a+b)^2-2ab}\)&lt;br&gt;\({(a-b)^2=(a+b)^2-4ab}\)&lt;br&gt;\({a^3+b^3=(a+b)^3-3ab(a+b)}\)&lt;br&gt;\({a^2+b^2+c^2=(a+b+c)^2-2(ab+bc+ca)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R60、R52&lt;/span&gt;&lt;/div&gt;" 编号="R07" 类型="结论" 条件="无条件" 分区="① 代数" 坐标="B3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1610" width="332" height="166" as="geometry"/></mxCell></UserObject>
<UserObject id="R08" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R08&lt;/span&gt;&lt;br&gt;因式分解&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;提公因式：分配律倒用&lt;br&gt;公式法：平方差、完全平方、立方和（差）倒用&lt;br&gt;十字相乘：\({acx^2+(ad+bc)x+bd=(ax+b)(cx+d)}\)&lt;br&gt;分组分解&lt;/div&gt;" 编号="R08" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="C2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1296" y="910" width="363" height="160" as="geometry"/></mxCell></UserObject>
<UserObject id="P01" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P01&lt;/span&gt;&lt;br&gt;★★ 配方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({ax^2+bx+c=a\left(x+\dfrac{b}{2a}\right)^2+\dfrac{4ac-b^2}{4a}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{b}{2a}}\)&lt;/span&gt; 无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R17；同见二次函数大厦 R01&lt;/span&gt;&lt;/div&gt;" 编号="P01" 类型="结论（有条件）" 条件="〔定义域〕$a\ne 0$" 分区="① 代数" 坐标="A2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="479" y="1260" width="319" height="196" as="geometry"/></mxCell></UserObject>
<UserObject id="P02" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\Delta\ge 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P02&lt;/span&gt;&lt;br&gt;求根公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({ax^2+bx+c=0}\)（\({a\ne 0}\)）的根 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=\dfrac{-b\pm\sqrt{\Delta}}{2a}}\)&lt;/span&gt;，\({\Delta=b^2-4ac}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({\Delta&amp;lt;0}\) 时 \({\sqrt{\Delta}}\) 在实数范围内无意义&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见二次函数大厦 J05&lt;/span&gt;&lt;/div&gt;" 编号="P02" 类型="中间结果（有条件）" 条件="〔定义域〕$\Delta\ge 0$" 分区="① 代数" 坐标="A3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="429" y="1596" width="418" height="194" as="geometry"/></mxCell></UserObject>
<UserObject id="P03" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({x_1,x_2}\) 是方程的两根&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P03&lt;/span&gt;&lt;br&gt;★★ 韦达定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_1+x_2=-\dfrac{b}{a}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_1x_2=\dfrac{c}{a}}\)&lt;/span&gt;（重根算两个）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({x^2-3x+2=0}\) 的根是 1、2；误把 1、3 当两根：\({1+3=4\ne 3}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R52；同见二次函数大厦 J06&lt;/span&gt;&lt;/div&gt;" 编号="P03" 类型="结论（有条件）" 条件="〔结构前提〕$x_1,x_2$ 是方程的两根" 分区="① 代数" 坐标="A3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="402" y="1915" width="472" height="178" as="geometry"/></mxCell></UserObject>
<UserObject id="P04" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({\Delta\ge 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P04&lt;/span&gt;&lt;br&gt;交点式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({ax^2+bx+c=a(x-x_1)(x-x_2)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见二次函数大厦 P01&lt;/span&gt;&lt;/div&gt;" 编号="P04" 类型="中间结果（有条件）" 条件="〔结构前提〕$\Delta\ge 0$" 分区="① 代数" 坐标="A4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="2206" width="236" height="134" as="geometry"/></mxCell></UserObject>
<UserObject id="R09" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R09&lt;/span&gt;&lt;br&gt;\({x^n-y^n}\) 的分解&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({x^n-y^n=(x-y)(x^{n-1}+x^{n-2}y+\cdots+y^{n-1})}\)（\({n}\) 为正整数）&lt;br&gt;\({n=2,3}\) 即平方差、立方差&lt;/div&gt;" 编号="R09" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="C2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1717" y="942" width="403" height="97" as="geometry"/></mxCell></UserObject>
<UserObject id="R10" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R10&lt;/span&gt;&lt;br&gt;三元立方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^3+b^3+c^3-3abc=(a+b+c)(a^2+b^2+c^2-ab-bc-ca)}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({=\dfrac{1}{2}(a+b+c)\left[(a-b)^2+(b-c)^2+(c-a)^2\right]}\)&lt;/span&gt;&lt;br&gt;推论：\({a+b+c=0\Rightarrow a^3+b^3+c^3=3abc}\)&lt;/div&gt;" 编号="R10" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="D2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2178" y="912" width="415" height="157" as="geometry"/></mxCell></UserObject>
<UserObject id="R11" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R11&lt;/span&gt;&lt;br&gt;拉格朗日恒等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a^2+b^2)(c^2+d^2)=(ac+bd)^2+(ad-bc)^2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R66：由 \({(ad-bc)^2\ge 0}\) 得柯西不等式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：模的乘法 \({|z_1z_2|=|z_1||z_2|}\)〔R25 · K7〕&lt;/span&gt;&lt;/div&gt;" 编号="R11" 类型="中间结果" 条件="无条件" 分区="① 代数" 坐标="E2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="2650" y="932" width="366" height="118" as="geometry"/></mxCell></UserObject>
<UserObject id="S02" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S02&lt;/span&gt;&lt;br&gt;【定义】乘方与指数幂&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^n}\)：\({n}\) 个 \({a}\) 相乘（\({n}\) 为正整数）&lt;br&gt;\({a^0=1}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{-n}=\dfrac{1}{a^n}}\)&lt;/span&gt;（\({a\ne 0}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{\frac{m}{n}}=\sqrt[n]{a^m}}\)&lt;/span&gt;（\({a&amp;gt;0}\)；\({m,n}\) 为正整数，\({n&amp;gt;1}\)）&lt;br&gt;无理数指数幂（\({a&amp;gt;0}\)）课本承认&lt;/div&gt;" 编号="S02" 类型="起点" 条件="无条件" 分区="② 指数与对数" 坐标="F4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3693" y="2104" width="327" height="180" as="geometry"/></mxCell></UserObject>
<UserObject id="S03" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S03&lt;/span&gt;&lt;br&gt;【定义】对数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a&amp;gt;0}\)，\({a\ne 1}\)，\({N&amp;gt;0}\) 时：\({a^b=N\iff b=\log_a N}\)&lt;br&gt;\({\lg N=\log_{10}N}\)，\({\ln N=\log_e N}\)&lt;/div&gt;" 编号="S03" 类型="起点" 条件="无条件" 分区="② 指数与对数" 坐标="G4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4257" y="2396" width="358" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="R12" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R12&lt;/span&gt;&lt;br&gt;★ 指数运算律（正整数指数）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^m\cdot a^n=a^{m+n}}\)，\({(a^m)^n=a^{mn}}\)，\({(ab)^n=a^nb^n}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：结合律、交换律重排〔S01 · B1〕&lt;/span&gt;&lt;/div&gt;" 编号="R12" 类型="结论" 条件="无条件" 分区="② 指数与对数" 坐标="F4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3691" y="2408" width="331" height="98" as="geometry"/></mxCell></UserObject>
<UserObject id="P05" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a&amp;gt;0,\ b&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P05&lt;/span&gt;&lt;br&gt;★ 实数指数运算律&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^ra^s=a^{r+s}}\)，\({(a^r)^s=a^{rs}}\)，\({(ab)^r=a^rb^r}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a^r}{a^s}=a^{r-s}}\)&lt;/span&gt;（\({r,s\in\mathbb{R}}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 底数为负：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(-8)^{\frac{2}{6}}=\sqrt[6]{64}=2}\)&lt;/span&gt;，而 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(-8)^{\frac{1}{3}}=-2}\)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" 编号="P05" 类型="结论（有条件）" 条件="〔定义域〕$a&gt;0,\ b&gt;0$" 分区="② 指数与对数" 坐标="F4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3622" y="2636" width="470" height="174" as="geometry"/></mxCell></UserObject>
<UserObject id="P06" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a&amp;gt;0,\ a\ne 1,\ N&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P06&lt;/span&gt;&lt;br&gt;★ 对数恒等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{\log_a N}=N}\)，\({\log_a a^b=b}\)&lt;br&gt;\({\log_a 1=0}\)，\({\log_a a=1}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({N=-2}\) 时 \({\log_a N}\) 无意义&lt;/span&gt;&lt;/div&gt;" 编号="P06" 类型="结论（有条件）" 条件="〔定义域〕$a&gt;0,\ a\ne 1,\ N&gt;0$" 分区="② 指数与对数" 坐标="G4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4303" y="2643" width="266" height="160" as="geometry"/></mxCell></UserObject>
<UserObject id="P07" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({M&amp;gt;0,\ N&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P07&lt;/span&gt;&lt;br&gt;★★ 对数运算律&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\log_a(MN)=\log_a M+\log_a N}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a\dfrac{M}{N}=\log_a M-\log_a N}\)&lt;/span&gt;&lt;br&gt;\({\log_a M^n=n\log_a M}\)（\({n\in\mathbb{R}}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({\log_2[(-2)(-4)]=3}\) 有意义，\({\log_2(-2)}\) 无意义；\({\log_a x^2=2\log_a|x|}\)（\({x\ne 0}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P21、P04&lt;/span&gt;&lt;/div&gt;" 编号="P07" 类型="结论（有条件）" 条件="〔定义域〕$M&gt;0,\ N&gt;0$" 分区="② 指数与对数" 坐标="F5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3556" y="2923" width="602" height="222" as="geometry"/></mxCell></UserObject>
<UserObject id="P08" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a,c&amp;gt;0}\) 且 \({\ne 1}\)，\({b&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P08&lt;/span&gt;&lt;br&gt;★ 换底公式&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_a b=\dfrac{\log_c b}{\log_c a}}\)&lt;/span&gt;&lt;/div&gt;" 编号="P08" 类型="结论（有条件）" 条件="〔定义域〕$a,c&gt;0$ 且 $\ne 1$，$b&gt;0$" 分区="② 指数与对数" 坐标="F5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3703" y="3271" width="308" height="134" as="geometry"/></mxCell></UserObject>
<UserObject id="P09" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕底数 \({&amp;gt;0}\) 且 \({\ne 1}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P09&lt;/span&gt;&lt;br&gt;换底推论&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\log_a b\cdot\log_b a=1}\)（\({a,b&amp;gt;0}\) 且 \({\ne 1}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\log_{a^m}b^n=\dfrac{n}{m}\log_a b}\)&lt;/span&gt;（\({m\ne 0}\)）&lt;/div&gt;" 编号="P09" 类型="中间结果（有条件）" 条件="〔定义域〕底数 $&gt;0$ 且 $\ne 1$" 分区="② 指数与对数" 坐标="F6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3706" y="3517" width="302" height="173" as="geometry"/></mxCell></UserObject>
<UserObject id="P10" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a&amp;gt;0,\ a\ne 1}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P10&lt;/span&gt;&lt;br&gt;★ 指数函数与对数函数互为反函数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({y=a^x}\) 与 \({y=\log_a x}\) 的图像关于 \({y=x}\) 对称&lt;br&gt;\({\log_a(a^x)=x}\)（\({x\in\mathbb{R}}\)），\({a^{\log_a x}=x}\)（\({x&amp;gt;0}\)）&lt;br&gt;特例：\({e^x}\) 与 \({\ln x}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 互逆：指数式 ⟷ 对数式&lt;/span&gt;&lt;/div&gt;" 编号="P10" 类型="结论（有条件）" 条件="〔定义域〕$a&gt;0,\ a\ne 1$" 分区="② 指数与对数" 坐标="G5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4263" y="2943" width="346" height="182" as="geometry"/></mxCell></UserObject>
<UserObject id="S04" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S04&lt;/span&gt;&lt;br&gt;【定义】三角函数（单位圆）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;角 \({\alpha}\) 终边与单位圆交于 \({P(x,y)}\)&lt;br&gt;\({\sin\alpha=y}\)，\({\cos\alpha=x}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{y}{x}}\)&lt;/span&gt;（\({x\ne 0}\)）&lt;br&gt;终边相同的角 \({\alpha+2k\pi}\)（\({k\in\mathbb{Z}}\)）三角函数值相同&lt;/div&gt;" 编号="S04" 类型="起点" 条件="无条件" 分区="③ 三角" 坐标="K1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6559" y="410" width="345" height="140" as="geometry"/></mxCell></UserObject>
<UserObject id="S05" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S05&lt;/span&gt;&lt;br&gt;【定义】向量数量积&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\vec a\cdot\vec b=|\vec a||\vec b|\cos\theta}\)（\({\theta\in[0,\pi]}\) 为夹角）&lt;br&gt;交换律、数乘结合律、分配律（课本给出）&lt;br&gt;单位正交基：\({\vec i\cdot\vec i=\vec j\cdot\vec j=1}\)，\({\vec i\cdot\vec j=0}\)&lt;/div&gt;" 编号="S05" 类型="起点" 条件="无条件" 分区="③ 三角" 坐标="N1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8584" y="419" width="307" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="S06" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S06&lt;/span&gt;&lt;br&gt;【定义】复数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({i^2=-1}\)；\({z=a+bi}\)（\({a,b\in\mathbb{R}}\)）；\({a+bi=c+di\iff a=c}\) 且 \({b=d}\)&lt;br&gt;\({z}\) ↔ 点 \({(a,b)}\) ↔ 向量；模 \({|z|=\sqrt{a^2+b^2}}\)，共轭 \({\bar z=a-bi}\)&lt;br&gt;加、乘按多项式运算，运算律照常成立&lt;/div&gt;" 编号="S06" 类型="起点" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="K5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6175" y="3359" width="495" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="S11" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S11&lt;/span&gt;&lt;br&gt;【承认】欧拉公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({e^{i\theta}=\cos\theta+i\sin\theta}\)；\({\theta=\pi}\) 时 \({e^{i\pi}+1=0}\)&lt;br&gt;要用级数或复变函数才能证明，高中只承认&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：三角形式乘法“辐角相加”与 \({e^ae^b=e^{a+b}}\) 是同一件事〔R26 · L6〕&lt;/span&gt;&lt;/div&gt;" 编号="S11" 类型="起点" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="K7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6555" y="4192" width="478" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="R13" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R13&lt;/span&gt;&lt;br&gt;★★★ 勾股恒等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin^2\alpha+\cos^2\alpha=1}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R01、R02、R03&lt;/span&gt;&lt;/div&gt;" 编号="R13" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="K2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6446" y="762" width="239" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="P11" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\cos\alpha\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P11&lt;/span&gt;&lt;br&gt;商数关系&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{\sin\alpha}{\cos\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha=\dfrac{\pi}{2}}\)&lt;/span&gt;：\({\cos\alpha=0}\)，两边都无意义&lt;/span&gt;&lt;/div&gt;" 编号="P11" 类型="中间结果（有条件）" 条件="〔定义域〕$\cos\alpha\ne 0$" 分区="③ 三角" 坐标="K2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6131" y="727" width="257" height="170" as="geometry"/></mxCell></UserObject>
<UserObject id="P12" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\cos\alpha\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P12&lt;/span&gt;&lt;br&gt;正切与余弦&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1+\tan^2\alpha=\dfrac{1}{\cos^2\alpha}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P16&lt;/span&gt;&lt;/div&gt;" 编号="P12" 类型="中间结果（有条件）" 条件="〔定义域〕$\cos\alpha\ne 0$" 分区="③ 三角" 坐标="J2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6092" y="1104" width="220" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="R14" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R14&lt;/span&gt;&lt;br&gt;★★ 诱导公式（sin、cos 对任意实数 \({\alpha}\) 成立）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;① \({\alpha+2k\pi}\)：值不变&lt;br&gt;② \({\sin(\pi+\alpha)=-\sin\alpha}\)，\({\cos(\pi+\alpha)=-\cos\alpha}\)&lt;br&gt;③ \({\sin(-\alpha)=-\sin\alpha}\)，\({\cos(-\alpha)=\cos\alpha}\)&lt;br&gt;④ \({\sin(\pi-\alpha)=\sin\alpha}\)，\({\cos(\pi-\alpha)=-\cos\alpha}\)&lt;br&gt;⑤ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\left(\dfrac{\pi}{2}-\alpha\right)=\cos\alpha}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\left(\dfrac{\pi}{2}-\alpha\right)=\sin\alpha}\)&lt;/span&gt;&lt;br&gt;⑥ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\left(\dfrac{\pi}{2}+\alpha\right)=\cos\alpha}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\left(\dfrac{\pi}{2}+\alpha\right)=-\sin\alpha}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;口诀“奇变偶不变，符号看象限”（把 \({\alpha}\) 看作锐角定符号）只用于记忆，不是条件&lt;/span&gt;&lt;/div&gt;" 编号="R14" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="L2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7246" y="689" width="535" height="246" as="geometry"/></mxCell></UserObject>
<UserObject id="P13" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕两边的 tan 都有定义&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P13&lt;/span&gt;&lt;br&gt;tan 的诱导公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\tan(\pi+\alpha)=\tan\alpha}\)，\({\tan(-\alpha)=-\tan\alpha}\)，\({\tan(\pi-\alpha)=-\tan\alpha}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\left(\dfrac{\pi}{2}-\alpha\right)=\dfrac{1}{\tan\alpha}}\)&lt;/span&gt;（&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\ne\dfrac{k\pi}{2}}\)&lt;/span&gt;）&lt;/div&gt;" 编号="P13" 类型="中间结果（有条件）" 条件="〔定义域〕两边的 tan 都有定义" 分区="③ 三角" 坐标="L2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7235" y="1104" width="448" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="R15" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R15&lt;/span&gt;&lt;br&gt;★★ 数量积坐标式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\vec a=(x_1,y_1)}\)，\({\vec b=(x_2,y_2)\Rightarrow\vec a\cdot\vec b=x_1x_2+y_1y_2}\)&lt;br&gt;\({|\vec a|^2=x_1^2+y_1^2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R16&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：与多项式乘法同样逐项展开〔R01 · B2〕&lt;/span&gt;&lt;/div&gt;" 编号="R15" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="N2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8566" y="751" width="341" height="142" as="geometry"/></mxCell></UserObject>
<UserObject id="R16" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R16&lt;/span&gt;&lt;br&gt;★★★ 两角差的余弦&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;\({\cos(\alpha-\beta)=\cos\alpha\cos\beta+\sin\alpha\sin\beta}\)&lt;/div&gt;" 编号="R16" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="M2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8134" y="1140" width="302" height="78" as="geometry"/></mxCell></UserObject>
<UserObject id="R17" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R17&lt;/span&gt;&lt;br&gt;★★ 其余和差角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\cos(\alpha+\beta)=\cos\alpha\cos\beta-\sin\alpha\sin\beta}\)&lt;br&gt;\({\sin(\alpha\pm\beta)=\sin\alpha\cos\beta\pm\cos\alpha\sin\beta}\)&lt;/div&gt;" 编号="R17" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="M3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8134" y="1447" width="302" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="P14" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕三个 tan 都有定义&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P14&lt;/span&gt;&lt;br&gt;两角和差的正切&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan(\alpha\pm\beta)=\dfrac{\tan\alpha\pm\tan\beta}{1\mp\tan\alpha\tan\beta}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha=\beta=\dfrac{\pi}{4}}\)&lt;/span&gt;：\({\tan(\alpha+\beta)}\) 无定义，右边分母 \({1-1=0}\)&lt;/span&gt;&lt;/div&gt;" 编号="P14" 类型="中间结果（有条件）" 条件="〔定义域〕三个 tan 都有定义" 分区="③ 三角" 坐标="N3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8624" y="1734" width="377" height="170" as="geometry"/></mxCell></UserObject>
<UserObject id="R18" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R18&lt;/span&gt;&lt;br&gt;★★ 倍角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin 2\alpha=2\sin\alpha\cos\alpha}\)&lt;br&gt;\({\cos 2\alpha=\cos^2\alpha-\sin^2\alpha=2\cos^2\alpha-1=1-2\sin^2\alpha}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R02&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：用 \({\sin^2\alpha+\cos^2\alpha=1}\) 换成单一函数〔R13 · K2〕&lt;/span&gt;&lt;/div&gt;" 编号="R18" 类型="结论" 条件="无条件" 分区="③ 三角" 坐标="M3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7538" y="1758" width="407" height="142" as="geometry"/></mxCell></UserObject>
<UserObject id="P15" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\tan\alpha}\)、\({\tan 2\alpha}\) 有定义&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P15&lt;/span&gt;&lt;br&gt;正切倍角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan 2\alpha=\dfrac{2\tan\alpha}{1-\tan^2\alpha}}\)&lt;/span&gt;&lt;br&gt;即 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\ne\dfrac{\pi}{2}+k\pi}\)&lt;/span&gt; 且 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\ne\dfrac{\pi}{4}+\dfrac{k\pi}{2}}\)&lt;/span&gt;&lt;/div&gt;" 编号="P15" 类型="中间结果（有条件）" 条件="〔定义域〕$\tan\alpha$、$\tan 2\alpha$ 有定义" 分区="③ 三角" 坐标="N4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8670" y="2123" width="287" height="170" as="geometry"/></mxCell></UserObject>
<UserObject id="R19" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R19&lt;/span&gt;&lt;br&gt;降幂&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos^2\alpha=\dfrac{1+\cos 2\alpha}{2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin^2\alpha=\dfrac{1-\cos 2\alpha}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\cos\alpha=\dfrac{1}{2}\sin 2\alpha}\)&lt;/span&gt;&lt;/div&gt;" 编号="R19" 类型="中间结果" 条件="无条件" 分区="③ 三角" 坐标="L4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7288" y="2131" width="327" height="154" as="geometry"/></mxCell></UserObject>
<UserObject id="P16" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔符号分支〕± 由 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\alpha}{2}}\)&lt;/span&gt; 所在象限定&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P16&lt;/span&gt;&lt;br&gt;★ 半角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\dfrac{\alpha}{2}=\pm\sqrt{\dfrac{1-\cos\alpha}{2}}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\dfrac{\alpha}{2}=\pm\sqrt{\dfrac{1+\cos\alpha}{2}}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({\alpha=300^\circ}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos 150^\circ=-\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，取正号得 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({+\dfrac{\sqrt{3}}{2}}\)&lt;/span&gt;，错&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\dfrac{\alpha}{2}=\dfrac{\sin\alpha}{1+\cos\alpha}=\dfrac{1-\cos\alpha}{\sin\alpha}}\)&lt;/span&gt;（无 ±；前式 \({\cos\alpha\ne -1}\)，后式 \({\sin\alpha\ne 0}\)）&lt;/div&gt;" 编号="P16" 类型="结论（有条件）" 条件="〔符号分支〕± 由 $\frac{\alpha}{2}$ 所在象限定" 分区="③ 三角" 坐标="L4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7170" y="2528" width="562" height="232" as="geometry"/></mxCell></UserObject>
<UserObject id="R20" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R20&lt;/span&gt;&lt;br&gt;积化和差&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\cos\beta=\dfrac{1}{2}[\sin(\alpha+\beta)+\sin(\alpha-\beta)]}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\alpha\cos\beta=\dfrac{1}{2}[\cos(\alpha+\beta)+\cos(\alpha-\beta)]}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha\sin\beta=-\dfrac{1}{2}[\cos(\alpha+\beta)-\cos(\alpha-\beta)]}\)&lt;/span&gt;&lt;/div&gt;" 编号="R20" 类型="中间结果" 条件="无条件" 分区="③ 三角" 坐标="O3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9060" y="1723" width="318" height="193" as="geometry"/></mxCell></UserObject>
<UserObject id="R21" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R21&lt;/span&gt;&lt;br&gt;和差化积&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\theta+\sin\varphi=2\sin\dfrac{\theta+\varphi}{2}\cos\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\theta-\sin\varphi=2\cos\dfrac{\theta+\varphi}{2}\sin\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta+\cos\varphi=2\cos\dfrac{\theta+\varphi}{2}\cos\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta-\cos\varphi=-2\sin\dfrac{\theta+\varphi}{2}\sin\dfrac{\theta-\varphi}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 互逆：积化和差〔R20 · O3〕&lt;/span&gt;&lt;/div&gt;" 编号="R21" 类型="中间结果" 条件="无条件" 分区="③ 三角" 坐标="O4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9073" y="2081" width="292" height="253" as="geometry"/></mxCell></UserObject>
<UserObject id="P17" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({a,b}\) 不全为 0；〔符号分支〕\({\varphi}\) 由 \({a,b}\) 正负定&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P17&lt;/span&gt;&lt;br&gt;★★ 辅助角&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a\sin x+b\cos x=\sqrt{a^2+b^2}\,\sin(x+\varphi)}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\varphi=\dfrac{a}{\sqrt{a^2+b^2}}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\varphi=\dfrac{b}{\sqrt{a^2+b^2}}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=b=-1}\) 应取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\varphi=\dfrac{5\pi}{4}}\)&lt;/span&gt;；只看 \({\tan\varphi=1}\) 取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{4}}\)&lt;/span&gt;，得 \({\sin x+\cos x}\)，错&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 R13&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{a}{r}\right)^2+\left(\dfrac{b}{r}\right)^2=1}\)&lt;/span&gt;，故有 \({\varphi}\)〔R13 · K2〕&lt;/span&gt;&lt;/div&gt;" 编号="P17" 类型="结论（有条件）" 条件="〔定义域〕$a,b$ 不全为 0；〔符号分支〕$\varphi$ 由 $a,b$ 正负定" 分区="③ 三角" 坐标="M3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8004" y="1710" width="562" height="238" as="geometry"/></mxCell></UserObject>
<UserObject id="P18" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({\alpha\ne\pi+2k\pi}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P18&lt;/span&gt;&lt;br&gt;万能公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({t=\tan\dfrac{\alpha}{2}}\)&lt;/span&gt;：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha=\dfrac{2t}{1+t^2}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\alpha=\dfrac{1-t^2}{1+t^2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\tan\alpha=\dfrac{2t}{1-t^2}}\)&lt;/span&gt;（还要 \({t^2\ne 1}\)）&lt;/div&gt;" 编号="P18" 类型="中间结果（有条件）" 条件="〔定义域〕$\alpha\ne\pi+2k\pi$" 分区="③ 三角" 坐标="M4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7673" y="2123" width="336" height="170" as="geometry"/></mxCell></UserObject>
<UserObject id="P19" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({A+B+C=\pi}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P19&lt;/span&gt;&lt;br&gt;三角形内角关系&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin(A+B)=\sin C}\)，\({\cos(A+B)=-\cos C}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\dfrac{A+B}{2}=\cos\dfrac{C}{2}}\)&lt;/span&gt;&lt;/div&gt;" 编号="P19" 类型="中间结果（有条件）" 条件="〔结构前提〕$A+B+C=\pi$" 分区="③ 三角" 坐标="M2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7741" y="1104" width="314" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="P20" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({a,b}\) 夹角 \({C}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P20&lt;/span&gt;&lt;br&gt;三角形面积&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S=\dfrac{1}{2}ab\sin C=\dfrac{1}{2}bc\sin A=\dfrac{1}{2}ca\sin B}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 直角边 \({a=b=1}\)、\({C=90^\circ}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S=\dfrac{1}{2}}\)&lt;/span&gt;；误用非夹角 \({A=45^\circ}\) 得 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sqrt{2}}{4}}\)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" 编号="P20" 类型="中间结果（有条件）" 条件="〔结构前提〕$a,b$ 夹角 $C$" 分区="③ 三角" 坐标="L2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6723" y="1094" width="454" height="170" as="geometry"/></mxCell></UserObject>
<UserObject id="P21" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕同一三角形的边与对角&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P21&lt;/span&gt;&lt;br&gt;★★ 正弦定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{\sin A}=\dfrac{b}{\sin B}=\dfrac{c}{\sin C}=2R}\)&lt;/span&gt;（\({R}\) 为外接圆半径）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=2}\)，\({b=1}\)，\({A=B=60^\circ}\) 不来自同一三角形：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{\sin A}\ne\dfrac{b}{\sin B}}\)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" 编号="P21" 类型="结论（有条件）" 条件="〔结构前提〕同一三角形的边与对角" 分区="③ 三角" 坐标="L3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6711" y="1410" width="479" height="174" as="geometry"/></mxCell></UserObject>
<UserObject id="P22" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕\({a}\) 为 \({A}\) 的对边，\({b,c}\) 夹 \({A}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P22&lt;/span&gt;&lt;br&gt;★★ 余弦定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^2=b^2+c^2-2bc\cos A}\)（其余两式同理）&lt;br&gt;\({A=90^\circ}\) 时即勾股定理&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({a=2}\)，\({b=c=1}\)，\({A=60^\circ}\)：右边 \({=1}\)，左边 \({=4}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：勾股恒等式〔R13 · K2〕&lt;/span&gt;&lt;/div&gt;" 编号="P22" 类型="结论（有条件）" 条件="〔结构前提〕$a$ 为 $A$ 的对边，$b,c$ 夹 $A$" 分区="③ 三角" 坐标="N2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8738" y="1088" width="385" height="182" as="geometry"/></mxCell></UserObject>
<UserObject id="R22" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R22&lt;/span&gt;&lt;br&gt;复数乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+bi)(c+di)=(ac-bd)+(ad+bc)i}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：多项式乘法展开〔R01 · B2〕&lt;/span&gt;&lt;/div&gt;" 编号="R22" 类型="中间结果" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="K6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6274" y="3681" width="296" height="96" as="geometry"/></mxCell></UserObject>
<UserObject id="R23" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R23&lt;/span&gt;&lt;br&gt;★ 共轭与模&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({z\bar z=|z|^2=a^2+b^2}\)；\({z+\bar z=2a}\)，\({z-\bar z=2bi}\)&lt;br&gt;\({\overline{z_1\pm z_2}=\bar z_1\pm\bar z_2}\)，\({\overline{z_1z_2}=\bar z_1\bar z_2}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：与平方差同型〔R02 · A2〕&lt;/span&gt;&lt;/div&gt;" 编号="R23" 类型="结论" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="K6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6213" y="3940" width="342" height="120" as="geometry"/></mxCell></UserObject>
<UserObject id="P23" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({c+di\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P23&lt;/span&gt;&lt;br&gt;复数除法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a+bi}{c+di}=\dfrac{(ac+bd)+(bc-ad)i}{c^2+d^2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({c=d=0}\) 时分母为 0&lt;/span&gt;&lt;/div&gt;" 编号="P23" 类型="中间结果（有条件）" 条件="〔定义域〕$c+di\ne 0$" 分区="③ 三角（续）复数分支" 坐标="J7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5969" y="4177" width="244" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="R24" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R24&lt;/span&gt;&lt;br&gt;\({i^n}\) 以 4 为周期&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({i^1=i}\)，\({i^2=-1}\)，\({i^3=-i}\)，\({i^4=1}\)；\({i^{n+4}=i^n}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：指数运算律〔R12 · F4〕&lt;/span&gt;&lt;/div&gt;" 编号="R24" 类型="中间结果" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="K6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6628" y="3670" width="338" height="117" as="geometry"/></mxCell></UserObject>
<UserObject id="R25" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R25&lt;/span&gt;&lt;br&gt;模的乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|z_1z_2|=|z_1||z_2|}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：拉格朗日恒等式〔R11 · E2〕&lt;/span&gt;&lt;/div&gt;" 编号="R25" 类型="中间结果" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="K7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="6271" y="4194" width="226" height="118" as="geometry"/></mxCell></UserObject>
<UserObject id="P24" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({z\ne 0}\)；〔符号分支〕\({\theta}\) 由 \({a,b}\) 正负定&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P24&lt;/span&gt;&lt;br&gt;★ 三角形式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({z=a+bi=r(\cos\theta+i\sin\theta)}\)，\({r=|z|}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos\theta=\dfrac{a}{r}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\theta=\dfrac{b}{r}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({z=-1-i}\)：只看 \({\tan\theta=1}\) 取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\pi}{4}}\)&lt;/span&gt;，得 \({1+i\ne z}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：单位圆定义〔S04 · K1〕&lt;/span&gt;&lt;/div&gt;" 编号="P24" 类型="结论（有条件）" 条件="〔定义域〕$z\ne 0$；〔符号分支〕$\theta$ 由 $a,b$ 正负定" 分区="③ 三角（续）复数分支" 坐标="L6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7036" y="3621" width="402" height="216" as="geometry"/></mxCell></UserObject>
<UserObject id="R26" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R26&lt;/span&gt;&lt;br&gt;★★ 三角形式乘法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({r_1(\cos\theta_1+i\sin\theta_1)\cdot r_2(\cos\theta_2+i\sin\theta_2)}\)&lt;br&gt;\({=r_1r_2[\cos(\theta_1+\theta_2)+i\sin(\theta_1+\theta_2)]}\)&lt;br&gt;模相乘，辐角相加&lt;/div&gt;" 编号="R26" 类型="结论" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="L6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7064" y="3929" width="346" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="P25" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({z_2\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P25&lt;/span&gt;&lt;br&gt;三角形式除法&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{z_1}{z_2}=\dfrac{r_1}{r_2}[\cos(\theta_1-\theta_2)+i\sin(\theta_1-\theta_2)]}\)&lt;/span&gt;&lt;/div&gt;" 编号="P25" 类型="中间结果（有条件）" 条件="〔定义域〕$z_2\ne 0$" 分区="③ 三角（续）复数分支" 坐标="L7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7091" y="4177" width="292" height="152" as="geometry"/></mxCell></UserObject>
<UserObject id="R27" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R27&lt;/span&gt;&lt;br&gt;★ 棣莫弗公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({[r(\cos\theta+i\sin\theta)]^n=r^n(\cos n\theta+i\sin n\theta)}\)（\({n}\) 为正整数）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;教材必修四 10.3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：数学归纳法〔S10 · B6〕&lt;/span&gt;&lt;/div&gt;" 编号="R27" 类型="结论" 条件="无条件" 分区="③ 三角（续）复数分支" 坐标="M7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="7441" y="4203" width="464" height="120" as="geometry"/></mxCell></UserObject>
<UserObject id="S09" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S09&lt;/span&gt;&lt;br&gt;【定义】数列&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({S_n=a_1+a_2+\cdots+a_n}\)&lt;br&gt;等差：\({a_{n+1}-a_n=d}\)（常数）&lt;br&gt;等比：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a_{n+1}}{a_n}=q}\)&lt;/span&gt;（常数，\({a_n\ne 0}\)，\({q\ne 0}\)）&lt;/div&gt;" 编号="S09" 类型="起点" 条件="无条件" 分区="④ 数列" 坐标="C5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1499" y="2940" width="319" height="140" as="geometry"/></mxCell></UserObject>
<UserObject id="S10" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S10&lt;/span&gt;&lt;br&gt;【工具】数学归纳法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({n=n_0}\) 成立；\({n=k}\) 成立 \({\Rightarrow n=k+1}\) 成立&lt;br&gt;\({\Rightarrow}\) 对一切 \({n\ge n_0}\) 成立&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P23（伯努利归纳步）&lt;/span&gt;&lt;/div&gt;" 编号="S10" 类型="起点" 条件="无条件" 分区="④ 数列" 坐标="B6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1186" y="4078" width="327" height="122" as="geometry"/></mxCell></UserObject>
<UserObject id="R28" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R28&lt;/span&gt;&lt;br&gt;★ 累加相消&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;\({(b_2-b_1)+(b_3-b_2)+\cdots+(b_{n+1}-b_n)=b_{n+1}-b_1}\)&lt;/div&gt;" 编号="R28" 类型="结论" 条件="无条件" 分区="④ 数列" 坐标="A5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="338" y="2971" width="375" height="78" as="geometry"/></mxCell></UserObject>
<UserObject id="P26" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P26&lt;/span&gt;&lt;br&gt;★ 等差通项&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;\({a_n=a_1+(n-1)d}\)，\({a_n=a_m+(n-m)d}\)&lt;/div&gt;" 编号="P26" 类型="结论（有条件）" 条件="〔结构前提〕等差数列" 分区="④ 数列" 坐标="B5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1199" y="3228" width="291" height="116" as="geometry"/></mxCell></UserObject>
<UserObject id="P27" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P27&lt;/span&gt;&lt;br&gt;等差下标性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({m+n=p+q\Rightarrow a_m+a_n=a_p+a_q}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 1, 2, 4, 7 不是等差：\({a_1+a_4=8}\)，\({a_2+a_3=6}\)&lt;/span&gt;&lt;/div&gt;" 编号="P27" 类型="中间结果（有条件）" 条件="〔结构前提〕等差数列" 分区="④ 数列" 坐标="B6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="774" y="3515" width="343" height="134" as="geometry"/></mxCell></UserObject>
<UserObject id="P28" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等差数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P28&lt;/span&gt;&lt;br&gt;★★ 等差求和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_n=\dfrac{n(a_1+a_n)}{2}=na_1+\dfrac{n(n-1)}{2}d}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 1, 2, 4, 7：\({S_4=14}\)，而 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{4\times(1+7)}{2}=16}\)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" 编号="P28" 类型="结论（有条件）" 条件="〔结构前提〕等差数列" 分区="④ 数列" 坐标="B6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="776" y="3784" width="339" height="174" as="geometry"/></mxCell></UserObject>
<UserObject id="R29" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R29&lt;/span&gt;&lt;br&gt;自然数求和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1+2+\cdots+n=\dfrac{n(n+1)}{2}}\)&lt;/span&gt;&lt;br&gt;\({a_k=k}\) 本身是等差数列，无需另加条件&lt;/div&gt;" 编号="R29" 类型="中间结果" 条件="无条件" 分区="④ 数列" 坐标="B6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="814" y="4071" width="263" height="136" as="geometry"/></mxCell></UserObject>
<UserObject id="P29" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等比数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P29&lt;/span&gt;&lt;br&gt;★ 等比通项&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;\({a_n=a_1q^{n-1}}\)&lt;/div&gt;" 编号="P29" 类型="结论（有条件）" 条件="〔结构前提〕等比数列" 分区="④ 数列" 坐标="C5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1549" y="3228" width="220" height="116" as="geometry"/></mxCell></UserObject>
<UserObject id="P30" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等比数列&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P30&lt;/span&gt;&lt;br&gt;等比下标性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({m+n=p+q\Rightarrow a_ma_n=a_pa_q}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ 1, 2, 4, 7：\({a_1a_4=7}\)，\({a_2a_3=8}\)&lt;/span&gt;&lt;/div&gt;" 编号="P30" 类型="中间结果（有条件）" 条件="〔结构前提〕等比数列" 分区="④ 数列" 坐标="B6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1175" y="3515" width="258" height="134" as="geometry"/></mxCell></UserObject>
<UserObject id="P31" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔结构前提〕等比数列；〔定义域〕\({q\ne 1}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P31&lt;/span&gt;&lt;br&gt;★★ 等比求和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({q\ne 1}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_n=\dfrac{a_1(1-q^n)}{1-q}}\)&lt;/span&gt;；\({q=1}\)：\({S_n=na_1}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({q=1}\) 时分母为 0&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P13&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：【因式分解】\({1-q^n=(1-q)(1+q+\cdots+q^{n-1})}\)（另一路）〔R09 · C2〕&lt;/span&gt;&lt;/div&gt;" 编号="P31" 类型="结论（有条件）" 条件="〔结构前提〕等比数列；〔定义域〕$q\ne 1$" 分区="④ 数列" 坐标="C6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1490" y="3493" width="337" height="198" as="geometry"/></mxCell></UserObject>
<UserObject id="P32" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({n\ge 2}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P32&lt;/span&gt;&lt;br&gt;\({a_n}\) 与 \({S_n}\)&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_1=S_1}\)；\({n\ge 2}\) 时 \({a_n=S_n-S_{n-1}}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({S_n=n^2+1}\)：\({a_1=2}\)，而 \({2n-1}\) 在 \({n=1}\) 时得 1&lt;/span&gt;&lt;/div&gt;" 编号="P32" 类型="中间结果（有条件）" 条件="〔定义域〕$n\ge 2$" 分区="④ 数列" 坐标="C5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1827" y="3220" width="356" height="134" as="geometry"/></mxCell></UserObject>
<UserObject id="R30" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R30&lt;/span&gt;&lt;br&gt;★ 裂项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k(k+1)}=\dfrac{1}{k}-\dfrac{1}{k+1}}\)&lt;/span&gt;（\({k}\) 为正整数）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\displaystyle\sum_{k=1}^{n}\dfrac{1}{k(k+1)}=1-\dfrac{1}{n+1}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P24&lt;/span&gt;&lt;/div&gt;" 编号="R30" 类型="结论" 条件="无条件" 分区="④ 数列" 坐标="A5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="3206" width="285" height="162" as="geometry"/></mxCell></UserObject>
<UserObject id="R31" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R31&lt;/span&gt;&lt;br&gt;★ 平方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1^2+2^2+\cdots+n^2=\dfrac{n(n+1)(2n+1)}{6}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：累加相消〔R28 · A5〕&lt;/span&gt;&lt;/div&gt;" 编号="R31" 类型="结论" 条件="无条件" 分区="④ 数列" 坐标="A7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="517" y="4353" width="282" height="116" as="geometry"/></mxCell></UserObject>
<UserObject id="R32" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R32&lt;/span&gt;&lt;br&gt;立方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1^3+2^3+\cdots+n^3=\left[\dfrac{n(n+1)}{2}\right]^2=(1+2+\cdots+n)^2}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：平方和〔R31 · A7〕&lt;/span&gt;&lt;/div&gt;" 编号="R32" 类型="中间结果" 条件="无条件" 分区="④ 数列" 坐标="B7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="857" y="4333" width="347" height="136" as="geometry"/></mxCell></UserObject>
<UserObject id="S07" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S07&lt;/span&gt;&lt;br&gt;【原理】两个计数原理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;分类加法：各类方法数相加&lt;br&gt;分步乘法：各步方法数相乘&lt;/div&gt;" 编号="S07" 类型="起点" 条件="无条件" 分区="⑤ 计数" 坐标="F1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3953" y="410" width="220" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="P33" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({m\le n}\)（自然数）&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P33&lt;/span&gt;&lt;br&gt;排列数&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({A_n^m=n(n-1)\cdots(n-m+1)=\dfrac{n!}{(n-m)!}}\)&lt;/span&gt;（\({0!=1}\)）&lt;/div&gt;" 编号="P33" 类型="中间结果（有条件）" 条件="〔定义域〕$m\le n$（自然数）" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3891" y="636" width="343" height="131" as="geometry"/></mxCell></UserObject>
<UserObject id="P34" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({0\le m\le n}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P34&lt;/span&gt;&lt;br&gt;★★ 组合数&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({C_n^m=\dfrac{A_n^m}{m!}=\dfrac{n!}{m!(n-m)!}}\)&lt;/span&gt;&lt;/div&gt;" 编号="P34" 类型="结论（有条件）" 条件="〔定义域〕$0\le m\le n$" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3953" y="880" width="220" height="134" as="geometry"/></mxCell></UserObject>
<UserObject id="P35" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({1\le m\le n}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P35&lt;/span&gt;&lt;br&gt;组合数性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({C_n^m=C_n^{n-m}}\)&lt;br&gt;\({C_{n+1}^m=C_n^m+C_n^{m-1}}\)（杨辉三角的递推）&lt;/div&gt;" 编号="P35" 类型="中间结果（有条件）" 条件="〔定义域〕$1\le m\le n$" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3556" y="1139" width="277" height="155" as="geometry"/></mxCell></UserObject>
<UserObject id="R33" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R33&lt;/span&gt;&lt;br&gt;★★★ 二项式定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(a+b)^n=\displaystyle\sum_{k=0}^{n}C_n^k a^{n-k}b^k}\)&lt;/span&gt;（\({n}\) 为正整数）&lt;br&gt;通项 \({T_{k+1}=C_n^k a^{n-k}b^k}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;同见不等式大厦 P26（伯努利不等式）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⇐ 前提：多项式乘法逐项展开〔R01 · B2〕&lt;/span&gt;&lt;/div&gt;" 编号="R33" 类型="结论" 条件="无条件" 分区="⑤ 计数" 坐标="F2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3892" y="1145" width="342" height="164" as="geometry"/></mxCell></UserObject>
<UserObject id="R34" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R34&lt;/span&gt;&lt;br&gt;二项式系数性质&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({C_n^0+C_n^1+\cdots+C_n^n=2^n}\)&lt;br&gt;奇数项系数和 = 偶数项系数和 \({=2^{n-1}}\)&lt;/div&gt;" 编号="R34" 类型="中间结果" 条件="无条件" 分区="⑤ 计数" 坐标="F3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3930" y="1407" width="266" height="97" as="geometry"/></mxCell></UserObject>
<UserObject id="P36" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({1\le k\le n}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background-color:#90A4AE;color:#FFFFFF;font-size:10px;&quot;&gt;&amp;nbsp;拓展&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P36&lt;/span&gt;&lt;br&gt;组合数的提取&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;\({kC_n^k=nC_{n-1}^{k-1}}\)&lt;/div&gt;" 编号="P36" 类型="中间结果（有条件）" 条件="〔定义域〕$1\le k\le n$" 分区="⑤ 计数" 坐标="G2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4333" y="1160" width="220" height="113" as="geometry"/></mxCell></UserObject>
<UserObject id="S08" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S08&lt;/span&gt;&lt;br&gt;【定义】导数&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f'(x_0)=\displaystyle\lim_{\Delta x\to 0}\dfrac{f(x_0+\Delta x)-f(x_0)}{\Delta x}}\)&lt;/span&gt;&lt;/div&gt;" 编号="S08" 类型="起点" 条件="无条件" 分区="⑥ 导数" 坐标="G7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4022" y="4354" width="307" height="100" as="geometry"/></mxCell></UserObject>
<UserObject id="S12" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S12&lt;/span&gt;&lt;br&gt;【课本给出】导数表与链式法则&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({C'=0}\)；\({(\sin x)'=\cos x}\)，\({(\cos x)'=-\sin x}\)；\({(e^x)'=e^x}\)（\({x\in\mathbb{R}}\)）&lt;br&gt;\({(x^\alpha)'=\alpha x^{\alpha-1}}\)（\({\alpha}\) 为任意实数时取 \({x&amp;gt;0}\)；\({\alpha}\) 为正整数时 \({x\in\mathbb{R}}\)）&lt;br&gt;\({(a^x)'=a^x\ln a}\)（\({a&amp;gt;0}\)，\({x\in\mathbb{R}}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\log_a x)'=\dfrac{1}{x\ln a}}\)&lt;/span&gt;（\({a&amp;gt;0,\ a\ne 1,\ x&amp;gt;0}\)）；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln x)'=\dfrac{1}{x}}\)&lt;/span&gt;（\({x&amp;gt;0}\)）&lt;br&gt;有定义不等于可导：\({\sqrt{x}}\) 在 \({x=0}\) 有定义，但没有有限导数&lt;br&gt;链式法则：\({g}\) 在 \({x}\) 处可导、\({f}\) 在 \({u=g(x)}\) 处可导 \({\Rightarrow y'_x=f'(u)\cdot g'(x)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;课本直接给出（链式法则课本写“可以证明”）；下面的 R35、P39、P40 只说明由来&lt;/span&gt;&lt;/div&gt;" 编号="S12" 类型="起点" 条件="无条件" 分区="⑥ 导数" 坐标="H7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4881" y="4290" width="548" height="228" as="geometry"/></mxCell></UserObject>
<UserObject id="R35" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R35&lt;/span&gt;&lt;br&gt;正整数幂求导的由来&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;\({(x^n)'=nx^{n-1}}\)（\({n}\) 为正整数，\({x\in\mathbb{R}}\)）&lt;/div&gt;" 编号="R35" 类型="中间结果" 条件="无条件" 分区="⑥ 导数" 坐标="F7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3556" y="4713" width="262" height="76" as="geometry"/></mxCell></UserObject>
<UserObject id="P37" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({u,v}\) 在该点可导&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P37&lt;/span&gt;&lt;br&gt;★★ 和、差、积的求导法则&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(u\pm v)'=u'\pm v'}\)&lt;br&gt;\({(uv)'=u'v+uv'}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({u=|x|}\)，\({v=-|x|}\)，\({x=0}\)：\({(u+v)'=0}\)，右边 \({u'}\)、\({v'}\) 不存在&lt;/span&gt;&lt;/div&gt;" 编号="P37" 类型="结论（有条件）" 条件="〔定义域〕$u,v$ 在该点可导" 分区="⑥ 导数" 坐标="G7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="3943" y="4671" width="465" height="160" as="geometry"/></mxCell></UserObject>
<UserObject id="P38" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({u,v}\) 可导，\({v(x)\ne 0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P38&lt;/span&gt;&lt;br&gt;★ 商的求导法则&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{u}{v}\right)'=\dfrac{u'v-uv'}{v^2}}\)&lt;/span&gt;（同时得出 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{u}{v}}\)&lt;/span&gt; 可导）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#B71C1C;font-weight:normal;&quot;&gt;✗ \({v(x)=0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{u}{v}}\)&lt;/span&gt; 在该点无定义&lt;/span&gt;&lt;/div&gt;" 编号="P38" 类型="结论（有条件）" 条件="〔定义域〕$u,v$ 可导，$v(x)\ne 0$" 分区="⑥ 导数" 坐标="G8"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="4424" y="4957" width="301" height="196" as="geometry"/></mxCell></UserObject>
<UserObject id="P39" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;〔定义域〕\({x&amp;gt;0}\)&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P39&lt;/span&gt;&lt;br&gt;\({(\ln x)'}\) 的由来&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln x)'=\dfrac{1}{x}}\)&lt;/span&gt;&lt;/div&gt;" 编号="P39" 类型="中间结果（有条件）" 条件="〔定义域〕$x&gt;0$" 分区="⑥ 导数" 坐标="H7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#BF360C;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="5045" y="4685" width="220" height="131" as="geometry"/></mxCell></UserObject>
