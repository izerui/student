<UserObject id="e44" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔符号分支〕：± 由 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\frac{\alpha}{2}}\)&lt;/span&gt; 所在象限定&lt;/span&gt;&lt;br&gt;【代换】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\alpha\to\dfrac{\alpha}{2}}\)&lt;/span&gt; 后开平方&lt;br&gt;tan 式：分子、分母同乘 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({2\cos\dfrac{\alpha}{2}}\)&lt;/span&gt;" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;" edge="1" parent="1" source="R19" target="P16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7451" y="2349"/></Array><mxPoint x="128" y="30" as="offset"/></mxGeometry></mxCell></UserObject>
