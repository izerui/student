<UserObject id="e49" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔定义域〕：\({\alpha\ne\pi+2k\pi}\)&lt;/span&gt;&lt;br&gt;【同除】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin\alpha=\dfrac{2\sin\frac{\alpha}{2}\cos\frac{\alpha}{2}}{\sin^2\frac{\alpha}{2}+\cos^2\frac{\alpha}{2}}}\)&lt;/span&gt;，同除 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos^2\dfrac{\alpha}{2}}\)&lt;/span&gt;" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;" edge="1" parent="1" source="R18" target="P18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7773" y="1942"/></Array><mxPoint x="159" y="9" as="offset"/></mxGeometry></mxCell></UserObject>
<UserObject id="e50" label="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件〔结构前提〕：\({A+B+C=\pi}\)&lt;/span&gt;&lt;br&gt;【代换】\({A+B=\pi-C}\)，用 ④&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{A+B}{2}=\dfrac{\pi}{2}-\dfrac{C}{2}}\)&lt;/span&gt;，用 ⑤" 类型="推导"><mxCell style="html=1;rounded=1;curved=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;fontColor=#263238;endArrow=block;strokeColor=#455A64;strokeWidth=2.5;endSize=7;" edge="1" parent="1" source="R14" target="P19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="7710" y="971"/><mxPoint x="7763" y="1052"/></Array><mxPoint x="136" y="-3" as="offset"/></mxGeometry></mxCell></UserObject>
