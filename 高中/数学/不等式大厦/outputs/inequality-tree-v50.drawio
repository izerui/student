  <diagram id="autolayout" name="Page-1">
    <mxGraphModel dx="2264" dy="771" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0">
      <root><mxCell id="0" /><mxCell id="bg" parent="0" style="locked=1;" value="背景（网格、坐标、底色，已锁定）" /><mxCell id="bg98" parent="bg" vertex="1" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=3;"><mxGeometry x="-1800" y="1926" width="800" height="1452" as="geometry" /></mxCell><mxCell id="1" parent="0" /><UserObject id="ax_order" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S01&lt;/span&gt;&lt;br&gt;【公理】实数大小&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a\gt b \iff  a-b\gt 0}\)（\({a-b}\) 是正数）&lt;br&gt;任意两个实数 a、b：\({a\gt b}\)、\({a=b}\)、\({a\lt b}\) 恰有一种成立&lt;br&gt;正数 + 正数 = 正数（由此得&lt;b&gt;传递性&lt;/b&gt;：\({a \gt  b}\)，\({b \gt  c \Rightarrow  a \gt  c}\)）&lt;br&gt;&lt;b&gt;对称性&lt;/b&gt;：\({a \gt  b \iff  b \lt  a}\)（两者都表示 \({a - b}\) 是正数）&lt;br&gt;边界：大小只对实数规定；虚数之间不能比较大小&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：实数的基本规定，所有推导的地基（四则运算、分配律、相反数、倒数直接使用）&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="任意实数" 编号="S01" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="151" width="675" x="7830" y="73" as="geometry" />
          </mxCell></UserObject><UserObject id="ax_pos" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S02&lt;/span&gt;&lt;br&gt;【公理】正数相乘&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;正数 × 正数 = 正数&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：实数的基本规定，和“实数大小”的规定一起构成实数大小的公理&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="任意实数" 编号="S02" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="122" width="461" x="6370" y="90" as="geometry" />
          </mxCell></UserObject><UserObject id="ax_abs" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S03&lt;/span&gt;&lt;br&gt;【定义】绝对值&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({x\ge 0}\) 时 \({|x|=x}\)&lt;br&gt;\({x\lt 0}\) 时 \({|x|=-x}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：这是定义，不是推出来的&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="任意实数" 编号="S03" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="120" width="438" x="2391" y="5251" as="geometry" />
          </mxCell></UserObject><UserObject id="ax_deriv" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S04&lt;/span&gt;&lt;br&gt;【定理】导数判单调&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;在同一个区间 I 内：\({f'(x) \ge  0 \Rightarrow  f(x)}\) 递增（不减）；\({f'(x) \le  0 \Rightarrow  f(x)}\) 递减（不增）&lt;br&gt;\({f'(x) \gt  0 \Rightarrow}\) 严格递增；\({f'(x) \lt  0 \Rightarrow}\) 严格递减&lt;br&gt;不同区间不能连起来用：如 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x)=-\dfrac{1}{x}}\)&lt;/span&gt; 在 \({x\lt 0}\)、\({x\gt 0}\) 上分别递增，但 \({f(-1) \gt  f(1)}\)&lt;br&gt;区间端点要算进去时，函数在端点要连续&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：课本直接使用，不需要证明（严格证明要用拉格朗日中值定理，超出高中）&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="不适用" 编号="S04" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="150" width="670" x="5363" y="5243" as="geometry" />
          </mxCell></UserObject><UserObject id="add" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R04&lt;/span&gt;&lt;br&gt;加法保序&lt;br&gt;\({a\gt b \Rightarrow  a+c \gt  b+c}\)&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;推论：&lt;b&gt;移项法则&lt;/b&gt;&lt;br&gt;\({a + b \gt  c \Rightarrow  a \gt  c - b}\)（两边加 \({-b}\)）&lt;/span&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R04" 层级="1"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="94" width="240" x="7440" y="405" as="geometry" />
          </mxCell></UserObject><UserObject id="mulp" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\in \mathbb{R}}\)；\({c\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R05&lt;/span&gt;&lt;br&gt;正数乘法保序&lt;br&gt;\({a\gt b, c\gt 0 \Rightarrow  ac \gt  bc}\)" 类型="中间结果" 适用范围="a,b∈ℝ；c&gt;0" 编号="R05" 层级="1"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="104" width="220" x="6940" y="420" as="geometry" />
          </mxCell></UserObject><UserObject id="muln" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\in \mathbb{R}}\)；\({c\lt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R06&lt;/span&gt;&lt;br&gt;负数乘法反序&lt;br&gt;\({a\gt b, c\lt 0 \Rightarrow  ac \lt  bc}\)" 类型="中间结果" 适用范围="a,b∈ℝ；c&lt;0" 编号="R06" 层级="1"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="91" width="220" x="6490" y="420" as="geometry" />
          </mxCell></UserObject><UserObject id="divp" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\in \mathbb{R}}\)；\({d\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R19&lt;/span&gt;&lt;br&gt;除正数不变向&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a\gt b, d\gt 0 \Rightarrow  \dfrac{a}{d} \gt  \dfrac{b}{d}}\)&lt;/span&gt;" 类型="中间结果" 适用范围="a,b∈ℝ；d&gt;0" 编号="R19" 层级="2"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="80" width="220" x="6800" y="760" as="geometry" />
          </mxCell></UserObject><UserObject id="sumadd" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R07&lt;/span&gt;&lt;br&gt;同向不等式可加&lt;br&gt;\({a\ge b, c\ge d \Rightarrow  a+c \ge  b+d}\)&lt;br&gt;其中一个为 &amp;gt; 时，结论为 &amp;gt;" 类型="中间结果" 适用范围="任意实数" 编号="R07" 层级="1"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="94" width="240" x="7840" y="411.5" as="geometry" />
