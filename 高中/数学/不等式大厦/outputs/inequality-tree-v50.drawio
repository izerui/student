          </mxCell></UserObject><UserObject id="e7" label="【分类讨论】\({x\lt 0}\)：令 \({a=0, b=c=x \Rightarrow  x^{2}\gt 0}\)&lt;br&gt;\({x=0}\) 时 \({x^{2}=0}\)" 类型="推导"><mxCell edge="1" parent="1" source="muln" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="sq"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="6600" y="628" /><mxPoint x="6560.3" y="628" /></Array><mxPoint x="-150" y="-78" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e11" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({0\lt a\lt b}\)&lt;/span&gt;&lt;br&gt;【作差】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{a} - \dfrac{1}{b} = \dfrac{b-a}{ab} \gt  0}\)&lt;/span&gt;（\({b-a \gt  0}\)，\({ab \gt  0}\)：正数 × 正数为正）" 类型="推导"><mxCell edge="1" parent="1" source="ax_order" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="recip" mark="▼ 本步：0&amp;lt;a&amp;lt;b"><mxGeometry relative="1" as="geometry" x="1" y="0">
