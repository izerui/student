          </mxCell></UserObject><UserObject id="e23" label="【同除】两边 \({\div 4}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a^{2}+b^{2}}{2} \ge  \dfrac{(a+b)^{2}}{4} = \left(\dfrac{a+b}{2}\right)^{2}}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="sum2" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.3960;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="half"><mxGeometry relative="1" as="geometry" x="0.0852">
              <Array as="points"><mxPoint x="9539.0" y="3223.1" /><mxPoint x="9490.2" y="3223.1" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e25" label="【等价转化】恒\({\ge 0 \iff}\) 最小值\({\ge 0}\)&lt;br&gt;即 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({-\dfrac{\Delta }{4a}\ge 0 \iff  \Delta \le 0}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="qmin" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=1.0000;exitY=0.6644;exitDx=0;exitDy=0;entryX=0.3522;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="qall"><mxGeometry relative="1" as="geometry" x="0.5068">
