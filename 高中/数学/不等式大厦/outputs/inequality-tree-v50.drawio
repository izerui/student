          </mxCell></UserObject><UserObject id="abs_sum" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R29&lt;/span&gt;&lt;br&gt;\({-(|a|+|b|) \le  a+b \le  |a|+|b|}\)" 类型="中间结果" 适用范围="任意实数" 编号="R29" 层级="3"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="48" width="260" x="2337" y="6088" as="geometry" />
          </mxCell></UserObject><UserObject id="triangle" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R36&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 三角不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|a+b| \le  |a|+|b|}\)&lt;br&gt;等号 \({\iff  ab \ge  0}\)&lt;br&gt;b 换成 −b：\({|a-b| \le  |a| + |b|}\)&lt;br&gt;推广到 n 项：&lt;br&gt;\({|a_{1}+\cdots +a_{n}| \le  |a_{1}|+\cdots +|a_{n}|}\)&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R36" 层级="4" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="152" width="290" x="2322" y="6284" as="geometry" />
