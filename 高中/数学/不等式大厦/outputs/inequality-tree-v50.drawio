n=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;fontStyle=1;fontSize=16;fontColor=#263238;" value="节点：颜色表示类型和适用范围，★ 越多越重要"><mxGeometry x="20" y="50" width="760" height="32" as="geometry" /></mxCell><mxCell id="lg2" parent="legend" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;" value="【公理】【定义】【定理】"><mxGeometry x="20" y="90" width="200" height="40" as="geometry" /></mxCell><mxCell id="lg3" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="紫色：起点，直接承认或定义"><mxGeometry x="240" y="90" width="540" height="40" as="geometry" /></mxCell><mxCell id="lg4" parent="legend" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;" value="★ 结论"><mxGeometry x="20" y="138" width="200" height="40" as="geometry" /></mxCell><mxCell id="lg5" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="绿色：结论，主变量取任意实数（若有橙色标签，只限制标签里的参数）"><mxGeometry x="240" y="138" width="540" height="40" as="geometry" /></mxCell><mxCell id="lg6" parent="legend" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" value="中间结果"><mxGeometry x="20" y="186" width="200" height="40" as="geometry" /></mxCell><mxCell id="lg7" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="白底：推导中间一步，主变量取任意实数（橙色标签同上）"><mxGeometry x="240" y="186" width="540" height="40" as="geometry" /></mxCell><mxCell id="lg8" parent="legend" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;" value="★ 结论（有条件）"><mxGeometry x="20" y="234" width="200" height="40" as="geometry" /></mxCell><mxCell id="lg9" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="橙色：要求 \({\ge 0}\)、\({\gt 0}\) 或其他条件，标题旁写明限制哪些量"><mxGeometry x="240" y="234" width="540" height="40" as="geometry" /></mxCell><mxCell id="lg10" parent="legend" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;" value="中间结果（有条件）"><mxGeometry x="20" y="282" width="200" height="40" as="geometry" /></mxCell><mxCell id="lg11" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="淡橙：有条件的中间一步"><mxGeometry x="240" y="282" width="540" height="40" as="geometry" /></mxCell><mxCell id="lg12" parent="legend" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;" value="工具箱公式"><mxGeometry x="20" y="330" width="200" height="40" as="geometry" /></mxCell><mxCell id="lg13" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="蓝色：借用的公式（也是工具），不画线"><mxGeometry x="240" y="330" width="540" height="40" as="geometry" /></mxCell><mxCell id="lg14" parent="legend" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" value="看到… / 反推…"><mxGeometry x="20" y="378" width="200" height="40" as="geometry" /></mxCell><mxCell id="lg15" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="青绿虚线框：题型入口，集中在左侧目录，做题从这里进"><mxGeometry x="240" y="378" width="540" height="40" as="geometry" /></mxCell><mxCell id="lg16" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;fontStyle=1;fontSize=16;fontColor=#263238;" value="节点标题上的小标签"><mxGeometry x="20" y="434" width="760" height="32" as="geometry" /></mxCell><mxCell id="lg17" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;align=center;" value="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:12px;font-weight:bold;&quot;&gt; \({\ge 0}\) &lt;/span&gt; &lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:12px;font-weight:bold;&quot;&gt; \({x\ge -1}\) &lt;/span&gt;"><mxGeometry x="20" y="474" width="200" height="32" as="geometry" /></mxCell><mxCell id="lg18" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="橙色标签：使用条件，写明限制哪些量；没有橙色标签 = 对任意实数成立"><mxGeometry x="240" y="474" width="540" height="32" as="geometry" /></mxCell><mxCell id="lg19" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;align=center;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt; &lt;span style=&quot;font-size:12px;color:#78909C;&quot;&gt;R12&lt;/span&gt;"><mxGeometry x="20" y="512" width="200" height="32" as="geometry" /></mxCell><mxCell id="lg20" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="灰色“拓展”：竞赛内容，可先跳过；编号 S 起点、R 实数域（参数条件见橙色标签）、P 正数域与条件域；蓝色“高考常用”：教材没单列、高考常用的结论或方法；棕色“解法”：几种方法配合工具的解题流程，写不成一个公式"><mxGeometry x="240" y="503.5" width="540" height="49" as="geometry" /></mxCell><mxCell id="lg21" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;fontStyle=1;fontSize=16;fontColor=#263238;" value="连线：深色 = 推导，浅灰 = 前提"><mxGeometry x="20" y="558" width="760" height="32" as="geometry" /></mxCell><mxCell id="lg22" parent="legend" edge="1" style="html=1;rounded=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="614" as="sourcePoint" /><mxPoint x="220" y="614" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lg23" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="实线：推导，越粗越是主干；线上【】是方法（具体做法，归属 12 类见左侧“方法”一栏），「」是套用的工具（公式），其余是具体操作"><mxGeometry x="240" y="598" width="540" height="32" as="geometry" /></mxCell><mxCell id="lg22b" parent="legend" edge="1" style="html=1;rounded=1;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="660.0" as="sourcePoint" /><mxPoint x="220" y="660.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lg23b" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="浅灰线：前提——引用别处已推出的结论，线上写【前提】"><mxGeometry x="240" y="644.0" width="540" height="32" as="geometry" /></mxCell><mxCell id="lg24" parent="legend" vertex="1" style="rounded=1;arcSize=8;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;" value="公式工具"><mxGeometry x="20" y="690.0" width="200" height="32" as="geometry" /></mxCell><mxCell id="lg25" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="蓝底大框：公式与工具箱（不画线，按编号 ①② 查）"><mxGeometry x="240" y="690.0" width="540" height="32" as="geometry" /></mxCell><mxCell id="lg26" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;fontStyle=1;fontSize=16;fontColor=#263238;" value="文字标记"><mxGeometry x="20" y="736.0" width="760" height="32" as="geometry" /></mxCell><mxCell id="lg27" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;align=center;" value="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域 / ▼ 加条件&lt;/span&gt;"><mxGeometry x="20" y="776.0" width="200" height="32" as="geometry" /></mxCell><mxCell id="lg28" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="分水岭：从这一步起有使用条件，后面写明限制哪些量"><mxGeometry x="240" y="776.0" width="540" height="32" as="geometry" /></mxCell><mxCell id="lg29" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;align=center;" value="&lt;span style=&quot;color:#2E7D32;&quot;&gt;⇐ 前提&lt;/span&gt; &lt;span style=&quot;color:#1565C0;&quot;&gt;⇐ 工具 ②&lt;/span&gt;"><mxGeometry x="20" y="814.0" width="200" height="32" as="geometry" /></mxCell><mxCell id="lg30" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="节点里注明用到的前提 / 公式"><mxGeometry x="240" y="814.0" width="540" height="32" as="geometry" /></mxCell><mxCell id="lg31" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;align=center;" value="&lt;b style=&quot;color:#004D40;&quot;&gt;〔R36 · C6〕&lt;/b&gt;"><mxGeometry x="20" y="852.0" width="200" height="32" as="geometry" /></mxCell><mxCell id="lg32" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="编号 · 坐标：按图边上的字母（列）和数字（行）找到格子"><mxGeometry x="240" y="852.0" width="540" height="32" as="geometry" /></mxCell><mxCell id="lg33" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;align=center;" value="&lt;span style=&quot;color:#607D8B;&quot;&gt;⋯ 配合 / ⋯ 同源&lt;/span&gt;"><mxGeometry x="20" y="890.0" width="200" height="32" as="geometry" /></mxCell><mxCell id="lg34" parent="legend" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;whiteSpace=wrap;" value="配合：解题时常一起用；同源：特例或推广关系（都不是本图的推导线）"><mxGeometry x="240" y="890.0" width="540" height="32" as="geometry" /></mxCell><UserObject id="sub_opp" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R75&lt;/span&gt;&lt;br&gt;★ 异向不等式可减&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a\gt b}\)，\({c\lt d \Rightarrow  a-c \gt  b-d}\)&lt;br&gt;⚠ 同向不等式不能相减：\({5\gt 4}\)，\({3\gt 0}\)，但 \({5-3=2 \lt  4-0=4}\)&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R75" 层级="2"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="7800" y="760" width="380" height="84" as="geometry" /></mxCell></UserObject><UserObject id="v33e1" label="【作差】\({(a-c)-(b-d) = (a-b)+(d-c) \gt  0}\)" 类型="推导"><mxCell parent="1" edge="1" source="sumadd" target="sub_opp" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="1" y="0"><Array as="points"><mxPoint x="7960" y="710" /><mxPoint x="7990" y="710" /></Array><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="div_opp" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a\gt b\gt 0}\)；\({0\lt d\lt c}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P50&lt;/span&gt;&lt;br&gt;★ 异向正数不等式可除&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a\gt b\gt 0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({0\lt d\lt c \Rightarrow  \dfrac{a}{d} \gt  \dfrac{b}{c}}\)&lt;/span&gt;&lt;br&gt;⚠ 同向正数不等式不能对应项相除：\({4\gt 3}\)，\({4\gt 1}\)，但 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{4}{4}=1 \lt  \dfrac{3}{1}=3}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="a&gt;b&gt;0；0&lt;d&lt;c" 编号="P50" 层级="4"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="7600" y="1050" width="400" height="116" as="geometry" /></mxCell></UserObject><UserObject id="v33e2" label="「同向正数可乘」\({a\gt b\gt 0}\) 与 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{d}\gt \dfrac{1}{c}\gt 0}\)&lt;/span&gt; 相乘" 类型="推导"><mxCell parent="1" edge="1" source="mul_pos" target="div_opp" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="1" y="0"><Array as="points"><mxPoint x="7220" y="964" /><mxPoint x="7720" y="964" /></Array><mxPoint x="-150" y="-29" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="v33e3" label="【前提】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({0\lt d\lt c \Rightarrow  \dfrac{1}{d} \gt  \dfrac{1}{c}}\)&lt;/span&gt;" 类型="汇合"><mxCell parent="1" edge="1" source="recip" target="div_opp" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="1" y="0"><Array as="points"><mxPoint x="8380" y="980" /><mxPoint x="7900" y="980" /></Array><mxPoint x="150" y="-29" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="exp2" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\ge 0}\)（\({x\le 0}\) 时反向） &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P51&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;泰勒放缩（二阶）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({e^{x} \ge  1 + x + \dfrac{x^{2}}{2}}\)&lt;/span&gt;（\({x\ge 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({x\le 0}\) 时不等号反向：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({e^{x} \le  1 + x + \dfrac{x^{2}}{2}}\)&lt;/span&gt;&lt;br&gt;等号 \({\iff  x=0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：比一阶的 \({e^{x} \ge  1+x}\) 更贴近 \({e^{x}}\)，压轴题一阶不够用时换它&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="x≥0（x≤0 时反向）" 编号="P51" 层级="2" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="4598" y="5973" width="400" height="148" as="geometry" /></mxCell></UserObject><UserObject id="v33e4" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 加条件：\({x\ge 0}\)（\({x\le 0}\) 时反向）&lt;/span&gt;&lt;br&gt;【构造函数】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({g(x) = e^{x} - 1 - x - \dfrac{x^{2}}{2}}\)&lt;/span&gt;&lt;br&gt;【求导】\({g'(x) = e^{x} - 1 - x \ge  0}\)（由 \({e^{x} \ge  1+x}\)），只在 \({x=0}\) 处为 0&lt;br&gt;「单调性」g 在 ℝ 上递增，\({g(0)=0}\)：\({x\ge 0}\) 时 \({g(x)\ge 0}\)，\({x\le 0}\) 时 \({g(x)\le 0}\)" 类型="推导"><mxCell parent="1" edge="1" source="expineq" target="exp2" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 加条件：x≥0（x≤0 时反向）"><mxGeometry relative="1" as="geometry" x="0.0871"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="cos2" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R76&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;泰勒放缩（二阶）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos  x \ge  1 - \dfrac{x^{2}}{2}}\)&lt;/span&gt;（\({x\in \mathbb{R}}\)）&lt;br&gt;等号 \({\iff  x=0}\)" 类型="结论" 适用范围="任意实数" 编号="R76" 层级="2" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;"><mxGeometry x="5045" y="5996" width="360" height="101" as="geometry" /></mxCell></UserObject><UserObject id="v33e5" label="【构造函数】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x) = \cos  x - 1 + \dfrac{x^{2}}{2}}\)&lt;/span&gt;&lt;br&gt;【求导】\({f'(x) = x - \sin  x \ge  0}\)（\({x\ge 0}\)，由 \({|\sin  x| \le  |x|}\)）&lt;br&gt;「单调性」\({x\ge 0}\) 时 \({f(x) \ge  f(0) = 0}\)&lt;br&gt;【对称】f 是偶函数，\({x\lt 0}\) 时同样成立" 类型="推导"><mxCell parent="1" edge="1" source="sinx_ineq" target="cos2" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.6190;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.3535"><Array as="points"><mxPoint x="5081.9" y="5863.7" /><mxPoint x="5224.6" y="5863.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="sin3" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P52&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;泰勒放缩（三阶）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin  x \ge  x - \dfrac{x^{3}}{6}}\)&lt;/span&gt;（\({x\ge 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;等号 \({\iff  x=0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：与 \({\sin  x \le  x}\) 合起来，\({x\ge 0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x - \dfrac{x^{3}}{6} \le  \sin  x \le  x}\)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="x≥0" 编号="P52" 层级="3" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="5045" y="6335" width="360" height="130" as="geometry" /></mxCell></UserObject><UserObject id="v33e6" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({x\ge 0}\)&lt;/span&gt;&lt;br&gt;【构造函数】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({h(x) = \sin  x - x + \dfrac{x^{3}}{6}}\)&lt;/span&gt;&lt;br&gt;【求导】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({h'(x) = \cos  x - 1 + \dfrac{x^{2}}{2} \ge  0}\)&lt;/span&gt;（就是上一条）&lt;br&gt;「单调性」\({x\ge 0}\) 时 \({h(x) \ge  h(0) = 0}\)" 类型="推导"><mxCell parent="1" edge="1" source="cos2" target="sin3" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 加条件：x≥0"><mxGeometry relative="1" as="geometry" x="0.1134"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="ln2" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\ge 0}\)（\({-1\lt x\le 0}\) 时反向） &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P53&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;泰勒放缩（二阶）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln (1+x) \ge  x - \dfrac{x^{2}}{2}}\)&lt;/span&gt;（\({x\ge 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({-1\lt x\le 0}\) 时不等号反向；等号 \({\iff  x=0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：与 \({\ln (1+x) \le  x}\) 合起来，\({x\ge 0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x - \dfrac{x^{2}}{2} \le  \ln (1+x) \le  x}\)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="x≥0（−1&lt;x≤0 时反向）" 编号="P53" 层级="1" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="7286" y="5620" width="420" height="130" as="geometry" /></mxCell></UserObject><UserObject id="v33e7" label="【构造函数】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\varphi (x) = \ln (1+x) - x + \dfrac{x^{2}}{2}}\)&lt;/span&gt;（\({x\gt -1}\)）&lt;br&gt;【求导】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\varphi '(x) = \dfrac{1}{1+x} - 1 + x = \dfrac{x^{2}}{1+x} \ge  0}\)&lt;/span&gt;&lt;br&gt;「单调性」φ 在 \({(-1,+\infty)}\) 上递增，\({\varphi (0)=0}\)：\({x\ge 0}\) 时 \({\varphi (x)\ge 0}\)" 类型="推导"><mxCell parent="1" edge="1" source="ax_deriv" target="ln2" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=1.0000;exitY=0.4995;exitDx=0;exitDy=0;entryX=0.4976;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.8485"><Array as="points"><mxPoint x="7494.5" y="5317.6" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="sqrt_split_lo" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 正整数 k &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P54&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 根式裂项（下界）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\sqrt{k}} \gt  2\left(\sqrt{k+1} - \sqrt{k}\right)}\)&lt;/span&gt;（\({k \ge  1}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Rightarrow  1 + \dfrac{1}{\sqrt{2}} + \cdots  + \dfrac{1}{\sqrt{n}} \gt  2\left(\sqrt{n+1} - 1\right)}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：与根式裂项（上界）合起来，把和夹在两个能算出的式子之间&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="正整数 k" 编号="P54" 层级="4" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="12364" y="5491" width="420" height="130" as="geometry" /></mxCell></UserObject><UserObject id="v33e8" label="【取倒数】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sqrt{k+1} + \sqrt{k} \gt  2\sqrt{k} \gt  0 \Rightarrow  \dfrac{1}{\sqrt{k}} = \dfrac{2}{2\sqrt{k}} \gt  \dfrac{2}{\sqrt{k+1} + \sqrt{k}}}\)&lt;/span&gt;&lt;br&gt;【分母有理化】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{2}{\sqrt{k+1} + \sqrt{k}} = 2\left(\sqrt{k+1} - \sqrt{k}\right)}\)&lt;/span&gt;&lt;br&gt;【裂项】求和时中间项相消，剩 \({2\left(\sqrt{n+1} - 1\right)}\)" 类型="推导"><mxCell parent="1" edge="1" source="recip" target="sqrt_split_lo" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9830"><Array as="points"><mxPoint x="8380.0" y="1345.6" /><mxPoint x="7089.2" y="1345.6" /><mxPoint x="7409.2" y="1345.6" /><mxPoint x="12796.7" y="1345.6" /><mxPoint x="13116.7" y="1345.6" /><mxPoint x="13116.7" y="1665.6" /><mxPoint x="13116.7" y="4694.7" /><mxPoint x="13116.7" y="5014.7" /><mxPoint x="12796.7" y="5014.7" /><mxPoint x="11845.7" y="5014.7" /><mxPoint x="11525.7" y="5014.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5130.7" /><mxPoint x="11845.7" y="5130.7" /><mxPoint x="12253.5" y="5130.7" /><mxPoint x="12573.5" y="5130.7" /><mxPoint x="12573.5" y="5312.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="split_tight" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 正整数 \({k\ge 2}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P55&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 更紧的裂项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k^{2}} \lt  \dfrac{1}{k^{2}-1} = \tfrac12 \left[\dfrac{1}{k-1} - \dfrac{1}{k+1}\right] \Rightarrow  1 + \dfrac{1}{2^{2}} + \cdots  + \dfrac{1}{n^{2}} \lt  \dfrac{7}{4}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k^{2}} \lt  \dfrac{4}{4k^{2}-1} = 2\left[\dfrac{1}{2k-1} - \dfrac{1}{2k+1}\right] \Rightarrow  1 + \dfrac{1}{2^{2}} + \cdots  + \dfrac{1}{n^{2}} \lt  \dfrac{5}{3}}\)&lt;/span&gt;&lt;br&gt;两式都从 \({k=2}\) 起放缩，首项 1 保留不放&lt;/div&gt;" 类型="结论" 适用范围="正整数 k≥2" 编号="P55" 层级="5" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="10727" y="5794" width="460" height="169" as="geometry" /></mxCell></UserObject><UserObject id="v33e9" label="【放缩】分母减得越少，放大得越少：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({k(k-1) \lt  k^{2}-1 \lt  k^{2}-\dfrac{1}{4} \lt  k^{2}}\)&lt;/span&gt;&lt;br&gt;【裂项】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k^{2}-1} = \tfrac12 \left[\dfrac{1}{k-1} - \dfrac{1}{k+1}\right]}\)&lt;/span&gt;；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{4}{4k^{2}-1} = 2\left[\dfrac{1}{2k-1} - \dfrac{1}{2k+1}\right]}\)&lt;/span&gt;&lt;br&gt;【保留首项】\({k=2}\) 起求和：前者 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\lt  \tfrac12 \left(1 + \tfrac12\right) = \dfrac{3}{4}}\)&lt;/span&gt;，后者 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\lt  \dfrac{2}{3}}\)&lt;/span&gt;；再加首项 1" 类型="推导"><mxCell parent="1" edge="1" source="split_frac" target="split_tight" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1358"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="root_ineq" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 定义域内 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P56&lt;/span&gt;&lt;br&gt;★ 根式（无理）不等式的等价形式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sqrt{f(x)} \gt  g(x) \iff  \{f(x) \ge  0}\) 且 \({g(x) \lt  0\}}\) 或 \({\{g(x) \ge  0}\) 且 \({f(x) \gt  g(x)^{2}\}}\)&lt;br&gt;\({\sqrt{f(x)} \lt  g(x) \iff  f(x) \ge  0}\) 且 \({g(x) \gt  0}\) 且 \({f(x) \lt  g(x)^{2}}\)&lt;br&gt;先查定义域 \({f(x) \ge  0}\)；只有两边都非负时才能平方&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;（新教材不作要求，老题常见）&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="定义域内" 编号="P56" 层级="2"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="3477" y="3052" width="460" height="133" as="geometry" /></mxCell></UserObject><UserObject id="v33e10" label="【分类讨论】按 g(x) 的正负分情况：\({g(x)\lt 0}\) 时 \({\sqrt{f(x)} \ge  0 \gt  g(x)}\) 自动成立&lt;br&gt;【平方】\({g(x) \ge  0}\) 时两边都非负，平方不改变方向（非负数平方保序）" 类型="推导"><mxCell parent="1" edge="1" source="sq_mono" target="root_ineq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9614"><Array as="points"><mxPoint x="6055.0" y="498.0" /><mxPoint x="6055.0" y="1345.6" /><mxPoint x="6488.4" y="1345.6" /><mxPoint x="6168.4" y="1345.6" /><mxPoint x="3167.6" y="1345.6" /><mxPoint x="2847.6" y="1345.6" /><mxPoint x="2847.6" y="1665.6" /><mxPoint x="2847.6" y="2315.2" /><mxPoint x="2847.6" y="2635.2" /><mxPoint x="3167.6" y="2635.2" /><mxPoint x="3387.4" y="2635.2" /><mxPoint x="3707.4" y="2635.2" /><mxPoint x="3707.4" y="2837.9" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="cube3" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a+b+c\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P57&lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;三元均值不等式的多项式形式（\({a,b,c \ge  0}\) 时）&lt;/span&gt;&lt;br&gt;\({a^{3} + b^{3} + c^{3} \ge  3abc}\)（\({a+b+c \ge  0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;等号 \({\iff  a=b=c}\) 或 \({a+b+c=0}\)&lt;br&gt;（\({a,b,c \ge  0}\) 时最常用）&lt;/div&gt;" 类型="结论" 适用范围="a+b+c≥0" 编号="P57" 层级="9"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="9919" y="3778" width="440" height="102" as="geometry" /></mxCell></UserObject><UserObject id="v33e11" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 加条件：\({a+b+c\ge 0}\)&lt;/span&gt;&lt;br&gt;【因式分解】\({a^{3}+b^{3}+c^{3}-3abc = (a+b+c)(a^{2}+b^{2}+c^{2}-ab-bc-ca)}\)&lt;br&gt;「同号相乘」\({a+b+c \ge  0}\)，且 \({a^{2}+b^{2}+c^{2} \ge  ab+bc+ca \Rightarrow}\) 乘积 \({\ge  0}\)" 类型="推导"><mxCell parent="1" edge="1" source="three_sq" target="cube3" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.8719;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 加条件：a+b+c≥0"><mxGeometry relative="1" as="geometry" x="0.3574"><Array as="points"><mxPoint x="9983.9" y="3621.0" /><mxPoint x="10139.2" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="v33e12" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({x,y,z\ge 0}\)&lt;/span&gt;&lt;br&gt;【代换】令 \({a=\sqrt[3]{x}}\)，\({b=\sqrt[3]{y}}\)，\({c=\sqrt[3]{z}}\)（\({x,y,z \ge  0}\)，则 \({a+b+c \ge  0}\)）&lt;br&gt;\({x + y + z \ge  3\sqrt[3]{xyz}}\)，两边 \({\div 3}\)（另一条路：不用 n 元均值）" 类型="推导"><mxCell parent="1" edge="1" source="cube3" target="am3" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5823;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0896;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 本步：x,y,z≥0"><mxGeometry relative="1" as="geometry" x="-0.8088"><Array as="points"><mxPoint x="10175.4" y="3994.0" /><mxPoint x="10330.2" y="3994.0" /><mxPoint x="10330.2" y="4025.7" /><mxPoint x="10978.0" y="4025.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="powmean" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a_{i}\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P58&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 幂平均不等式（拓展）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({M_{p} = \left(\dfrac{a_{1}^{p}+\cdots +a_{n}^{p}}{n}\right)^{\frac{1}{p}}}\)&lt;/span&gt;（\({p\ne 0}\)），\({M_{0} = \sqrt[n]{a_{1}a_{2}\cdots a_{n}}}\)&lt;br&gt;\({p \lt  q \Rightarrow  M_{p} \le  M_{q}}\)；等号 \({\iff  a_{i}}\) 全相等&lt;br&gt;\({p = -1}\)、0、1、2 就是 调和 ≤ 几何 ≤ 算术 ≤ 平方 平均&lt;/div&gt;" 类型="结论" 适用范围="aᵢ&gt;0" 编号="P58" 层级="3" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="6844" y="6333" width="460" height="135" as="geometry" /></mxCell></UserObject><UserObject id="v33e13" label="【构造函数】\({0\lt p\lt q}\) 时取 \({f(t) = t^{\frac{q}{p}}}\)（\({t\gt 0}\)），&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{q}{p}\gt 1 \Rightarrow  f'' \ge  0}\)&lt;/span&gt;（下凸）&lt;br&gt;【取特值】对 \({x_{i} = a_{i}^{p}}\) 用琴生：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\sum a_{i}^{q}}{n} \ge  \left(\dfrac{\sum a_{i}^{p}}{n}\right)^{\frac{q}{p}}}\)&lt;/span&gt;，两边开 q 次方&lt;br&gt;\({p\lt 0}\) 或含 0 的情形同理或取极限（超出高中）" 类型="推导"><mxCell parent="1" edge="1" source="jensen" target="powmean" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0325"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="holder" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a_{i},b_{i}\ge 0}\)；\({p,q\gt 1}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{p}+\dfrac{1}{q}=1}\)&lt;/span&gt; &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P59&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 赫尔德不等式（拓展）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_{1}b_{1}+\cdots +a_{n}b_{n} \le  \left(\sum a_{i}^{p}\right)^{\frac{1}{p}} \cdot  \left(\sum b_{i}^{q}\right)^{\frac{1}{q}}}\)&lt;br&gt;等号 \({\iff  a_{i}^{p}}\) 与 \({b_{i}^{q}}\) 对应成比例&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：\({p = q = 2}\) 时就是柯西不等式（n 项）&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="aᵢ,bᵢ≥0；p,q&gt;1，1/p+1/q=1" 编号="P59" 层级="12" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="11963" y="4743" width="480" height="114" as="geometry" /></mxCell></UserObject><UserObject id="v33e14" label="【取特值】加权均值取两个数、权 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{p}}\)&lt;/span&gt; 与 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{q}}\)&lt;/span&gt;：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x^{\frac{1}{p}}\cdot y^{\frac{1}{q}} \le  \dfrac{x}{p} + \dfrac{y}{q}}\)&lt;/span&gt;（\({x,y \ge  0}\)）&lt;br&gt;【归一化】记 \({A=\sum a_{i}^{p}}\)，\({B=\sum b_{i}^{q}}\)（A、B 有一个为 0 时两边都是 0）；取 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=\dfrac{a_{i}^{p}}{A}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({y=\dfrac{b_{i}^{q}}{B}}\)&lt;/span&gt;&lt;br&gt;「同向可加」&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sum \dfrac{a_{i}b_{i}}{A^{\frac{1}{p}}\cdot B^{\frac{1}{q}}} \le  \dfrac{1}{p} + \dfrac{1}{q} = 1}\)&lt;/span&gt;&lt;br&gt;p 为有理数时用加权均值即可；&lt;br&gt;任意实数 p：【构造函数】\({g(x)=\dfrac{x}{p}+\dfrac{1}{q}-x^{\frac{1}{p}}}\)（\({x\gt 0}\)），【求导】\({g'(x)=\dfrac{1}{p}\left(1-x^{\frac{1}{p}-1}\right)}\)，\({x=1}\) 处取最小值 0；【代换】令 \({x=\dfrac{X}{Y}}\)（\({Y\gt 0}\)），两边乘 Y 即得上式" 类型="推导"><mxCell parent="1" edge="1" source="wam" target="holder" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.4798;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="-0.0509"><Array as="points"><mxPoint x="12229.2" y="4630.1" /><mxPoint x="12203.1" y="4630.1" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><mxCell id="bg1" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="-80" y="-80" as="sourcePoint" /><mxPoint x="-80" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg2" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="1085" y="-80" as="sourcePoint" /><mxPoint x="1085" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg3" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="2250" y="-80" as="sourcePoint" /><mxPoint x="2250" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg4" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="3415" y="-80" as="sourcePoint" /><mxPoint x="3415" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg5" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="4580" y="-80" as="sourcePoint" /><mxPoint x="4580" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg6" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="5745" y="-80" as="sourcePoint" /><mxPoint x="5745" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg7" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="6910" y="-80" as="sourcePoint" /><mxPoint x="6910" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg8" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="8075" y="-80" as="sourcePoint" /><mxPoint x="8075" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg9" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="9240" y="-80" as="sourcePoint" /><mxPoint x="9240" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg10" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="10405" y="-80" as="sourcePoint" /><mxPoint x="10405" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg11" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="11570" y="-80" as="sourcePoint" /><mxPoint x="11570" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg12" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="12735" y="-80" as="sourcePoint" /><mxPoint x="12735" y="7732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bg13" parent="bg" edge="1" value="" style="endArrow=none;html=1;strokeColor=#B0BEC5;strokeWidth=1;dashed=1;dashPattern=2 8;"><mxGeometry relative="1" as="geometry"><mxPoint x="13900" y="-80" as