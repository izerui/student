          </mxCell></UserObject><UserObject id="recip" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({0\lt a\lt b}\)；一般式 \({ab\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P17&lt;/span&gt;&lt;br&gt;★ 正数倒数反序&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({0\lt a\lt b \Rightarrow  \dfrac{1}{a} \gt  \dfrac{1}{b}}\)&lt;/span&gt;&lt;br&gt;（一般地：\({ab\gt 0}\) 时，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a\gt b \Rightarrow  \dfrac{1}{a} \lt  \dfrac{1}{b}}\)&lt;/span&gt;）&lt;/div&gt;" 类型="结论" 适用范围="0&lt;a&lt;b；一般式 ab&gt;0" 编号="P17" 层级="3"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="174" width="260" x="8250" y="420" as="geometry" />
          </mxCell></UserObject><UserObject id="abs_bound" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R09&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({-|x| \le  x \le  |x|}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：平方非负——\({|a|=\sqrt{a^{2}}}\)，绝对值与平方可互相转化&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R09" 层级="1"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="91.0" width="170" x="2382" y="5576" as="geometry" />
