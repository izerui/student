          </mxCell></UserObject><UserObject id="e26" label="【取特值】二次项系数 1、一次项系数 \({-3}\)、常数项 3（自变量用字母 a）&lt;br&gt;代入配方结果 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a\left(x+\dfrac{b}{2a}\right)^{2}-\dfrac{\Delta }{4a}}\)&lt;/span&gt;：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{2}-3a+3 = \left(a-\dfrac{3}{2}\right)^{2} + \dfrac{3}{4}}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="quad_sq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5856;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="ex1"><mxGeometry relative="1" as="geometry" x="0.5981">
              <Array as="points"><mxPoint x="4541.4" y="2189" /><mxPoint x="4541.4" y="2647.2" /><mxPoint x="4438.0" y="2647.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e27" label="「平方非负」平方\({\ge 0}\)，再&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({+\dfrac{3}{4}}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="ex1" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="ex2"><mxGeometry relative="1" as="geometry" x="0.0755">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e28" label="【同加】两边 \({+3a}\)" 类型="推导"><mxCell edge="1" parent="1" source="ex2" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="ex3"><mxGeometry relative="1" as="geometry" x="0.2460">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e29" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({u,v\ge 0}\)&lt;/span&gt;&lt;br&gt;【代换】令 \({a=\sqrt{u}, b=\sqrt{v}}\)&lt;br&gt;\({\left(\sqrt{u}-\sqrt{v}\right)^{2} \ge  0}\)&lt;br&gt;展开得 \({u+v \ge  2\sqrt{uv}}\)" 类型="推导"><mxCell edge="1" parent="1" source="sqsum" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.8217;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0243;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="rad" mark="▼ 本步：u,v≥0"><mxGeometry relative="1" as="geometry" x="0.3962">
              <Array as="points"><mxPoint x="9851.3" y="2854.7" /><mxPoint x="10121.0" y="2854.7" /><mxPoint x="10121.0" y="2886.1" /><mxPoint x="10299.1" y="2886.1" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e30" label="【同除】两边 \({\div 2}\)" 类型="推导"><mxCell edge="1" parent="1" source="rad" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=1.0000;exitY=0.5011;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.0680;entryDx=0;entryDy=0;curved=1;" target="am"><mxGeometry relative="1" as="geometry" x="0.1683">
              <Array as="points"><mxPoint x="10691.1" y="3055.7" /><mxPoint x="10691.1" y="3223.1" /><mxPoint x="10745.6" y="3223.1" /><mxPoint x="10745.6" y="3338.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e31" label="【开平方】记 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({Q=\sqrt{\dfrac{a^{2}+b^{2}}{2}}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({A=\dfrac{a+b}{2}}\)&lt;/span&gt;&lt;br&gt;\({Q^{2}\ge A^{2} \Rightarrow  Q\ge |A|}\)" 类型="推导"><mxCell edge="1" parent="1" source="half" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.4074;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5143;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="qm_step"><mxGeometry relative="1" as="geometry" x="0.1978">
              <Array as="points"><mxPoint x="9469.1" y="3621.0" /><mxPoint x="9425.2" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e32" label="「绝对值界」\({Q\ge |A|\ge A}\)&lt;br&gt;等号 \({\Leftrightarrow  a=b}\) 且 \({A\ge 0}\)，即 \({a=b\ge 0}\)" 类型="推导"><mxCell edge="1" parent="1" source="qm_step" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.7138;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3141;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="qmgeam"><mxGeometry relative="1" as="geometry" x="0.0798">
              <Array as="points"><mxPoint x="9495.2" y="3994.0" /><mxPoint x="9499.2" y="3994.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e33" label="【配凑】\({(u+v)^{2}-4uv = (u-v)^{2} \ge  0}\)&lt;br&gt;\({\Rightarrow  (u+v)^{2} \ge  4uv}\)（对任意实数成立）" 类型="推导"><mxCell edge="1" parent="1" source="dsq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.4951;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="prod"><mxGeometry relative="1" as="geometry" x="0.6601">
              <Array as="points"><mxPoint x="9226.7" y="2021.7" /><mxPoint x="9226.7" y="2179.2" /><mxPoint x="9198.2" y="2179.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e34" label="【同除】两边 \({\div 4}\)" 类型="推导"><mxCell edge="1" parent="1" source="prod" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="prodlim"><mxGeometry relative="1" as="geometry" x="0.0314">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e35" label="【代入消元】代入 \({u+v=S}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({uv \le  \dfrac{S^{2}}{4}}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="prodlim" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="fixsum"><mxGeometry relative="1" as="geometry" x="0.1791">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e36" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：要求 \({u,v\gt 0}\)（排除负数：\({u=v=-1}\) 时 \({u+v=-2\lt 2}\)）&lt;/span&gt;&lt;br&gt;【代入消元】直接代入 \({uv=P}\)&lt;br&gt;\({u+v \ge  2\sqrt{P}}\)" 类型="推导"><mxCell edge="1" parent="1" source="am" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.9264;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="fixprod" mark="▼ 要求 u,v&gt;0（排除负数：u=v=−1 时 u+v=−2&lt;2）"><mxGeometry relative="1" as="geometry" x="0.4660">
              <Array as="points"><mxPoint x="10679.1" y="3459.7" /><mxPoint x="10679.1" y="3621.0" /><mxPoint x="10550.2" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e37" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 要求 \({\gt 0}\)（不能取 0）&lt;/span&gt;&lt;br&gt;【代换】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({u=x, v=\dfrac{1}{x}}\)&lt;/span&gt;&lt;br&gt;\({uv=1}\)" 类型="推导"><mxCell edge="1" parent="1" source="am" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.1177;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5633;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="recip_sum" mark="▼ 要求 &amp;gt;0（不能取 0）"><mxGeometry relative="1" as="geometry" x="0.0028">
              <Array as="points"><mxPoint x="10862.4" y="3621.0" /><mxPoint x="10848.2" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e38" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 要求 \({\gt 0}\)（不能取 0）&lt;/span&gt;&lt;br&gt;【代换】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({u=\dfrac{a}{b}, v=\dfrac{b}{a}}\)&lt;/span&gt;&lt;br&gt;\({uv=1}\)" 类型="推导"><mxCell edge="1" parent="1" source="am" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.9566;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2141;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="ratio" mark="▼ 要求 &amp;gt;0（不能取 0）"><mxGeometry relative="1" as="geometry" x="0.0475">
              <Array as="points"><mxPoint x="11298.6" y="3621.0" /><mxPoint x="11406.4" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e39" label="【前提】\({H\le G}\)" 类型="汇合"><mxCell edge="1" parent="1" source="gmgehm" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=8;exitX=0.3305;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.6135;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="meanchain"><mxGeometry relative="1" as="geometry" x="0.8607">
              <Array as="points"><mxPoint x="11125.1" y="4304.7" /><mxPoint x="10150.2" y="4305.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e40" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 要求 \({\gt 0}\)（不能取 0）&lt;/span&gt;&lt;br&gt;【前提】\({G\le A}\)" 类型="汇合"><mxCell edge="1" parent="1" source="am" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=8;exitX=0.2794;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.0857;entryDx=0;entryDy=0;curved=1;" target="meanchain" mark="▼ 要求 &amp;gt;0（不能取 0）"><mxGeometry relative="1" as="geometry" x="0.0620">
              <Array as="points"><mxPoint x="10946.4" y="4157.5" /><mxPoint x="10872.6" y="4157.5" /><mxPoint x="10872.6" y="4406.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e41" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({a,b\gt 0}\)&lt;/span&gt;&lt;br&gt;【前提】\({A\le Q}\)" 类型="汇合"><mxCell edge="1" parent="1" source="qmgeam" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=8;exitX=0.9517;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2053;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="meanchain" mark="▼ 本步：a,b&amp;gt;0"><mxGeometry relative="1" as="geometry" x="0.3162">
              <Array as="points"><mxPoint x="9770.1" y="4305.0" /><mxPoint x="9819.1" y="4305.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e42" label="【代换】令 \({x = ad-bc}\)" 类型="推导"><mxCell edge="1" parent="1" source="sq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" target="c0"><mxGeometry relative="1" as="geometry" x="0.9341">
              <Array as="points"><mxPoint x="6600.5" y="1465.6" /><mxPoint x="6722.3" y="1465.6" /><mxPoint x="7042.3" y="1465.6" /><mxPoint x="7449.9" y="1465.6" /><mxPoint x="7769.9" y="1465.6" /><mxPoint x="7769.9" y="1572.6" /><mxPoint x="7769.9" y="1572.6" /><mxPoint x="7769.9" y="1679.6" /><mxPoint x="7655.4" y="1679.6" /><mxPoint x="7655.4" y="1679.6" /><mxPoint x="7540.9" y="1679.6" /><mxPoint x="7540.9" y="1826.5" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e43" label="【展开】\({(ad-bc)^{2} = a^{2}d^{2}-2abcd+b^{2}c^{2}}\)" 类型="推导"><mxCell edge="1" parent="1" source="c0" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="c1"><mxGeometry relative="1" as="geometry" x="0.0574">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e44" label="【移项】两边 \({+2abcd}\)&lt;br&gt;【配凑】再两边 \({+(ac+bd)^{2}}\)" 类型="推导"><mxCell edge="1" parent="1" source="c1" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="c2"><mxGeometry relative="1" as="geometry" x="-0.0617">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e45" label="【展开】展开左边新增的平方&lt;br&gt;左右两边的 \({+2abcd}\) 相互抵消" 类型="推导"><mxCell edge="1" parent="1" source="c2" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="c3"><mxGeometry relative="1" as="geometry" x="0.1096">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e46" label="【提公因式】左边提取公因式&lt;br&gt;\({= (a^{2}+b^{2})(c^{2}+d^{2})}\)" 类型="推导"><mxCell edge="1" parent="1" source="c3" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="cauchy2"><mxGeometry relative="1" as="geometry" x="0.1411">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e47" label="【代换】三个平方之和&lt;br&gt;\({x=av-bu, aw-cu, bw-cv}\)" 类型="推导"><mxCell edge="1" parent="1" source="sq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" target="c3_0"><mxGeometry relative="1" as="geometry" x="0.9340">
              <Array as="points"><mxPoint x="6600.5" y="1465.6" /><mxPoint x="6722.3" y="1465.6" /><mxPoint x="7042.3" y="1465.6" /><mxPoint x="7449.9" y="1465.6" /><mxPoint x="7769.9" y="1465.6" /><mxPoint x="7769.9" y="1572.6" /><mxPoint x="7769.9" y="1572.6" /><mxPoint x="7769.9" y="1679.6" /><mxPoint x="7884.5" y="1679.6" /><mxPoint x="7884.5" y="1679.6" /><mxPoint x="7999.0" y="1679.6" /><mxPoint x="7999.0" y="1826.6" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e48" label="【展开】逐个展开三个平方，再相加" 类型="推导"><mxCell edge="1" parent="1" source="c3_0" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="c3_1"><mxGeometry relative="1" as="geometry" x="0.0746">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e50" label="【展开】\({(a_{2}-a_{1})(b_{2}-b_{1}) = a_{2}b_{2}-a_{2}b_{1}-a_{1}b_{2}+a_{1}b_{1}}\)" 类型="推导"><mxCell edge="1" parent="1" source="rearr_setup" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="rearr_expand"><mxGeometry relative="1" as="geometry" x="0.1098">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e51" label="【移项】即 \({a_{1}b_{1}+a_{2}b_{2} \ge  a_{1}b_{2}+a_{2}b_{1}}\)" 类型="推导"><mxCell edge="1" parent="1" source="rearr_expand" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="rearr"><mxGeometry relative="1" as="geometry" x="0.0696">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e52" label="【调整】若有一对顺序相反，就交换它们（由两数情形，和不减）&lt;br&gt;反复交换，直到完全同序；逆序同理" 类型="推导"><mxCell edge="1" parent="1" source="rearr" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="rearr_n"><mxGeometry relative="1" as="geometry" x="0.0671">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e53" label="【轮换求和】把 b 依次往后挪一位、挪到末尾的回到开头，共挪 n 次&lt;br&gt;每次：同序和 ≥ 挪动后的和（排序不等式）&lt;br&gt;n 个式子相加：\({n\cdot (}\)同序和\({) \ge  (a_{1}+\cdots +a_{n})(b_{1}+\cdots +b_{n})}\)，再 \({\div n}\)" 类型="推导"><mxCell edge="1" parent="1" source="rearr_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="cheby"><mxGeometry relative="1" as="geometry" x="0.0617">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e54" label="【奠基】验证 \({n=1}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_induction" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5477;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2731;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="bern_base"><mxGeometry relative="1" as="geometry" x="0.0317">
              <Array as="points"><mxPoint x="10266.6" y="5555.8" /><mxPoint x="10267.6" y="5555.8" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e55" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 加条件：\({x\ge -1}\)&lt;/span&gt;&lt;br&gt;【递推】设 \({n=k}\) 成立，证 \({n=k+1}\)" 类型="推导"><mxCell edge="1" parent="1" source="bern_base" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5892;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3529;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="bern_step" mark="▼ 加条件：x≥−1"><mxGeometry relative="1" as="geometry" x="0.0683">
              <Array as="points"><mxPoint x="10349.8" y="5878.8" /><mxPoint x="10354.6" y="5878.8" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e56" label="【归纳】奠基+递推 ⇒ 对所有正整数 n 成立" 类型="推导"><mxCell edge="1" parent="1" source="bern_step" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="bernoulli"><mxGeometry relative="1" as="geometry" x="0.0746">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e57" label="【前提】\({kx^{2}\ge 0}\)（平方非负）&lt;br&gt;【放缩】去掉 \({kx^{2}}\) 这一项" 类型="汇合"><mxCell edge="1" parent="1" source="sq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7739;entryY=0.0000;entryDx=0;entryDy=0;" target="bern_step"><mxGeometry relative="1" as="geometry" x="0.9581">
              <Array as="points"><mxPoint x="6600.5" y="1345.6" /><mxPoint x="7018.6" y="1345.6" /><mxPoint x="7338.6" y="1345.6" /><mxPoint x="12796.7" y="1345.6" /><mxPoint x="13116.7" y="1345.6" /><mxPoint x="13116.7" y="1665.6" /><mxPoint x="13116.7" y="4694.7" /><mxPoint x="13116.7" y="5014.7" /><mxPoint x="12796.7" y="5014.7" /><mxPoint x="11845.7" y="5014.7" /><mxPoint x="11525.7" y="5014.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5130.7" /><mxPoint x="11205.7" y="5130.7" /><mxPoint x="10919.6" y="5130.7" /><mxPoint x="10599.6" y="5130.7" /><mxPoint x="10599.6" y="5421.2" /><mxPoint x="10599.6" y="5421.2" /><mxPoint x="10599.6" y="5711.8" /><mxPoint x="10591.6" y="5711.8" /><mxPoint x="10591.6" y="5711.8" /><mxPoint x="10583.6" y="5711.8" /><mxPoint x="10583.6" y="5859.6" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e58" label="【归纳】反复把两项合并成一项，每次用一次柯西分式" 类型="推导"><mxCell edge="1" parent="1" source="cauchy_frac" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0854;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.6523;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="power_sum"><mxGeometry relative="1" as="geometry" x="0.5596">
              <Array as="points"><mxPoint x="7385.4" y="3601.9" /><mxPoint x="7195.9" y="3602.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e59" label="【代换】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({u=ax, v=\dfrac{b}{x}}\)&lt;/span&gt;（\({x\gt 0}\)）&lt;br&gt;\({uv=ab}\) 为定值 \({\Rightarrow  u+v \ge  2\sqrt{ab}}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({ax=\dfrac{b}{x}}\)&lt;/span&gt; 即 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=\sqrt{\dfrac{b}{a}}}\)&lt;/span&gt; 时取等" 类型="推导"><mxCell edge="1" parent="1" source="fixprod" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.4748;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5143;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="hook_fn"><mxGeometry relative="1" as="geometry" x="0.0342">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e64" label="取等：a,b 不全为 0 时，点 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{a}{\sqrt{a^{2}+b^{2}}}, \dfrac{b}{\sqrt{a^{2}+b^{2}}}\right)}\)&lt;/span&gt; 在单位圆上&lt;br&gt;取 sinθ、cosθ 等于它（或它的相反数）即达到 \({\pm \sqrt{a^{2}+b^{2}}}\)；\({a=b=0}\) 时恒为 0" 类型="推导"><mxCell edge="1" parent="1" source="trig_cauchy" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.6124;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="trig_max"><mxGeometry relative="1" as="geometry" x="0.0885">
              <Array as="points"><mxPoint x="8901.0" y="5640.8" /><mxPoint x="8899.7" y="5640.8" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e65" label="【配凑】分三组&lt;br&gt;(a,b)(b,c)(a,c)&lt;br&gt;各用 \({a^{2}+b^{2}\ge 2ab}\)" 类型="推导"><mxCell edge="1" parent="1" source="sqsum" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.6436;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3723;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="three_sq_step"><mxGeometry relative="1" as="geometry" x="0.1475">
              <Array as="points"><mxPoint x="9817.5" y="2886.1" /><mxPoint x="9839.2" y="2886.1" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e66" label="【取特值】令 \({u=v=w=1}\)" 类型="推导"><mxCell edge="1" parent="1" source="cauchy3" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="sum_sq_step"><mxGeometry relative="1" as="geometry" x="0.0679">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e67" label="【等价转化】即 \({3(a^{2}+b^{2}+c^{2}) \ge  (a+b+c)^{2}}\)，左右互换写成 ≤" 类型="推导"><mxCell edge="1" parent="1" source="sum_sq_step" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="sum_sq"><mxGeometry relative="1" as="geometry" x="-0.0861">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e68" label="【取特值】令 \({r=s=1}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1^{2}}{x}+\dfrac{1^{2}}{y} \ge  \dfrac{(1+1)^{2}}{x+y}}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="cauchy_frac" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5374;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3981;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="recip_sum_ineq"><mxGeometry relative="1" as="geometry" x="-0.0001">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e70" label="【分组】前两项合并、第三项单独&lt;br&gt;「同号相乘」按各因子符号判断" 类型="推导"><mxCell edge="1" parent="1" source="schur_setup" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="schur_group"><mxGeometry relative="1" as="geometry" x="0.0668">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e71" label="【合并整理】两部分都 \({\ge  0}\)，相加得证&lt;br&gt;取 \({t=1}\) 展开得常用形式" 类型="推导"><mxCell edge="1" parent="1" source="schur_group" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="schur"><mxGeometry relative="1" as="geometry" x="0.0674">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e76" label="【取特值】取 \({n=3}\)" 类型="推导"><mxCell edge="1" parent="1" source="am_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0454;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7960;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="am3"><mxGeometry relative="1" as="geometry" x="0.5168">
              <Array as="points"><mxPoint x="11523.2" y="4304.7" /><mxPoint x="11319.2" y="4305.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e99" label="【配凑】两边 \({+(au+bv+cw)^{2}}\)，展开合并，交叉项抵消&lt;br&gt;【提公因式】左边 \({= (a^{2}+b^{2}+c^{2})(u^{2}+v^{2}+w^{2})}\)" 类型="推导"><mxCell edge="1" parent="1" source="c3_1" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="cauchy3"><mxGeometry relative="1" as="geometry" x="0.0662">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e110" label="【代换】\({(a-b)^{2} = (a+b)^{2}-4ab = s^{2}-4p \ge  0}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Rightarrow  p \le  \dfrac{s^{2}}{4}}\)&lt;/span&gt;（对任意实数 a,b 成立）" 类型="推导"><mxCell edge="1" parent="1" source="dsq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.7400;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3423;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="mean_sub"><mxGeometry relative="1" as="geometry" x="0.6283">
              <Array as="points"><mxPoint x="9826.2" y="2163.7" /><mxPoint x="9990.6" y="2163.7" /><mxPoint x="9990.6" y="2179.2" /><mxPoint x="10147.2" y="2179.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e113" label="【等价转化】\({a\gt 0}\) 时：&lt;br&gt;二次方程 \({h(x)=0}\) 有实数解 ⟺ 最小值 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({-\dfrac{\Delta }{4a} \le  0 \iff  \Delta \ge 0}\)&lt;/span&gt;&lt;br&gt;\({a \lt  0}\) 时方程两边乘 \({-1}\)（Δ 不变），同理" 类型="推导"><mxCell edge="1" parent="1" source="qmin" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.6644;exitDx=0;exitDy=0;entryX=0.6368;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="delta_range"><mxGeometry relative="1" as="geometry" x="0.6696">
              <Array as="points"><mxPoint x="4974.4" y="2502.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e132" label="【构造函数】令 \({h(x)=x-1-\ln  x}\)（\({x\gt 0}\)）&lt;br&gt;【求导】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({h'(x)=1-\dfrac{1}{x}=\dfrac{x-1}{x}}\)&lt;/span&gt;&lt;br&gt;「导数判单调」\({0\lt x\lt 1}\) 时 \({h'\lt 0}\) 递减；\({x\gt 1}\) 时 \({h'\gt 0}\) 递增&lt;br&gt;【求最值】\({x=1}\) 处取最小值 \({h(1)=0}\)&lt;br&gt;【移项】\({h(x)\ge 0 \Rightarrow  \ln  x \le  x-1}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.3356;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;curved=1;" target="logineq"><mxGeometry relative="1" as="geometry" x="0.5870">
              <Array as="points"><mxPoint x="4294.6" y="5295.7" /><mxPoint x="4294.6" y="5498.2" /><mxPoint x="4221.8" y="5498.2" /><mxPoint x="4221.8" y="5684.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e133" label="【构造函数】令 \({g(x)=e^{x}-1-x}\)&lt;br&gt;【求导】\({g'(x)=e^{x}-1}\)&lt;br&gt;「导数判单调」\({x\lt 0}\) 时 \({g'\lt 0}\) 递减；\({x\gt 0}\) 时 \({g'\gt 0}\) 递增&lt;br&gt;【求最值】\({x=0}\) 处取最小值 \({g(0)=0}\)&lt;br&gt;【移项】\({g(x)\ge 0 \Rightarrow  e^{x} \ge  1+x}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.6639;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="expineq"><mxGeometry relative="1" as="geometry" x="0.6689">
              <Array as="points"><mxPoint x="4799.6" y="5339.7" /><mxPoint x="4799.6" y="5498.2" /><mxPoint x="4797.5" y="5498.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e134" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 要求 \({\gt 0}\)（不能取 0）&lt;/span&gt;&lt;br&gt;【代换】用 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{a}}\)&lt;/span&gt;、&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{b}}\)&lt;/span&gt; 代入 \({\text{AM}\ge \text{GM}}\)&lt;br&gt;【同乘】两边 \({\times 2}\)" 类型="推导"><mxCell edge="1" parent="1" source="am" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.6558;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3766;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="hm_mid" mark="▼ 要求 &amp;gt;0（不能取 0）"><mxGeometry relative="1" as="geometry" x="-0.0427">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e135" label="【分组】2→4：分两组各用 \({\text{AM}\ge \text{GM}}\)，再对两组的几何平均用一次&lt;br&gt;【重复】同理 \({4\to 8\to \cdots \to 2^{k}}\)" 类型="推导"><mxCell edge="1" parent="1" source="am" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=1.0000;exitY=0.5005;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="amn_mid"><mxGeometry relative="1" as="geometry" x="0.4308">
              <Array as="points"><mxPoint x="11619.1" y="3399.6" /><mxPoint x="11619.1" y="3621.0" /><mxPoint x="11733.2" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e136" label="【配方】提取 a，括号内配成完全平方&lt;br&gt;记号：记 \({\Delta  = b^{2}-4ac}\)" 类型="推导"><mxCell edge="1" parent="1" source="quad0" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="quad_sq"><mxGeometry relative="1" as="geometry" x="0.0674">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e137" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：要求 \({a,b,c\gt 0}\)（排除负数，分母不能为 0）&lt;/span&gt;&lt;br&gt;【配凑】每项 \({+1}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b+c}+1 = \dfrac{a+b+c}{b+c}}\)&lt;/span&gt;，记 \({S=a+b+c}\)&lt;br&gt;原式 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({= S\cdot \left[\dfrac{1}{b+c}+\dfrac{1}{c+a}+\dfrac{1}{a+b}\right] - 3}\)&lt;/span&gt;&lt;br&gt;【放缩】由三元 \({\text{AM}\ge \text{GM}}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(x+y+z)\left(\dfrac{1}{x}+\dfrac{1}{y}+\dfrac{1}{z}\right) \ge  3\sqrt[3]{xyz}\cdot \dfrac{3}{\sqrt[3]{xyz}} = 9}\)&lt;/span&gt;&lt;br&gt;取 x,y,z 为 \({b+c}\)、\({c+a}\)、\({a+b}\)（和为 2S）&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Rightarrow  \sum \dfrac{1}{b+c} \ge  \dfrac{9}{2S}}\)&lt;/span&gt;&lt;br&gt;⇒ 原式 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ge  S\cdot \dfrac{9}{2S} - 3 = \dfrac{3}{2}}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="am3" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.8359;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0230;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="nesbitt" mark="▼ 要求 a,b,c&gt;0（排除负数，分母不能为 0）"><mxGeometry relative="1" as="geometry" x="-0.5977">
              <Array as="points"><mxPoint x="11338.4" y="4630.1" /><mxPoint x="11711.4" y="4630.1" /><mxPoint x="11711.4" y="4671.7" /><mxPoint x="12486.3" y="4671.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e138" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({u,v\gt 0}\)；r,s不限正负&lt;/span&gt;&lt;br&gt;【取特值】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a=\dfrac{r}{\sqrt{u}}, b=\dfrac{s}{\sqrt{v}}, c=\sqrt{u}, d=\sqrt{v}}\)&lt;/span&gt;&lt;br&gt;【代入消元】代入柯西二项：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{r^{2}}{u}+\dfrac{s^{2}}{v}\right)(u+v) \ge  (r+s)^{2}}\)&lt;/span&gt;&lt;br&gt;【同除】两边 \({\div (u+v)}\)" 类型="推导"><mxCell edge="1" parent="1" source="cauchy2" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="cauchy_frac" mark="▼ 本步：u,v&amp;gt;0；r,s不限正负"><mxGeometry relative="1" as="geometry" x="0.0469">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e139" label="【配凑】把 \({a_{i}}\) 重复 \({w_{i}}\) 次，共 \({N=w_{1}+\cdots +w_{n}}\) 个数&lt;br&gt;【代入消元】对这 N 个数用 n 元 \({\text{AM}\ge \text{GM}}\)，整理得加权形式" 类型="推导"><mxCell edge="1" parent="1" source="am_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.9534;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3286;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="wam"><mxGeometry relative="1" as="geometry" x="0.5521">
              <Array as="points"><mxPoint x="11942.6" y="4304.7" /><mxPoint x="12132.1" y="4305.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e140" label="【构造函数】令 \({f(x)=x-\sin x}\)，\({g(x)=x+\sin x}\)（\({x\ge 0}\)）&lt;br&gt;【求导】\({f'=1-\cos x\ge 0}\)，\({g'=1+\cos x\ge 0}\)，且 \({f(0)=g(0)=0}\)&lt;br&gt;\({\Rightarrow  x\ge 0}\) 时 \({-x \le  \sin x \le  x}\)，即 \({|\sin x| \le  x}\)&lt;br&gt;\({x\gt 0}\) 时导数只在个别点为 \({0 \Rightarrow  f(x)\gt 0}\)、\({g(x)\gt 0}\)：只有 \({x=0}\) 取等&lt;br&gt;【对称】\({x\lt 0}\) 时用 \({|\sin (-x)|=|\sin x|}\)，得 \({|\sin x| \le  |x|}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.1396;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="sinx_ineq"><mxGeometry relative="1" as="geometry" x="0.3900">
              <Array as="points"><mxPoint x="5456.1" y="5460.7" /><mxPoint x="5301.8" y="5460.7" /><mxPoint x="5301.8" y="5498.2" /><mxPoint x="5054.6" y="5498.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e141" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：要求 \({a,b,c\ge 0}\)（三个不等式两边都非负才能相乘）&lt;/span&gt;&lt;br&gt;【分组】三对&lt;br&gt;(a,b)(b,c)(c,a)&lt;br&gt;各用 \({\text{AM}\ge \text{GM}}\)&lt;br&gt;三对分别用 \({\text{AM}\ge \text{GM}}\)：&lt;br&gt;\({a+b \ge  2\sqrt{ab}}\)&lt;br&gt;\({b+c \ge  2\sqrt{bc}}\)&lt;br&gt;\({c+a \ge  2\sqrt{ca}}\)&lt;br&gt;「同向正数可乘」三式相乘&lt;br&gt;右边 \({2^{3}\cdot \sqrt{a^{2}b^{2}c^{2}}=8abc}\)" 类型="推导"><mxCell edge="1" parent="1" source="am" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.9782;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4571;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="prod3" mark="▼ 要求 a,b,c≥0（三个不等式两边都非负才能相乘）"><mxGeometry relative="1" as="geometry" x="0.6722">
              <Array as="points"><mxPoint x="11309.8" y="3567.7" /><mxPoint x="11890.1" y="3567.7" /><mxPoint x="11890.1" y="3621.0" /><mxPoint x="12100.9" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e142" label="「同向可加」三式相加&lt;br&gt;三组配对求和&lt;br&gt;\({2(a^{2}+b^{2}+c^{2}) \ge  2(ab+bc+ca)}\)&lt;br&gt;【同除】两边 \({\div 2}\)" 类型="推导"><mxCell edge="1" parent="1" source="three_sq_step" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" target="three_sq"><mxGeometry relative="1" as="geometry" x="-0.0393">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ent_contra" label="&lt;b&gt;看到 至少 / 至多 / 存在 / 唯一 型结论&lt;/b&gt;&lt;br&gt;反推：假设反面成立（如都 \({\lt k}\)）→ 同向相加推出矛盾 ← 同向不等式可加&lt;br&gt;适用：直接证明困难、结论是“至少有一个”&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【反证】假设结论不成立，各式同向相加推出矛盾 → 同向不等式可加 &lt;b&gt;〔R07 · G1〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="92" width="520" x="-840" y="1009" as="geometry" />
          </mxCell></UserObject><UserObject id="v18_pos_rearr" label="「同号相乘」\({a_{2}-a_{1}\ge 0}\)，\({b_{2}-b_{1}\ge 0 \Rightarrow}\) 乘积 \({\ge  0}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_pos" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" target="rearr_setup"><mxGeometry relative="1" as="geometry" x="0.9784">
              <Array as="points"><mxPoint x="6042.0" y="151.0" /><mxPoint x="6042.0" y="1285.6" /><mxPoint x="6265.5" y="1285.6" /><mxPoint x="5945.5" y="1285.6" /><mxPoint x="1022.0" y="1285.6" /><mxPoint x="702.0" y="1285.6" /><mxPoint x="702.0" y="1482.6" /><mxPoint x="702.0" y="1482.6" /><mxPoint x="702.0" y="1679.6" /><mxPoint x="514.8" y="1679.6" /><mxPoint x="514.8" y="1679.6" /><mxPoint x="327.5" y="1679.6" /><mxPoint x="327.5" y="1837.9" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=16;fontFamily=PingFang SC;container=1;" value="图例" vertex="1"><mxGeometry height="934.0" width="800" x="-1800" as="geometry" y="-80" />
        </mxCell><UserObject id="fx1" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({a,b,c\ge 0}\)；\({t\gt 0}\)&lt;/span&gt;&lt;br&gt;【分类讨论】不妨设 \({a\ge b\ge c\ge 0}\)&lt;br&gt;「同号相乘」判断各因子符号" 类型="推导"><mxCell edge="1" parent="1" source="ax_pos" target="schur_setup" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" mark="▼ 本步：a,b,c≥0；t&amp;gt;0"><mxGeometry relative="1" as="geometry" x="0.9802">
              <Array as="points"><mxPoint x="6042.0" y="151.0" /><mxPoint x="6042.0" y="1285.6" /><mxPoint x="6265.5" y="1285.6" /><mxPoint x="5945.5" y="1285.6" /><mxPoint x="1022.0" y="1285.6" /><mxPoint x="702.0" y="1285.6" /><mxPoint x="702.0" y="1482.6" /><mxPoint x="702.0" y="1482.6" /><mxPoint x="702.0" y="1679.6" /><mxPoint x="889.3" y="1679.6" /><mxPoint x="889.3" y="1679.6" /><mxPoint x="1076.5" y="1679.6" /><mxPoint x="1076.5" y="1834.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="fx2" label="【前提】\({a\gt b \iff  a-b\gt 0}\)" 类型="汇合"><mxCell edge="1" parent="1" source="ax_order" target="mulp" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="8167.5" y="356" /><mxPoint x="7105" y="356" /></Array><mxPoint x="150" y="-18" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="fx3" label="【前提】\({a\gt b \iff  a-b\gt 0}\)；正 × 负为负" 类型="汇合"><mxCell edge="1" parent="1" source="ax_order" target="muln" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="8167.5" y="344" /><mxPoint x="6655" y="344" /></Array><mxPoint x="0" y="-10" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="sq_mono" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P03&lt;/span&gt;&lt;br&gt;★ 非负数平方保序&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({0 \le  a \lt  b \Rightarrow  a^{2} \lt  b^{2}}\)&lt;br&gt;反过来：\({a,b \ge  0}\) 时，\({a^{2} \lt  b^{2} \Rightarrow  a \lt  b}\)（可两边开平方）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：乘方与开方保序（\({n=2}\) 的情形）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ① 平方差公式：用①把 \({b^{2}-a^{2}}\) 分解为 \({(b+a)(b-a)}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="a,b≥0" 编号="P03" 层级="1"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="6080" y="420" width="300" height="156" as="geometry" />
          </mxCell></UserObject><UserObject id="gap1" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({0\le a\lt b}\)&lt;/span&gt;&lt;br&gt;【作差】\({b^{2}-a^{2} = (b+a)(b-a) \gt  0}\)&lt;br&gt;【反证】反过来 \({a^{2}\lt b^{2}}\)：若 \({a\ge b}\) 则 \({a^{2}\ge b^{2}}\)，矛盾" 类型="推导"><mxCell edge="1" parent="1" source="ax_pos" target="sq_mono" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" mark="▼ 本步：0≤a&amp;lt;b"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="6600.5" y="282" /><mxPoint x="6230" y="282" /></Array><mxPoint x="0" y="-34" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="cube_ab" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\in \mathbb{R}}\)；\({a+b\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P27&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;排序不等式的特例（\({a,b \ge  0}\) 时）&lt;/span&gt;&lt;br&gt;\({a^{3}+b^{3} \ge  ab(a+b)}\)（\({a+b \ge  0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;等号 \({\iff  a=b}\) 或 \({a+b=0}\)&lt;br&gt;（\({a,b\gt 0}\) 时最常用）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑩ 立方和与积的互换：\({a^{3}+b^{3} = (a+b)^{3}-3ab(a+b)}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ③ 立方和公式：另一证法（作差）： \({a^{3}+b^{3}-ab(a+b) = (a+b)(a^{2}-ab+b^{2}-ab) = (a+b)(a-b)^{2} \ge  0}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="a,b∈ℝ；a+b≥0" 编号="P27" 层级="5" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="9332" y="2256" width="364" height="210" as="geometry" />
          </mxCell></UserObject><UserObject id="gap4" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 加条件：\({a+b\ge 0}\)&lt;/span&gt;&lt;br&gt;【配凑】\({(a+b)^{2}-4ab = (a-b)^{2} \ge  0 \Rightarrow  (a+b)^{2} \ge  4ab}\)&lt;br&gt;【同乘】两边乘 \({a+b \ge  0}\)：\({(a+b)^{3} \ge  4ab(a+b)}\)&lt;br&gt;【代换】由⑩：\({a^{3}+b^{3} = (a+b)^{3}-3ab(a+b) \ge  ab(a+b)}\)" 类型="推导"><mxCell edge="1" parent="1" source="dsq" target="cube_ab" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.2600;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 加条件：a+b≥0"><mxGeometry relative="1" as="geometry" x="0.5699">
              <Array as="points"><mxPoint x="9754.2" y="2152.7" /><mxPoint x="9697.8" y="2152.7" /><mxPoint x="9697.8" y="2179.2" /><mxPoint x="9516.2" y="2179.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="three_cross" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R70&lt;/span&gt;&lt;br&gt;★ \({(a+b+c)^{2} \ge  3(ab+bc+ca)}\)&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;等号 \({\iff  a=b=c}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑪ 平方和与交叉积互换：\({a^{2}+b^{2}+c^{2} = (a+b+c)^{2}-2(ab+bc+ca)}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R70" 层级="9"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="9627" y="3782" width="260" height="94" as="geometry" />
          </mxCell></UserObject><UserObject id="gap6" label="【代换】由⑪：\({(a+b+c)^{2} = a^{2}+b^{2}+c^{2} + 2(ab+bc+ca)}\)&lt;br&gt;【放缩】\({a^{2}+b^{2}+c^{2} \ge  ab+bc+ca}\)&lt;br&gt;\({\Rightarrow  (a+b+c)^{2} \ge  3(ab+bc+ca)}\)" 类型="推导"><mxCell edge="1" parent="1" source="three_sq" target="three_cross" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.3075;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.2487">
              <Array as="points"><mxPoint x="9837.1" y="3621.0" /><mxPoint x="9757.2" y="3621.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ent_tri" label="&lt;b&gt;看到 三角形中求最值 / 范围&lt;/b&gt;&lt;br&gt;反推：余弦定理 \({a^{2}=b^{2}+c^{2}-2bc\cdot \cos A \to}\) 配合 \({b^{2}+c^{2} \ge  2bc}\) 求 bc 或 cosA 的范围&lt;br&gt;或：正弦定理把边化为角 → 化成 \({a\sin \theta +b\cos \theta}\) 型 → 三角函数有界&lt;br&gt;先查：角的取值范围（如 \({0\lt A\lt \pi}\)），等号能否在三角形中取到&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ ㉜ 余弦定理 &lt;b&gt;〔㉜ · 工具箱②〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 或 正弦定理 → ㉛ 正弦定理 &lt;b&gt;〔㉛ · 工具箱②〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 再用 \({b^{2}+c^{2} \ge  2bc \to  a^{2}+b^{2} \ge  2ab}\) &lt;b&gt;〔R55 · J3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="4648" width="520" height="137" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_seq" label="&lt;b&gt;看到 数列求和 / 放缩估计&lt;/b&gt;&lt;br&gt;能直接求和：用等差、等比、\({\sum k^{2}}\)、\({\sum k^{3}}\) 公式&lt;br&gt;不能直接求和：裂项放缩（&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k^{2}} \lt  \dfrac{1}{k-1} - \dfrac{1}{k}}\)&lt;/span&gt;）、根式裂项、等比放缩、对数放缩（&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln \left(1+\dfrac{1}{k}\right) \lt  \dfrac{1}{k}}\)&lt;/span&gt;）、伯努利&lt;br&gt;先查：每一项放缩方向一致；前几项可单独处理，保证不放过头&lt;br&gt;反推：能直接求和就先求和；求不出就逐项放缩成能求和的形式（裂项、等比、对数、伯努利、n 元均值）&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 和 n 有关、要一步步推到 \({n+1 \to}\) 【公理】数学归纳法 &lt;b&gt;〔S06 · J5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ ㉕㉖ 等差数列 &lt;b&gt;〔㉕㉖ · 工具箱②〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ ㉗㉘ 等比数列 &lt;b&gt;〔㉗㉘ · 工具箱②〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ ㊳ 前 n 项平方和 &lt;b&gt;〔㊳ · 工具箱②〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ ㊴ 前 n 项立方和 &lt;b&gt;〔㊴ · 工具箱②〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 放缩用伯努利 → 伯努利不等式 &lt;b&gt;〔P26 · K6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 裂项放缩 → 裂项放缩 &lt;b&gt;〔P24 · K6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 等比放缩 → 等比放缩（\({a_{k}\gt 0}\)） &lt;b&gt;〔P13 · K6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对数放缩 → 对数放缩求和 &lt;b&gt;〔P21 · D6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根式裂项 → 根式裂项 &lt;b&gt;〔P25 · L6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求下界 → 根式裂项（下界） &lt;b&gt;〔P54 · L6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 要证 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\lt  \dfrac{5}{3}}\)&lt;/span&gt;、&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\lt  \dfrac{7}{4} \to}\)&lt;/span&gt; 更紧的裂项 &lt;b&gt;〔P55 · K6〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="5976" width="520" height="349" as="geometry" />
          </mxCell></UserObject><UserObject id="mul_pos" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a\ge b\ge 0}\)；\({c\ge d\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P10&lt;/span&gt;&lt;br&gt;★ 同向非负不等式可乘&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a\ge b\ge 0}\)，\({c\ge d\ge 0 \Rightarrow  ac\ge bd}\)&lt;br&gt;若 \({a\gt b\ge 0}\) 且 \({c\gt d\ge 0}\)，则 \({ac\gt bd}\)&lt;/div&gt;" 类型="结论" 适用范围="a≥b≥0；c≥d≥0" 编号="P10" 层级="2"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="7100" y="760" width="240" height="84" as="geometry" />
          </mxCell></UserObject><UserObject id="s1e3" label="【作差】\({ac-bd = (a-b)c + b(c-d) \ge  0}\)（两项都是非负数之积）&lt;br&gt;严格时 \({c\gt d\ge 0 \Rightarrow  c\gt 0}\)，\({(a-b)c\gt 0 \Rightarrow  ac\gt bd}\)" 类型="推导"><mxCell edge="1" parent="1" source="mulp" target="mul_pos" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="7050" y="652" /><mxPoint x="7220" y="652" /></Array><mxPoint x="0" y="-26" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="pow_mono" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a\gt b\ge 0}\)；奇次幂见末行 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P19&lt;/span&gt;&lt;br&gt;★ 乘方与开方保序&lt;br&gt;\({a\gt b\ge 0 \Rightarrow  a^{n}\gt b^{n}}\)，\({\sqrt[n]{a} \gt  \sqrt[n]{b}}\)（n 为正整数）&lt;br&gt;推广：s 为正有理数时 \({a^{s} \gt  b^{s}}\)&lt;br&gt;奇次幂对任意实数保序：\({a \gt  b \iff  a^{3} \gt  b^{3}}\)" 类型="结论" 适用范围="a&gt;b≥0；奇次幂任意实数" 编号="P19" 层级="3"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;"><mxGeometry x="7070" y="1015" width="300" height="154" as="geometry" />
          </mxCell></UserObject><UserObject id="s1e4" label="【归纳】\({a^{k}\gt b^{k}\ge 0}\) 与 \({a\gt b\ge 0}\) 相乘 \({\Rightarrow  a^{k+1}\gt b^{k+1}}\)&lt;br&gt;【反证】开方：若 \({\sqrt[n]{a} \le  \sqrt[n]{b}}\)，乘方得 \({a\le b}\)，矛盾" 类型="推导"><mxCell edge="1" parent="1" source="mul_pos" target="pow_mono" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points" /><mxPoint x="0" y="-26" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="s1e6" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：要求 \({a,b,c\gt 0}\)（排除负数，分母不能为 0）&lt;/span&gt;&lt;br&gt;【前提】两个同向正数不等式相乘" 类型="汇合"><mxCell edge="1" parent="1" source="mul_pos" target="nesbitt" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2768;entryY=0.0000;entryDx=0;entryDy=0;" mark="▼ 要求 a,b,c&gt;0（排除负数，分母不能为 0）"><mxGeometry relative="1" as="geometry" x="0.5526">
              <Array as="points"><mxPoint x="7045.0" y="802.0" /><mxPoint x="7045.0" y="1405.6" /><mxPoint x="6970.4" y="1405.6" /><mxPoint x="7290.4" y="1405.6" /><mxPoint x="11095.7" y="1405.6" /><mxPoint x="11415.7" y="1405.6" /><mxPoint x="11415.7" y="1542.6" /><mxPoint x="11415.7" y="1542.6" /><mxPoint x="11415.7" y="1679.6" /><mxPoint x="11735.7" y="1679.6" /><mxPoint x="12254.2" y="1679.6" /><mxPoint x="12574.2" y="1679.6" /><mxPoint x="12574.2" y="1999.6" /><mxPoint x="12574.2" y="2208.2" /><mxPoint x="12574.2" y="2528.2" /><mxPoint x="12588.7" y="2528.2" /><mxPoint x="12588.7" y="2528.2" /><mxPoint x="12603.3" y="2528.2" /><mxPoint x="12603.3" y="2848.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="s1e7" label="【前提】回退时两边开 n 次方不改变方向" 类型="汇合"><mxCell edge="1" parent="1" source="pow_mono" target="am_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8436;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.5530">
              <Array as="points"><mxPoint x="7220.0" y="1405.6" /><mxPoint x="6973.8" y="1405.6" /><mxPoint x="7293.8" y="1405.6" /><mxPoint x="11095.7" y="1405.6" /><mxPoint x="11415.7" y="1405.6" /><mxPoint x="11415.7" y="1542.6" /><mxPoint x="11415.7" y="1542.6" /><mxPoint x="11415.7" y="1679.6" /><mxPoint x="11735.7" y="1679.6" /><mxPoint x="12461.2" y="1679.6" /><mxPoint x="12781.2" y="1679.6" /><mxPoint x="12781.2" y="1999.6" /><mxPoint x="12781.2" y="2378.6" /><mxPoint x="12781.2" y="2698.6" /><mxPoint x="12461.2" y="2698.6" /><mxPoint x="12212.0" y="2698.6" /><mxPoint x="11892.0" y="2698.6" /><mxPoint x="11892.0" y="3018.6" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="s1e10" label="【前提】\({|\sin (\theta +\varphi)| \le  1}\)" 类型="汇合"><mxCell edge="1" parent="1" source="trig_bound" target="trig_max" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.9531;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0828;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1856">
              <Array as="points"><mxPoint x="8522.6" y="5640.8" /><mxPoint x="8613.7" y="5640.8" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="cauchy_n" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R42&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 柯西不等式（n 项）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a_{1}^{2}+\cdots +a_{n}^{2})(b_{1}^{2}+\cdots +b_{n}^{2}) \ge  (a_{1}b_{1}+\cdots +a_{n}b_{n})^{2}}\)&lt;br&gt;等号 \({\iff  a_{i}}\) 与 \({b_{i}}\) 对应成比例：有常数 t 使每个 \({b_{i}=t\cdot a_{i}}\)，或 \({a_{i}}\) 全为 0&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 应用（统计）：取 \({a_{i}=x_{i}-\bar{x}}\)、\({b_{i}=y_{i}-\bar{y}}\)，得相关系数 \({|r| \le  1}\)；\({|r|=1 \iff}\) 样本点都在一条直线上&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R42" 层级="4" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="7826" y="3225" width="460" height="145" as="geometry" />
          </mxCell></UserObject><UserObject id="s1e11" label="【构造函数】\({A=\sum a_{i}^{2}}\)，\({B=\sum a_{i}b_{i}}\)，\({C=\sum b_{i}^{2}}\)&lt;br&gt;\({A=0}\)：\({a_{i}}\) 全为 0，柯西两边为 0&lt;br&gt;\({A\gt 0}\)：\({\sum (a_{i}x-b_{i})^{2}=Ax^{2}-2Bx+C\ge 0}\)&lt;br&gt;「Δ ≤ 0」\({4B^{2}-4AC\le 0 \Rightarrow  AC\ge B^{2}}\)&lt;br&gt;取等 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Leftrightarrow  b_{i}=\left(\dfrac{B}{A}\right)\cdot a_{i}}\)&lt;/span&gt;；连同 \({A=0}\) 的情形，就是对应成比例（含某组全为 0）" 类型="推导"><mxCell edge="1" parent="1" source="qall" target="cauchy_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="-0.0523">
              <Array as="points"><mxPoint x="6380.4" y="2813.7" /><mxPoint x="6700.4" y="2813.7" /><mxPoint x="6700.4" y="3055.7" /><mxPoint x="6700.4" y="3055.7" /><mxPoint x="6700.4" y="3297.7" /><mxPoint x="7020.4" y="3297.7" /></Array><mxPoint x="-214.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ent_split" label="&lt;b&gt;看到 分式求最值，分子次数 ≥ 分母次数&lt;/b&gt;&lt;br&gt;反推：令 \({t=}\)分母，分离常数 → 化成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({At + B + \dfrac{C}{t} \to}\)&lt;/span&gt; 对勾函数 / 积定和最小&lt;br&gt;能化成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({At+B+\dfrac{C}{t}}\)&lt;/span&gt; 才走这条路（常见：二次式 ÷ 一次式）；只看次数不够，如 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{x^{4}+1}{x+1}}\)&lt;/span&gt; 就化不成&lt;br&gt;例：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{x^{2}+x+1}{x+1}}\)&lt;/span&gt;，\({x\gt -1}\)：令 \({t=x+1\gt 0}\)，原式 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({= t + \dfrac{1}{t} - 1 \ge  1}\)&lt;/span&gt;&lt;br&gt;先查：\({t\ne 0}\)；A、C、t 都 \({\gt 0}\) 才能直接用基本不等式，否则分类讨论或求导；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({t=\sqrt{\dfrac{C}{A}}}\)&lt;/span&gt; 是否在范围内，不在就用单调性&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对勾函数最值 &lt;b&gt;〔P40 · K4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 或 积定和最小 → 积定和最小（\({u,v\gt 0}\)） &lt;b&gt;〔P30 · K4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="1652" width="520" height="238" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_comp" label="&lt;b&gt;看到 竞赛型对称不等式（三元、分式和、有序乘积）&lt;/b&gt;&lt;br&gt;反推：分式和 → 柯西分式 / 权方和 \({/\text{Nesbitt}}\)；三元对称多项式 → 舒尔、立方和&lt;br&gt;有序数组的乘积和 → 排序 / 切比雪夫；带权的平均 → 加权均值&lt;br&gt;先查：变量是否非负；能否齐次化、能否设 \({a\ge b\ge c}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 分式和 → 权方和不等式（\({m=1}\) 的情形，即柯西分式的 n 项形式） &lt;b&gt;〔P39 · G4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ Nesbitt → Nesbitt 不等式 &lt;b&gt;〔P46 · L5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三元对称 → 舒尔不等式（\({t=1}\) 常用形式，\({a,b,c\ge 0}\)） &lt;b&gt;〔P18 · A3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 立方和 \({\to  a^{3}+b^{3} \ge  ab(a+b)}\)（\({a+b \ge  0}\)） &lt;b&gt;〔P27 · J3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 有序乘积和 → 切比雪夫不等式 &lt;b&gt;〔R51 · A4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 带权 → 加权 AM-GM（\({w_{i}}\) 为正整数，\({N=w_{1}+\cdots +w_{n}}\)） &lt;b&gt;〔P43 · L5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三元立方和 \({\to  a^{3}+b^{3}+c^{3} \ge  3abc}\) &lt;b&gt;〔P57 · J4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 幂次推广 → 幂平均 &lt;b&gt;〔P58 · G6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 柯西推广 → 赫尔德 &lt;b&gt;〔P59 · L5〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="3761" width="520" height="226" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_homo" label="&lt;b&gt;看到 分式求最值，分子分母同次（齐次式）&lt;/b&gt;&lt;br&gt;反推：齐次化——令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({t=\dfrac{y}{x}}\)&lt;/span&gt; 化成单变量&lt;br&gt;先查：分子、分母每一项的次数都相同才行（只是最高次相同不够），或已知条件能把比例消掉；\({x=0}\) 先单独处理&lt;br&gt;再用判别式法（化为关于 t 的二次方程，\({\Delta \ge 0}\)）或导数求最值；换元后保留原来的取值范围&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【齐次化】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({t=\dfrac{y}{x}}\)&lt;/span&gt; 化成单变量，再用判别式 → 有实数解 ⟺ Δ ≥ 0（判别式求范围） &lt;b&gt;〔R33 · E3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 或 求导 → 【定理】导数判单调 &lt;b&gt;〔S04 · E5〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="2878" width="520" height="169" as="geometry" />
          </mxCell></UserObject><UserObject id="mono_def" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S07&lt;/span&gt;&lt;br&gt;【定义】函数单调性&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;增函数：区间 I 上任取 \({x_{1}\lt x_{2}}\)，都有 \({f(x_{1})\lt f(x_{2})}\)&lt;br&gt;减函数：区间 I 上任取 \({x_{1}\lt x_{2}}\)，都有 \({f(x_{1})\gt f(x_{2})}\)&lt;br&gt;起点：这是定义；\({a^{x}}\)、\({\log_{a} x}\)、幂函数的单调性课本直接给出&lt;/div&gt;" 类型="起点" 适用范围="任意实数" 编号="S07" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="14063" y="1875" width="320" height="154" as="geometry" />
          </mxCell></UserObject><UserObject id="three_two" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\in \mathbb{R}}\)；\({a\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R34&lt;/span&gt;&lt;br&gt;★★ 三个二次的关系（\({a\gt 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\Delta \gt 0}\)：方程有两根 \({x_{1}\lt x_{2}}\)；\({f(x)\gt 0 \iff  x\lt x_{1}}\) 或 \({x\gt x_{2}}\)；\({f(x)\lt 0 \iff  x_{1}\lt x\lt x_{2}}\)&lt;br&gt;\({\Delta =0}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x)\gt 0 \iff  x\ne -\dfrac{b}{2a}}\)&lt;/span&gt;；\({f(x)\lt 0}\) 无解；\({f(x) \ge  0}\) 对一切 x 成立，\({f(x) \le  0}\) 仅在 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x = -\dfrac{b}{2a}}\)&lt;/span&gt; 处成立&lt;br&gt;\({\Delta \lt 0}\)：\({f(x)\gt 0}\) 对一切 x 成立；\({f(x)\lt 0}\) 无解&lt;br&gt;不等号带等号（≥、≤）时，解集要把根也算进去&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑫ 韦达定理（根与系数的关系）&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="x∈ℝ；a&gt;0" 编号="R34" 层级="3"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="5237" y="2709" width="420" height="209" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e0" label="【因式分解】\({\Delta \gt 0}\) 时 \({f(x)=a(x-x_{1})(x-x_{2})}\)&lt;br&gt;【分类讨论】两根之外两个因式同号，之间异号&lt;br&gt;【数形结合】开口向上的抛物线：两根之外在 x 轴上方，之间在下方&lt;br&gt;【等价转化】\({\Delta  \le  0}\)：最小值 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({-\dfrac{\Delta }{4a} \ge  0}\)&lt;/span&gt;，\({\Delta  = 0}\) 时只有顶点处等于 0" 类型="推导"><mxCell edge="1" parent="1" source="qmin" target="three_two" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0611">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="solve_quad" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R43&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#6D4C41;font-weight:bold;&quot;&gt; 解法 &lt;/span&gt;&lt;br&gt;★ 解一元二次不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;① 化成二次项系数 \({\gt 0}\)（两边乘 \({-1}\)，不等号反向）&lt;br&gt;② 算 Δ、求根；③ 按三个二次的关系写出解集&lt;br&gt;含参时：依次讨论二次项系数是否为 0 及其正负、Δ 的符号、两根的大小&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R43" 层级="4" 类型标记="解法"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="5792" y="3071" width="380" height="102" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e2" label="【等价转化】\({a\lt 0}\) 时两边乘 \({-1}\) 化为 \({a\gt 0}\)&lt;br&gt;【数形结合】由图像写解集" 类型="推导"><mxCell edge="1" parent="1" source="three_two" target="solve_quad" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.9404;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1538;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.4904">
              <Array as="points"><mxPoint x="5632.4" y="2956.3" /><mxPoint x="5753.6" y="2956.3" /><mxPoint x="5753.6" y="2971.2" /><mxPoint x="5850.9" y="2971.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="p2e3" label="【前提】乘以负数，不等号反向" 类型="汇合"><mxCell edge="1" parent="1" source="muln" target="solve_quad" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8124;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.5484">
              <Array as="points"><mxPoint x="6440.0" y="465.5" /><mxPoint x="6440.0" y="1405.6" /><mxPoint x="6609.7" y="1405.6" /><mxPoint x="6289.7" y="1405.6" /><mxPoint x="6225.4" y="1405.6" /><mxPoint x="5905.4" y="1405.6" /><mxPoint x="5905.4" y="1542.6" /><mxPoint x="5905.4" y="1542.6" /><mxPoint x="5905.4" y="1679.6" /><mxPoint x="5994.9" y="1679.6" /><mxPoint x="5994.9" y="1679.6" /><mxPoint x="6084.4" y="1679.6" /><mxPoint x="6084.4" y="1934.4" /><mxPoint x="6084.4" y="1934.4" /><mxPoint x="6084.4" y="2189.2" /><mxPoint x="6092.8" y="2189.2" /><mxPoint x="6092.8" y="2189.2" /><mxPoint x="6101.2" y="2189.2" /><mxPoint x="6101.2" y="2509.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="high_ineq" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R25&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#6D4C41;font-weight:bold;&quot;&gt; 解法 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 高次不等式（穿根法）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;化为 \({(x-x_{1})(x-x_{2})\cdots (x-x_{n}) \gt  0}\)（各因式 x 的系数为正）&lt;br&gt;无实根的因式（如 \({x^{2}+x+1}\)）先判断符号，恒正就约去&lt;br&gt;数轴上标根，从最右边上方开始依次穿线&lt;br&gt;奇次重根穿过，偶次重根不穿；解 \({\gt 0}\) 时所有根都不取（偶次根处也要挖去），解 \({\ge 0}\) 时根都取上&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ④ 立方差公式：分解因式，如 \({x^{3}-1 = (x-1)(x^{2}+x+1)}\)，其中 \({x^{2}+x+1 \gt  0}\) 恒成立，只剩 \({x-1}\) 一个因式&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R25" 层级="2" 高考常用="是" 类型标记="解法"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2204" y="3037" width="460" height="164" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e4" label="【分类讨论】\({x-x_{i}}\) 在 \({x_{i}}\) 右侧为正、左侧为负&lt;br&gt;积的符号由负因式个数的奇偶决定（正×正=正、负×负=正）&lt;br&gt;【数形结合】在数轴上标出各根，从最右边上方开始穿线，读出正负区间" 类型="推导"><mxCell edge="1" parent="1" source="ax_pos" target="high_ineq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3652;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9650">
              <Array as="points"><mxPoint x="6042.0" y="151.0" /><mxPoint x="6042.0" y="1345.6" /><mxPoint x="6436.8" y="1345.6" /><mxPoint x="6116.8" y="1345.6" /><mxPoint x="3167.6" y="1345.6" /><mxPoint x="2847.6" y="1345.6" /><mxPoint x="2847.6" y="1665.6" /><mxPoint x="2847.6" y="2315.2" /><mxPoint x="2847.6" y="2635.2" /><mxPoint x="2603.0" y="2635.2" /><mxPoint x="2603.0" y="2635.2" /><mxPoint x="2358.4" y="2635.2" /><mxPoint x="2358.4" y="2766.5" /><mxPoint x="2358.4" y="2766.5" /><mxPoint x="2358.4" y="2897.7" /><mxPoint x="2365.4" y="2897.7" /><mxPoint x="2365.4" y="2897.7" /><mxPoint x="2372.4" y="2897.7" /><mxPoint x="2372.4" y="2961.3" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="frac_ineq" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R35&lt;/span&gt;&lt;br&gt;★ 分式不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;先移项通分，化成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{f(x)}{g(x)}}\)&lt;/span&gt; 与 0 比较，不能直接乘分母&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{f(x)}{g(x)} \gt  0 \iff  f(x)\cdot g(x) \gt  0}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{f(x)}{g(x)} \ge  0 \iff  f(x)\cdot g(x) \ge  0}\)&lt;/span&gt; 且 \({g(x) \ne  0}\)&lt;br&gt;有理式可化整式后用穿根法；始终保留原定义域禁点&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R35" 层级="3"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2145" y="3456" width="320" height="205" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e5" label="【同乘】两边乘 \({g(x)^{2}\gt 0}\)，不等号方向不变&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{f}{g} \cdot  g^{2} = f\cdot g}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="mulp" target="frac_ineq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5455;exitY=1;exitDx=0;exitDy=0;entryX=0.0428;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.8892">
              <Array as="points"><mxPoint x="7060.0" y="1345.6" /><mxPoint x="6491.1" y="1345.6" /><mxPoint x="6171.1" y="1345.6" /><mxPoint x="3167.6" y="1345.6" /><mxPoint x="2847.6" y="1345.6" /><mxPoint x="2847.6" y="1665.6" /><mxPoint x="2847.6" y="2315.2" /><mxPoint x="2847.6" y="2635.2" /><mxPoint x="2527.6" y="2635.2" /><mxPoint x="2372.4" y="2635.2" /><mxPoint x="2052.4" y="2635.2" /><mxPoint x="2052.4" y="2877.0" /><mxPoint x="2052.4" y="2877.0" /><mxPoint x="2052.4" y="3118.8" /><mxPoint x="2105.7" y="3118.8" /><mxPoint x="2105.7" y="3118.8" /><mxPoint x="2159.1" y="3118.8" /><mxPoint x="2159.1" y="3302.8" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="p2e6" label="【前提】化成整式后用穿根法求解" 类型="汇合"><mxCell edge="1" parent="1" source="high_ineq" target="frac_ineq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.3674;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7125;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0401">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="abs_solve" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R15&lt;/span&gt;&lt;br&gt;★ 绝对值不等式的等价形式（\({a\gt 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|x|\lt a \iff  -a\lt x\lt a}\)；\({|x|\gt a \iff  x\lt -a}\) 或 \({x\gt a}\)&lt;br&gt;\({|f(x)|\lt g(x) \iff  -g(x)\lt f(x)\lt g(x)}\)&lt;br&gt;两边都非负可平方：\({|x| \lt  a \iff  x^{2} \lt  a^{2}}\)〔P03 · F1〕&lt;br&gt;多个绝对值：按零点分段讨论&lt;br&gt;例：\({|x-1|+|x+2| \ge  5}\)，分 \({x\lt -2}\)、\({-2\le x\le 1}\)、\({x\gt 1}\) 三段 \({\Rightarrow  x \le  -3}\) 或 \({x \ge  2}\)&lt;/div&gt;" 类型="结论" 适用范围="a&gt;0" 编号="R15" 层级="1"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2584" y="5543" width="340" height="157" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e7" label="【分类讨论】按 \({x\ge 0}\)、\({x\lt 0}\) 去掉绝对值，再合并&lt;br&gt;【数形结合】\({|x|\lt a}\)：数轴上到原点的距离小于 a" 类型="推导"><mxCell edge="1" parent="1" source="ax_abs" target="abs_solve" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.7544;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4647;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1694">
              <Array as="points"><mxPoint x="2721.4" y="5461.7" /><mxPoint x="2742.0" y="5461.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="abs_dist" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R53&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 绝对值和的最小值&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|x-a|+|x-b| \ge  |a-b|}\)&lt;br&gt;几何意义：数轴上 x 到 a、b 的距离之和&lt;br&gt;等号 \({\iff  x}\) 在 a、b 之间（含端点 a、b）；解“距离和 \({\ge  k}\)”（\({k\gt |a-b|}\)）：在两点外侧各找一个边界点&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R53" 层级="5" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2451" y="6592" width="320" height="151" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e8" label="【代换】\({|x-a|+|x-b| = |x-a|+|b-x|}\)&lt;br&gt;\({\ge  |(x-a)+(b-x)| = |a-b|}\)；等号 \({\iff  (x-a)(b-x) \ge  0}\)&lt;br&gt;【数形结合】数轴上 x 到 a、b 的距离之和：x 在 a、b 之间时最小" 类型="推导"><mxCell edge="1" parent="1" source="triangle" target="abs_dist" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.6578;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.4178">
              <Array as="points"><mxPoint x="2498.5" y="6500.2" /><mxPoint x="2611.0" y="6500.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="explog_ineq" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 定义域内 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P04&lt;/span&gt;&lt;br&gt;★ 指数、对数不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a\gt 1}\)：\({a^{f(x)} \gt  a^{g(x)} \iff  f(x) \gt  g(x)}\)；\({0\lt a\lt 1}\) 时不等号反向&lt;br&gt;\({\log_{a} f(x) \gt  \log_{a} g(x)}\)：先保证 \({f(x)\gt 0}\)、\({g(x)\gt 0}\)（定义域优先）&lt;br&gt;再按底数 \({a\gt 1}\) 或 \({0\lt a\lt 1}\) 去掉对数&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑮⑯ 对数运算律：对数运算律：把两边化为同底再比较&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="定义域内" 编号="P04" 层级="1"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="13297" y="2226" width="420" height="150" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e9" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 加条件：定义域内&lt;/span&gt;&lt;br&gt;「单调性」增函数保持不等号，减函数反转&lt;br&gt;\({y=a^{x}}\)、\({y=\log_{a} x}\)：\({a\gt 1}\) 递增，\({0\lt a\lt 1}\) 递减" 类型="推导"><mxCell edge="1" parent="1" source="mono_def" target="explog_ineq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.3333;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8393;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 加条件：定义域内"><mxGeometry relative="1" as="geometry" x="0.6163">
              <Array as="points"><mxPoint x="14169.3" y="2109.2" /><mxPoint x="13825.5" y="2109.2" /><mxPoint x="13825.5" y="2127.7" /><mxPoint x="13649.2" y="2127.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="quotient" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({b\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P11&lt;/span&gt;&lt;br&gt;★ 商与 1 比较（\({b\gt 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b} \gt  1 \iff  a \gt  b}\)&lt;/span&gt;&lt;br&gt;适合含幂、指数、阶乘的式子比大小&lt;/div&gt;" 类型="结论" 适用范围="b&gt;0" 编号="P11" 层级="2"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="7420" y="760" width="300" height="100" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e10" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({b\gt 0}\)&lt;/span&gt;&lt;br&gt;【同乘】两边乘 b" 类型="推导"><mxCell edge="1" parent="1" source="mulp" target="quotient" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" mark="▼ 加条件：b&amp;gt;0"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="7050" y="638" /><mxPoint x="7570" y="638" /></Array><mxPoint x="30" y="-26" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="sugar" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,m\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P20&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 糖水不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({b\gt a\gt 0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({m\gt 0 \Rightarrow  \dfrac{a+m}{b+m} \gt  \dfrac{a}{b}}\)&lt;/span&gt;（糖水加糖更甜）&lt;br&gt;反过来：\({a\gt b\gt 0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a+m}{b+m} \lt  \dfrac{a}{b}}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="a,b,m&gt;0" 编号="P20" 层级="3" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="8640" y="413" width="300" height="148" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e11" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：\({b\gt a\gt 0, m\gt 0}\)&lt;/span&gt;&lt;br&gt;【作差】差 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({= \dfrac{m(b-a)}{b(b+m)} \gt  0}\)&lt;/span&gt;（分子、分母都是正数之积）" 类型="推导"><mxCell edge="1" parent="1" source="ax_order" target="sugar" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" mark="▼ 要求 b&gt;a&gt;0、m&gt;0"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="8167.5" y="290" /><mxPoint x="8790" y="290" /></Array><mxPoint x="0" y="-37" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ln_lower" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P12&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;对数切线不等式的变形（x 换成 \({\dfrac{1}{x}}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  x \ge  1 - \dfrac{1}{x}}\)&lt;/span&gt;（\({x\gt 0}\)）&lt;br&gt;等号 \({\iff  x=1}\)" 类型="结论" 适用范围="x&gt;0" 编号="P12" 层级="2" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;"><mxGeometry x="3902" y="5983" width="260" height="128" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e12" label="【代换】\({\ln  x \le  x-1}\) 中把 x 换成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({-\ln  x \le  \dfrac{1}{x} - 1}\)&lt;/span&gt;，两边乘 \({-1}\)" 类型="推导"><mxCell edge="1" parent="1" source="logineq" target="ln_lower" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0277">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ln_sum" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 正整数 k &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P21&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 对数放缩求和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k+1} \lt  \ln \left(1+\dfrac{1}{k}\right) \lt  \dfrac{1}{k}}\)&lt;/span&gt;（k 为正整数）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Rightarrow  \ln (n+1) \lt  1 + \dfrac{1}{2} + \cdots  + \dfrac{1}{n}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Rightarrow  \dfrac{1}{2} + \dfrac{1}{3} + \cdots  + \dfrac{1}{n+1} \lt  \ln (n+1)}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑮⑯ 对数运算律：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln \left(1+\dfrac{1}{k}\right) = \ln \left(\dfrac{k+1}{k}\right) = \ln (k+1) - \ln  k}\)&lt;/span&gt; 逐项相加时中间项相消&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="正整数 k" 编号="P21" 层级="3" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="4248" y="6304" width="340" height="193" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e13" label="【代换】\({\ln  x \le  x-1}\) 中令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=1+\dfrac{1}{k}}\)&lt;/span&gt;：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln \left(1+\dfrac{1}{k}\right) \lt  \dfrac{1}{k}}\)&lt;/span&gt;（\({x\ne 1}\)，取不到等号）&lt;br&gt;「同向可加」左边 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({= \ln \left(\dfrac{2}{1}\right)+\ln \left(\dfrac{3}{2}\right)+\cdots +\ln \left(\dfrac{n+1}{n}\right) = \ln (n+1)}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="logineq" target="ln_sum" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=1.0000;exitY=0.7124;exitDx=0;exitDy=0;entryX=0.7401;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.7020">
              <Array as="points"><mxPoint x="4573.3" y="5701.7" /><mxPoint x="4573.3" y="6229.7" /><mxPoint x="4499.2" y="6229.7" /></Array><mxPoint x="60.2" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="p2e14" label="【前提】令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=1+\dfrac{1}{k}}\)&lt;/span&gt;：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln \left(1+\dfrac{1}{k}\right) \gt  1 - \dfrac{k}{k+1} = \dfrac{1}{k+1}}\)&lt;/span&gt;" 类型="汇合"><mxCell edge="1" parent="1" source="ln_lower" target="ln_sum" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.7395;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1936;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1023">
              <Array as="points"><mxPoint x="4093.8" y="6229.7" /><mxPoint x="4313.3" y="6229.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="split_frac" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 正整数 \({k\ge 2}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P24&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 裂项放缩&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k^{2}} \lt  \dfrac{1}{k(k-1)} = \dfrac{1}{k-1} - \dfrac{1}{k}}\)&lt;/span&gt;（\({k\ge 2}\)）&lt;br&gt;\({n\ge 2}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1 + \dfrac{1}{2^{2}} + \cdots  + \dfrac{1}{n^{2}} \lt  2 - \dfrac{1}{n} \lt  2}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="正整数 k≥2" 编号="P24" 层级="4" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="10787" y="5498" width="340" height="116" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e15" label="【取倒数】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({k^{2} \gt  k(k-1) \gt  0 \Rightarrow  \dfrac{1}{k^{2}} \lt  \dfrac{1}{k(k-1)}}\)&lt;/span&gt;&lt;br&gt;【裂项】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{k(k-1)} = \dfrac{1}{k-1} - \dfrac{1}{k}}\)&lt;/span&gt;，求和时中间项相消" 类型="推导"><mxCell edge="1" parent="1" source="recip" target="split_frac" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9813">
              <Array as="points"><mxPoint x="8380.0" y="1345.6" /><mxPoint x="7089.2" y="1345.6" /><mxPoint x="7409.2" y="1345.6" /><mxPoint x="12796.7" y="1345.6" /><mxPoint x="13116.7" y="1345.6" /><mxPoint x="13116.7" y="1665.6" /><mxPoint x="13116.7" y="4694.7" /><mxPoint x="13116.7" y="5014.7" /><mxPoint x="12796.7" y="5014.7" /><mxPoint x="11845.7" y="5014.7" /><mxPoint x="11525.7" y="5014.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5130.7" /><mxPoint x="11241.1" y="5130.7" /><mxPoint x="11241.1" y="5130.7" /><mxPoint x="10956.6" y="5130.7" /><mxPoint x="10956.6" y="5316.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="geo_bound" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a_{k}\gt 0}\)；\({0\lt q\lt 1}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P13&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 等比放缩（\({a_{k}\gt 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;若 \({a_{k+1} \le  q\cdot a_{k}}\)（\({0\lt q\lt 1}\)）&lt;br&gt;则 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a_{1}+\cdots +a_{n} \le  \dfrac{a_{1}(1-q^{n})}{1-q} \lt  \dfrac{a_{1}}{1-q}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ㉗㉘ 等比数列：等比数列求和公式&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="aₖ&gt;0；0&lt;q&lt;1" 编号="P13" 层级="2" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="11323" y="5483" width="320" height="145" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e16" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：要求 \({a_{k}\gt 0}\)、\({q\gt 0}\)&lt;/span&gt;&lt;br&gt;【逐项递推】\({a_{k} \le  a_{1}q^{k-1}}\)（反复用 \({a_{k+1} \le  q\cdot a_{k}}\)）&lt;br&gt;「同向可加」再用等比数列求和公式" 类型="推导"><mxCell edge="1" parent="1" source="sumadd" target="geo_bound" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2158;entryY=0.0000;entryDx=0;entryDy=0;" mark="▼ 要求 aₖ&gt;0、q&gt;0"><mxGeometry relative="1" as="geometry" x="0.9728">
              <Array as="points"><mxPoint x="8215.0" y="458.5" /><mxPoint x="8215.0" y="1345.6" /><mxPoint x="7031.3" y="1345.6" /><mxPoint x="7351.3" y="1345.6" /><mxPoint x="12796.7" y="1345.6" /><mxPoint x="13116.7" y="1345.6" /><mxPoint x="13116.7" y="1665.6" /><mxPoint x="13116.7" y="4694.7" /><mxPoint x="13116.7" y="5014.7" /><mxPoint x="12796.7" y="5014.7" /><mxPoint x="11845.7" y="5014.7" /><mxPoint x="11525.7" y="5014.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5130.7" /><mxPoint x="11417.7" y="5130.7" /><mxPoint x="11417.7" y="5130.7" /><mxPoint x="11309.6" y="5130.7" /><mxPoint x="11309.6" y="5253.5" /><mxPoint x="11309.6" y="5253.5" /><mxPoint x="11309.6" y="5376.3" /><mxPoint x="11350.6" y="5376.3" /><mxPoint x="11350.6" y="5376.3" /><mxPoint x="11391.7" y="5376.3" /><mxPoint x="11391.7" y="5431.3" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="exp_ex" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R26&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;指数切线不等式（切点 \({x=1}\)）&lt;/span&gt;&lt;br&gt;\({e^{x} \ge  ex}\)（\({x\in \mathbb{R}}\)）&lt;br&gt;等号 \({\iff  x=1}\)" 类型="结论" 适用范围="任意实数" 编号="R26" 层级="2" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;"><mxGeometry x="4289" y="5997" width="240" height="99" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e18" label="【代换】\({e^{x} \ge  1+x}\) 中把 x 换成 \({x-1}\)：\({e^{x-1} \ge  x}\)&lt;br&gt;【同乘】两边乘 e" 类型="推导"><mxCell edge="1" parent="1" source="expineq" target="exp_ex" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.2464;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.5647">
              <Array as="points"><mxPoint x="4481.3" y="5667.7" /><mxPoint x="4481.3" y="5863.7" /><mxPoint x="4408.5" y="5863.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ln_xe" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P14&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;对数切线不等式（切点 \({x=e}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  x \le  \dfrac{x}{e}}\)&lt;/span&gt;（\({x\gt 0}\)）&lt;br&gt;等号 \({\iff  x=e}\)" 类型="结论" 适用范围="x&gt;0" 编号="P14" 层级="2" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;"><mxGeometry x="3564" y="5989" width="240" height="115" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e19" label="【代换】\({\ln  x \le  x-1}\) 中把 x 换成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{x}{e}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  x - 1 \le  \dfrac{x}{e} - 1}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="logineq" target="ln_xe" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.6620;exitDx=0;exitDy=0;entryX=0.5035;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.4932">
              <Array as="points"><mxPoint x="3684.6" y="5697.6" /></Array><mxPoint x="0.1" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="f_derivrule" label="㊵ 求导法则（u,v 可导；商要求 \({v\ne 0}\)）&lt;br&gt;\({(uv)'=u'v+uv'}\)；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{u}{v}\right)'=\dfrac{u'v-uv'}{v^{2}}}\)&lt;/span&gt;&lt;br&gt;\({(e^{x})'=e^{x}}\)；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(\ln  x)'=\dfrac{1}{x}}\)&lt;/span&gt;（\({x\gt 0}\)）&lt;br&gt;\({(x^{n})'=nx^{n-1}}\)（\({n\in \mathbb{R}}\)，\({x\gt 0}\)；正整数 n 另含 \({x\le 0}\)）&lt;br&gt;\({(\sin  x)' = \cos  x}\)；\({(\cos  x)' = -\sin  x}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 构造函数：看到 \({f'+f}\) 想 \({(e^{x}f)'}\)，看到 \({xf'-f}\) 想 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{f}{x}\right)'}\)&lt;/span&gt;，凑成积或商的导数 〔P05 · E6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 对构造的函数求导，看导数正负判单调、求最值 〔S04 · E5〕&lt;/span&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;"><mxGeometry x="-1390" y="2939" width="350" height="208" as="geometry" />
          </mxCell></UserObject><UserObject id="abs_construct" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 定义域内 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P05&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 积、商的导数定号（抽象函数；在同一区间内可导）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({f'+f\gt 0 \Rightarrow  e^{x}f(x)}\) 递增；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f'-f\gt 0 \Rightarrow  \dfrac{f(x)}{e^{x}}}\)&lt;/span&gt; 递增&lt;br&gt;\({xf'+f\gt 0 \Rightarrow  xf(x)}\) 递增；\({xf'-f\gt 0}\)（\({x\gt 0}\)）&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Rightarrow  \dfrac{f(x)}{x}}\)&lt;/span&gt; 递增&lt;br&gt;看到 \({f'}\) 与 f 的组合，就把它们凑成某个积或商的导数&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ㊵ 求导法则：积、商的求导法则&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="定义域内" 编号="P05" 层级="1" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="5202" y="5602" width="400" height="165" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e20" label="【构造函数】\({(e^{x}f)'=e^{x}(f'+f)}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{f}{e^{x}}\right)'=\dfrac{f'-f}{e^{x}}}\)&lt;/span&gt;&lt;br&gt;\({(xf)'=f+xf'}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{f}{x}\right)'=\dfrac{xf'-f}{x^{2}}}\)&lt;/span&gt;&lt;br&gt;【求导】导数的符号已知 ⇒ 用导数判单调" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" target="abs_construct" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.2792;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.6631;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1523">
              <Array as="points"><mxPoint x="5549.6" y="5498.2" /><mxPoint x="5466.8" y="5498.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="tangent_ineq" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({f''}\) 定号的区间 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P06&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 切线不等式（切线放缩）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({f''(x) \ge  0}\)（下凸）\({\Rightarrow  f(x) \ge  f(x_{0}) + f'(x_{0})(x-x_{0})}\)：图像在切线上方&lt;br&gt;\({f''(x) \le  0}\)（上凸）⇒ 不等号反向：图像在切线下方&lt;br&gt;\({e^{x} \ge  1+x}\)、\({e^{x} \ge  ex}\) 是下凸的特例；\({\ln  x \le  x-1}\)、&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  x \le  \dfrac{x}{e}}\)&lt;/span&gt; 是上凸的特例&lt;/div&gt;" 类型="结论" 适用范围="f″ 定号的区间" 编号="P06" 层级="1" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="6894" y="5608" width="360" height="153" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e22" label="【构造函数】令 \({g(x) = f(x) - [f(x_{0}) + f'(x_{0})(x-x_{0})]}\)&lt;br&gt;\({f''\ge 0 \Rightarrow  f'}\) 不减 \({\Rightarrow  g' = f'(x) - f'(x_{0})}\) 在 \({x_{0}}\) 左侧\({\le 0}\)、右侧\({\ge 0}\)&lt;br&gt;【求最值】\({g(x) \ge  g(x_{0}) = 0}\)；\({f''\le 0}\) 时同理反向&lt;br&gt;【数形结合】\({f''\ge 0}\) 时图像下凸，整条曲线在切线上方" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" target="tangent_ineq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.8931;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.8406">
              <Array as="points"><mxPoint x="5960.9" y="5467.7" /><mxPoint x="6847.8" y="5467.7" /><mxPoint x="6847.8" y="5498.2" /><mxPoint x="7073.5" y="5498.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="log_mean" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\gt 0}\)；\({a\ne b}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P07&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 对数平均不等式（拓展）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a,b\gt 0}\)，\({a\ne b}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sqrt{ab} \lt  \dfrac{a-b}{\ln  a - \ln  b} \lt  \dfrac{a+b}{2}}\)&lt;/span&gt;&lt;br&gt;推论（\({x \gt  1}\)）：取 \({a = x}\)、\({b = 1}\) 得 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  x \gt  \dfrac{2(x-1)}{x+1}}\)&lt;/span&gt;；取 \({a = x^{2}}\)、\({b = 1}\) 得 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  x \lt  \tfrac12 \left(x - \dfrac{1}{x}\right)}\)&lt;/span&gt;；都比 \({\ln  x \le  x-1}\) 更紧&lt;br&gt;用途：极值点偏移（如证 \({x_{1}+x_{2} \gt  2x_{0}}\) 一类）；先由题设把 \({x_{1}}\)、\({x_{2}}\) 对应到 a、b&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑮⑯ 对数运算律：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  a - \ln  b = \ln \left(\dfrac{a}{b}\right) = \ln  t}\)&lt;/span&gt; 化成只含 t 的不等式&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="a,b&gt;0；a≠b" 编号="P07" 层级="1" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="6050" y="5553" width="380" height="264" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e23" label="【换元】不妨 \({a\gt b}\)，令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({t=\dfrac{a}{b}\gt 1}\)&lt;/span&gt;，化为 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{2(t-1)}{t+1} \lt  \ln  t \lt  \dfrac{t-1}{\sqrt{t}}}\)&lt;/span&gt;&lt;br&gt;【构造函数】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({g(t)=\ln  t - \dfrac{2(t-1)}{t+1}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({h(t)=\dfrac{t-1}{\sqrt{t}} - \ln  t}\)&lt;/span&gt;&lt;br&gt;【求导】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({g'=\dfrac{(t-1)^{2}}{t(t+1)^{2}}\gt 0}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({h'=\dfrac{\left(\sqrt{t}-1\right)^{2}}{2t\sqrt{t}}\gt 0}\)&lt;/span&gt;，且 \({g(1)=h(1)=0 \Rightarrow  t\gt 1}\) 时 \({g,h\gt 0}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" target="log_mean" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.6794;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4992;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.2034">
              <Array as="points"><mxPoint x="5817.7" y="5498.2" /><mxPoint x="6239.3" y="5498.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="f_dot" label="㊶ 向量数量积：\({a\cdot b=x_{1}x_{2}+y_{1}y_{2}}\)&lt;br&gt;两向量非零时：\({a\cdot b=|a||b|\cos \theta}\)&lt;br&gt;有零向量时数量积为 0，不定义夹角&lt;br&gt;⇒ 用于：R16〔H6〕" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;"><mxGeometry x="-1390" y="3163" width="350" height="83" as="geometry" />
          </mxCell></UserObject><UserObject id="vec_cauchy" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R16&lt;/span&gt;&lt;br&gt;★ 向量形式的柯西（任意向量）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({|a\cdot b| \le  |a||b|}\)，等号 \({\iff  a}\)、b 共线（含零向量）&lt;br&gt;坐标形式：\({|x_{1}x_{2}+y_{1}y_{2}| \le  \sqrt{x_{1}^{2}+y_{1}^{2}}\cdot \sqrt{x_{2}^{2}+y_{2}^{2}}}\)（即二项柯西）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ㊶ 向量数量积：数量积的两种表示&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R16" 层级="1"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="8096" y="5755" width="380" height="115" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e24" label="【分类讨论】任一为零时两边为 0&lt;br&gt;非零向量：\({a\cdot b=|a||b|\cos \theta}\)，\({|\cos \theta|\le 1}\)&lt;br&gt;等号 \({\Leftrightarrow  |\cos \theta|=1}\)，即两向量共线；连同零向量的情形，就是对应成比例" 类型="推导"><mxCell edge="1" parent="1" source="trig_bound" target="vec_cauchy" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.4086;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1992">
              <Array as="points"><mxPoint x="8326.0" y="5640.8" /><mxPoint x="8286.1" y="5640.8" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="vec_tri" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R27&lt;/span&gt;&lt;br&gt;★ 向量三角不等式（任意向量）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({||a|-|b|| \le  |a+b| \le  |a|+|b|}\)&lt;br&gt;右边等号 ⟺ 同向或有零向量；左边等号 ⟺ 反向或有零向量&lt;br&gt;复数同理：\({||z_{1}|-|z_{2}|| \le  |z_{1} \pm  z_{2}| \le  |z_{1}| + |z_{2}|}\)&lt;br&gt;坐标形式（闵可夫斯基）：\({\sqrt{x_{1}^{2}+y_{1}^{2}} + \sqrt{x_{2}^{2}+y_{2}^{2}} \ge  \sqrt{(x_{1}+x_{2})^{2} + (y_{1}+y_{2})^{2}}}\)&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R27" 层级="2"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="8046" y="6047" width="480" height="177" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e26" label="【展开】\({|a+b|^{2} = |a|^{2}+2a\cdot b+|b|^{2} \le  |a|^{2}+2|a||b|+|b|^{2} = (|a|+|b|)^{2}}\)&lt;br&gt;下界同理用 \({a\cdot b \ge  -|a||b|}\)；两边非负，开平方" 类型="推导"><mxCell edge="1" parent="1" source="vec_cauchy" target="vec_tri" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1460">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="meanchain_n" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a_{i}\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P45&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ n 元平均数不等式链（拓展）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_{i}\gt 0}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{n}{\dfrac{1}{a_{1}}+\cdots +\dfrac{1}{a_{n}}} \le  \sqrt[n]{a_{1}\cdots a_{n}} \le  \dfrac{a_{1}+\cdots +a_{n}}{n} \le  \sqrt{\dfrac{a_{1}^{2}+\cdots +a_{n}^{2}}{n}}}\)&lt;/span&gt;&lt;br&gt;等号 \({\iff  a_{i}}\) 全相等&lt;/div&gt;" 类型="结论" 适用范围="aᵢ&gt;0" 编号="P45" 层级="11" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="11449" y="4378" width="440" height="150" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e27" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 要求 \({\gt 0}\)（不能取 0）&lt;/span&gt;&lt;br&gt;【前提】\({G\le A}\)；把 \({a_{i}}\) 换成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{a_{i}}}\)&lt;/span&gt; 再取倒数（正数倒数反序〔P17 · H1〕）得 \({H\le G}\)" 类型="汇合"><mxCell edge="1" parent="1" source="am_n" target="meanchain_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.3895;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5295;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 要求 &amp;gt;0（不能取 0）"><mxGeometry relative="1" as="geometry" x="0.0364">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="p2e28" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：要求 \({a_{i}\gt 0}\)&lt;/span&gt;&lt;br&gt;【前提】取 \({b_{i}=1}\)：\({(a_{1}+\cdots +a_{n})^{2} \le  n(a_{1}^{2}+\cdots +a_{n}^{2}) \Rightarrow  A\le Q}\)" 类型="汇合"><mxCell edge="1" parent="1" source="cauchy_n" target="meanchain_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" mark="▼ 要求 aᵢ&gt;0"><mxGeometry relative="1" as="geometry" x="-0.2675">
              <Array as="points"><mxPoint x="8761.2" y="3297.7" /><mxPoint x="8761.2" y="4575" /><mxPoint x="11669" y="4575" /></Array><mxPoint x="-187.6" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="jensen" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({f''\ge 0}\) 的区间 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P15&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 琴生不等式（拓展）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({x_{i}}\) 都在同一区间 I 内，f 在 I 上二阶可导且 \({f'' \ge  0}\)（下凸）：&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{f(x_{1})+\cdots +f(x_{n})}{n} \ge  f\left(\dfrac{x_{1}+\cdots +x_{n}}{n}\right)}\)&lt;/span&gt;&lt;br&gt;\({f'' \gt  0}\) 时：等号 \({\iff  x_{i}}\) 全相等&lt;br&gt;只有 \({f'' \ge  0}\) 时：等号 \({\iff  x_{i}}\) 全相等，或 f 在这些点覆盖的区间 [最小的 \({x_{i}}\), 最大的 \({x_{i}]}\) 上满足 \({f(x)=kx+b}\)（允许 \({k=0}\)，即也包括常数函数；如 \({f(x)=x}\)、\({f(x)=1}\) 时恒取等）&lt;/div&gt;" 类型="结论" 适用范围="f″≥0 的区间" 编号="P15" 层级="2" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="6844" y="5962" width="460" height="170" as="geometry" />
          </mxCell></UserObject><UserObject id="p2e29" label="【取特值】取 \({x_{0} =}\) 平均值 \({\bar{x}}\)，对每个 \({x_{i}}\) 写切线不等式&lt;br&gt;「同向可加」\({f'(\bar{x})\cdot \sum (x_{i}-\bar{x}) = 0}\)，右边只剩 \({n\cdot f(\bar{x})}\)" 类型="推导"><mxCell edge="1" parent="1" source="tangent_ineq" target="jensen" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0772">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ent_solve" label="&lt;b&gt;看到 解不等式（求解集）&lt;/b&gt;&lt;br&gt;一次：\({ax \gt  b}\)，\({a \gt  0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x \gt  \dfrac{b}{a}}\)&lt;/span&gt;；\({a \lt  0}\) 时 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x \lt  \dfrac{b}{a}}\)&lt;/span&gt;（不等号反向）；\({a = 0}\) 时看 b：\({b \lt  0}\) 解集为 ℝ，\({b \ge  0}\) 无解&lt;br&gt;二次：化成二次项系数 \({\gt  0 \to}\) 能分解先用&lt;b&gt;十字相乘&lt;/b&gt;求根，如 \({x^{2}-5x+6=(x-2)(x-3)}\)；分解不出就算 &lt;b&gt;Δ&lt;/b&gt; → 三个二次的关系&lt;br&gt;含参二次：先试十字相乘，如 \({x^{2}-(a+1)x+a=(x-a)(x-1)}\)，再按两根 a、1 的大小分类；二次项系数含参时先讨论它是否为 0 及其正负&lt;br&gt;分式、高次：移项通分 → &lt;b&gt;因式分解&lt;/b&gt;成一次因式的乘积 → &lt;b&gt;穿根法&lt;/b&gt;，注意分母 \({\ne  0}\)&lt;br&gt;绝对值：\({|x|\lt a}\)、\({|x|\gt a}\) 公式，或按零点分段；指对：定义域优先，再看底数&lt;br&gt;三角：用三角函数线或图象，先在一个周期内找出范围，再加周期（sin、cos 加 2kπ，tan 加 kπ），如 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin  x \ge  \dfrac{1}{2} \iff  \dfrac{\pi }{6} + 2k\pi  \le  x \le  \dfrac{5\pi }{6} + 2k\pi}\)&lt;/span&gt;（\({k\in \mathbb{Z}}\)）&lt;br&gt;不等式组：分别解出再取交集；“或”取并集；最后用集合或区间写出解集&lt;br&gt;已知解集反求系数：先由解集形状定二次项系数的符号（如 \({\gt  0}\) 的解集在两根之间 \({\Rightarrow  a \lt  0}\)）；解集端点就是方程的根 → 写成 \({a(x-x_{1})(x-x_{2})}\) 展开比较系数，或用&lt;b&gt;韦达定理&lt;/b&gt;（工具箱② ⑫）&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次 → 解一元二次不等式 &lt;b&gt;〔R43 · F3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 分式 → 分式不等式 &lt;b&gt;〔R35 · C4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 高次 → 高次不等式（穿根法） &lt;b&gt;〔R25 · C3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 绝对值 → 绝对值不等式的等价形式（\({a\gt 0}\)） &lt;b&gt;〔R15 · C6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 指对 → 指数、对数不等式 &lt;b&gt;〔P04 · M3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根的分布 → 一元二次方程根的分布（\({a\gt 0}\)） &lt;b&gt;〔R44 · E3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 不等式组、写解集 → 不等式组与解集 &lt;b&gt;〔R72 · C4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根式 → 根式（无理）不等式的等价形式 &lt;b&gt;〔P56 · D3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="414" width="520" height="410" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_cmp" label="&lt;b&gt;看到 两个式子比大小&lt;/b&gt;&lt;br&gt;首选作差：\({a-b}\) 与 0 比较，差再用&lt;b&gt;因式分解&lt;/b&gt;或&lt;b&gt;配方&lt;/b&gt;定正负，如 \({a^{3}+b^{3}-ab(a+b)=(a+b)(a-b)^{2}}\)&lt;br&gt;含幂、指数的正数式子用作商：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b}}\)&lt;/span&gt; 与 1 比较&lt;br&gt;分式加同一个正数：糖水不等式；同一函数的两个值：利用单调性&lt;br&gt;复杂时找中间量（如 0、1），或构造函数用导数判断&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 作差 → 实数大小（作差法的依据） &lt;b&gt;〔S01 · H1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 作差后分解 \({\to  a^{3}+b^{3} \ge  ab(a+b)}\)（\({a+b \ge  0}\)） &lt;b&gt;〔P27 · J3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 作商 → 商与 1 比较（\({b\gt 0}\)） &lt;b&gt;〔P11 · G1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 糖水 → 糖水不等式 &lt;b&gt;〔P20 · H1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 单调性 → 【定义】函数单调性 &lt;b&gt;〔S07 · N2〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({a^{b}}\) 与 \({b^{a} \to}\) 构造 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x) = \dfrac{\ln x}{x}}\)&lt;/span&gt; 比大小（\({x\gt 0}\)） &lt;b&gt;〔P08 · F6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 作商的例子 \({\to  a^{a}b^{b} \ge  a^{b}b^{a}}\) &lt;b&gt;〔P49 · N3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两个不等式相减、相除 → 异向可减 &lt;b&gt;〔R75 · G1〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 异向正数可除 &lt;b&gt;〔P50 · G2〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="130" width="520" height="260" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_multi" label="&lt;b&gt;看到 多变量最值，有等式约束&lt;/b&gt;&lt;br&gt;消元：由约束解出一个变量代入，化成一元函数再求最值&lt;br&gt;换元：三角换元、和积代换（\({a+b=s, ab=p}\)）、增量换元（设 \({a=x+t}\)）&lt;br&gt;主元法：把某个字母看成主变量，其余看成常数；调整法：保持原约束，调整变量使目标更优&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 和积代换 → 和与积的关系 &lt;b&gt;〔R52 · J3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 消元后求导 → 【定理】导数判单调 &lt;b&gt;〔S04 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 调整法 → 排序不等式（n 个数） &lt;b&gt;〔R41 · A3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="2717" width="520" height="137" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_geo" label="&lt;b&gt;看到 斜率型、距离型的式子&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{y-b}{x-a}}\)&lt;/span&gt;：点 (x,y) 与 (a,b) 连线的斜率；\({\sqrt{(x-a)^{2}+(y-b)^{2}}}\)：两点间距离&lt;br&gt;\({|x-a|+|x-b|}\)：数轴上到两点的距离和&lt;br&gt;画图后，最值通常在相切或连线与图形相交时取到&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 距离和 → 绝对值和的最小值 &lt;b&gt;〔R53 · C7〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 距离（三角不等式） → 向量三角不等式（任意向量） &lt;b&gt;〔R27 · H6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 线性目标 \({ax+by}\)，约束是二元一次不等式组 → 简单线性规划（拓展） &lt;b&gt;〔R74 · C4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="4209" width="520" height="153" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_adv" label="&lt;b&gt;看到 导数压轴：放缩证明、极值点偏移、抽象函数&lt;/b&gt;&lt;br&gt;放缩：用切线不等式（\({e^{x}\ge 1+x}\)、\({\ln  x\le x-1}\) 及其变形）把函数换成一次式&lt;br&gt;求和放缩：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln \left(1+\dfrac{1}{k}\right) \lt  \dfrac{1}{k}}\)&lt;/span&gt;、裂项放缩、等比放缩&lt;br&gt;极值点偏移：先建立题设联系，再考虑对数平均不等式；抽象函数：把 \({f'}\) 与 f 凑成积或商的导数&lt;br&gt;隐零点：\({f'(x_{0}) = 0}\) 解不出 \({x_{0}}\) 时设而不求，用 \({f'(x_{0}) = 0}\) 把 \({e^{x_{0}}}\)、\({\ln  x_{0}}\) 换成 \({x_{0}}\) 的代数式，再代回 \({f(x_{0})}\) 化简&lt;br&gt;指对同构：如 \({xe^{x} = e^{x+\ln  x}}\)、\({x + \ln  x = \ln (xe^{x})}\)，（x &gt; 0）把两边化成同一个函数 g 的形式，再用 g 的单调性比较&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 指对同构 → \({xe^{x} \ge  x + \ln  x + 1}\) &lt;b&gt;〔P60 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 切线放缩 → 切线不等式（切线放缩） &lt;b&gt;〔P06 · G6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求和放缩 → 对数放缩求和 &lt;b&gt;〔P21 · D6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 极值点偏移 → 对数平均不等式（拓展） &lt;b&gt;〔P07 · F6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 抽象函数 → 积、商的导数定号（抽象函数） &lt;b&gt;〔P05 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({\ln (1+x)}\) 放缩 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\to  \dfrac{x}{1+x} \le  \ln (1+x) \le  x}\)&lt;/span&gt;（\({x \gt  -1}\)） &lt;b&gt;〔P22 · D6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 一阶切线不够精确 → 二阶放缩 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({e^{x} \ge  1+x+\dfrac{x^{2}}{2}}\)&lt;/span&gt; （\({x \ge  0}\)；\({x \lt  0}\) 时反向） &lt;b&gt;〔P51 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos  x \ge  1-\dfrac{x^{2}}{2}}\)&lt;/span&gt; &lt;b&gt;〔R76 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln (1+x) \ge  x-\dfrac{x^{2}}{2}}\)&lt;/span&gt; （\({x \ge  0}\)；\({-1 \lt  x \le  0}\) 时反向） &lt;b&gt;〔P53 · G6〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="5521" width="520" height="381" as="geometry" />
          </mxCell></UserObject><UserObject id="hm_mid" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P35&lt;/span&gt;&lt;br&gt;倒数的均值&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{a} + \dfrac{1}{b} \ge  \dfrac{2}{\sqrt{ab}}}\)&lt;/span&gt;（\({a,b\gt 0}\)）" 类型="中间结果" 适用范围="a,b&gt;0" 编号="P35" 层级="9"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;"><mxGeometry x="11029" y="3789" width="300" height="80" as="geometry" />
          </mxCell></UserObject><UserObject id="p3_hm" label="【取倒数】两边为正，取倒数不等号反向&lt;br&gt;【同乘、通分】两边 \({\times 2}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{2}{\dfrac{1}{a}+\dfrac{1}{b}} = \dfrac{2ab}{a+b}}\)&lt;/span&gt;" 类型="推导"><mxCell edge="1" parent="1" source="hm_mid" target="gmgehm" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1729">
              <Array as="points"><mxPoint x="11179.2" y="3994.0" /><mxPoint x="11192.2" y="3994.0" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="amn_mid" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a_{i}\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P36&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;2、4、8、…、\({2^{k}}\) 个数时成立" 类型="中间结果" 适用范围="aᵢ≥0" 编号="P36" 层级="9" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;"><mxGeometry x="11603" y="3805" width="260" height="48" as="geometry" />
          </mxCell></UserObject><UserObject id="p3_amn" label="【补项】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({A=\sum \dfrac{a_{i}}{n}}\)&lt;/span&gt;，取 \({m=2^{k}\gt n}\)，补 \({m-n}\) 个 A&lt;br&gt;\({A=0}\)：由 \({a_{i}\ge 0}\) 得全为 0，结论取等&lt;br&gt;\({A\gt 0}\)：m 元式给 \({A^{m}\ge (\prod a_{i})A^{m-n}}\)&lt;br&gt;约去 \({A^{m-n}}\) 后开 n 次方；取等 \({\Leftrightarrow  a_{i}}\) 全相等" 类型="推导"><mxCell edge="1" parent="1" source="amn_mid" target="am_n" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1876">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="quad_sq" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R17&lt;/span&gt;&lt;br&gt;配方结果&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x) = a\left(x + \dfrac{b}{2a}\right)^{2} - \dfrac{\Delta }{4a}}\)&lt;/span&gt;，其中 \({\Delta  = b^{2}-4ac}\)" 类型="中间结果" 适用范围="任意实数" 编号="R17" 层级="1"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;"><mxGeometry x="5282" y="2141" width="330" height="96" as="geometry" />
          </mxCell></UserObject><UserObject id="p3_quad" label="「平方非负」\({a\gt 0}\)，平方项 \({\ge  0}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x = -\dfrac{b}{2a}}\)&lt;/span&gt; 时平方项为 0，取到最小值" 类型="推导"><mxCell edge="1" parent="1" source="quad_sq" target="qmin" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0662">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ent_probe" label="&lt;b&gt;看到 含参不等式，分离参数很难&lt;/b&gt;&lt;br&gt;必要性探路：设 h(x) 为两边之差，要 \({h(x)\ge 0}\) 在区间上恒成立；先找一点 \({x_{0}}\)，使无论参数取何值都有 \({h(x_{0})=0}\)，这时 \({x_{0}}\) 就是最小值点&lt;br&gt;\({x_{0}}\) 是区间内部的点 \({\Rightarrow  h'(x_{0})=0}\)（切线法）；\({x_{0}}\) 是左端点 \({\Rightarrow  h'(x_{0}) \ge  0}\)（端点效应）；右端点 \({\Rightarrow  h'(x_{0}) \le  0}\)&lt;br&gt;先由此求出参数的候选值，再证明它确实满足（充分性）；前提是 \({h(x)\ge 0}\) 恒成立，只有 \({h(x_{0})=0}\) 推不出 \({h'(x_{0})=0}\)&lt;br&gt;例：\({e^{x} \ge  ax+1}\) 对一切实数 x 恒成立，\({x=0}\) 时两边都等于 1 且为内点 \({\Rightarrow  a=1}\)；验证：\({a=1}\) 时就是 \({e^{x} \ge  1+x}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求导找候选值 → 【定理】导数判单调 &lt;b&gt;〔S04 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 例：\({a=1 \to  e^{x} \ge  1+x}\) &lt;b&gt;〔R10 · E6〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="5109" width="520" height="196" as="geometry" />
          </mxCell></UserObject><UserObject id="p5e2" label="【前提】负 × 负 = 正：两个负因式之积为正" 类型="汇合"><mxCell edge="1" parent="1" source="muln" target="high_ineq" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8997;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9405">
              <Array as="points"><mxPoint x="6440.0" y="465.5" /><mxPoint x="6440.0" y="1345.6" /><mxPoint x="6483.0" y="1345.6" /><mxPoint x="6163.0" y="1345.6" /><mxPoint x="3167.6" y="1345.6" /><mxPoint x="2847.6" y="1345.6" /><mxPoint x="2847.6" y="1665.6" /><mxPoint x="2847.6" y="2315.2" /><mxPoint x="2847.6" y="2635.2" /><mxPoint x="2769.5" y="2635.2" /><mxPoint x="2769.5" y="2635.2" /><mxPoint x="2691.4" y="2635.2" /><mxPoint x="2691.4" y="2766.5" /><mxPoint x="2691.4" y="2766.5" /><mxPoint x="2691.4" y="2897.7" /><mxPoint x="2654.8" y="2897.7" /><mxPoint x="2654.8" y="2897.7" /><mxPoint x="2618.2" y="2897.7" /><mxPoint x="2618.2" y="2961.3" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="p5e3" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 进入正数域：要求 \({a_{k}\gt 0}\)、\({q\gt 0}\)&lt;/span&gt;&lt;br&gt;【前提】乘以 \({q\gt 0}\) 不改变方向，递推得 \({a_{k} \le  a_{1}q^{k-1}}\)" 类型="汇合"><mxCell edge="1" parent="1" source="mulp" target="geo_bound" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5455;exitY=1;exitDx=0;exitDy=0;entryX=0.7664;entryY=0.0000;entryDx=0;entryDy=0;" mark="▼ 要求 aₖ&gt;0、q&gt;0"><mxGeometry relative="1" as="geometry" x="0.9717">
              <Array as="points"><mxPoint x="7060.0" y="1345.6" /><mxPoint x="7025.0" y="1345.6" /><mxPoint x="7345.0" y="1345.6" /><mxPoint x="12796.7" y="1345.6" /><mxPoint x="13116.7" y="1345.6" /><mxPoint x="13116.7" y="1665.6" /><mxPoint x="13116.7" y="4694.7" /><mxPoint x="13116.7" y="5014.7" /><mxPoint x="12796.7" y="5014.7" /><mxPoint x="11845.7" y="5014.7" /><mxPoint x="11525.7" y="5014.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5130.7" /><mxPoint x="11586.1" y="5130.7" /><mxPoint x="11586.1" y="5130.7" /><mxPoint x="11646.5" y="5130.7" /><mxPoint x="11646.5" y="5253.5" /><mxPoint x="11646.5" y="5253.5" /><mxPoint x="11646.5" y="5376.3" /><mxPoint x="11607.2" y="5376.3" /><mxPoint x="11607.2" y="5376.3" /><mxPoint x="11567.8" y="5376.3" /><mxPoint x="11567.8" y="5431.5" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="root_dist" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\in \mathbb{R}}\)；\({a\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R44&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 一元二次方程根的分布（\({a\gt 0}\)；重根算两个根）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;两根都大于 \({k \iff  \Delta  \ge  0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({-\dfrac{b}{2a} \gt  k}\)&lt;/span&gt;，\({f(k) \gt  0}\)&lt;br&gt;一根大于 k、一根小于 \({k \iff  f(k) \lt  0}\)&lt;br&gt;两根都在 (m,n) 内 \({\iff  \Delta  \ge  0}\)，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({m \lt  -\dfrac{b}{2a} \lt  n}\)&lt;/span&gt;，\({f(m) \gt  0}\)，\({f(n) \gt  0}\)&lt;/div&gt;" 类型="结论" 适用范围="x∈ℝ；a&gt;0" 编号="R44" 层级="4" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="5237" y="3046" width="420" height="151" as="geometry" />
          </mxCell></UserObject><UserObject id="p5e5" label="【数形结合】看三样：判别式、对称轴位置、端点函数值的符号" 类型="推导"><mxCell edge="1" parent="1" source="three_two" target="root_dist" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0688">
              <mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="lnx_over_x" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P08&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 函数 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x) = \dfrac{\ln x}{x}}\)&lt;/span&gt; 的单调性（\({x\gt 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f'(x) = \dfrac{1 - \ln  x}{x^{2}}}\)&lt;/span&gt;：(0,e) 递增，\({(e,+\infty)}\) 递减&lt;br&gt;最大值 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(e) = \dfrac{1}{e} \Rightarrow  \ln  x \le  \dfrac{x}{e}}\)&lt;/span&gt;&lt;br&gt;例：\({f(e) \gt  f(\pi) \Rightarrow  \pi  \gt  e\cdot \ln  \pi  \Rightarrow  e^{\pi } \gt  \pi ^{e}}\)&lt;/div&gt;" 类型="结论" 适用范围="x&gt;0" 编号="P08" 层级="1" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="6462" y="5610" width="400" height="150" as="geometry" />
          </mxCell></UserObject><UserObject id="p5e6" label="【构造函数】把 \({a^{b}}\) 与 \({b^{a}}\) 取对数，化为比较 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\ln a}{a}}\)&lt;/span&gt; 与 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\ln b}{b}}\)&lt;/span&gt;&lt;br&gt;【求导】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f' = \dfrac{1 - \ln  x}{x^{2}}}\)&lt;/span&gt;，按 x 与 e 的大小分类" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" target="lnx_over_x" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.7862;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4575;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.7510">
              <Array as="points"><mxPoint x="5889.3" y="5482.7" /><mxPoint x="6449.7" y="5482.7" /><mxPoint x="6449.7" y="5498.2" /><mxPoint x="6644.6" y="5498.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="sin_tan" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({0\lt x\lt \dfrac{\pi }{2}}\)&lt;/span&gt; &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P16&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;常用三角不等式（也可用单位圆面积比较）&lt;/span&gt;&lt;br&gt;\({\sin  x \lt  x \lt  \tan  x}\)（&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({0 \lt  x \lt  \dfrac{\pi }{2}}\)&lt;/span&gt;）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ㉞ 正切与余弦：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\cos^{2} x} = 1 + \tan^{2} x}\)&lt;/span&gt;&lt;/span&gt;" 类型="结论" 适用范围="0&lt;x&lt;π/2" 编号="P16" 层级="2" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;"><mxGeometry x="5558" y="5975" width="320" height="143" as="geometry" />
          </mxCell></UserObject><UserObject id="p5e7" label="&lt;span style=&quot;color:#D84315;font-weight:bold;&quot;&gt;▼ 加条件：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({0\lt x\lt \dfrac{\pi }{2}}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;【前提】\({|\sin  x| \le  |x|}\)，\({x\gt 0}\) 时取不到等号 \({\Rightarrow  \sin  x \lt  x}\)" 类型="汇合"><mxCell edge="1" parent="1" source="sinx_ineq" target="sin_tan" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.8093;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3416;entryY=0.0000;entryDx=0;entryDy=0;curved=1;" mark="▼ 加条件：0&amp;lt;x&amp;lt;π/2"><mxGeometry relative="1" as="geometry" x="0.5230">
              <Array as="points"><mxPoint x="5125.7" y="5793.7" /><mxPoint x="5522.2" y="5793.7" /><mxPoint x="5522.2" y="5863.7" /><mxPoint x="5666.9" y="5863.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="p5e8" label="【构造函数】令 \({g(x) = \tan  x - x}\)&lt;br&gt;【求导】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({g' = \dfrac{1}{\cos^{2} x} - 1 = \tan^{2} x \gt  0}\)&lt;/span&gt;，\({g(0)=0 \Rightarrow  \tan  x \gt  x}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_deriv" target="sin_tan" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.4956;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8415;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1477">
              <Array as="points"><mxPoint x="5694.6" y="5684.7" /><mxPoint x="5826.9" y="5684.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ln1px" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\gt -1}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P22&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;对数切线不等式的变形（x 换成 \({1+x}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{x}{1+x} \le  \ln (1+x) \le  x}\)&lt;/span&gt;（\({x \gt  -1}\)）&lt;br&gt;等号 \({\iff  x=0}\)" 类型="结论" 适用范围="x&gt;−1" 编号="P22" 层级="3" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;"><mxGeometry x="3466" y="6343" width="320" height="115" as="geometry" />
          </mxCell></UserObject><UserObject id="p5e10" label="【代换】\({\ln  t \le  t-1}\) 中令 \({t = 1+x}\)：\({\ln (1+x) \le  x}\)" 类型="推导"><mxCell edge="1" parent="1" source="logineq" target="ln1px" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.0000;exitY=0.3371;exitDx=0;exitDy=0;entryX=0.2025;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.6651">
              <Array as="points"><mxPoint x="3423.8" y="5671.7" /><mxPoint x="3423.8" y="6229.7" /><mxPoint x="3530.4" y="6229.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="p5e11" label="【前提】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  t \ge  1 - \dfrac{1}{t}}\)&lt;/span&gt; 中令 \({t = 1+x}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln (1+x) \ge  \dfrac{x}{1+x}}\)&lt;/span&gt;" 类型="汇合"><mxCell edge="1" parent="1" source="ln_lower" target="ln1px" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.1772;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7530;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0993">
              <Array as="points"><mxPoint x="3947.6" y="6229.7" /><mxPoint x="3706.5" y="6229.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="sqrt_split" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 正整数 k &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P25&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 根式裂项&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{\sqrt{k}} \lt  2\left(\sqrt{k} - \sqrt{k-1}\right)}\)&lt;/span&gt;（\({k \ge  1}\)）&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\Rightarrow  1 + \dfrac{1}{\sqrt{2}} + \cdots  + \dfrac{1}{\sqrt{n}} \lt  2\sqrt{n}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ① 平方差公式：\({\left(\sqrt{k} + \sqrt{k-1}\right)\left(\sqrt{k} - \sqrt{k-1}\right) = 1}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="正整数 k" 编号="P25" 层级="4" 高考常用="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="11909" y="5477" width="320" height="157" as="geometry" />
          </mxCell></UserObject><UserObject id="p5e12" label="【取倒数】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sqrt{k} + \sqrt{k-1} \lt  2\sqrt{k} \Rightarrow  \dfrac{1}{\sqrt{k}} = \dfrac{2}{2\sqrt{k}} \lt  \dfrac{2}{\sqrt{k} + \sqrt{k-1}}}\)&lt;/span&gt;&lt;br&gt;【分母有理化】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{2}{\sqrt{k} + \sqrt{k-1}} = 2\left(\sqrt{k} - \sqrt{k-1}\right)}\)&lt;/span&gt;；【裂项】求和时中间项相消" 类型="推导"><mxCell edge="1" parent="1" source="recip" target="sqrt_split" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9832">
              <Array as="points"><mxPoint x="8380.0" y="1345.6" /><mxPoint x="7089.2" y="1345.6" /><mxPoint x="7409.2" y="1345.6" /><mxPoint x="12796.7" y="1345.6" /><mxPoint x="13116.7" y="1345.6" /><mxPoint x="13116.7" y="1665.6" /><mxPoint x="13116.7" y="4694.7" /><mxPoint x="13116.7" y="5014.7" /><mxPoint x="12796.7" y="5014.7" /><mxPoint x="11845.7" y="5014.7" /><mxPoint x="11525.7" y="5014.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5072.7" /><mxPoint x="11525.7" y="5130.7" /><mxPoint x="11797.1" y="5130.7" /><mxPoint x="11797.1" y="5130.7" /><mxPoint x="12068.5" y="5130.7" /><mxPoint x="12068.5" y="5309.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="ax_set" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S08&lt;/span&gt;&lt;br&gt;【定义】集合与区间&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;交集 A∩B：同时属于 A 和 B；并集 A∪B：属于 A 或属于 B&lt;br&gt;区间：(a,b)、[a,b]、\({(a,+\infty)}\)、\({(-\infty ,b]}\) 等；圆括号不含端点，方括号含端点&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：这是定义&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="不适用" 编号="S08" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2842" y="2831" width="340" height="134" as="geometry" /></mxCell></UserObject><UserObject id="sol_set" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R72&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#6D4C41;font-weight:bold;&quot;&gt; 解法 &lt;/span&gt;&lt;br&gt;★ 不等式组与解集&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;不等式组（各式同时成立）：分别解出，再取交集&lt;br&gt;“或”连接（满足其一即可）：取并集&lt;br&gt;解集写成集合或区间：如 \({\{x | x\lt -1}\) 或 \({x\gt 2\} = (-\infty ,-1)\cup (2,+\infty)}\)&lt;br&gt;数轴上画出各解集，公共部分就是交集；端点取到画实心点，取不到画空心点&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R72" 层级="1" 类型标记="解法"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2802" y="3273" width="420" height="154" as="geometry" /></mxCell></UserObject><UserObject id="v29e1" label="【定义】同时成立 ⇔ 属于每个解集 ⇔ 属于交集&lt;br&gt;满足其一 ⇔ 属于并集" 类型="推导"><mxCell parent="1" edge="1" source="ax_set" target="sol_set" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0392"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="v29e2" label="【前提】每个不等式先单独求出解集" 类型="汇合"><mxCell parent="1" edge="1" source="solve_quad" target="sol_set" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.4020"><Array as="points"><mxPoint x="5982" y="3250" /><mxPoint x="4017.4" y="3250" /><mxPoint x="4017.4" y="3349.8" /></Array><mxPoint x="104.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="ax_parity" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S09&lt;/span&gt;&lt;br&gt;【定义】函数奇偶性（定义域关于原点对称）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;偶函数：\({f(-x)=f(x)}\)，图像关于 y 轴对称&lt;br&gt;奇函数：\({f(-x)=-f(x)}\)，图像关于原点对称&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：这是定义&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="不适用" 编号="S09" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="13749" y="2252" width="360" height="99" as="geometry" /></mxCell></UserObject><UserObject id="mono_strip" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; 同一单调区间 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P47&lt;/span&gt;&lt;br&gt;★ 用单调性去掉 f&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;f 在区间 I 上递增，a、\({b\in I}\)：\({f(a)\lt f(b) \iff  a\lt b}\)&lt;br&gt;f 在区间 I 上递减：\({f(a)\lt f(b) \iff  a\gt b}\)（不等号反向）&lt;br&gt;先查：a、b 都要在定义域内，且在同一个单调区间里&lt;/div&gt;" 类型="结论" 适用范围="同一单调区间" 编号="P47" 层级="1"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="14141" y="2250" width="400" height="102" as="geometry" /></mxCell></UserObject><UserObject id="v29e3" label="【反证】设 \({f(a)\lt f(b)}\)，假设 \({a \ge  b}\)：&lt;br&gt;\({a=b}\) 时 \({f(a)=f(b)}\)，\({a\gt b}\) 时 \({f(a)\gt f(b)}\)，都与 \({f(a)\lt f(b)}\) 矛盾 \({\Rightarrow  a\lt b}\)" 类型="推导"><mxCell parent="1" edge="1" source="mono_def" target="mono_strip" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.6667;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3355;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="-0.0541"><Array as="points"><mxPoint x="14276.0" y="2127.7" /><mxPoint x="14274.9" y="2127.7" /></Array><mxPoint x="-52.2" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="par_mono" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; f 有奇偶性且单调 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P48&lt;/span&gt;&lt;br&gt;★ 奇偶性 + 单调性的等价转化（抽象函数）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;偶函数、在 \({[0,+\infty )}\) 上递增：\({f(a)\lt f(b) \iff  |a|\lt |b|}\)&lt;br&gt;奇函数、在 ℝ 上递增：\({f(a)+f(b)\lt 0 \iff  f(a)\lt f(-b) \iff  a\lt -b}\)&lt;br&gt;例：f 为偶函数且在 \({[0,+\infty )}\) 上递增，\({f(x-1)\lt f(2x) \iff  |x-1|\lt |2x| \iff  x\lt -1}\) 或 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x\gt \dfrac{1}{3}}\)&lt;/span&gt;&lt;br&gt;先查：定义域；偶函数先化成 \({f(|\cdot|)}\) 再比较，别漏掉负的那一半&lt;/div&gt;" 类型="结论" 适用范围="f 有奇偶性且单调" 编号="P48" 层级="2"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="14111" y="2550" width="460" height="153" as="geometry" /></mxCell></UserObject><UserObject id="v29e4" label="【代换】偶函数：\({f(a)=f(|a|)}\)，两边都化到 \({[0,+\infty )}\) 上&lt;br&gt;奇函数：\({-f(b)=f(-b)}\)，把负号移进括号" 类型="推导"><mxCell parent="1" edge="1" source="ax_parity" target="par_mono" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5862;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0195;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="-0.2898"><Array as="points"><mxPoint x="13959.7" y="2467.2" /><mxPoint x="14119.6" y="2467.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="v29e5" label="【去掉 f】同在一个单调区间后，按单调性比较自变量" 类型="推导"><mxCell parent="1" edge="1" source="mono_strip" target="par_mono" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.1842"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="v29e6" label="【前提】\({|a|\lt |b| \iff  a^{2}\lt b^{2}}\)（两边非负）" 类型="汇合"><mxCell parent="1" edge="1" source="sq_mono" target="par_mono" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9674;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9404"><Array as="points"><mxPoint x="6055.0" y="498.0" /><mxPoint x="6055.0" y="1285.6" /><mxPoint x="7205.0" y="1285.6" /><mxPoint x="7525.0" y="1285.6" /><mxPoint x="14546.7" y="1285.6" /><mxPoint x="14866.7" y="1285.6" /><mxPoint x="14866.7" y="1482.6" /><mxPoint x="14866.7" y="1482.6" /><mxPoint x="14866.7" y="1679.6" /><mxPoint x="14926.2" y="1679.6" /><mxPoint x="14926.2" y="1679.6" /><mxPoint x="14985.6" y="1679.6" /><mxPoint x="14985.6" y="1999.6" /><mxPoint x="14985.6" y="2147.2" /><mxPoint x="14985.6" y="2467.2" /><mxPoint x="14770.7" y="2467.2" /><mxPoint x="14770.7" y="2467.2" /><mxPoint x="14555.7" y="2467.2" /><mxPoint x="14555.7" y="2506.9" /></Array><mxPoint x="0.0" y="-0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="ent_absfn" label="&lt;b&gt;看到 只给性质、不给解析式的不等式，如 \({f(x-1) \lt  f(2x)}\)&lt;/b&gt;&lt;br&gt;反推：去掉 f ← 单调性；偶函数先化成 \({f(|\cdot|) \leftarrow}\) 奇偶性；奇函数先把 \({-f(b)}\) 化成 \({f(-b)}\)&lt;br&gt;先查：定义域；是否在同一个单调区间；偶函数要比较绝对值&lt;br&gt;若给的是 \({f'}\) 与 f 的关系（如 \({f'+f\gt 0}\)），改用构造函数&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 去掉 f → 用单调性去掉 f &lt;b&gt;〔P47 · N3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 奇偶性 + 单调性 → 奇偶性 + 单调性的等价转化 &lt;b&gt;〔P48 · N3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 给的是导数关系 → 积、商的导数定号（抽象函数） &lt;b&gt;〔P05 · E6〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;"><mxGeometry x="-840" y="848" width="520" height="137" as="geometry" /></mxCell></UserObject><UserObject id="lp_region" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R73&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 二元一次不等式表示平面区域&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({B\gt 0}\) 时：\({Ax+By+C\gt 0}\) 表示直线 \({Ax+By+C=0}\) 的上方，\({\lt 0}\) 表示下方&lt;br&gt;\({B\lt 0}\) 时上下相反；也可代入一个不在直线上的点（常用原点）判断&lt;br&gt;不等式组表示的区域：各个区域的公共部分&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R73" 层级="2" 拓展="是"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2940" y="3690" width="440" height="102" as="geometry" /></mxCell></UserObject><UserObject id="v29e7" label="【同乘】点 \({(x_{0},y_{0})}\) 在直线上，\({y\gt y_{0}}\)，\({B\gt 0}\)&lt;br&gt;\({\Rightarrow  B(y-y_{0})\gt 0 \Rightarrow  Ax_{0}+By+C \gt  Ax_{0}+By_{0}+C = 0}\)：直线上方" 类型="推导"><mxCell parent="1" edge="1" source="mulp" target="lp_region" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5455;exitY=1;exitDx=0;exitDy=0;entryX=0.8564;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.8972"><Array as="points"><mxPoint x="7060.0" y="1345.6" /><mxPoint x="6491.1" y="1345.6" /><mxPoint x="6171.1" y="1345.6" /><mxPoint x="3167.6" y="1345.6" /><mxPoint x="2847.6" y="1345.6" /><mxPoint x="2847.6" y="1665.6" /><mxPoint x="2847.6" y="2315.2" /><mxPoint x="2847.6" y="2635.2" /><mxPoint x="3138.0" y="2635.2" /><mxPoint x="3138.0" y="2635.2" /><mxPoint x="3428.4" y="2635.2" /><mxPoint x="3428.4" y="2955.2" /><mxPoint x="3428.4" y="3029.8" /><mxPoint x="3428.4" y="3349.8" /><mxPoint x="3372.8" y="3349.8" /><mxPoint x="3372.8" y="3349.8" /><mxPoint x="3317.2" y="3349.8" /><mxPoint x="3317.2" y="3513.8" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="v29e8" label="【前提】不等式组 ⇔ 各区域取交集（公共部分）" 类型="汇合"><mxCell parent="1" edge="1" source="sol_set" target="lp_region" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.6430;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0456"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="lp" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R74&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#6D4C41;font-weight:bold;&quot;&gt; 解法 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 简单线性规划&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;约束条件：二元一次不等式组画出平面区域&lt;br&gt;目标 \({z=ax+by}\)（\({b\ne 0}\)）：化为 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({y=-\left(\dfrac{a}{b}\right)x+\dfrac{z}{b}}\)&lt;/span&gt;，在区域内平移这条直线&lt;br&gt;\({b\gt 0}\) 时直线越往上 z 越大，\({b\lt 0}\) 时相反；最值一般在区域的顶点处取到&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：斜率型 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{y-b}{x-a}}\)&lt;/span&gt;、距离型 \({(x-a)^{2}+(y-b)^{2}}\) 也在同一区域上看几何意义&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R74" 层级="3" 拓展="是" 类型标记="解法"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="2930" y="3958" width="460" height="147" as="geometry" /></mxCell></UserObject><UserObject id="v29e9" label="【平移直线】目标看成一族平行直线，截距 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{z}{b}}\)&lt;/span&gt; 随 z 变化&lt;br&gt;【数形结合】在区域内找截距最大、最小的位置" 类型="推导"><mxCell parent="1" edge="1" source="lp_region" target="lp" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.0686"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="quot_ex" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P49&lt;/span&gt;&lt;br&gt;★ 作商比大小：\({a^{a}b^{b} \ge  a^{b}b^{a}}\)&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a,b\gt 0}\)；等号 \({\iff  a=b}\)&lt;br&gt;两边都是正的乘幂，作商比作差方便&lt;/div&gt;" 类型="结论" 适用范围="a,b&gt;0" 编号="P49" 层级="3"><mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;"><mxGeometry x="14573" y="2259" width="360" height="84" as="geometry" /></mxCell></UserObject><UserObject id="m32e0" label="【作商】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a^{a}b^{b}}{a^{b}b^{a}} = a^{a-b}\cdot b^{b-a} = \left(\dfrac{a}{b}\right)^{a-b}}\)&lt;/span&gt;&lt;br&gt;【分类讨论】\({a\gt b}\)：底\({\gt 1}\)、指数\({\gt 0 \Rightarrow}\) 商\({\gt 1}\)；\({a\lt b}\)：底\({\lt 1}\)、指数\({\lt 0 \Rightarrow}\) 商\({\gt 1}\)；\({a=b}\)：商\({=1}\)" 类型="推导"><mxCell parent="1" edge="1" source="quotient" target="quot_ex" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6826;entryY=0.0000;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.9294"><Array as="points"><mxPoint x="7570.0" y="1285.6" /><mxPoint x="7286.5" y="1285.6" /><mxPoint x="7606.5" y="1285.6" /><mxPoint x="14546.7" y="1285.6" /><mxPoint x="14866.7" y="1285.6" /><mxPoint x="14866.7" y="1482.6" /><mxPoint x="14866.7" y="1482.6" /><mxPoint x="14866.7" y="1679.6" /><mxPoint x="14807.2" y="1679.6" /><mxPoint x="14807.2" y="1679.6" /><mxPoint x="14747.7" y="1679.6" /><mxPoint x="14747.7" y="1815.9" /><mxPoint x="14747.7" y="1815.9" /><mxPoint x="14747.7" y="1952.2" /><mxPoint x="14783.0" y="1952.2" /><mxPoint x="14783.0" y="1952.2" /><mxPoint x="14818.4" y="1952.2" /><mxPoint x="14818.4" y="2099.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="m32e1" label="【前提】指数函数：底\({\gt 1}\) 时递增，\({0\lt}\)底\({\lt 1}\) 时递减" 类型="汇合"><mxCell parent="1" edge="1" source="mono_def" target="quot_ex" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;exitX=1.0000;exitY=0.8115;exitDx=0;exitDy=0;entryX=0.1826;entryY=0.0000;entryDx=0;entryDy=0;curved=1;"><mxGeometry relative="1" as="geometry" x="0.2623"><Array as="points"><mxPoint x="14500.2" y="2000.2" /><mxPoint x="14500.2" y="2127.7" /><mxPoint x="14638.4" y="2127.7" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="fx2e0" label="【前提】平方非负：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a\left(x+\dfrac{b}{2a}\right)^{2} \ge  0}\)&lt;/span&gt;（\({a\gt 0}\)）" 类型="汇合"><mxCell parent="1" edge="1" source="sq" target="qmin" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3361;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" x="0.6178"><Array as="points"><mxPoint x="6600.5" y="1405.6" /><mxPoint x="6648.1" y="1405.6" /><mxPoint x="6328.1" y="1405.6" /><mxPoint x="6225.4" y="1405.6" /><mxPoint x="5905.4" y="1405.6" /><mxPoint x="5905.4" y="1542.6" /><mxPoint x="5905.4" y="1542.6" /><mxPoint x="5905.4" y="1679.6" /><mxPoint x="5815.9" y="1679.6" /><mxPoint x="5815.9" y="1679.6" /><mxPoint x="5726.4" y="1679.6" /><mxPoint x="5726.4" y="1868.4" /><mxPoint x="5726.4" y="1868.4" /><mxPoint x="5726.4" y="2057.2" /><mxPoint x="5675.9" y="2057.2" /><mxPoint x="5675.9" y="2057.2" /><mxPoint x="5625.3" y="2057.2" /><mxPoint x="5625.3" y="2257.7" /><mxPoint x="5625.3" y="2257.7" /><mxPoint x="5625.3" y="2458.2" /><mxPoint x="5624.2" y="2458.2" /></Array><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell></UserObject><UserObject id="fx2e1" label="【前提】非负数平方保序：两边都非负，开平方不改变方向" 类型="汇合"><mxCell parent="1" edge="1" source="sq_mono" target="qm_step" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#90A4AE;strokeWidth=2;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4964;entryDx=0