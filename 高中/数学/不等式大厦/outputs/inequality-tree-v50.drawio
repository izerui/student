          </mxCell></UserObject><UserObject id="rev" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R59&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 反三角不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({||a|-|b|| \le  |a-b|}\)&lt;br&gt;等号 \({\iff  ab \ge  0}\)&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R59" 层级="7" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="98" width="210" x="2218" y="7126" as="geometry" />
          </mxCell></UserObject><UserObject id="dsq" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R37&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a-b)^{2} \ge  0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ② 完全平方公式：用②展开 \({(a-b)^{2}}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R37" 层级="4"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="102" width="150" x="9715" y="1971" as="geometry" />
          </mxCell></UserObject><UserObject id="dexp" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R46&lt;/span&gt;&lt;br&gt;\({a^{2}-2ab+b^{2} \ge  0}\)" 类型="中间结果" 适用范围="任意实数" 编号="R46" 层级="5"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="48" width="180" x="9700" y="2337" as="geometry" />
          </mxCell></UserObject><UserObject id="sqsum" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R55&lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;重要不等式&lt;/span&gt;&lt;br&gt;\({a^{2}+b^{2} \ge  2ab}\)&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;等号 \({\iff  a=b}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：排序不等式（两数）——\({a^{2}+b^{2}\ge 2ab}\) 是它的特例：(a,b) 与 (a,b) 同序和 ≥ 逆序和&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：㉜ 余弦定理——三角形中 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos A=\dfrac{b^{2}+c^{2}-a^{2}}{2bc}}\)&lt;/span&gt;，配合 \({b^{2}+c^{2}\ge 2bc}\) 求角的范围&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R55" 层级="6"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="193" width="190" x="9695" y="2602" as="geometry" />
          </mxCell></UserObject><UserObject id="sum2" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R60&lt;/span&gt;&lt;br&gt;平方和与完全平方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({2(a^{2}+b^{2}) \ge  (a+b)^{2}}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑨ \({a^{2}+b^{2} = (a+b)^{2}-2ab}\)：用⑨互换 \({a^{2}+b^{2}}\) 与 \({(a+b)^{2}}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R60" 层级="7"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="91" width="213" x="9455" y="3010" as="geometry" />
          </mxCell></UserObject><UserObject id="half" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R65&lt;/span&gt;&lt;br&gt;半平方和不等式&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a^{2}+b^{2}}{2} \ge  \left(\dfrac{a+b}{2}\right)^{2}}\)&lt;/span&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R65" 层级="8"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="80" width="228" x="9376" y="3360" as="geometry" />
          </mxCell></UserObject><UserObject id="quad0" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\in \mathbb{R}}\)；\({a\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S05&lt;/span&gt;&lt;br&gt;【研究对象】二次函数&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({f(x) = ax^{2}+bx+c}\)（\({a\gt 0}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：这是研究对象的定义，不是推出来的&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="x∈ℝ；a&gt;0" 编号="S05" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="90" width="260" x="5317" y="1875" as="geometry" />
          </mxCell></UserObject><UserObject id="qmin" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\in \mathbb{R}}\)；\({a\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R23&lt;/span&gt;&lt;br&gt;★ 二次函数最小值&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x) \ge  -\dfrac{\Delta }{4a}}\)&lt;/span&gt;&lt;br&gt;在 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=-\dfrac{b}{2a}}\)&lt;/span&gt; 取到&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：⑫ 韦达定理——已知两根时：顶点 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=-\dfrac{b}{2a}=\dfrac{x_{1}+x_{2}}{2}}\)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="x∈ℝ；a&gt;0" 编号="R23" 层级="2"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="182" width="328" x="5283" y="2389" as="geometry" />
          </mxCell></UserObject><UserObject id="qall" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\in \mathbb{R}}\)；\({a\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R30&lt;/span&gt;&lt;br&gt;★ 恒非负条件&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({ax^{2}+bx+c \ge  0}\) 对所有 x&lt;br&gt;\({\iff  \Delta  \le  0}\)（\({a\gt 0}\)）&lt;br&gt;恒 \({\gt  0 \iff  \Delta  \lt  0}\)；二次项系数含参时，先讨论它是否为 0；a &lt; 0 时不可能恒非负&lt;/div&gt;" 类型="结论" 适用范围="x∈ℝ；a&gt;0" 编号="R30" 层级="3"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="130" width="345" x="5690" y="2749" as="geometry" />
          </mxCell></UserObject><UserObject id="ex1" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R31&lt;/span&gt;&lt;br&gt;例：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a^{2}-3a+3 = \left(a-\dfrac{3}{2}\right)^{2}+\dfrac{3}{4}}\)&lt;/span&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R31" 层级="3"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="64" width="240" x="4297" y="2782" as="geometry" />
          </mxCell></UserObject><UserObject id="ex2" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R38&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(a-\dfrac{3}{2}\right)^{2}+\dfrac{3}{4} \ge  \dfrac{3}{4} \gt  0}\)&lt;/span&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R38" 层级="4"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="64" width="220" x="4307" y="3090" as="geometry" />
          </mxCell></UserObject><UserObject id="ex3" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R47&lt;/span&gt;&lt;br&gt;\({\therefore  a^{2}+3 \gt  3a}\)（任意实数 a）" 类型="中间结果" 适用范围="任意实数" 编号="R47" 层级="5"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="48" width="220" x="4307" y="3348" as="geometry" />
          </mxCell></UserObject><UserObject id="rad" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({u,v\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P28&lt;/span&gt;&lt;br&gt;和与几何平均的关系&lt;br&gt;\({u+v \ge  2\sqrt{uv}}\)（\({u,v \ge  0}\)）" 类型="中间结果" 适用范围="u,v≥0" 编号="P28" 层级="7"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;" vertex="1"><mxGeometry height="64" width="265" x="10293" y="3024" as="geometry" />
          </mxCell></UserObject><UserObject id="am" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P29&lt;/span&gt;&lt;br&gt;★★ 基本不等式 / 均值不等式\({(\text{AM}\ge \text{GM})}\)&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a+b}{2} \ge  \sqrt{ab}}\)&lt;/span&gt;&lt;br&gt;\({a,b \ge  0}\)；等号 \({\iff  a=b}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;人教 B 版：均值不等式要求 a、b 都是正数；基本不等式中 a、b 还可以为 0&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;几何意义：半圆直径被分成 a、b 两段，半弦 \({\sqrt{ab} \le}\) 半径 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a+b}{2}}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：万能公式（见《恒等式素材》）——把三角式化为 t 的式子再用 \({\text{AM}\ge \text{GM}}\)；代入后重新检查各项非负、等号能否取到&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#E65100;font-weight:bold;font-size:11px;&quot;&gt;⚠️ 一正二定三相等：“一正”（各项 \({\ge 0}\)）是定理成立的条件；“二定”（和或积为定值）、“三相等”（等号能取到）是用它求最值时还要查的&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="a,b≥0" 编号="P29" 层级="8"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="207" width="520" x="10801" y="3296" as="geometry" />
          </mxCell></UserObject><UserObject id="qm_step" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R69&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;平方平均与 \({|a+b|}\) 的关系&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sqrt{\dfrac{a^{2}+b^{2}}{2}} \ge  \dfrac{|a+b|}{2}}\)&lt;/span&gt;&lt;br&gt;又 \({|a+b| \ge  a+b}\)，故对任意实数 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ge  \dfrac{a+b}{2}}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R69" 层级="9"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="120" width="351" x="9245" y="3769" as="geometry" />
          </mxCell></UserObject><UserObject id="qmgeam" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R71&lt;/span&gt;&lt;br&gt;★ 平方平均 ≥ 算术平均&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sqrt{\dfrac{a^{2}+b^{2}}{2}} \ge  \dfrac{a+b}{2}}\)&lt;/span&gt;&lt;br&gt;对任意实数成立；等号 \({\iff  a=b \ge  0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 应用（统计）：n 个数时 \({\dfrac{x_{1}^{2}+\cdots +x_{n}^{2}}{n} \ge  \bar{x}^{2}}\)，即方差 \({s^{2} = \dfrac{x_{1}^{2}+\cdots +x_{n}^{2}}{n}-\bar{x}^{2} \ge  0}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R71" 层级="10"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="154" width="425" x="9366" y="4081" as="geometry" />
          </mxCell></UserObject><UserObject id="prod" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R48&lt;/span&gt;&lt;br&gt;和平方与积的关系&lt;br&gt;\({(u+v)^{2} \ge  4uv}\)（u,v 为任意实数）" 类型="中间结果" 适用范围="任意实数" 编号="R48" 层级="5"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="64" width="240" x="9078" y="2329" as="geometry" />
          </mxCell></UserObject><UserObject id="prodlim" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R56&lt;/span&gt;&lt;br&gt;积的上界&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({uv \le  \dfrac{(u+v)^{2}}{4}}\)&lt;/span&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R56" 层级="6"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="80" width="170" x="9113" y="2659" as="geometry" />
          </mxCell></UserObject><UserObject id="fixsum" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R61&lt;/span&gt;&lt;br&gt;★ 和定积最大（u,v 为任意实数）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({u+v=S \Rightarrow  uv \le  \dfrac{S^{2}}{4}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({u=v=\dfrac{S}{2}}\)&lt;/span&gt; 时取等&lt;br&gt;&lt;span style=&quot;color:#E65100;font-size:11px;&quot;&gt;注意：本结论不要求为正，只需和为定值、等号能取到&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R61" 层级="7"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="131" width="318.0" x="9039" y="2990" as="geometry" />
          </mxCell></UserObject><UserObject id="fixprod" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({u,v\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P30&lt;/span&gt;&lt;br&gt;★ 积定和最小（\({u,v\gt 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({uv=P \Rightarrow  u+v \ge  2\sqrt{P}}\)&lt;br&gt;\({u=v=\sqrt{P}}\) 时取等&lt;br&gt;&lt;span style=&quot;color:#E65100;font-weight:bold;font-size:11px;&quot;&gt;⚠️ 一正：\({u,v\gt 0}\)；二定：积 P 固定；三相等：\({u=v=\sqrt{P}}\) 要能取到（有其他约束时单独检查）&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="u,v&gt;0" 编号="P30" 层级="9"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="114" width="317" x="10392" y="3772" as="geometry" />
          </mxCell></UserObject><UserObject id="recip_sum" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P31&lt;/span&gt;&lt;br&gt;&lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;基本不等式的特例（对勾函数最小值）&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x+\dfrac{1}{x} \ge  2}\)&lt;/span&gt;（\({x\gt 0}\)）&lt;br&gt;等号 \({\iff  x=1}\)&lt;br&gt;\({x \lt  0}\) 时：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x + \dfrac{1}{x} \le  -2}\)&lt;/span&gt;（对 \({-x \gt  0}\) 用上式）&lt;br&gt;合起来：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({|x + \dfrac{1}{x}| \ge  2}\)&lt;/span&gt;（\({x \ne  0}\)）&lt;/div&gt;" 类型="中间结果" 适用范围="x&gt;0" 编号="P31" 层级="9"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="218" width="190" x="10741" y="3720" as="geometry" />
          </mxCell></UserObject><UserObject id="ratio" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P32&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b}+\dfrac{b}{a} \ge  2}\)&lt;/span&gt;（\({a,b\gt 0}\)）&lt;br&gt;等号 \({\iff  a=b}\)&lt;/div&gt;" 类型="中间结果" 适用范围="a,b&gt;0" 编号="P32" 层级="9"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="80" width="209" x="11362" y="3789" as="geometry" />
          </mxCell></UserObject><UserObject id="gmgehm" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P37&lt;/span&gt;&lt;br&gt;★ 几何平均 ≥ 调和平均&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sqrt{ab} \ge  \dfrac{2ab}{a+b}}\)&lt;/span&gt;&lt;br&gt;\({a,b\gt 0}\)；等号 \({\iff  a=b}\)&lt;/div&gt;" 类型="结论" 适用范围="a,b&gt;0" 编号="P37" 层级="10"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="114" width="396" x="10994" y="4101" as="geometry" />
          </mxCell></UserObject><UserObject id="meanchain" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P42&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★★★ 四种平均数不等式链（\({a,b\gt 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({H \le  G \le  A \le  Q}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{2ab}{a+b} \le  \sqrt{ab} \le  \dfrac{a+b}{2} \le  \sqrt{\dfrac{a^{2}+b^{2}}{2}}}\)&lt;/span&gt;&lt;br&gt;等号均 \({\iff  a=b}\)&lt;/div&gt;" 类型="结论" 适用范围="a,b&gt;0" 编号="P42" 层级="11" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="136" width="811" x="9653" y="4385" as="geometry" />
          </mxCell></UserObject><UserObject id="c0" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R39&lt;/span&gt;&lt;br&gt;\({(ad-bc)^{2} \ge  0}\)" 类型="中间结果" 适用范围="任意实数" 编号="R39" 层级="4"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="48" width="160" x="7461" y="1985" as="geometry" />
          </mxCell></UserObject><UserObject id="c1" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R49&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{2}d^{2}-2abcd+b^{2}c^{2} \ge  0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ② 完全平方公式：用②展开 \({(ad-bc)^{2}}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R49" 层级="5"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="75" width="220" x="7431" y="2204" as="geometry" />
          </mxCell></UserObject><UserObject id="c2" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R57&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{2}d^{2}+b^{2}c^{2}+(ac+bd)^{2}}\)&lt;br&gt;\({\ge  (ac+bd)^{2}+2abcd}\)&lt;br&gt;（两边加 \({(ac+bd)^{2}}\)）&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R57" 层级="6"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="80" width="391" x="7345" y="2492" as="geometry" />
          </mxCell></UserObject><UserObject id="c3" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R62&lt;/span&gt;&lt;br&gt;\({a^{2}c^{2}+a^{2}d^{2}+b^{2}c^{2}+b^{2}d^{2} \ge  (ac+bd)^{2}}\)" 类型="中间结果" 适用范围="任意实数" 编号="R62" 层级="7"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="48" width="280" x="7401" y="2797" as="geometry" />
          </mxCell></UserObject><UserObject id="cauchy2" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R66&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★★ 柯西不等式（二项）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a^{2}+b^{2})(c^{2}+d^{2}) \ge  (ac+bd)^{2}}\)&lt;br&gt;等号 \({\iff  ad=bc}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：柯西不等式（n 项）的特例&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：① 平方差公式——柯西题整理时常需因式分解&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R66" 层级="8" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="125" width="446" x="7318" y="3043" as="geometry" />
          </mxCell></UserObject><UserObject id="cauchy_frac" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({u,v\gt 0}\)；\({r,s\in \mathbb{R}}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P33&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 柯西分式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{r^{2}}{u} + \dfrac{s^{2}}{v} \ge  \dfrac{(r+s)^{2}}{u+v}}\)&lt;/span&gt;&lt;br&gt;\({u,v\gt 0}\)；等号 \({\iff  rv=su}\)&lt;/div&gt;" 类型="结论" 适用范围="u,v&gt;0；r,s∈ℝ" 编号="P33" 层级="9" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="100" width="375" x="7353" y="3419" as="geometry" />
          </mxCell></UserObject><UserObject id="c3_0" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R40&lt;/span&gt;&lt;br&gt;\({(av-bu)^{2}+(aw-cu)^{2}+(bw-cv)^{2} \ge  0}\)" 类型="中间结果" 适用范围="任意实数" 编号="R40" 层级="4"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="48" width="280" x="7859" y="1985" as="geometry" />
          </mxCell></UserObject><UserObject id="c3_1" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R50&lt;/span&gt;&lt;br&gt;展开三个平方后求和：&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{2}v^{2}+b^{2}u^{2}+a^{2}w^{2}+c^{2}u^{2}+b^{2}w^{2}+c^{2}v^{2}}\)&lt;br&gt;\({-2(abuv+acuw+bcvw) \ge  0}\)&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R50" 层级="5"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="80" width="480" x="7759" y="2201" as="geometry" />
          </mxCell></UserObject><UserObject id="cauchy3" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R58&lt;/span&gt;&lt;br&gt;★ 柯西不等式（三项）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a^{2}+b^{2}+c^{2})(u^{2}+v^{2}+w^{2})}\)&lt;br&gt;\({\ge  (au+bv+cw)^{2}}\)&lt;br&gt;等号 \({\iff  (a,b,c)}\) 与 (u,v,w) 对应成比例：有常数 t 使 \({u=ta}\)、\({v=tb}\)、\({w=tc}\)，或 \({a=b=c=0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：柯西不等式（n 项）的特例&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R58" 层级="6"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="133" width="460" x="7769" y="2465" as="geometry" />
          </mxCell></UserObject><UserObject id="logineq" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P01&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;对数切线不等式（切点 \({x=1}\)）&lt;/span&gt;&lt;br&gt;\({\ln  x \le  x-1}\)（\({x\gt 0}\)）&lt;br&gt;等号 \({\iff  x=1}\)" 类型="结论" 适用范围="x&gt;0" 编号="P01" 层级="1" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;" vertex="1"><mxGeometry height="112" width="214" x="3925" y="5629" as="geometry" />
          </mxCell></UserObject><UserObject id="expineq" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R10&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;指数切线不等式（切点 \({x=0}\)）&lt;/span&gt;&lt;br&gt;\({e^{x} \ge  1+x}\)&lt;br&gt;等号 \({\iff  x=0}\)" 类型="结论" 适用范围="任意实数" 编号="R10" 层级="1" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;" vertex="1"><mxGeometry height="99" width="180" x="4708" y="5635" as="geometry" />
          </mxCell></UserObject><UserObject id="rearr_setup" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R11&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;设 \({a_{1}\le a_{2}}\)，\({b_{1}\le b_{2}}\)&lt;br&gt;\({(a_{2}-a_{1})(b_{2}-b_{1}) \ge  0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 同源：\({a^{2}+b^{2} \ge  2ab}\)——\({a^{2}+b^{2}\ge 2ab}\) 是排序不等式的特例：(a,b) 与 (a,b) 同序和 ≥ 逆序和&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R11" 层级="1" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="104" width="230" x="212" y="2008" as="geometry" />
          </mxCell></UserObject><UserObject id="rearr_expand" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R24&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_{2}b_{2}+a_{1}b_{1} \ge  a_{2}b_{1}+a_{1}b_{2}}\)&lt;br&gt;（展开后移项）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：分组因式分解——反向即 \({a_{2}b_{2}+a_{1}b_{1}-a_{2}b_{1}-a_{1}b_{2} = (a_{2}-a_{1})(b_{2}-b_{1})}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R24" 层级="2" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="101.0" width="240" x="207" y="2302" as="geometry" />
          </mxCell></UserObject><UserObject id="rearr" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R32&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★★ 排序不等式（两数）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_{1}\le a_{2}}\)，\({b_{1}\le b_{2} \Rightarrow  a_{1}b_{1}+a_{2}b_{2} \ge  a_{1}b_{2}+a_{2}b_{1}}\)&lt;br&gt;（同序和 ≥ 逆序和）&lt;br&gt;等号 \({\iff  a_{1}=a_{2}}\) 或 \({b_{1}=b_{2}}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：舒尔不等式&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R32" 层级="3" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="121" width="500.0" x="77" y="2585" as="geometry" />
          </mxCell></UserObject><UserObject id="rearr_n" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R41&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 排序不等式（n 个数）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_{1}\le a_{2}\le \cdots \le a_{n}}\)，\({b_{1}\le b_{2}\le \cdots \le b_{n}}\)&lt;br&gt;同序和 \({a_{1}b_{1}+\cdots +a_{n}b_{n} \ge}\) 任意打乱后的和 ≥ 逆序和 \({a_{1}b_{n}+\cdots +a_{n}b_{1}}\)&lt;br&gt;例：\({a_{1}b_{1}+a_{2}b_{2}+a_{3}b_{3} \ge  a_{1}b_{2}+a_{2}b_{3}+a_{3}b_{1} \ge  a_{1}b_{3}+a_{2}b_{2}+a_{3}b_{1}}\)&lt;br&gt;取最大值 ⇔ 打乱后仍是同序：\({a_{i}\lt a_{j}}\) 时，配给 \({a_{j}}\) 的 b 不小于配给 \({a_{i}}\) 的 b；最小值反过来&lt;br&gt;等号：打乱后的和与同序（或逆序）一样，如 a 值相等的位置互换、某组数全相等&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：㉕㉖ 等差数列——数列中用排序不等式时，常配合等差求和&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：㊳ 前 n 项平方和——处理 \({\sum k\cdot a_{k}}\) 时常用&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R41" 层级="4" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="181" width="575.0" x="40" y="2888" as="geometry" />
          </mxCell></UserObject><UserObject id="cheby" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R51&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 切比雪夫不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_{1}\le \cdots \le a_{n}, b_{1}\le \cdots \le b_{n}}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{\left(\sum a_{i}\right)\left(\sum b_{i}\right)}{n} \le  \sum a_{i}b_{i}}\)&lt;/span&gt;&lt;br&gt;等号 ⟺ 某组全相等&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R51" 层级="5" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="118" width="487" x="84" y="3258" as="geometry" />
          </mxCell></UserObject><UserObject id="ax_induction" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;S06&lt;/span&gt;&lt;br&gt;【公理】数学归纳法&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({P(n_{0})}\) 成立，且 \({k \ge  n_{0}}\) 时 \({P(k) \Rightarrow  P(k+1)}\)&lt;br&gt;⇒ 对所有 \({n \ge  n_{0}}\) 的正整数 n 成立（\({n_{0}}\) 不一定是 1，如证 \({n \ge  5}\) 时 \({2^{n} \gt  n^{2}}\)）&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8D6E63;&quot;&gt;起点：证明原理，由自然数的性质保证&lt;/span&gt;&lt;/div&gt;" 类型="起点" 适用范围="不适用" 编号="S06" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="100" width="629" x="9922" y="5326" as="geometry" />
          </mxCell></UserObject><UserObject id="bern_base" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R12&lt;/span&gt;&lt;br&gt;\({n=1}\)：\({(1+x)^{1} = 1+x \ge  1+x}\) ✓" 类型="中间结果" 适用范围="任意实数" 编号="R12" 层级="1"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1"><mxGeometry height="48" width="260" x="10197" y="5688" as="geometry" />
          </mxCell></UserObject><UserObject id="bern_step" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\ge -1}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P23&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;归纳步：\({(1+x)^{k+1}}\)&lt;br&gt;\({= (1+x)^{k}\cdot (1+x)}\)&lt;br&gt;\({\ge  (1+kx)(1+x) \leftarrow}\)归纳假设，且需 \({1+x\ge 0}\)（即 \({x\ge -1}\)）&lt;br&gt;\({= 1+(k+1)x+kx^{2}}\)&lt;br&gt;\({\ge  1+(k+1)x \leftarrow kx^{2}\ge 0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：两数和的立方（见《恒等式素材》）——\({n=3}\) 时可直接展开 \({(1+x)^{3}=1+3x+3x^{2}+x^{3}}\)，\({x\ge 0}\) 时 \({\ge 1+3x}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="x≥−1" 编号="P23" 层级="4"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="132.0" width="544" x="10163" y="6019" as="geometry" />
          </mxCell></UserObject><UserObject id="bernoulli" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x\ge -1}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P26&lt;/span&gt;&lt;br&gt;★ 伯努利不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(1+x)^{n} \ge  1+nx}\)&lt;br&gt;\({x\ge -1, n}\)为正整数&lt;br&gt;等号 \({\iff  x=0}\) 或 \({n=1}\)&lt;br&gt;二项式放缩（多留一项，\({x \ge  0}\)）：&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(1+x)^{n} \ge  1 + nx + \dfrac{n(n-1)x^{2}}{2}}\)&lt;/span&gt;，比伯努利更紧&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑧ 二项式定理：另一证法（只适用于 \({x\ge 0}\)）： \({(1+x)^{n} = 1+nx+C(n,2)x^{2}+\cdots +x^{n}}\) 后面各项 \({\ge 0}\)，去掉后 \({\ge  1+nx}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="x≥−1" 编号="P26" 层级="5"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="198" width="412" x="10229" y="6290" as="geometry" />
          </mxCell></UserObject><UserObject id="am_n" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a_{i}\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P38&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★★ n 元均值不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a_{1}+\cdots +a_{n}}{n} \ge  \sqrt[n]{a_{1}a_{2}\cdots a_{n}}}\)&lt;/span&gt;&lt;br&gt;\({a_{i}\ge 0}\)；等号 ⟺ 全相等&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：㉗㉘ 等比数列——倍增证明中个数依次为 2、4、…、\({2^{k}}\)（等比）&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="aᵢ≥0" 编号="P38" 层级="10" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="127" width="462.0" x="11502" y="4094" as="geometry" />
          </mxCell></UserObject><UserObject id="power_sum" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({b_{i}\gt 0}\)；\({a_{i}\in \mathbb{R}}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P39&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 权方和不等式（\({m=1}\) 的情形，即柯西分式的 n 项形式）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a_{1}^{2}}{b_{1}}+\cdots +\dfrac{a_{n}^{2}}{b_{n}} \ge  \dfrac{(a_{1}+\cdots +a_{n})^{2}}{b_{1}+\cdots +b_{n}}}\)&lt;/span&gt;&lt;br&gt;\({b_{i}\gt 0}\)；等号 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\iff  \dfrac{a_{1}}{b_{1}}=\cdots =\dfrac{a_{n}}{b_{n}}}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="bᵢ&gt;0；aᵢ∈ℝ" 编号="P39" 层级="10" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="122" width="637" x="6780" y="3677" as="geometry" />
          </mxCell></UserObject><UserObject id="hook_fn" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,x\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P40&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 对勾函数最值&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({f(x) = ax + \dfrac{b}{x}}\)&lt;/span&gt;（\({a,b\gt 0, x\gt 0}\)）&lt;br&gt;\({f(x) \ge  2\sqrt{ab}}\)&lt;br&gt;在 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=\sqrt{\dfrac{b}{a}}}\)&lt;/span&gt; 取等&lt;/div&gt;" 类型="结论" 适用范围="a,b,x&gt;0" 编号="P40" 层级="10" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="142" width="487" x="10292" y="4087" as="geometry" />
          </mxCell></UserObject><UserObject id="trig_bound" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R01&lt;/span&gt;&lt;br&gt;正余弦有界&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({-1 \le  \sin \theta  \le  1}\)，\({-1 \le  \cos \theta  \le  1}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑱ 勾股恒等式：\({\sin^{2} \theta =1-\cos^{2} \theta  \le  1 \Rightarrow  |\sin \theta|\le 1}\)，同理 \({|\cos \theta|\le 1}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R01" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="91" width="361" x="8179" y="5436" as="geometry" />
          </mxCell></UserObject><UserObject id="trig_am" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R02&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;三角有界（\({a^{2}+b^{2}\ge 2ab}\) 的应用）&lt;br&gt;\({\sin^{2} \theta +\cos^{2} \theta  \ge  2\sin \theta \cos \theta}\)&lt;br&gt;即 \({1 \ge  \sin 2\theta}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑱ 勾股恒等式：【代入消元】\({\sin^{2} \theta +\cos^{2} \theta =1}\) 代入 \({a^{2}+b^{2}\ge 2ab}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ㉑ 倍角公式：\({2\sin \theta \cos \theta  = \sin 2\theta}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R02" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="121" width="372" x="9190" y="5421" as="geometry" />
          </mxCell></UserObject><UserObject id="trig_cauchy" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R03&lt;/span&gt;&lt;br&gt;三角有界（柯西应用）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(\sin^{2} \theta +\cos^{2} \theta)(a^{2}+b^{2}) \ge  (a\sin \theta +b\cos \theta)^{2}}\)&lt;br&gt;即 \({a\sin \theta +b\cos \theta  \le  \sqrt{a^{2}+b^{2}}}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑱ 勾股恒等式：【代入消元】\({\sin^{2} \theta +\cos^{2} \theta =1}\) 代入柯西二项&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R03" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="107" width="514" x="8644" y="5428" as="geometry" />
          </mxCell></UserObject><UserObject id="trig_max" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R13&lt;/span&gt;&lt;br&gt;★ 三角函数有界&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;θ 取遍实数时：\({a\sin \theta +b\cos \theta}\) 的最大值 \({= \sqrt{a^{2}+b^{2}}}\)，最小值 \({= -\sqrt{a^{2}+b^{2}}}\)&lt;br&gt;a,b 不全为 0：最大值在 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin \theta =\dfrac{a}{\sqrt{a^{2}+b^{2}}}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos \theta =\dfrac{b}{\sqrt{a^{2}+b^{2}}}}\)&lt;/span&gt; 时取到；\({a=b=0}\) 时恒为 0&lt;br&gt;θ 只在某个区间内：最大值不一定取得到，要看端点和导数为 0 的点&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：㉛ 正弦定理——三角形中用正弦定理把边化为角，再求 \({a\sin \theta +b\cos \theta}\) 的最值（注意角的范围）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ㉒ 辅助角公式：用㉒化为 \({\sqrt{a^{2}+b^{2}}\cdot \sin (\theta +\varphi)}\)，\({|\sin|\le 1}\) 得最大值&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R13" 层级="1"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="162" width="540" x="8569" y="5731" as="geometry" />
          </mxCell></UserObject><UserObject id="three_sq_step" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R63&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;三组配对，各用 \({a^{2}+b^{2}\ge 2ab}\)：&lt;br&gt;\({a^{2}+b^{2}\ge 2ab}\)&lt;br&gt;\({b^{2}+c^{2}\ge 2bc}\)&lt;br&gt;\({a^{2}+c^{2}\ge 2ac}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：⑦ 三数和的平方——展开 \({(a+b+c)^{2}}\) 时 \({a^{2}+b^{2}+c^{2}}\) 与 \({ab+bc+ca}\) 同时出现&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R63" 层级="7"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="123" width="376" x="9699" y="2994" as="geometry" />
          </mxCell></UserObject><UserObject id="three_sq" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R67&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;三组重要不等式相加&lt;/span&gt;&lt;br&gt;\({a^{2}+b^{2}+c^{2} \ge  ab+bc+ca}\)&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;等号 \({\iff  a=b=c}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：⑪ 平方和与交叉积互换——用⑪ 可把结论改写为 \({(a+b+c)^{2} \ge  3(ab+bc+ca)}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R67" 层级="8" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="133" width="260" x="9757" y="3333" as="geometry" />
          </mxCell></UserObject><UserObject id="sum_sq_step" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R64&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;柯西三项取 \({u=v=w=1}\)：&lt;br&gt;\({(a^{2}+b^{2}+c^{2})(1+1+1) \ge  (a+b+c)^{2}}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑦ 三数和的平方：用⑦展开右边 \({(a+b+c)^{2}}\)&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="任意实数" 编号="R64" 层级="7"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="77" width="304" x="7847" y="2782" as="geometry" />
          </mxCell></UserObject><UserObject id="sum_sq" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R68&lt;/span&gt;&lt;br&gt;★ \({(a+b+c)^{2} \le  3(a^{2}+b^{2}+c^{2})}\)&lt;br&gt;等号 \({\iff  a=b=c}\)" 类型="结论" 适用范围="任意实数" 编号="R68" 层级="8"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;" vertex="1"><mxGeometry height="67" width="270" x="7864" y="3072" as="geometry" />
          </mxCell></UserObject><UserObject id="recip_sum_ineq" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({x,y\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P41&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;柯西分式的特例（\({r=s=1}\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x} + \dfrac{1}{y} \ge  \dfrac{4}{x+y}}\)&lt;/span&gt;&lt;br&gt;\({x,y\gt 0}\)；等号 \({\iff  x=y}\)" 类型="结论" 适用范围="x,y&gt;0" 编号="P41" 层级="10" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;" vertex="1"><mxGeometry height="115" width="265" x="7449" y="3681" as="geometry" />
          </mxCell></UserObject><UserObject id="wam" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a_{i}\ge 0}\)；\({w_{i}}\)为正整数 &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P43&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 加权 AM-GM（\({w_{i}}\) 为正整数，\({N=w_{1}+\cdots +w_{n}}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{w_{1}a_{1}+\cdots +w_{n}a_{n}}{N} \ge  (a_{1}^{w_{1}}\cdot \cdots \cdot a_{n}^{w_{n}})^{\frac{1}{N}}}\)&lt;/span&gt;&lt;br&gt;\({a_{i}\ge 0}\)；等号 \({\iff  a_{i}}\) 全相等&lt;br&gt;（权为正有理数可通分化为整数；一般正实数需取极限，超出高中；两个数时可用导数证，见通往赫尔德的推导）&lt;/div&gt;" 类型="结论" 适用范围="aᵢ≥0；wᵢ为正整数" 编号="P43" 层级="11" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="146" width="642" x="11921" y="4380" as="geometry" />
          </mxCell></UserObject><UserObject id="schur_setup" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,c\ge 0}\)；\({t\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P02&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;由对称性不妨设 \({a\ge b\ge c\ge 0}\)，\({t\gt 0}\)&lt;br&gt;\({a^{t}(a-b)(a-c)+b^{t}(b-a)(b-c)+c^{t}(c-a)(c-b)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：⑩ 立方和与积的互换——t = 1 时整理展开式可把 \({a^{3}+b^{3}}\) 写成 \({(a+b)^{3}-3ab(a+b)}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：排序不等式——同样先排定大小顺序，再判断各因子符号&lt;/span&gt;&lt;/div&gt;" 类型="中间结果" 适用范围="a,b,c≥0；t&gt;0" 编号="P02" 层级="1" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="120.0" width="501" x="826" y="2000" as="geometry" />
          </mxCell></UserObject><UserObject id="schur_group" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,c\ge 0}\)；\({t\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P09&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;前两项合并：\({(a-b)[a^{t}(a-c)-b^{t}(b-c)] \ge  0}\)&lt;br&gt;（\({a-b\ge 0}\)，\({a-c\ge b-c\ge 0}\)；\({a^{t}\ge b^{t}}\)：幂函数 \({x^{t}}\)（\({t\gt 0}\)）在 \({x\ge 0}\) 上递增）&lt;br&gt;第三项 \({c^{t}(c-a)(c-b) \ge  0}\)（两因子同号）&lt;/div&gt;" 类型="中间结果" 适用范围="a,b,c≥0；t&gt;0" 编号="P09" 层级="2" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontColor=#5D4037;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="100" width="610" x="772" y="2303" as="geometry" />
          </mxCell></UserObject><UserObject id="schur" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,c\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P18&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ 舒尔不等式（\({t=1}\) 常用形式，\({a,b,c\ge 0}\)）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a(a-b)(a-c)+b(b-a)(b-c)+c(c-a)(c-b) \ge  0}\)&lt;br&gt;即 \({a^{3}+b^{3}+c^{3}+3abc \ge  ab(a+b)+bc(b+c)+ca(c+a)}\)&lt;br&gt;等号 \({\iff  a=b=c}\)，或两数相等且第三个为 0&lt;/div&gt;" 类型="结论" 适用范围="a,b,c≥0" 编号="P18" 层级="3" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="120" width="935" x="609" y="2586" as="geometry" />
          </mxCell></UserObject><UserObject id="prod3" label="&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,c\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P34&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;三次基本不等式相乘&lt;/span&gt;&lt;br&gt;\({(a+b)(b+c)(c+a) \ge  8abc}\)&lt;br&gt;\({a,b,c \ge  0}\)；等号 \({\iff  a=b=c}\)，或至少两个数为 0" 类型="结论" 适用范围="a,b,c≥0" 编号="P34" 层级="9" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;" vertex="1"><mxGeometry height="98" width="332" x="11949" y="3780" as="geometry" />
          </mxCell></UserObject><UserObject id="nesbitt" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,c\gt 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P46&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#9E9E9E;font-weight:bold;&quot;&gt; 拓展 &lt;/span&gt;&lt;br&gt;★ Nesbitt 不等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{b+c}+\dfrac{b}{a+c}+\dfrac{c}{a+b} \ge  \dfrac{3}{2}}\)&lt;/span&gt;&lt;br&gt;\({a,b,c\gt 0}\)；等号 \({\iff  a=b=c}\)&lt;/div&gt;" 类型="结论" 适用范围="a,b,c&gt;0" 编号="P46" 层级="12" 拓展="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="100" width="461" x="12476" y="4750" as="geometry" />
          </mxCell></UserObject><UserObject id="am3" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#E65100;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt; \({a,b,c\ge 0}\) &lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;P44&lt;/span&gt;&lt;br&gt;★ 三元 \({\text{AM}\ge \text{GM}}\)（常用特例）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a+b+c}{3} \ge  \sqrt[3]{abc}}\)&lt;/span&gt;&lt;br&gt;\({a,b,c \ge  0}\)；等号 \({\iff  a=b=c}\)&lt;/div&gt;" 类型="结论" 适用范围="a,b,c≥0" 编号="P44" 层级="11"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="100" width="483" x="10935" y="4403" as="geometry" />
          </mxCell></UserObject><UserObject id="sinx_ineq" label="&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R14&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ &lt;span data-name=&quot;1&quot; style=&quot;color:inherit;&quot;&gt;常用三角不等式&lt;/span&gt;&lt;br&gt;\({|\sin x| \le  |x|}\)（\({x \in  \mathbb{R}}\)）&lt;br&gt;等号 \({\iff  x=0}\)" 类型="结论" 适用范围="任意实数" 编号="R14" 层级="1" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;" vertex="1"><mxGeometry height="99" width="230" x="4940" y="5635" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sq_diff" label="&lt;div style=&quot;text-align:center&quot;&gt;① 平方差公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{2}-b^{2} = (a+b)(a-b)}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 作差比大小：\({b^{2}-a^{2}}\) 拆成 \({(b+a)(b-a)}\)，两个因式分别定号 〔P03 · F1〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 根式裂项：\({\left(\sqrt{k}+\sqrt{k-1}\right)\left(\sqrt{k}-\sqrt{k-1}\right) = 1}\)，分子有理化 〔P25 · L6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：柯西不等式（二项）&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="119" width="350" x="-1780" y="1946" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sq_complete" label="&lt;div style=&quot;text-align:center&quot;&gt;② 完全平方公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a\pm b)^{2} = a^{2}\pm 2ab+b^{2}}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 证明的起点：展开 \({(a-b)^{2} \ge  0}\) 得 \({a^{2}+b^{2} \ge  2ab}\)；柯西推导中展开 \({(ad-bc)^{2} \ge  0}\) 〔R37 · J2〕〔R49 · G3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 反过来用就是配方：凑成 \({(\cdots)^{2} +}\) 常数，判正负、求二次函数最值 〔R17 · E3〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="106" width="350" x="-1780" y="2081" as="geometry" />
          </mxCell></UserObject><UserObject id="f_cube_sum" label="&lt;div style=&quot;text-align:center&quot;&gt;③ 立方和公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{3}+b^{3} = (a+b)(a^{2}-ab+b^{2})}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 作差后分解定号：\({a^{3}+b^{3}-ab(a+b) = (a+b)(a-b)^{2}}\) 〔P27 · J3〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="78" width="350" x="-1780" y="2203" as="geometry" />
          </mxCell></UserObject><UserObject id="f_cube_diff" label="&lt;div style=&quot;text-align:center&quot;&gt;④ 立方差公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{3}-b^{3} = (a-b)(a^{2}+ab+b^{2})}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 高次不等式先分解：\({x^{3}-1 = (x-1)(x^{2}+x+1)}\)，后一个因式恒正，可约去 〔R25 · C3〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="78" width="350" x="-1780" y="2297" as="geometry" />
          </mxCell></UserObject><UserObject id="f_three_sq" label="&lt;div style=&quot;text-align:center&quot;&gt;⑦ 三数和的平方&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+b+c)^{2} = a^{2}+b^{2}+c^{2}+2ab+2ac+2bc}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：\({a^{2}+b^{2}+c^{2} \ge  ab+bc+ca}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇒ 用于：R64〔G3〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="77" width="350" x="-1780" y="2391" as="geometry" />
          </mxCell></UserObject><UserObject id="f_binomial" label="&lt;div style=&quot;text-align:center&quot;&gt;⑧ 二项式定理（n 为非负整数）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({(a+b)^{n} = \sum _{k=0}^{n} C(n,k)a^{n-k}b^{k}}\)&lt;br&gt;⇒ 用于：P26〔K6〕&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="67" width="350" x="-1780" y="2484" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sym_sq" label="⑨ \({a^{2}+b^{2} = (a+b)^{2}-2ab}\)&lt;br&gt;（平方和与积的互换）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 已知 \({a+b}\)、ab，求 \({a^{2}+b^{2}}\)：和积代换 s、p 〔R52 · J3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 比较平方和与和的平方：\({2(a^{2}+b^{2}) \ge  (a+b)^{2}}\) 〔R60 · J3〕&lt;/span&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;" vertex="1"><mxGeometry height="78" width="350" x="-1780" y="2567" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sym_cube" label="⑩ \({a^{3}+b^{3} = (a+b)^{3}-3ab(a+b)}\)&lt;br&gt;（立方和与积的互换）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：舒尔不等式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇒ 用于：P27〔J3〕&lt;/span&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;" vertex="1"><mxGeometry height="77" width="350" x="-1780" y="2661" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sym_3var" label="⑪ \({a^{2}+b^{2}+c^{2} = (a+b+c)^{2}-2(ab+bc+ca)}\)&lt;br&gt;（三元平方和与交叉积的互换）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：\({a^{2}+b^{2}+c^{2} \ge  ab+bc+ca}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇒ 用于：R70〔J4〕&lt;/span&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;" vertex="1"><mxGeometry height="77" width="350" x="-1780" y="2754" as="geometry" />
          </mxCell></UserObject><UserObject id="f_vieta" label="⑫ 韦达定理（根与系数的关系；\({ax^{2}+bx+c=0}\)，\({a\ne 0}\)）&lt;br&gt;实根 \({x_{1},x_{2}}\) 按重数计：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_{1}+x_{2}=-\dfrac{b}{a}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x_{1}x_{2}=\dfrac{c}{a}}\)&lt;/span&gt;&lt;br&gt;在实数范围须 \({\Delta \ge 0}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：二次函数最小值——已知两根时，顶点 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=-\dfrac{b}{2a}=\dfrac{x_{1}+x_{2}}{2}}\)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 已知解集反求系数：解集端点就是两根，用两根之和、之积列方程 〔R34 · E3〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 对称式 \({a+b}\)、ab：把 a、b 看成 \({t^{2}-st+p=0}\) 的两根，实根要求 \({s^{2} \ge  4p}\) 〔R52 · J3〕&lt;/span&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;" vertex="1"><mxGeometry height="184" width="350" x="-1780" y="2847" as="geometry" />
          </mxCell></UserObject><UserObject id="f_log_rules" label="⑮⑯ 对数运算律（底数 \({q\gt 0}\) 且 \({q\ne 1}\)）&lt;br&gt;\({M,N\gt 0}\)：\({\log_{q} (MN)=\log_{q}  M+\log_{q}  N}\)&lt;br&gt;\({M\gt 0}\)，\({t\in \mathbb{R}}\)：\({\log_{q} (M^{t})=t \log_{q}  M}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 对数放缩求和：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln \left(1+\dfrac{1}{k}\right) = \ln (k+1) - \ln  k}\)&lt;/span&gt;，逐项相消 〔P21 · D6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 对数平均：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  a - \ln  b = \ln \left(\dfrac{a}{b}\right)}\)&lt;/span&gt;，令 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({t = \dfrac{a}{b}}\)&lt;/span&gt; 化成单变量 〔P07 · F6〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 指数、对数不等式：先化成同底，再用单调性 〔P04 · M3〕&lt;/span&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;" vertex="1"><mxGeometry height="203" width="350" x="-1780" y="3047" as="geometry" />
          </mxCell></UserObject><UserObject id="f_pyth" label="&lt;div style=&quot;text-align:center&quot;&gt;⑱ 勾股恒等式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin^{2} \theta +\cos^{2} \theta  = 1}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 正余弦有界：\({\sin^{2} \theta  = 1 - \cos^{2} \theta  \le  1}\) 〔R01 · H5〕&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 三角有界：配合柯西或 \({a^{2}+b^{2} \ge  2ab}\)，用 \({\sin^{2} \theta +\cos^{2} \theta  = 1}\) 化成常数 〔R03 · H5〕〔R02 · J5〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="92" width="350" x="-1780" y="3266" as="geometry" />
          </mxCell></UserObject><UserObject id="f_double" label="&lt;div style=&quot;text-align:center&quot;&gt;㉑ 倍角公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({\sin 2\alpha =2\sin \alpha \cos \alpha}\)&lt;br&gt;\({\cos 2\alpha =\cos^{2} \alpha -\sin^{2} \alpha =2\cos^{2} \alpha -1}\)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇒ 用于：R02〔J5〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="80" width="350" x="-1390" y="1946" as="geometry" />
          </mxCell></UserObject><UserObject id="f_aux" label="&lt;div style=&quot;text-align:center&quot;&gt;㉒ 辅助角公式&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;a,b 不全为 0：\({a\sin \theta +b\cos \theta  = \sqrt{a^{2}+b^{2}}\cdot \sin (\theta +\varphi)}\)&lt;br&gt;其中 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\cos \varphi  = \dfrac{a}{\sqrt{a^{2}+b^{2}}}}\)&lt;/span&gt;，&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sin \varphi  = \dfrac{b}{\sqrt{a^{2}+b^{2}}}}\)&lt;/span&gt;；\({a=b=0}\) 时原式恒为 0&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;▸ 用在 求 \({a \sin \theta  + b \cos \theta}\) 的最值或范围：化成 \({\sqrt{a^{2}+b^{2}}\cdot \sin (\theta +\varphi)}\)，再用 \({|\sin| \le  1}\) 〔R13 · H6〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="129" width="350" x="-1390" y="2042" as="geometry" />
          </mxCell></UserObject><UserObject id="f_arith" label="&lt;div style=&quot;text-align:center&quot;&gt;㉕㉖ 等差数列&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a_{n}=a_{1}+(n-1)d}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_{n}=\dfrac{n(a_{1}+a_{n})}{2}=na_{1}+\dfrac{n(n-1)d}{2}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：排序不等式（n 个数）&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="96" width="350" x="-1390" y="2187" as="geometry" />
          </mxCell></UserObject><UserObject id="f_geom" label="㉗㉘ 等比数列（\({n\ge 1}\)；\({q\ne 0}\)）&lt;br&gt;\({a_{n}=a_{1}q^{n-1}}\)；\({q\ne 1}\)：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({S_{n}=\dfrac{a_{1}(1-q^{n})}{1-q}}\)&lt;/span&gt;&lt;br&gt;\({q=1}\)：\({S_{n}=na_{1}}\)&lt;br&gt;⇒ 用于：P13〔K6〕&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：n 元均值不等式（倍增证明）&lt;/span&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;" vertex="1"><mxGeometry height="112" width="350" x="-1390" y="2299" as="geometry" />
          </mxCell></UserObject><UserObject id="mean_sub" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R52&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 和与积的关系&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;令 \({a+b=s}\)，\({ab=p}\)&lt;br&gt;则 \({a^{2}+b^{2} = s^{2}-2p}\)&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({(a-b)^{2} = s^{2}-4p \ge  0 \Rightarrow  p \le  \dfrac{s^{2}}{4}}\)&lt;/span&gt;&lt;br&gt;把不等式转化为关于 s,p 的问题&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑫ 韦达定理：a、b 是 \({t^{2}-st+p=0}\) 的两根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇐ 工具 ⑨ \({a^{2}+b^{2} = (a+b)^{2}-2ab}\)：\({a^{2}+b^{2}=(a+b)^{2}-2ab}\)，即 \({s^{2}-2p}\)&lt;/span&gt;&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R52" 层级="5" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="162" width="685" x="9913" y="2280" as="geometry" />
          </mxCell></UserObject><UserObject id="delta_range" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px;color:#78909C;font-weight:normal;&quot;&gt;R33&lt;/span&gt; &lt;span style=&quot;font-size:10px;color:#FFFFFF;background-color:#1565C0;font-weight:bold;&quot;&gt; 高考常用 &lt;/span&gt;&lt;br&gt;★ 有实数解 ⟺ Δ ≥ 0（判别式求范围）&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;设 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({y=\dfrac{f(x)}{g(x)}}\)&lt;/span&gt;，若整理为关于 x 的二次方程 \({h(x)=0}\)&lt;br&gt;x 有实数解 \({\iff  \Delta  \ge  0}\)（二次项系数 \({\ne  0}\)），由此得到 y 的取值范围&lt;br&gt;注意：① 二次项系数含 y 时，系数为 0 要单独讨论&lt;br&gt;② 求出的 y 要能对应定义域内的 x（\({g(x)\ne 0}\)）&lt;br&gt;③ x 被限制在某个区间内（如换元后 \({t \gt  0}\)）时，\({\Delta  \ge  0}\) 不够，改用根的分布〔R44 · E3〕&lt;/div&gt;" 类型="结论" 适用范围="任意实数" 编号="R33" 层级="3" 高考常用="是"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="163" width="636" x="4569" y="2732.5" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sine_law" label="&lt;div style=&quot;text-align:center&quot;&gt;㉛ 正弦定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a}{\sin A} = \dfrac{b}{\sin B} = \dfrac{c}{\sin C} = 2R}\)&lt;/span&gt;&lt;br&gt;（同一个三角形的对应边和角；R 为外接圆半径）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：三角函数有界&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="96" width="350" x="-1390" y="2427" as="geometry" />
          </mxCell></UserObject><UserObject id="f_cosine_law" label="&lt;div style=&quot;text-align:center&quot;&gt;㉜ 余弦定理&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;\({a^{2} = b^{2}+c^{2}-2bc\cdot \cos A}\)&lt;br&gt;（推广勾股定理；a、b、c 与 A 是同一个三角形的边和角）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：\({a^{2}+b^{2} \ge  2ab}\)&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="80" width="350" x="-1390" y="2539" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sec" label="&lt;div style=&quot;text-align:center&quot;&gt;㉞ 正切与余弦&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({1+\tan^{2} \theta  = \dfrac{1}{\cos^{2} \theta }}\)&lt;/span&gt;（\({\cos \theta \ne 0}\)）&lt;br&gt;（由 \({\sin^{2} +\cos^{2} =1}\) 两边\({\div \cos^{2} \theta}\)）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1565C0;font-weight:normal;&quot;&gt;⇒ 用于：P16〔E6〕&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="96" width="350" x="-1390" y="2635" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sum_sq" label="&lt;div style=&quot;text-align:center&quot;&gt;㊳ 前 n 项平方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sum _{k=1}^{n}k^{2} = \dfrac{n(n+1)(2n+1)}{6}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#607D8B;font-weight:normal;&quot;&gt;⋯ 配合：排序不等式（n 个数）&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="80" width="350" x="-1390" y="2747" as="geometry" />
          </mxCell></UserObject><UserObject id="f_sum_cube" label="&lt;div style=&quot;text-align:center&quot;&gt;㊴ 前 n 项立方和&lt;/div&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\sum _{k=1}^{n}k^{3} = \left[\dfrac{n(n+1)}{2}\right]^{2}}\)&lt;/span&gt;&lt;/div&gt;" 类型="恒等式" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;spacingLeft=8;spacingRight=8;" vertex="1"><mxGeometry height="80" width="350" x="-1390" y="2843" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_sq" label="&lt;b&gt;看到 \({a^{2}+b^{2}/}\) 平方和结构&lt;/b&gt;&lt;br&gt;反推：\({a^{2}+b^{2}\ge 2ab \leftarrow  (a-b)^{2}\ge 0 \leftarrow}\) 平方非负&lt;br&gt;三个数时：\({a^{2}+b^{2}+c^{2} \ge  ab+bc+ca}\)（三组配对相加）&lt;br&gt;用法：平方和求下界，或积 ab 求上界&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({a^{2}+b^{2} \ge  2ab}\) &lt;b&gt;〔R55 · J3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三个数时 \({\to  a^{2}+b^{2}+c^{2} \ge  ab+bc+ca}\) &lt;b&gt;〔R67 · J4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 平方和开方与 \({a+b}\) 比较 → 平方平均 ≥ 算术平均 &lt;b&gt;〔R71 · J4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 几种平均数一起比较 → 四种平均数不等式链 &lt;b&gt;〔P42 · J5〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="156" width="520" x="-840" y="2421" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_fxsum" label="&lt;b&gt;看到 和固定，求积最大&lt;/b&gt;&lt;br&gt;反推：和定积最大 \({\leftarrow  (u+v)^{2}\ge 4uv \leftarrow  (u-v)^{2}\ge 0 \leftarrow}\) 平方非负&lt;br&gt;先查：\({u+v}\) 是否为定值；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({u=v=\dfrac{S}{2}}\)&lt;/span&gt; 能否取到（不要求 u,v 为正）&lt;br&gt;实际应用（周长固定求面积最大等）：设变量、列目标函数，看和是否为定值&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 和定积最大（u,v 为任意实数） &lt;b&gt;〔R61 · H3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="125" width="520" x="-840" y="1175" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_fxprd" label="&lt;b&gt;看到 积固定，求和最小&lt;/b&gt;&lt;br&gt;反推：积定和最小 \({\leftarrow  \text{AM}\ge \text{GM} \leftarrow  \left(\sqrt{u}-\sqrt{v}\right)^{2}\ge 0}\)&lt;br&gt;先查：\({u,v\gt 0}\)；\({u=v=\sqrt{P}}\) 能否取到&lt;br&gt;实际应用（用料最省、费用最少等）：设变量、列目标函数 → 看和或积是否为定值 → 用基本不等式，并检查取等时的变量值在实际范围内&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 积定和最小（\({u,v\gt 0}\)） &lt;b&gt;〔P30 · K4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="132" width="520" x="-840" y="1324" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_hook" label="&lt;b&gt;看到 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({ax+\dfrac{b}{x}}\)&lt;/span&gt; 或 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x+\dfrac{k}{x}}\)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;反推：对勾函数 ← 积定和最小（&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({ax\cdot \dfrac{b}{x}=ab}\)&lt;/span&gt; 是定值）\({\leftarrow  \text{AM}\ge \text{GM}}\)&lt;br&gt;先查：\({a,b,x\gt 0}\)；&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=\sqrt{\dfrac{b}{a}}}\)&lt;/span&gt; 不在定义域内时改用单调性&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对勾函数最值 &lt;b&gt;〔P40 · K4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="148" width="520" x="-840" y="1480" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_frac" label="&lt;b&gt;看到 分式和求最值，如 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{r^{2}}{u} + \dfrac{s^{2}}{v}}\)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;反推：分子是平方、分母和为定值 → 柯西分式（权方和）← 柯西二项 \({\leftarrow  (ad-bc)^{2}\ge 0}\)&lt;br&gt;先查：分母为正；取等 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{r}{u} = \dfrac{s}{v}}\)&lt;/span&gt;&lt;br&gt;不符合时：齐次化成单变量，再用判别式或导数&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 柯西分式 &lt;b&gt;〔P33 · G4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="139" width="520" x="-840" y="3465" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_abs" label="&lt;b&gt;看到 \({|a+b|}\) 或绝对值比大小&lt;/b&gt;&lt;br&gt;反推：三角不等式 \({\leftarrow  -|x|\le x\le |x|}\) 两式相加 ← 绝对值定义&lt;br&gt;差的形式 \({|a|-|b|}\) 用反三角不等式&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角不等式 &lt;b&gt;〔R36 · C6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 差的形式 → 反三角不等式 &lt;b&gt;〔R59 · C7〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({|x-a| + |x-b|}\) 求最小值、恒成立求参 → 绝对值和的最小值 &lt;b&gt;〔R53 · C7〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="124" width="520" x="-840" y="4061" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_trig" label="&lt;b&gt;看到 \({a\sin \theta +b\cos \theta}\) 求最值&lt;/b&gt;&lt;br&gt;反推：三角有界 ← 柯西二项代入 \({\sin^{2} \theta +\cos^{2} \theta =1}\)（或辅助角公式）&lt;br&gt;结论：θ 取遍实数时，最大值 \({\sqrt{a^{2}+b^{2}}}\)，最小值 \({-\sqrt{a^{2}+b^{2}}}\)；\({a=b=0}\) 时恒为 0&lt;br&gt;先查：θ 的范围；只在某个区间内时，看端点和导数为 0 的点，最值不一定取得到&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三角函数有界 &lt;b&gt;〔R13 · H6〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="107" width="520" x="-840" y="4386" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_circ" label="&lt;b&gt;看到 约束 \({x^{2}+y^{2}=r^{2}}\)（\({r\ge 0}\)），求 \({ax+by}\) 的最值&lt;/b&gt;&lt;br&gt;反推：三角换元 \({x=r\cos \theta , y=r\sin \theta  \to}\) 化为 \({r(a\cos \theta +b\sin \theta) \to}\) 三角有界&lt;br&gt;结论：最大值 \({r\cdot \sqrt{a^{2}+b^{2}}}\)（别漏乘 r）；也可直接用柯西：\({(x^{2}+y^{2})(a^{2}+b^{2}) \ge  (ax+by)^{2}}\)&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【三角换元】令 \({x=r\cos \theta}\)，\({y=r\sin \theta}\)，目标化为 \({a\sin \theta +b\cos \theta}\) 型 → 三角函数有界 &lt;b&gt;〔R13 · H6〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="107" width="520" x="-840" y="4517" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_para" label="&lt;b&gt;看到 含参不等式：恒成立 / 能成立&lt;/b&gt;&lt;br&gt;恒成立：\({a \ge  g(x)}\) 对所有 x 成立 \({\Leftrightarrow  a \ge  g(x)}\) 的最大值；能成立：存在 x 使 \({a \ge  g(x) \Leftrightarrow  a \ge  g(x)}\) 的最小值（最值要能取到）&lt;br&gt;最大（小）值取不到时，看端点或极限，等号要单独判断：例 \({g(x)=x}\)，\({x\in (0,1)}\)，恒成立 \({\Leftrightarrow  a\ge 1}\)，能成立 \({\Leftrightarrow  a\gt 0}\)&lt;br&gt;参数分离：除以含 x 的式子时，要按它的正、负、零分类（不等号可能变向）&lt;br&gt;不能分离：\({x\in R}\) 上的二次式，二次项系数\({\gt 0}\) 时 恒 \({\ge 0 \Leftrightarrow  \Delta \le 0}\)（系数含参数时先讨论它是否为 0）；区间上改用最值或根的分布&lt;br&gt;双变量（各最值都取得到时）：\({\forall x_{1}\exists x_{2} f(x_{1})\ge g(x_{2}) \Leftrightarrow  f}\) 最小值 \({\ge  g}\) 最小值；\({\forall \forall  \Leftrightarrow  f}\) 最小值 \({\ge  g}\) 最大值；\({\exists \exists  \Leftrightarrow  f}\) 最大值 \({\ge  g}\) 最小值；\({\exists x_{1}\forall x_{2} \Leftrightarrow  f}\) 最大值 \({\ge  g}\) 最大值&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【分离参数】按除数正负分类后，化为求 g(x) 的最值 → 【定理】导数判单调 &lt;b&gt;〔S04 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 或 判别式法 → 有实数解 ⟺ Δ ≥ 0（判别式求范围） &lt;b&gt;〔R33 · E3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({x\in R}\) 上的二次式：\({\Delta \le 0 \to}\) 恒非负条件 &lt;b&gt;〔R30 · F3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="226" width="520" x="-840" y="4859" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_sym" label="&lt;b&gt;看到 对称式 \({a+b}\)、ab&lt;/b&gt;&lt;br&gt;反推：设 \({s=a+b, p=ab \to}\) 和积代换 ← 韦达定理、\({a^{2}+b^{2}=s^{2}-2p}\)&lt;br&gt;隐含约束：a,b 为实数 \({\Rightarrow  s^{2}\ge 4p}\)（来自 \({(a-b)^{2}\ge 0}\)）&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 和积代换 → 和与积的关系 &lt;b&gt;〔R52 · J3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="92" width="520" x="-840" y="2601" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_prod" label="&lt;b&gt;看到 多项乘积，如 \({(a+b)(b+c)(c+a)}\)&lt;/b&gt;&lt;br&gt;反推：每个因子用 \({\text{AM}\ge \text{GM}}\) 放成 \({2\sqrt{\cdot}}\) 再相乘 \({\leftarrow  \text{AM}\ge \text{GM}}\)&lt;br&gt;先查：相乘的各式两边非负（允许为零）；有零因子时单独判等；正因子时查各组等号，必要时尝试调整拆分&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【待定系数】设拆分系数，使各组等号能同时取到，再分组用 \({\text{AM}\ge \text{GM} \to}\) 基本不等式 \({(\text{AM}\ge \text{GM})}\) &lt;b&gt;〔P29 · K4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三个因子 \({(a+b)(b+c)(c+a) \to}\) 三次基本不等式相乘 &lt;b&gt;〔P34 · L4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三个正数的和与积 → 三元 \({\text{AM} \ge  \text{GM}}\) &lt;b&gt;〔P44 · K5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ n 个数时 → n 元均值 → n 元均值不等式 &lt;b&gt;〔P38 · L4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="171" width="520" x="-840" y="2226" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_cauch" label="&lt;b&gt;看到 \({\left(\sum a_{i}^{2}\right)\left(\sum b_{i}^{2}\right)}\) 或内积结构&lt;/b&gt;&lt;br&gt;反推：柯西不等式（二项/三项）\({\leftarrow  (ad-bc)^{2}\ge 0}\) 等平方和非负&lt;br&gt;取等：对应成比例（有 t 使 \({b_{i}=t\cdot a_{i}}\)，或 \({a_{i}}\) 全为 0）；不要写成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{a_{i}}{b_{i}}}\)&lt;/span&gt; 相等，分母可能为 0&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 柯西不等式（二项） &lt;b&gt;〔R66 · G3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 柯西不等式（三项） &lt;b&gt;〔R58 · G3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 柯西不等式（n 项） &lt;b&gt;〔R42 · G4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="142" width="520" x="-840" y="3299" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_order" label="&lt;b&gt;看到 两组有序数，求 \({\sum a_{i}b_{i}}\) 范围&lt;/b&gt;&lt;br&gt;反推：排序不等式 \({\leftarrow  (a_{2}-a_{1})(b_{2}-b_{1})\ge 0}\)（两组同序）&lt;br&gt;结论：同序和最大，逆序和最小&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 排序不等式（两数） &lt;b&gt;〔R32 · A3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 排序不等式（n 个数） &lt;b&gt;〔R41 · A3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="109" width="520" x="-840" y="3628" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_quad" label="&lt;b&gt;看到 二次函数 \({ax^{2}+bx+c}\) 求最值&lt;/b&gt;&lt;br&gt;反推：二次函数最值 ← 配方 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({a\left(x+\dfrac{b}{2a}\right)^{2}-\dfrac{\Delta }{4a} \leftarrow}\)&lt;/span&gt; 平方非负&lt;br&gt;先查 a：\({a\gt 0}\) 顶点处最小，\({a\lt 0}\) 顶点处最大；\({a=0}\) 时不是二次函数，按一次函数或常数处理&lt;br&gt;先查区间：顶点 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({x=-\dfrac{b}{2a}}\)&lt;/span&gt; 不在区间内就看端点；端点不含在内或区间无界（看 x→∞）时，最值可能取不到&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【配方】求顶点，【数形结合】看抛物线最低点 → 二次函数最小值 &lt;b&gt;〔R23 · E3〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="154" width="520" x="-840" y="3071" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_expln" label="&lt;b&gt;看到 \({e^{x}}\)、ln x、sinx 与多项式比大小 / 求范围&lt;/b&gt;&lt;br&gt;反推：\({\ln  x\le x-1}\)、\({e^{x}\ge 1+x \leftarrow}\) 构造函数求导找最小值 ← 导数判单调&lt;br&gt;常用变形：x 换成 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}}\)&lt;/span&gt; 得 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\ln  x \ge  1-\dfrac{1}{x}}\)&lt;/span&gt;；三角：\({|\sin x| \le  |x|}\)&lt;br&gt;含参如 \({e^{x} \ge  ax+1}\) 对一切实数 x 恒成立：\({x=0}\) 时两边相等，故 \({y=ax+1}\) 须是切线 \({\Rightarrow  a=1}\)（切线法，再验证）&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({\ln  x \le  x-1}\)（\({x\gt 0}\)）：【数形结合】\({y=\ln  x}\) 在 \({y=x-1}\) 下方，\({x=1}\) 处相切 &lt;b&gt;〔P01 · D6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 或 \({e^{x}\ge 1+x \to  e^{x} \ge  1+x}\) &lt;b&gt;〔R10 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ sinx 与 x 比较 \({\to  |\sin x| \le  |x|}\)（\({x \in  \mathbb{R}}\)） &lt;b&gt;〔R14 · E6〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="168" width="520" x="-840" y="5329" as="geometry" />
          </mxCell></UserObject><UserObject id="ent_recip" label="&lt;b&gt;看到 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}+\dfrac{1}{y}}\)&lt;/span&gt; 求最值（\({x,y\gt 0}\)）&lt;/b&gt;&lt;br&gt;已知 \({a,b\gt 0}\)，\({ax+by=1}\)：乘 1 法 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{1}{x}+\dfrac{1}{y}\right)(ax+by) = a+b + \dfrac{by}{x} + \dfrac{ax}{y} \ge  a+b+2\sqrt{ab}}\)&lt;/span&gt;&lt;br&gt;取等：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{by}{x} = \dfrac{ax}{y}}\)&lt;/span&gt;；例 \({x+2y=1}\) 时最小值 \({3+2\sqrt{2}}\)&lt;br&gt;下式对 \({x,y\gt 0}\) 恒成立；和固定时便于求最小值： &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}+\dfrac{1}{y} \ge  \dfrac{4}{x+y}}\)&lt;/span&gt;&lt;br&gt;反推：&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{x}+\dfrac{1}{y} \ge  \dfrac{4}{x+y} \leftarrow}\)&lt;/span&gt; 柯西分式取 \({r=s=1 \leftarrow}\) 柯西二项&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ \({x+y}\) 固定时可得常数下界 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\to  \dfrac{1}{x} + \dfrac{1}{y} \ge  \dfrac{4}{x+y}}\)&lt;/span&gt; &lt;b&gt;〔P41 · G4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【乘 1 法】展开后 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\left(\dfrac{by}{x}\right)\cdot \left(\dfrac{ax}{y}\right)=ab}\)&lt;/span&gt;，为定值 ⇒ 积定和最小 → 积定和最小（\({u,v\gt 0}\)） &lt;b&gt;〔P30 · K4〕&lt;/b&gt;&lt;/span&gt;" 类型="题型入口" 适用范围="不适用" 层级="0"><mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1"><mxGeometry height="288" width="520" x="-840" y="1914" as="geometry" />
          </mxCell></UserObject><UserObject id="e0" label="【作差】\({(a+c)-(b+c) = a-b \gt  0}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_order" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="add"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="8167.5" y="370" /><mxPoint x="7560" y="370" /></Array><mxPoint x="0" y="-18" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e1" label="【作差】\({(a+c)-(b+d) = (a-b)+(c-d) \ge  0}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_order" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="sumadd"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="8167.5" y="356" /><mxPoint x="7960" y="356" /></Array><mxPoint x="0" y="-18" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e2" label="【作差】\({c\gt 0}\)：\({(a-b)c \gt  0}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_pos" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="mulp"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="6600.5" y="370" /><mxPoint x="7006" y="370" /></Array><mxPoint x="-60" y="-18" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e3" label="【作差】\({c\lt 0}\)：\({(a-b)(-c) \gt  0 \Rightarrow  ac \lt  bc}\)" 类型="推导"><mxCell edge="1" parent="1" source="ax_pos" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="muln"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="6600.5" y="342" /><mxPoint x="6556" y="342" /></Array><mxPoint x="-40" y="-18" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e5" label="【代换】&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({c = \dfrac{1}{d}}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({\dfrac{1}{d}\gt 0}\)&lt;/span&gt;：否则 &lt;span style=&quot;display:inline-block;margin:3px 0;&quot;&gt;\({d\cdot \left(\dfrac{1}{d}\right) \le  0}\)&lt;/span&gt;，与 \({=1}\) 矛盾" 类型="推导"><mxCell edge="1" parent="1" source="mulp" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#455A64;strokeWidth=2.5;fontSize=11;fontColor=#263238;endArrow=block;endSize=7;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="divp"><mxGeometry relative="1" as="geometry" x="1" y="0">
              <Array as="points"><mxPoint x="7050" y="622" /><mxPoint x="6910" y="622" /></Array><mxPoint x="45" y="-48" as="offset" /></mxGeometry>
          </mxCell></UserObject><UserObject id="e6" label="【分类讨论】\({x\gt 0}\)：令 \({a=c=x, b=0 \Rightarrow  x^{2}\gt 0}\)" 类型="推导"><mxCell edge="1" parent="1" source="mulp" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontFamily=PingFang SC;labelBackgroundColor=#FFFFFF;strokeColor=#263238;strokeWidth=4;fontSize=12;fontColor=#263238;fontStyle=1;endArrow=block;endSize=8;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="sq"><mxGeometry relative="1" as="geometry" x="1" y="0">
