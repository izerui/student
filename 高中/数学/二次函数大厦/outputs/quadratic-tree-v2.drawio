<mxfile host="build.py"><diagram id="quadratic" name="二次函数大厦"><mxGraphModel dx="2000" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="1" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="bg" value="背景（锁定）" style="locked=1;" parent="0"/>
<mxCell id="1" value="推导" parent="0"/>
<mxCell id="c1" value="二次函数大厦" style="text;html=1;fontFamily=PingFang SC;fontSize=40;fontStyle=1;fontColor=#263238;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2060" y="40" width="1800" height="60" as="geometry"/></mxCell>
<mxCell id="c2" value="从函数定义和二次函数定义出发，推出图像、性质、三个二次、根的分布与综合应用&lt;br&gt;正推：沿箭头往下读（综合法）；反推：从左侧题型入口往回找（分析法）&lt;br&gt;与不等式大厦重合的结论标“同见不等式大厦〔编号〕”" style="text;html=1;fontFamily=PingFang SC;fontSize=15;fontColor=#455A64;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2060" y="110" width="1800" height="80" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b style=&quot;font-size:20px&quot;&gt;图例&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="bg"><mxGeometry x="-2060" y="220" width="1800" height="932" as="geometry"/></mxCell>
<mxCell id="c4" value="【定义】【约定】【公理】【定理】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#4A148C;shadow=1;arcSize=12;" vertex="1" parent="bg"><mxGeometry x="-2030" y="276" width="300" height="54" as="geometry"/></mxCell>
<mxCell id="c5" value="紫色：起点，直接承认或定义" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-1710" y="276" width="1420" height="54" as="geometry"/></mxCell>
<mxCell id="c6" value="★ 结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=PingFang SC;fontSize=13;fontColor=#1B5E20;fontStyle=1;shadow=1;arcSize=12;" vertex="1" parent="bg"><mxGeometry x="-2030" y="346" width="300" height="54" as="geometry"/></mxCell>
<mxCell id="c7" value="绿色：结论，对所有二次函数、所有 \(x\) 都成立" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-1710" y="346" width="1420" height="54" as="geometry"/></mxCell>
<mxCell id="c8" value="中间结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;arcSize=10;" vertex="1" parent="bg"><mxGeometry x="-2030" y="416" width="300" height="54" as="geometry"/></mxCell>
<mxCell id="c9" value="白底：推导中间一步，不加条件" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-1710" y="416" width="1420" height="54" as="geometry"/></mxCell>
<mxCell id="c10" value="★ 结论（有条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2.5;fontFamily=PingFang SC;fontSize=13;fontColor=#BF360C;fontStyle=1;shadow=1;arcSize=12;" vertex="1" parent="bg"><mxGeometry x="-2030" y="486" width="300" height="54" as="geometry"/></mxCell>
<mxCell id="c11" value="橙色：要加条件才成立（开口方向、\(\Delta\)、区间、参数），标题旁橙色标签写明条件" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-1710" y="486" width="1420" height="54" as="geometry"/></mxCell>
<mxCell id="c12" value="「韦达」ᴾ²¹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="bg"><mxGeometry x="-2030" y="556" width="300" height="54" as="geometry"/></mxCell>
<mxCell id="c13" value="蓝底「」：套用的工具，右上角是引用的节点或工具箱圈号；左侧“工具”一栏（工具、方法的区别见“三层”）" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-1710" y="556" width="1420" height="54" as="geometry"/></mxCell>
<mxCell id="c14" value="【作差】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="bg"><mxGeometry x="-2030" y="626" width="300" height="54" as="geometry"/></mxCell>
<mxCell id="c15" value="棕底【】：方法，往哪走，一条线只走一步；左侧“方法”一栏按类写方向、依据、信号、易错点" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-1710" y="626" width="1420" height="54" as="geometry"/></mxCell>
<mxCell id="c16" value="看到… / 反推…" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="bg"><mxGeometry x="-2030" y="696" width="300" height="54" as="geometry"/></mxCell>
<mxCell id="c17" value="青绿虚线框：题型入口，做题从这里进" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-1710" y="696" width="1420" height="54" as="geometry"/></mxCell>
<mxCell id="c18" value="灰底虚线框 = 分区：最上面是地基，沿箭头往下读；跨框的深色线是分区之间的推导，跨框的前提写在节点里“⇐ 前提”；紫色起点放在第一次用到它的分区" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2030" y="766" width="1740" height="56" as="geometry"/></mxCell>
<mxCell id="c19" value="连线：深色实线 = 推导，越粗越是主干；线上写【方法】和具体操作" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2030" y="828" width="1740" height="56" as="geometry"/></mxCell>
<mxCell id="c20" value="浅灰线 = 前提：引用别处已推出的结论，线上写【前提】" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2030" y="890" width="1740" height="56" as="geometry"/></mxCell>
<mxCell id="c21" value="▼ 加条件：从这一步起有使用条件，后面的结论都带着它" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2030" y="952" width="1740" height="56" as="geometry"/></mxCell>
<mxCell id="c22" value="〔编号 · 坐标〕：S 起点，R、P 是结论的编号（有没有条件看颜色和橙色标签，不看字母）；按图边字母（列）和数字（行）找格子" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2030" y="1014" width="1740" height="56" as="geometry"/></mxCell>
<mxCell id="c23" value="★ 越多越重要；灰色“拓展”可先跳过；“同见不等式大厦〔编号〕”= 两张图重合的结论" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontColor=#37474F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2030" y="1076" width="1740" height="56" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b style='font-size:18px'&gt;条件层级（越往下限制越多）&lt;/b&gt;&lt;br&gt;所有二次函数（\(a\ne 0\)）、所有实数 \(x\) —— 绿色、白色节点&lt;br&gt;  └ 开口方向：\(a&amp;gt;0\)（或 \(a&amp;lt;0\)）—— 单调性、最值、远近规律、三个二次&lt;br&gt;      └ 判别式：\(\Delta &amp;gt;0\)、\(\Delta =0\)、\(\Delta &amp;lt;0\)；交点式、韦达要求 \(\Delta \ge 0\)&lt;br&gt;      └ 区间：\(x\in [m,n]\) —— 闭区间最值、区间上恒成立&lt;br&gt;  └ 参数：系数含参数时先分 \(a=0\)（不是二次函数）与 \(a\ne 0\)&lt;br&gt;\(a&amp;lt;0\) 的结论把 \(a&amp;gt;0\) 的结论“上下翻过来”即可：最小变最大、递增变递减" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fontSize=14;" vertex="1" parent="bg"><mxGeometry x="-2060" y="1198" width="1800" height="200" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b style='font-size:20px'&gt;三层：工具、方法、题型入口&lt;/b&gt;&lt;br&gt;&lt;b&gt;工具&lt;/b&gt;（能用什么）：公理、定义、定理、公式，都能写成一个式子，凡能拿来直接用的　→ 图中：主图每个节点（本图推出的）；工具箱（借来的公式）；推导线上蓝底「…」，右上角是它引用的节点&lt;br&gt;&lt;b&gt;方法&lt;/b&gt;（往哪走）：运算中公认的变换方式和运算逻辑，本身不是公式、定理：把眼前的问题转化成什么样子　→ 图中：推导线上棕底【…】，一条线只走一步；左侧“方法”一栏&lt;br&gt;&lt;b&gt;题型入口&lt;/b&gt;（从哪进）：看到什么题，用哪个工具、走哪个方向　→ 图中：左侧“题型入口”一栏&lt;br&gt;先用方法找方向，再用熟悉的工具完成每一步：方法决定能不能想到，工具决定能不能算对。&lt;br&gt;题型入口按题型查（这道题用哪些工具、方法），“方法”一栏按方法查（这个方法用在哪些题），是同一张表的两种查法。&lt;br&gt;正推（由因导果）= 综合法：沿箭头往下读；反推（执果索因）= 分析法：题型入口里的“反推”。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#37474F;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=4;fontSize=14;" vertex="1" parent="bg"><mxGeometry x="-2060" y="1438" width="1800" height="204" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b style=&quot;font-size:20px&quot;&gt;工具（能用什么）：主图每个节点都是工具；下面是常用节点速查和工具箱（借来的公式原文，按圈号查，不画线）&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#0D47A1;align=left;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2060" y="1682" width="1800" height="40" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;常用节点速查：看到什么 → 想到哪个节点&lt;/b&gt;&lt;br&gt;▸ 看到要把二次式拆开 → 先试十字相乘〔R24 · F4〕；拆不出来 → 算 \(\Delta\)〔R34 · E5〕&lt;br&gt;▸ 看到有没有根、几个交点、恒成立、能取到哪些值 → 判别式〔R34 · E5〕&lt;br&gt;▸ 看到两根的和、积、平方和、差 → 不求根，用韦达〔P21 · E5〕；实数范围先查 \(\Delta \ge 0\)，复数范围 \(\Delta &amp;lt;0\) 也成立&lt;br&gt;▸ 看到单调、最值、比大小 → 先找对称轴〔R01 · C4〕〔R04 · D8〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="1732" width="885" height="125" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;① 平方差公式&lt;/b&gt;&lt;br&gt;\(a^{2} - b^{2} = (a+b)(a-b)\)&lt;br&gt;▸ 用在 推出作差恒等式：\(a[(x_{1}-h)^{2}-(x_{2}-h)^{2}]\) 拆成 \(a(x_{1}-x_{2})(x_{1}+x_{2}-2h)\) 〔R18 · C5〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="1732" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;② 完全平方公式&lt;/b&gt;&lt;br&gt;\((a\pm b)^{2} = a^{2} \pm  2ab + b^{2}\)&lt;br&gt;▸ 用在 配方：一般式化顶点式、方程配成 \((x+\frac{b}{2a})^{2}=\frac{\Delta}{4a^{2}}\) 〔R01 · C4〕〔R34 · E5〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="1839" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;③ 两点距离公式&lt;/b&gt;&lt;br&gt;\(|PQ| = \sqrt{(x_{1}-x_{2})^{2}+(y_{1}-y_{2})^{2}}\)&lt;br&gt;▸ 用在 弦长：两点在 \(y=kx+m\) 上，化成 \(\sqrt{1+k^{2}}\cdot |x_{1}-x_{2}|\) 〔R20 · I5〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="1877" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;④ 点到直线距离&lt;/b&gt;&lt;br&gt;点 \((x_{0},y_{0})\) 到 \(Ax+By+C=0\)：\(d = \frac{|Ax_{0}+By_{0}+C|}{\sqrt{A^{2}+B^{2}}}\)&lt;br&gt;▸ 用在 抛物线上的点到直线：绝对值里是二次式，配方求最小值 入口28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="1946" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c32" value="&lt;b&gt;⑤ 求导法则&lt;/b&gt;&lt;br&gt;\((x^{n})' = nx^{n-1}\)，常数的导数为 0，\((u\pm v)' = u'\pm v'\)；\(f'&amp;gt;0\) 的区间上递增，\(f'&amp;lt;0\) 的区间上递减&lt;br&gt;▸ 用在 二次、三次函数：\(f'(x)=2ax+b\)；三次函数的导数是二次函数 〔R22 · G8〕〔R17 · D15〕&lt;br&gt;▸ 用在 牛顿法：切线斜率 \(f'(x_{k})\) 〔R29 · E14〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="1984" width="885" height="106" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;⑥ 指数、对数函数的单调性&lt;/b&gt;&lt;br&gt;\(y=a^{x}\)、\(y=\log\)ₐ\(x\)：\(a&amp;gt;1\) 时递增，\(0&amp;lt;a&amp;lt;1\) 时递减&lt;br&gt;▸ 用在 二次型复合：外层单调，范围由里层二次式定 〔P14 · D15〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="2053" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c34" value="&lt;b&gt;⑦ 同角关系&lt;/b&gt;&lt;br&gt;\(\sin ^{2}x + \cos ^{2}x = 1\)&lt;br&gt;▸ 用在 三角式里的二次：\(\sin ^{2}x\) 换成 \(1-\cos ^{2}x\)；\(\sin α+\cos α=s \Rightarrow  \sin α\cdot \cos α=\frac{s^{2}-1}{2}\) 〔P14 · D15〕〔R13 · H3〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2110" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b&gt;⑧ 对数运算律&lt;/b&gt;&lt;br&gt;\(M,N&amp;gt;0\)：\(\lg  M + \lg  N = \lg (MN)\)&lt;br&gt;▸ 用在 对数方程：合并后化成二次方程，回原定义域检验 〔P19 · F6〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="2160" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c36" value="&lt;b&gt;⑨ 等差数列前 n 项和&lt;/b&gt;&lt;br&gt;\(S_{n} = na_{1} + n(n-1)\frac{d}{2}\)&lt;br&gt;▸ 用在 \(S_{n}\) 的最值：展开是 \(n\) 的二次函数 〔P17 · B9〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2217" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c37" value="&lt;b&gt;⑩ 方差&lt;/b&gt;&lt;br&gt;\(s^{2} = [(x_{1}-\)平均数\()^{2} + \ldots  + (x_{n}-\)平均数\()^{2}]/n\)；\(D(aX+b)=a^{2}D(X)\)；二项分布 \(D(X)=np(1-p)\)&lt;br&gt;▸ 用在 方差、最小二乘：偏差平方和是二次函数 〔R36 · F14〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="2267" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c38" value="&lt;b&gt;⑪ 余弦定理&lt;/b&gt;&lt;br&gt;\(a^{2} = b^{2} + c^{2} - 2bc\cdot \cos A\)&lt;br&gt;▸ 用在 解三角形：已知两边和一边的对角，化成第三边的二次方程 入口42" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2324" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;⑫ 向量的模&lt;/b&gt;&lt;br&gt;\(|p|^{2} = p\cdot p\)，\(|p-tq|^{2} = |p|^{2} - 2t(p\cdot q) + t^{2}|q|^{2}\)&lt;br&gt;▸ 用在 模长求最值：化成 \(t\) 的二次函数 入口41" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="2374" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b&gt;⑬ 排列数&lt;/b&gt;&lt;br&gt;\(A_{n}\)ᵐ \(= n(n-1)\ldots (n-m+1)\)&lt;br&gt;▸ 用在 排列数方程：展开成 \(n\) 的二次方程 入口49" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2431" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c41" value="&lt;b&gt;⑭ 平方保序（同见不等式大厦）&lt;/b&gt;&lt;br&gt;\(0 \le  u &amp;lt; v \Rightarrow  u^{2} &amp;lt; v^{2}\)&lt;br&gt;▸ 用在 远近规律：离轴远的 \(|x-h|\) 大，平方也大 〔P04 · B8〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="2481" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c42" value="&lt;b&gt;⑮ 符号规则（同见不等式大厦）&lt;/b&gt;&lt;br&gt;\(u&amp;lt;0\)、\(v&amp;lt;0 \Rightarrow  uv&amp;gt;0\)；\(u&amp;lt;0\)、\(v&amp;gt;0 \Rightarrow  uv&amp;lt;0\)&lt;br&gt;▸ 用在 穿根法：乘积的正负由负因式个数的奇偶定 〔R27 · J8〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0D47A1;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2538" width="885" height="87" as="geometry"/></mxCell>
<mxCell id="c43" value="&lt;b style=&quot;font-size:20px&quot;&gt;方法（往哪走）：每类方法往哪走、凭什么、何时用&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#4E342E;align=left;whiteSpace=wrap;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2695" width="1800" height="40" as="geometry"/></mxCell>
<mxCell id="c44" value="&lt;b style='font-size:15px'&gt;【比较】（作差）&lt;/b&gt;&lt;br&gt;方向：比大小、证单调 → 两式相减，化成乘积看各因子的符号&lt;br&gt;依据：大小就是差的符号〔S04 · G1〕；作差恒等式〔R18 · C5〕&lt;br&gt;信号：比较两个函数值；证单调；中点的函数值与两端平均&lt;br&gt;用在：\(f(x_{1}) - f(x_{2}) = a[(x_{1}-h)^{2} - (x_{2}-h)^{2}]\)〔R43 · C4〕、两点同高 \(\Rightarrow\) 对称轴〔R05 · E8〕、单调性〔P02 · C8〕、凸性：中点不等式〔P22 · G8〕&lt;br&gt;⚠ 差要化成乘积才好定号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2745" width="885" height="163" as="geometry"/></mxCell>
<mxCell id="c45" value="&lt;b style='font-size:15px'&gt;【配凑】（配方法、待定系数）&lt;/b&gt;&lt;br&gt;方向：凑成“平方 + 常数”或已知的形状；按已知形状设式子求系数&lt;br&gt;依据：平方非负〔S05 · H1〕；完全平方公式②&lt;br&gt;信号：求最值、证恒正、找顶点；两根的对称式；已知形状求系数（待定系数）&lt;br&gt;用在：\((x + \frac{b}{2a})^{2} = \frac{b^{2}-4ac}{4a^{2}} = \frac{\Delta}{4a^{2}}\)〔R41 · E4〕、\(a[(x + \frac{b}{2a})^{2} - \frac{b^{2}}{4a^{2}}] + c\)〔R45 · C3〕、待定系数法求解析式〔R02 · C3〕、统计与概率中的二次：方差、最小二乘〔R36 · F14〕、两根的对称式求值〔R25 · E6〕&lt;br&gt;⚠ 证恒正：写成平方 + 正常数，如 \(x^{2}+x+1=(x+\frac{1}{2})^{2}+\frac{3}{4}&amp;gt;0\)；提出 \(a\) 时看清 \(a\) 的正负" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="2745" width="885" height="163" as="geometry"/></mxCell>
<mxCell id="c46" value="&lt;b style='font-size:15px'&gt;【恒等变形】（展开、提取公因式、因式分解、通分、移项通分、比较系数）&lt;/b&gt;&lt;br&gt;方向：把式子换成相等、更好用的样子（用 = 连接）&lt;br&gt;依据：运算律和工具箱公式①②&lt;br&gt;信号：要定正负就分解成因式之积；要对照系数就展开、比较系数；有分式就通分&lt;br&gt;用在：一元二次方程的解法〔R33 · E3〕、\(a[x^{2} + (\frac{b}{a})x] + c\)〔R44 · C3〕、顶点式〔R01 · C4〕、交点式（两根式）〔P01 · D3〕、解一元二次不等式〔R09 · I10〕、均值代换〔R13 · H3〕、\(\frac{f(x)}{g(x)}\) 与 0 比较〔R49 · I11〕、\((a_{1}x+c_{1})(a_{2}x+c_{2}) = a_{1}a_{2}x^{2} + (a_{1}c_{2}+a_{2}c_{1})x + c_{1}c_{2}\)〔R42 · F3〕、十字相乘〔R24 · F4〕、两根的对称式求值〔R25 · E6〕&lt;br&gt;⚠ 整数范围拆不出 \(\ne\) 没有实根：先算 \(\Delta\)，\(\Delta \ge 0\) 用求根公式（\(x^{2}-2x-1\)：\(\Delta =8\)，\(x=1\pm \sqrt{2}\)）；与等价变形分清：恒等变形用 =，等价变形用 \(\iff\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="2928" width="885" height="182" as="geometry"/></mxCell>
<mxCell id="c47" value="&lt;b style='font-size:15px'&gt;【等价变形】（同乘法、同除、开平方、判别式法、移项）&lt;/b&gt;&lt;br&gt;方向：换成同解、更好处理的形式，每一步都是 \(\iff\)&lt;br&gt;依据：不等式的性质〔S04 · G1〕；有实根 \(\iff  \Delta \ge 0\)〔R34 · E5〕&lt;br&gt;信号：解不等式；恒成立化成最值；“有实数解”“对一切 \(t\) 成立”化成 \(\Delta\) 的不等式&lt;br&gt;用在：一元二次方程的解法〔R33 · E3〕、\(x^{2} + (\frac{b}{a})x + \frac{c}{a} = 0\)〔R39 · E3〕、\(x^{2} + (\frac{b}{a})x = -\frac{c}{a}\)〔R40 · E4〕、求根公式与判别式〔R34 · E5〕、作差恒等式〔R18 · C5〕、相关系数 \(|r| \le  1\)（判别式）〔R38 · G14〕、解一元二次不等式〔R09 · I10〕、恒成立（全体实数）〔P08 · K8〕、恒成立 \(\iff\) 最不利的值满足；能成立 \(\iff\) 最有利的值满足〔P25 · K8〕、\(x\) 有实根 \(\Rightarrow  \Delta \ge 0\)：得到候选 \(y\)〔R47 · H3〕、分式不等式化为二次〔R19 · I12〕、\(f(x)&amp;gt;0 \iff  (x-h)^{2} &amp;gt; \frac{\Delta}{4a^{2}}\)〔P28 · L8〕、配方法解二次不等式〔P15 · L9〕、\(\Delta &amp;lt;0\) 时开平方〔P23 · F5〕&lt;br&gt;⚠ 乘负数不等号反向；两边同除前确认除数 \(\ne 0\)；开平方先看右边 \(\ge 0\)；判别式法只给候选值，要检验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="2928" width="885" height="220" as="geometry"/></mxCell>
<mxCell id="c48" value="&lt;b style='font-size:15px'&gt;【代换】（代入、代入特定值、代换法、换元法）&lt;/b&gt;&lt;br&gt;方向：把已知代进去；把反复出现的部分换成新变量，装进已知结论的形状&lt;br&gt;依据：恒等式对一切取值成立；点在图像上 \(\iff\) 坐标满足解析式〔S03 · F1〕&lt;br&gt;信号：具体的点、特定值；同一个式子反复出现（\(2^{x}\)、\(\cos  x\)、\(\sqrt{x}\)）&lt;br&gt;用在：\(y = x^{2}\) 的图像〔R30 · G3〕、平移：\(y = a(x-h)^{2} + k\)〔R32 · G4〕、韦达定理〔P21 · E5〕、系数的几何意义〔R03 · B4〕、对称轴〔R04 · D8〕、值域〔R07 · E9〕、\(f(n) - f(m) = a(n-m)(m+n-2h)\)〔R46 · B9〕、对称轴的一般形式〔R35 · E9〕、奇偶性〔R06 · A9〕、\(y\) 变成 \(t\) 的二次函数，\(t\) 取 \(g(x)\) 的值域〔P27 · D14〕、复数范围内的一元二次方程〔R21 · G5〕、换元后的方程〔P24 · F5〕&lt;br&gt;⚠ 换元后先求新变量的范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="3130" width="885" height="201" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b style='font-size:15px'&gt;【消元】（代入消元、分离参数）&lt;/b&gt;&lt;br&gt;方向：多个未知数 → 一个；参数和变量分到两边&lt;br&gt;依据：方程可以解出一个变量；恒成立 \(\iff\) 最值满足〔P09 · K9〕&lt;br&gt;信号：直线与曲线联立；含参数的恒成立、能成立&lt;br&gt;用在：区间上恒成立 / 能成立（参数记作 λ）〔P09 · K9〕、直线与抛物线的交点〔R15 · I3〕&lt;br&gt;⚠ 消元后保留剩下变量的范围；分离参数时除数先定正负" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="3168" width="885" height="144" as="geometry"/></mxCell>
<mxCell id="c50" value="&lt;b style='font-size:15px'&gt;【导数与逼近】（求导、取极限、切线）&lt;/b&gt;&lt;br&gt;方向：单调、极值、切线 → 看导函数；求近似值 → 以直代曲&lt;br&gt;依据：求导法则⑤&lt;br&gt;信号：三次函数、含 \(e^{x}\)、\(\ln  x\)；求近似根&lt;br&gt;用在：\(F'(x) = 3Ax^{2} + 2Bx + C\) 是二次函数〔R48 · D14〕、用导数看二次函数〔R22 · G8〕、牛顿法求根〔R29 · E14〕&lt;br&gt;⚠ 导数为 0 不一定是极值点；看导数的符号要在同一区间内" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="3332" width="885" height="144" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b style='font-size:15px'&gt;【数形结合】（列表描点、伸缩）&lt;/b&gt;&lt;br&gt;方向：式子 → 图像，从图上读出正负、个数、位置&lt;br&gt;依据：点在图像上〔S03 · F1〕&lt;br&gt;信号：拿不准正负、个数、位置；根的分布；含绝对值；画新函数先列表描点&lt;br&gt;用在：\(y = x^{2}\) 的图像〔R30 · G3〕、\(y = ax^{2}\) 的图像（\(a\ne 0\)）〔R31 · G3〕、顶点式〔R01 · C4〕、零点 \(\iff\) 根 \(\iff\) 交点〔R08 · I9〕、三个二次的关系〔P07 · I9〕、两根都大于 \(k\)〔P10 · H13〕、一根大于 \(k\)、一根小于 \(k\)〔P11 · I13〕、两根分属两个区间〔P18 · I14〕&lt;br&gt;⚠ 图只作引导，结论要能用代数说清" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="3351" width="885" height="182" as="geometry"/></mxCell>
<mxCell id="c52" value="&lt;b style='font-size:15px'&gt;【分类讨论】&lt;/b&gt;&lt;br&gt;方向：结论依赖符号、大小、位置 → 分段各自处理&lt;br&gt;依据：二次函数的定义（\(a\ne 0\)）〔S02 · G1〕&lt;br&gt;信号：参数会改变“是不是二次、开口、根的大小、轴的位置”；去绝对值&lt;br&gt;用在：求根公式与判别式〔R34 · E5〕、闭区间上的最值〔P05 · C9〕、含参最值〔P06 · C10〕、含参二次不等式〔R10 · I11〕、恰有一根在 \((m, n)\) 内〔P13 · I14〕、\(x\) 有实根 \(\Rightarrow  \Delta \ge 0\)：得到候选 \(y\)〔R47 · H3〕、含绝对值的图像〔R14 · F8〕、解集为 \((x_{1},x_{2}) \Rightarrow  a&amp;gt;0\)，\(x_{1}\)、\(x_{2}\) 是 \(ax^{2}+bx+c=0\) 的两根〔R50 · J10〕&lt;br&gt;⚠ 分类标准统一，不重不漏；二次项系数含参先分 \(=0\) 与 \(\ne 0\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="3496" width="885" height="182" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b style='font-size:15px'&gt;【反证】（反证法）&lt;/b&gt;&lt;br&gt;方向：直接证困难 → 假设结论不成立，推出矛盾&lt;br&gt;信号：至少、唯一、不可能&lt;br&gt;用在：恰有一根在 \((m, n)\) 内〔P13 · I14〕&lt;br&gt;⚠ 要否定整个结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="3553" width="885" height="125" as="geometry"/></mxCell>
<mxCell id="c54" value="&lt;b style='font-size:15px'&gt;【回到定义与检验】（定义、检验、距离验证）&lt;/b&gt;&lt;br&gt;方向：概念题回到定义逐字翻译；变形不可逆时把结果代回原题&lt;br&gt;依据：定义〔S01 · E1〕〔S06 · A8〕〔S07 · I8〕&lt;br&gt;信号：零点、相切、反函数；平方、去分母、判别式给出的候选值；焦点准线要两边算距离&lt;br&gt;用在：零点 \(\iff\) 根 \(\iff\) 交点〔R08 · I9〕、判别式法求值域〔R12 · H4〕、直线与抛物线的交点〔R15 · I3〕、抛物线的几何定义（选择性必修衔接）〔R16 · K3〕、换元解方程（舍根）〔P19 · F6〕、二次函数的反函数〔P20 · D9〕&lt;br&gt;⚠ 判别式法、平方、去分母后都要检验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-2060" y="3698" width="885" height="163" as="geometry"/></mxCell>
<mxCell id="c55" value="&lt;b style='font-size:15px'&gt;【建模】&lt;/b&gt;&lt;br&gt;方向：实际问题 → 设变量、列函数、写定义域&lt;br&gt;信号：利润、面积、距离、刹车&lt;br&gt;用在：二次函数模型（实际应用）〔P16 · D10〕&lt;br&gt;⚠ 写出实际意义的定义域（长度为正、件数为整数）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#4E342E;arcSize=10;align=left;spacingLeft=8;fontSize=13;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=8;absoluteArcSize=1;arcSize=18;" vertex="1" parent="bg"><mxGeometry x="-1145" y="3698" width="885" height="125" as="geometry"/></mxCell>
<mxCell id="c56" value="&lt;b style=&quot;font-size:20px&quot;&gt;题型入口（从哪进）：看到什么 → 反推到哪 → 先查什么 → 用哪个工具、走哪个方向 → 去这里查&lt;/b&gt;" style="text;html=1;fontFamily=PingFang SC;fontColor=#00695C;align=left;" vertex="1" parent="bg"><mxGeometry x="-2060" y="3931" width="1800" height="40" as="geometry"/></mxCell>
<mxCell id="c57" value="&lt;b&gt;入口1　看到 求二次函数的解析式&lt;/b&gt;&lt;br&gt;反推：已知什么设什么：三点 → 一般式；顶点 → 顶点式；两零点 → 交点式&lt;br&gt;先查：\(a\ne 0\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 已知与 \(x\) 轴两个交点：\(y=a(x-x_{1})(x-x_{2})\)，再用一个点定 \(a\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt; 已知顶点或最值：设顶点式 \(a(x-h)^{2}+k\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 已知两点同高：对称轴是两点的中点&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 待定系数法求解析式 &lt;b&gt;〔R02 · C3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 顶点式 &lt;b&gt;〔R01 · C4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 交点式（两根式） &lt;b&gt;〔P01 · D3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="3981" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c58" value="&lt;b&gt;入口2　看到 二次函数在给定区间上求最值&lt;/b&gt;&lt;br&gt;反推：先求对称轴 \(x=h\)，再看 \(h\) 与区间的位置&lt;br&gt;先查：开口方向 \(a\)；区间开闭、是否无界、端点能否取到&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 看对称轴在区间左、内、右&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 按轴的位置分三类；开区间端点取不到要说明&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 单调性 &lt;b&gt;〔P02 · C8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 最值 &lt;b&gt;〔P03 · E8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="3981" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c59" value="&lt;b&gt;入口3　看到 含参数的最值（轴动 / 区间动）&lt;/b&gt;&lt;br&gt;反推：按对称轴与区间的相对位置分类；\(a&amp;gt;0\) 求最大值、\(a&amp;lt;0\) 求最小值时，用区间中点判断取哪个端点；另一种最值按顶点是否落在区间内判断&lt;br&gt;先查：\(a\) 的正负；参数在轴里还是在区间里&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; \(a&amp;gt;0\) 的最大值（\(a&amp;lt;0\) 的最小值）看轴与区间中点&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 轴动区间定、区间动轴定，按位置分类&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含参最值 &lt;b&gt;〔P06 · C10〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 作差恒等式 &lt;b&gt;〔R18 · C5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="3981" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c60" value="&lt;b&gt;入口4　看到 已知单调区间，求参数&lt;/b&gt;&lt;br&gt;反推：“在 \(D\) 上单调”：\(D\) 整个落在对称轴同一侧；“单调区间是 \(D\)”：\(D\) 的端点就是 \(h\)&lt;br&gt;先查：开口方向；二次项系数含参数时先看 \(=0\)（一次函数看 \(b\) 的符号）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; “在 \(D\) 上单调”：\(D\) 落在轴的一侧；“单调区间是 \(D\)”：\(D\) 的端点就是 \(h\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 二次项系数含参时先分 \(=0\) 与 \(\ne 0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 单调性 &lt;b&gt;〔P02 · C8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对称轴 &lt;b&gt;〔R04 · D8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="4215" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c61" value="&lt;b&gt;入口5　看到 比较 \(f(x_{1})\)、\(f(x_{2})\) 的大小&lt;/b&gt;&lt;br&gt;反推：看谁离对称轴远&lt;br&gt;先查：\(a&amp;gt;0\) 远的大，\(a&amp;lt;0\) 远的小&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 看离对称轴的远近：\(a&amp;gt;0\) 远的大，\(a&amp;lt;0\) 远的小&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 远近规律 &lt;b&gt;〔P04 · B8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两点同高 \(\Rightarrow\) 对称轴 &lt;b&gt;〔R05 · E8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="4233" width="580" height="174" as="geometry"/></mxCell>
<mxCell id="c62" value="&lt;b&gt;入口6　看到 解一元二次不等式（含参）&lt;/b&gt;&lt;br&gt;反推：化正 \(\to  \Delta  \to\) 两根大小；也可配方化成 \(|x-h|\) 与常数比较&lt;br&gt;先查：二次项系数是否可能为 0&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 能分解就分解，两根直接读出，如 \((x-1)(x-m)\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt; 也可配方：\((x-h)^{2}\) 与常数比较&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 拆不出来时算 \(\Delta\)，定根的个数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 开口向上：两根之外为正、之间为负&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 先看二次项系数是否为 0，再看开口，再比两根大小&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含参二次不等式 &lt;b&gt;〔R10 · I11〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三个二次的关系 &lt;b&gt;〔P07 · I9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 配方法解二次不等式 &lt;b&gt;〔P15 · L9〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="4233" width="580" height="282" as="geometry"/></mxCell>
<mxCell id="c63" value="&lt;b&gt;入口7　看到 恒成立 / 能成立&lt;/b&gt;&lt;br&gt;反推：全体实数：看 \(a\) 和 \(\Delta\)；区间上：化为最值或分离参数&lt;br&gt;先查：\(a=0\) 的情形；分离参数时除数的正负；\(g\) 的取值范围有没有最值、边界能否取到、是否无界（\(λ\ge g\) 恒成立遇向上无界无解；\(λ\le g\) 恒成立遇向下无界无解）；\(g\) 不是二次函数时换用对应工具，如 \(x+\frac{1}{x}\) 同见不等式大厦〔P31、P40〕&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 全体实数恒 \(&amp;gt;0\)：开口向上且 \(\Delta &amp;lt;0\)（\(\ge 0\) 时 \(\Delta \le 0\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 区间上：转成区间最值，看轴的位置&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 二次项系数含参先分 \(=0\) 与 \(\ne 0\)；分离参数时先定除数的正负&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 恒成立（全体实数） &lt;b&gt;〔P08 · K8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 区间上恒成立 / 能成立（参数记作 λ） &lt;b&gt;〔P09 · K9〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="4431" width="580" height="246" as="geometry"/></mxCell>
<mxCell id="c64" value="&lt;b&gt;入口8　看到 方程根的分布&lt;/b&gt;&lt;br&gt;反推：判别式、对称轴、端点值三样；或用韦达看符号&lt;br&gt;先查：二次项系数不为 0，\(a&amp;lt;0\) 先化正；重根怎么算&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 两根在 \(k\) 同侧：\(\Delta \ge 0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 看根的正负：同号先要 \(\Delta \ge 0\)，再看两根之和、积的符号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 两根在 \(k\) 同侧：对称轴也在那一侧&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 画图看 \(\Delta\)、对称轴、端点值三样&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 端点是根、重根时单独检验&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根都大于 \(k\) &lt;b&gt;〔P10 · H13〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 一根大于 \(k\)、一根小于 \(k\) &lt;b&gt;〔P11 · I13〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根都在 \((m, n)\) 内 &lt;b&gt;〔P12 · H14〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 恰有一根在 \((m, n)\) 内 &lt;b&gt;〔P13 · I14〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根的符号：用韦达 &lt;b&gt;〔R11 · J13〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="4431" width="580" height="300" as="geometry"/></mxCell>
<mxCell id="c65" value="&lt;b&gt;入口9　看到 分式函数求值域&lt;/b&gt;&lt;br&gt;反推：化为关于 \(x\) 的方程，\(\Delta \ge 0\) 得到候选 \(y\)&lt;br&gt;先查：二次项系数为 0 的 \(y\)；每个候选 \(y\) 都要对应定义域内、分母\(\ne 0\) 的 \(x\)（不只查端点）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; \(y\) 当已知数，\(x\) 有实根 \(\Rightarrow  \Delta \ge 0\)，得候选 \(y\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 二次项系数含 \(y\) 时，为 0 单独判断；检验被排除的 \(x\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 判别式法求值域 &lt;b&gt;〔R12 · H4〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="4539" width="580" height="174" as="geometry"/></mxCell>
<mxCell id="c66" value="&lt;b&gt;入口10　看到 指数、三角式里藏着二次&lt;/b&gt;&lt;br&gt;反推：换元 \(t\)，先求 \(t\) 的范围&lt;br&gt;先查：\(t\) 的范围是开是闭、端点能否取到&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 在 \(t\) 的范围上看对称轴的位置求最值&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代换】&lt;/span&gt; 令 \(t=2^{x}\) 或 \(t=\cos  x\)，先求 \(t\) 的范围&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次型复合：换元 &lt;b&gt;〔P14 · D15〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="4701" width="580" height="174" as="geometry"/></mxCell>
<mxCell id="c67" value="&lt;b&gt;入口11　看到 画抛物线、图像平移&lt;/b&gt;&lt;br&gt;反推：化成顶点式 → 由 \(y=ax^{2}\) 平移；开口看 \(a\)，与 \(y\) 轴交点看 \(c\)&lt;br&gt;先查：平移方向（括号里左加右减）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt; 配方成 \(a(x-h)^{2}+k\)，读出顶点&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 由 \(y=ax^{2}\) 平移；开口定 \(a\)，轴的位置定 \(a\)、\(b\) 同号异号，与 \(y\) 轴交点定 \(c\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 平移：\(y = a(x-h)^{2} + k\) &lt;b&gt;〔R32 · G4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 顶点式 &lt;b&gt;〔R01 · C4〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 系数的几何意义 &lt;b&gt;〔R03 · B4〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="4737" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c68" value="&lt;b&gt;入口12　看到 求值域（二次、换元、分式）&lt;/b&gt;&lt;br&gt;反推：二次（\(x\in \mathbb{R}\)）：看开口和顶点；限定区间：查闭区间最值；换元：先求新变量范围；分式：判别式法&lt;br&gt;先查：定义域；区间开闭与端点；分式要逐个检验候选值&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt; 里层二次先配方求范围&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 分式用判别式法&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 限定区间时看对称轴的位置&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代换】&lt;/span&gt; 根式、指数里的二次先换元，先求新变量的范围&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 值域 &lt;b&gt;〔R07 · E9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次型复合：换元 &lt;b&gt;〔P14 · D15〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 判别式法求值域 &lt;b&gt;〔R12 · H4〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="4755" width="580" height="282" as="geometry"/></mxCell>
<mxCell id="c69" value="&lt;b&gt;入口13　看到 零点个数、含绝对值的二次&lt;/b&gt;&lt;br&gt;反推：零点 = 与 \(x\) 轴交点：看 \(\Delta\)；含绝对值先画翻折后的图像，再数交点&lt;br&gt;先查：二次项系数含参数时先看 \(=0\)（一次函数 \(b\ne 0\) 时恰有一个零点）；\(|f(x)|\) 与 \(f(|x|)\) 的区别&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 看 \(\Delta\) 定根的个数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 含绝对值先画翻折后的图像，数与水平线的交点&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 二次项系数含参先分 \(=0\)；按绝对值里的式子正负分段&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 零点 \(\iff\) 根 \(\iff\) 交点 &lt;b&gt;〔R08 · I9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含绝对值的图像 &lt;b&gt;〔R14 · F8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 恰有一根在 \((m, n)\) 内 &lt;b&gt;〔P13 · I14〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="4899" width="580" height="246" as="geometry"/></mxCell>
<mxCell id="c70" value="&lt;b&gt;入口14　看到 已知两数的和与积，求范围&lt;/b&gt;&lt;br&gt;反推：均值代换：两数是 \(t^{2}-st+p=0\) 的两根&lt;br&gt;先查：隐含条件 \(s^{2}-4p\ge 0\)；两数限正（负）时，再用韦达看根的符号&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 两数是 \(t^{2}-st+p=0\) 的根 \(\Rightarrow  s^{2}-4p\ge 0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 两数限正（负）时，再看和与积的符号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 均值代换 &lt;b&gt;〔R13 · H3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根的符号：用韦达 &lt;b&gt;〔R11 · J13〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="4971" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c71" value="&lt;b&gt;入口15　看到 实际应用：利润、面积的最值（刹车距离类是解不等式，见解一元二次不等式）&lt;/b&gt;&lt;br&gt;反推：列出二次函数 → 写出实际意义的定义域 → 在定义域上求最值&lt;br&gt;先查：自变量是否只能取整数；端点能否取到&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 在实际意义的定义域上看对称轴位置；整数自变量取离轴最近的整数（\(a&amp;lt;0\) 求最大值、\(a&amp;gt;0\) 求最小值）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次函数模型（实际应用） &lt;b&gt;〔P16 · D10〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 整数自变量上的最值 &lt;b&gt;〔P17 · B9〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="5061" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c72" value="&lt;b&gt;入口16　看到 分式不等式&lt;/b&gt;&lt;br&gt;反推：移项通分 → 化成 \(f\cdot g\) 与 0 比较 → 按二次（或高次）不等式解&lt;br&gt;先查：分母 \(\ne  0\)；\(\ge\) 时等号只来自分子&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 化成乘积后分解因式&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 数轴上标根，看各段的正负&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 分式不等式化为二次 &lt;b&gt;〔R19 · I12〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="5169" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c73" value="&lt;b&gt;入口17　看到 已知解集，求系数&lt;/b&gt;&lt;br&gt;反推：\(&amp;lt;0\) 的解集是两根之间 → 开口向上；\(&amp;gt;0\) 的解集是两根之间 → 开口向下；两端是方程的根 → 韦达&lt;br&gt;先查：解集形式决定 \(a\) 的符号&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 解集的端点是方程的两根，用两根之和、积求系数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 解集是两根之间：\(&amp;lt;0\) 时开口向上，\(&amp;gt;0\) 时开口向下&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 已知解集反求系数 &lt;b&gt;〔R23 · J11〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三个二次的关系 &lt;b&gt;〔P07 · I9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="5205" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c74" value="&lt;b&gt;入口18　看到 两根分别在两个区间内&lt;/b&gt;&lt;br&gt;反推：端点函数值符号：\(f(m)&amp;gt;0\)，\(f(n)&amp;lt;0\)，\(f(p)&amp;gt;0\)（\(a&amp;gt;0\)）&lt;br&gt;先查：开口方向；两区间不相邻时四个端点都要查&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 画图看各端点处函数值的符号（\(a&amp;gt;0\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根分属两个区间 &lt;b&gt;〔P18 · I14〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 一根大于 \(k\)、一根小于 \(k\) &lt;b&gt;〔P11 · I13〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 恰有一根在 \((m, n)\) 内 &lt;b&gt;〔P13 · I14〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="5295" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c75" value="&lt;b&gt;入口19　看到 \(\Delta &amp;lt;0\) 的方程、复数根&lt;/b&gt;&lt;br&gt;反推：在复数范围内用求根公式，根与系数的关系仍成立；实系数时，已知一个虚根，另一根是它的共轭，用韦达求系数&lt;br&gt;先查：题目是在实数还是复数范围内；求 \(|x_{1}-x_{2}|\) 时 \(\Delta &amp;lt;0\) 用 \(|a|\cdot |x_{1}-x_{2}| = \sqrt{-\Delta }\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 实系数、\(\Delta &amp;lt;0\)：两个共轭虚根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 根与系数的关系在复数范围仍成立&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 复数范围内的一元二次方程 &lt;b&gt;〔R21 · G5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="5385" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c76" value="&lt;b&gt;入口20　看到 直线与抛物线：相切、弦长&lt;/b&gt;&lt;br&gt;反推：联立消元得 \(a'x^{2}+b'x+c'=0\)，\(\Delta'=b'^{2}-4a'c'\)：\(\Delta'=0\) 相切；弦长 \(\sqrt{1+k^{2}}\cdot \frac{\sqrt{\Delta'}}{|a'|}\)&lt;br&gt;先查：竖直直线单独处理&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 联立后 \(\Delta'=0\) 相切&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 弦长 \(\sqrt{1+k^{2}}\cdot |x_{1}-x_{2}|\)，其中 \(|x_{1}-x_{2}|=\frac{\sqrt{\Delta'}}{|a'|}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线与抛物线的交点 &lt;b&gt;〔R15 · I3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线截抛物线的弦长 &lt;b&gt;〔R20 · I5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="5457" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c77" value="&lt;b&gt;入口21　看到 高次不等式&lt;/b&gt;&lt;br&gt;反推：化成一次因式乘积（\(x\) 的系数为正），标根后从右往左穿线&lt;br&gt;先查：无实根的二次因式恒正可约去；重根&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 先试出一个根降次，剩下的二次再分解&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 标根后从右往左穿线&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 高次不等式（穿根法） &lt;b&gt;〔R27 · J8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三个二次的关系 &lt;b&gt;〔P07 · I9〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="5511" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c78" value="&lt;b&gt;入口22　看到 换元后化成一元二次方程&lt;/b&gt;&lt;br&gt;反推：令 \(t=\sqrt{x}\)、\(x^{2}\)、\(a^{x}\)、\(\lg  x\) 等，解 \(t\) 的方程，再按 \(t\) 的范围舍根&lt;br&gt;先查：\(t\) 的取值范围；对数合并、两边平方后回原方程的定义域检验&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 换元后的二次方程分解求 \(t\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代换】&lt;/span&gt; 令 \(t=\sqrt{x}\)、\(x^{2}\) 或 \(2^{x}\)，按 \(t\) 的范围舍根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 换元解方程（舍根） &lt;b&gt;〔P19 · F6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次型复合：换元 &lt;b&gt;〔P14 · D15〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="5601" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c79" value="&lt;b&gt;入口23　看到 已知方程，求两根的对称式的值&lt;/b&gt;&lt;br&gt;反推：用韦达把 \(x_{1}^{2}+x_{2}^{2}\)、\(\frac{1}{x_{1}}+\frac{1}{x_{2}}\) 等化成 \(x_{1}+x_{2}\)、\(x_{1}x_{2}\)；非对称式先用“根满足原方程”降次&lt;br&gt;先查：\(\Delta \ge 0\)（有实根）；复数范围韦达仍成立，但模 \(|x_{1}-x_{2}|\) 要另算&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 先查 \(\Delta \ge 0\)，保证有实根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 配凑成两根之和、积&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根的对称式求值 &lt;b&gt;〔R25 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="5691" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c80" value="&lt;b&gt;入口24　看到 求零点的近似值&lt;/b&gt;&lt;br&gt;反推：二分法：保留端点值异号的半区间&lt;br&gt;先查：区间端点值异号、函数连续&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二分法求零点近似值 &lt;b&gt;〔R26 · J9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【定理】零点存在定理 &lt;b&gt;〔S08 · J8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="5727" width="580" height="138" as="geometry"/></mxCell>
<mxCell id="c81" value="&lt;b&gt;入口25　看到 二次函数的反函数&lt;/b&gt;&lt;br&gt;反推：先限制在一个单调区间，再把 \(x\) 用 \(y\) 表示、交换字母&lt;br&gt;先查：原函数的值域就是反函数的定义域&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 限制在对称轴的一侧；开平方按原定义域取符号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次函数的反函数 &lt;b&gt;〔P20 · D9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【定义】反函数 &lt;b&gt;〔S11 · D8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="5817" width="580" height="174" as="geometry"/></mxCell>
<mxCell id="c82" value="&lt;b&gt;入口26　看到 直线与抛物线、圆、圆锥曲线有几个交点&lt;/b&gt;&lt;br&gt;反推：联立消元，看 \(\Delta\)（圆也可比较 \(d\) 与 \(r\)）&lt;br&gt;先查：竖直直线单独处理；参数范围 \(= \Delta\) 的条件 ∩ 二次项系数 \(\ne 0\) 的条件（二次项系数为 0 时单独看）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 联立后看 \(\Delta'\) 的符号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 竖直直线单独处理&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线与抛物线的交点 &lt;b&gt;〔R15 · I3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="5889" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c83" value="&lt;b&gt;入口27　看到 过一点作抛物线的切线&lt;/b&gt;&lt;br&gt;反推：设切点 \(x_{0}\)，切线 \(y=f(x_{0})+f'(x_{0})(x-x_{0})\) 过该点 \(\Rightarrow  x_{0}\) 的二次方程；或设直线联立，令 \(\Delta =0\)&lt;br&gt;先查：点在不在抛物线上（在上面时它就是切点；在外面时有两条）；对 \(y^{2}=2px\) 这类开口向右的抛物线，斜率不存在的直线也可能是切线；问“只有一个公共点”时还要加上与对称轴平行的直线（它不是切线）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 设直线 \(y=k(x-x_{1})+y_{1}\) 与抛物线联立，令 \(\Delta =0\) 解 \(k\)（竖直直线单独看）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 点在抛物线上、在外面，分开处理&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 用导数看二次函数 &lt;b&gt;〔R22 · G8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线与抛物线的交点 &lt;b&gt;〔R15 · I3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求根公式与判别式 &lt;b&gt;〔R34 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="5925" width="580" height="264" as="geometry"/></mxCell>
<mxCell id="c84" value="&lt;b&gt;入口28　看到 抛物线上的点到直线的最短距离&lt;/b&gt;&lt;br&gt;反推：距离 \(=\frac{|f(x)-(kx+m)|}{\sqrt{1+k^{2}}}\)，绝对值里是二次式，配方求最小值&lt;br&gt;先查：直线与抛物线没有公共点（绝对值里不变号）；最近点是切线与该直线平行的切点&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt; 绝对值里的二次式配方，求最小值&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 联立后 \(\Delta &amp;lt;0\) 说明没有公共点，绝对值里不变号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 最值 &lt;b&gt;〔P03 · E8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线与抛物线的交点 &lt;b&gt;〔R15 · I3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 用导数看二次函数 &lt;b&gt;〔R22 · G8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="6015" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c85" value="&lt;b&gt;入口29　看到 已知函数是偶函数，求参数&lt;/b&gt;&lt;br&gt;反推：定义域关于原点对称时：二次函数是偶函数 \(\iff\) 一次项系数 \(b=0\)&lt;br&gt;先查：定义域是否关于原点对称；先展开成一般式&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; \(f(-x)=f(x) \iff  2bx=0\) 对一切 \(x\) 成立 \(\iff  b=0\)（\(a\ne 0\) 时即对称轴 \(x=0\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 定义域含参数时，先让定义域关于原点对称&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 奇偶性 &lt;b&gt;〔R06 · A9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【定义】单调性、最值、奇偶性 &lt;b&gt;〔S06 · A8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="6105" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c86" value="&lt;b&gt;入口30　看到 三次函数的单调区间&lt;/b&gt;&lt;br&gt;反推：求导得二次函数，解导函数 \(&amp;gt;0\)、\(&amp;lt;0\) 的二次不等式&lt;br&gt;先查：导函数二次项系数为负先化正；导函数的重根处单调性不变&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 导函数能分解就分解求根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 画导函数的草图看正负&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 与导数衔接 &lt;b&gt;〔R17 · D15〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="6213" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c87" value="&lt;b&gt;入口31　看到 三次函数的极值、有无极值求参数&lt;/b&gt;&lt;br&gt;反推：求导得二次函数：\(\Delta &amp;gt;0\) 时有两个变号零点，才有极值&lt;br&gt;先查：三次项系数含参数时先看是否为 0；导函数的重根不是极值点&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 导函数（二次）\(\Delta &amp;gt;0\) 才有两个变号零点，才有极值&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 三次项系数含参数时先分 \(=0\) 与 \(\ne 0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 与导数衔接 &lt;b&gt;〔R17 · D15〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求根公式与判别式 &lt;b&gt;〔R34 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="6249" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c88" value="&lt;b&gt;入口32　看到 求定义域：根号、对数里的二次&lt;/b&gt;&lt;br&gt;反推：根号下的二次式 \(\ge 0\)；对数真数里的二次式 \(&amp;gt;0\)；化成解一元二次不等式。定义域为 \(\mathbb{R}\) 求参数：化成恒成立&lt;br&gt;先查：二次项系数含参数时先看 \(=0\)；\(\surd\) 要 \(\ge 0\)，log 要 \(&amp;gt;0\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 定义域为 \(\mathbb{R}\)：根号下的二次式恒 \(\ge 0 \iff  a&amp;gt;0\) 且 \(\Delta \le 0\)；log 里恒 \(&amp;gt;0 \iff  a&amp;gt;0\) 且 \(\Delta &amp;lt;0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 二次项系数含参数时先分 \(=0\) 与 \(\ne 0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含参二次不等式 &lt;b&gt;〔R10 · I11〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 恒成立（全体实数） &lt;b&gt;〔P08 · K8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="6321" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c89" value="&lt;b&gt;入口33　看到 分段函数（含二次段）在 \(\mathbb{R}\) 上单调，求参数&lt;/b&gt;&lt;br&gt;反推：每一段都单调（二次段：区间落在对称轴同一侧）+ 分界点处衔接（递增时左段在分界点的值 \(\le\) 右段的值）&lt;br&gt;先查：只看每段单调不够，分界点处的大小也要查&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 二次段所在区间落在对称轴的一侧&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 每段单调 + 分界点衔接，分开列条件再取交集&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 单调性 &lt;b&gt;〔P02 · C8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对称轴 &lt;b&gt;〔R04 · D8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【定义】单调性、最值、奇偶性 &lt;b&gt;〔S06 · A8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="6429" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c90" value="&lt;b&gt;入口34　看到 已知弦的中点，求弦所在直线&lt;/b&gt;&lt;br&gt;反推：设直线联立，用韦达：\(x_{1}+x_{2}=2x_{0}\)，解出斜率或截距&lt;br&gt;先查：求出直线后验 \(\Delta'&amp;gt;0\)（弦真的存在）；圆、椭圆要另看斜率不存在的弦&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; \(x_{1}+x_{2}=-\frac{b'}{a'}=2x_{0}\)，列方程解出斜率&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 中点弦 &lt;b&gt;〔R37 · J3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线与抛物线的交点 &lt;b&gt;〔R15 · I3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="6465" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c91" value="&lt;b&gt;入口35　看到 OA⊥OB、向量数量积：求值或求参数&lt;/b&gt;&lt;br&gt;反推：联立 → 韦达 \(\to  x_{1}x_{2}+y_{1}y_{2}\) 代入直线化成 \(x_{1}+x_{2}\)、\(x_{1}x_{2}\)&lt;br&gt;先查：\(\Delta &amp;gt;0\)；交点不能与原点重合&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 联立后先要 \(\Delta &amp;gt;0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; \(x_{1}x_{2}+y_{1}y_{2}\) 化成两根之和、积，代入韦达&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根的对称式求值 &lt;b&gt;〔R25 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线与抛物线的交点 &lt;b&gt;〔R15 · I3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="6573" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c92" value="&lt;b&gt;入口36　看到 定点、定值&lt;/b&gt;&lt;br&gt;反推：联立 → 韦达 → 化简后与参数无关（定值）；或直线方程整理成参数乘某式 + 某式，令两式为 0（定点）&lt;br&gt;先查：斜率不存在的直线单独验证；\(\Delta &amp;gt;0\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 联立后不求根，整体代入两根之和、积&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 斜率存在与不存在分开讨论&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两根的对称式求值 &lt;b&gt;〔R25 · E6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线与抛物线的交点 &lt;b&gt;〔R15 · I3〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="6681" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c93" value="&lt;b&gt;入口37　看到 弦长、面积的最值&lt;/b&gt;&lt;br&gt;反推：弦长或面积写成参数的式子（常是二次式或其平方根）→ 参数范围由 \(\Delta &amp;gt;0\) 给出 → 求最值&lt;br&gt;先查：参数范围是开区间（\(\Delta &amp;gt;0\)），端点取不到&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; \(\Delta &amp;gt;0\) 给出参数范围&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 弦长 \(\sqrt{1+k^{2}}\cdot \frac{\sqrt{\Delta'}}{|a'|}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 化成参数的二次函数后看对称轴与范围&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 直线截抛物线的弦长 &lt;b&gt;〔R20 · I5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次型复合：换元 &lt;b&gt;〔P14 · D15〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="6681" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c94" value="&lt;b&gt;入口38　看到 集合包含、交集并集里的二次，求参数&lt;/b&gt;&lt;br&gt;反推：先解出（或表示出）二次方程、不等式的解集，再按集合关系列条件&lt;br&gt;先查：解集可能是空集（\(\Delta &amp;lt;0\)）；两根谁大；端点能否取等&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 方程（\(a\ne 0\)）的解集为空 \(\iff  \Delta &amp;lt;0\)，只有一个元素 \(\iff  \Delta =0\)；不等式的解集按三个二次的关系判断&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 按空集、一个元素、两个元素分类；二次项系数含参先分 \(=0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求根公式与判别式 &lt;b&gt;〔R34 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 零点 \(\iff\) 根 \(\iff\) 交点 &lt;b&gt;〔R08 · I9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含参二次不等式 &lt;b&gt;〔R10 · I11〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="6807" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c95" value="&lt;b&gt;入口39　看到 分式方程化成一元二次方程&lt;/b&gt;&lt;br&gt;反推：去分母化成一元二次方程，解出后验增根（使分母为 0 的根舍去）；“解集只有一个元素”：\(\Delta =0\)，或两根中有一个是增根&lt;br&gt;先查：去分母前写出分母 \(\ne 0\) 的条件；能换元先换元&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; “只有一个解”：\(\Delta =0\) 是其中一种情形&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 按 \(\Delta =0\) 和“一根是增根”分类，逐个验证&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 换元解方程（舍根） &lt;b&gt;〔P19 · F6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求根公式与判别式 &lt;b&gt;〔R34 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="6933" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c96" value="&lt;b&gt;入口40　看到 已知奇（偶）函数一侧的二次解析式，求另一侧&lt;/b&gt;&lt;br&gt;反推：\(x&amp;lt;0\) 时 \(-x&amp;gt;0\)，把 \(-x\) 代入已知一侧，再用 \(f(x)=-f(-x)\)（奇）或 \(f(x)=f(-x)\)（偶）&lt;br&gt;先查：奇函数在 \(x=0\) 处有定义时 \(f(0)=0\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 按 \(x&amp;gt;0\)、\(x=0\)、\(x&amp;lt;0\) 分段写&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【定义】单调性、最值、奇偶性 &lt;b&gt;〔S06 · A8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 奇偶性 &lt;b&gt;〔R06 · A9〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="6933" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c97" value="&lt;b&gt;入口41　看到 向量模长含参数：求最值或恒成立&lt;/b&gt;&lt;br&gt;反推：向量 \(p\)、\(q\)（\(q\ne 0\)）：\(|p-tq|^{2} = |q|^{2}t^{2} - 2(p\cdot q)t + |p|^{2}\) 是 \(t\) 的二次函数，对称轴 \(t=\frac{p\cdot q}{|q|}^{2}\)&lt;br&gt;先查：先平方再看二次函数；“恒有 \(|p-tq| \ge  |p-t_{0}q|\)” \(\iff  t_{0}\) 是最小值点&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt; 平方后配方，读出顶点&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 最小值在对称轴 \(t=\frac{p\cdot q}{|q|}^{2}\) 处&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 最值 &lt;b&gt;〔P03 · E8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对称轴 &lt;b&gt;〔R04 · D8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 顶点式 &lt;b&gt;〔R01 · C4〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="7059" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c98" value="&lt;b&gt;入口42　看到 解三角形：已知两边和其中一边的对角&lt;/b&gt;&lt;br&gt;反推：余弦定理 \(a^{2}=b^{2}+c^{2}-2bc\cdot \cos A\) 化成第三边 \(c\) 的二次方程：\(c^{2} - (2b\cdot \cos A)c + (b^{2}-a^{2}) = 0\)；正根个数 = 三角形个数&lt;br&gt;先查：只取正根；用 \(\Delta\) 和两根之积 \(b^{2}-a^{2}\) 的符号判断正根个数&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; \(\Delta &amp;lt;0\) 无解，\(\Delta =0\) 至多一个&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 两根之积 \(b^{2}-a^{2}\) 与和 \(2b\cdot \cos A\) 的符号定正根个数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 根的符号：用韦达 &lt;b&gt;〔R11 · J13〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求根公式与判别式 &lt;b&gt;〔R34 · E5〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="7149" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c99" value="&lt;b&gt;入口43　看到 已知 \(\sin α\pm \cos α\) 或 \(\sin α\cdot \cos α\)，求值&lt;/b&gt;&lt;br&gt;反推：平方得 \(\sin α\cdot \cos α\)；\(\sin α\)、\(\cos α\) 是一个一元二次方程的两根，解出后按象限取舍&lt;br&gt;先查：α 的范围决定 \(\sin α\)、\(\cos α\) 的符号；\(t\in [-1,1]\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;韦达定理&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt; 和为 \(s\)、积为 \(\frac{s^{2}-1}{2}\)，构造 \(t^{2}-st+\frac{s^{2}-1}{2}=0\)；差为 \(s\) 时：\(\sin α\cdot \cos α=\frac{1-s^{2}}{2}\)，\(\sin α\) 与 \(-\cos α\) 是 \(t^{2}-st+\frac{s^{2}-1}{2}=0\) 的两根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代换】&lt;/span&gt; 把 \(\sin α\)、\(\cos α\) 看成新变量 \(t\)，按 \(t\in [-1,1]\) 舍根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 均值代换 &lt;b&gt;〔R13 · H3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 换元解方程（舍根） &lt;b&gt;〔P19 · F6〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 韦达定理 &lt;b&gt;〔P21 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="7167" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c100" value="&lt;b&gt;入口44　看到 数列通项 \(a_{n}\) 是 \(n\) 的二次式&lt;/b&gt;&lt;br&gt;反推：是不是数列的项：解 \(n\) 的一元二次方程，只取正整数根；最大（小）项：取离对称轴最近的正整数；单调：\(a_{n+1}-a_{n}\) 的符号&lt;br&gt;先查：\(n\) 只取正整数；\(a_{n}=an^{2}+bn\)（\(a&amp;gt;0\)）递增 \(\iff\) 对称轴 \(&amp;lt;\frac{3}{2}\)，不是 \(\le 1\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; \(a_{n}=\)常数 化成二次方程后分解求 \(n\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 最大、最小项取离对称轴最近的正整数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 一元二次方程的解法 &lt;b&gt;〔R33 · E3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 整数自变量上的最值 &lt;b&gt;〔P17 · B9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="7311" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c101" value="&lt;b&gt;入口45　看到 已知函数在区间上单调（或有极值），求参数（导函数是二次）&lt;/b&gt;&lt;br&gt;反推：单调递减 \(\iff\) 导函数在区间上 \(\le 0\) 恒成立：开口向上时只查两个端点；有极值 \(\iff\) 导函数在区间内有变号零点&lt;br&gt;先查：导函数的开口方向；端点能否取等；变号零点不是重根&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 开口向上：在区间上 \(f'\le 0 \iff\) 两个端点处 \(f'\le 0\)（开区间也成立，由连续性）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 画导函数的草图，看它在区间上的正负&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 按开口方向、两根与区间的位置分类&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 与导数衔接 &lt;b&gt;〔R17 · D15〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 区间上恒成立 / 能成立（参数记作 λ） &lt;b&gt;〔P09 · K9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 恰有一根在 \((m, n)\) 内 &lt;b&gt;〔P13 · I14〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="7401" width="580" height="264" as="geometry"/></mxCell>
<mxCell id="c102" value="&lt;b&gt;入口46　看到 导函数含二次因式：单调区间、极值（含 \(e^{x}\)、\(\ln  x\)）&lt;/b&gt;&lt;br&gt;反推：提出恒正因子（\(e^{x}\)，或 \(x&amp;gt;0\) 时的 \(\frac{1}{x}\)），单调性只看剩下的二次式；含参时按两根的大小分类&lt;br&gt;先查：定义域（\(\ln  x\) 要 \(x&amp;gt;0\)）；两根是否在定义域内&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 二次因式能分解就分解，读出两根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 含参时按两根大小、根是否在定义域内分类&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 与导数衔接 &lt;b&gt;〔R17 · D15〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含参二次不等式 &lt;b&gt;〔R10 · I11〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="7419" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c103" value="&lt;b&gt;入口47　看到 三次函数的零点个数、与水平线的交点个数&lt;/b&gt;&lt;br&gt;反推：求导得二次函数：\(\Delta \le 0\) 时单调，只有一个零点；\(\Delta &amp;gt;0\) 时看极大值、极小值的符号&lt;br&gt;先查：三次项系数的正负；极值点处的函数值&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;求根公式与判别式&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt; 导函数 \(\Delta &amp;gt;0\) 才有两个极值点&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 画三次函数草图，看极值与水平线的上下位置&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 与导数衔接 &lt;b&gt;〔R17 · D15〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 求根公式与判别式 &lt;b&gt;〔R34 · E5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="7563" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c104" value="&lt;b&gt;入口48　看到 两种方案的方差和最小&lt;/b&gt;&lt;br&gt;反推：\(D(aX)=a^{2}D(X)\)：方差和化成投入量 \(x\) 的二次函数，在 \(x\) 的范围上求最小值&lt;br&gt;先查：\(x\) 的实际范围（如 \(0\le x\le\)总额）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 看对称轴是否落在 \(x\) 的范围内&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 统计与概率中的二次：方差、最小二乘 &lt;b&gt;〔R36 · F14〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="7671" width="580" height="174" as="geometry"/></mxCell>
<mxCell id="c105" value="&lt;b&gt;入口49　看到 排列组合数、概率方程化成一元二次方程&lt;/b&gt;&lt;br&gt;反推：按公式展开或列方程组消元，化成一元二次方程，只取符合要求的根；例：独立事件列方程组消元得 \(32b^{2}+4b-3=0\)，\(b=\frac{1}{4}\)（\(-\frac{3}{8}\) 舍）&lt;br&gt;先查：\(n\) 是正整数且不小于下标要求；概率要在 \([0,1]\) 内&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;十字相乘&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R24&lt;/sup&gt; 化成二次方程后分解，舍去不合要求的根（\(n\) 不是正整数、概率不在 \([0,1]\) 内）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 一元二次方程的解法 &lt;b&gt;〔R33 · E3〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 换元解方程（舍根） &lt;b&gt;〔P19 · F6〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="7689" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c106" value="&lt;b&gt;入口50　看到 无理不等式（根号）化成二次不等式&lt;/b&gt;&lt;br&gt;反推：\(\sqrt{f(x)} &amp;gt; g(x) \iff\) ① \(f(x)\ge 0\) 且 \(g(x)&amp;lt;0\)，或 ② \(g(x)\ge 0\) 且 \(f(x)&amp;gt;g(x)^{2}\)；\(\sqrt{f(x)} &amp;lt; g(x) \iff  f(x)\ge 0\)，\(g(x)&amp;gt;0\)，\(f(x)&amp;lt;g(x)^{2}\)&lt;br&gt;先查：根号下 \(\ge 0\)；两边平方前右边要非负，按 \(g(x)\) 的正负分情况&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 按右边 \(g(x)\) 的正负分两种情况，最后取并集&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 三个二次的关系 &lt;b&gt;〔P07 · I9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【公理】实数运算与大小 &lt;b&gt;〔S04 · G1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="7779" width="580" height="210" as="geometry"/></mxCell>
<mxCell id="c107" value="&lt;b&gt;入口51　看到 含绝对值的二次不等式&lt;/b&gt;&lt;br&gt;反推：\(|f(x)| &amp;lt; a\)（\(a&amp;gt;0\)）\(\iff  -a &amp;lt; f(x) &amp;lt; a\)，两个二次不等式取交集；\(|f(x)| &amp;gt; a \iff  f(x) &amp;gt; a\) 或 \(f(x) &amp;lt; -a\)，取并集&lt;br&gt;先查：\(a\le 0\) 时单独看；也可画 \(|f(x)|\) 的翻折图像与直线 \(y=a\) 比较&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 画 \(|f(x)|\) 的翻折图像，看在直线 \(y=a\) 的上方还是下方&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 去绝对值：拆成两个二次不等式，交集或并集&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 解一元二次不等式 &lt;b&gt;〔R09 · I10〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含绝对值的图像 &lt;b&gt;〔R14 · F8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 【定义】集合与区间 &lt;b&gt;〔S09 · H1〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="7869" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c108" value="&lt;b&gt;入口52　看到 比较 \(f(\)两点中点) 与两端函数值的平均&lt;/b&gt;&lt;br&gt;反推：作差：两者之差 \(= a(x_{1}-x_{2})\frac{^{2}}{4}\)；\(a&amp;gt;0\) 且 \(x_{1}\ne x_{2}\) 时，中点的函数值更小（\(x_{1}=x_{2}\) 时相等）&lt;br&gt;先查：开口方向 \(a\)&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 用 \(h\) 表示：\(u=x_{1}-h\)，\(v=x_{2}-h\)，作差得 \(a(u-v)\frac{^{2}}{4}\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 凸性：中点不等式 &lt;b&gt;〔P22 · G8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 作差恒等式 &lt;b&gt;〔R18 · C5〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="7905" width="580" height="192" as="geometry"/></mxCell>
<mxCell id="c109" value="&lt;b&gt;入口53　看到 抽象函数：已知 \(f(p+x)=f(q-x)\)，求对称轴&lt;/b&gt;&lt;br&gt;反推：两个自变量之和 \(p+q\) 是常数 \(\Rightarrow\) 对称轴 \(x=\frac{p+q}{2}\)；再用对称轴比大小、求参数&lt;br&gt;先查：等式对一切 \(x\) 成立；是 \(q-x\) 不是 \(q+x\)（\(q+x\) 是周期，不是对称）；比大小还要看开口方向 \(a\)（抽象函数要已知一侧的单调性）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 对称轴 \(h=\frac{p+q}{2}\)；是二次函数时再按离轴远近比较函数值（看 \(a\) 的正负）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt; 画草图：两点关于直线 \(x=\frac{p+q}{2}\) 对称&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 对称轴的一般形式 &lt;b&gt;〔R35 · E9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 两点同高 \(\Rightarrow\) 对称轴 &lt;b&gt;〔R05 · E8〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 远近规律 &lt;b&gt;〔P04 · B8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-1450" y="8013" width="580" height="228" as="geometry"/></mxCell>
<mxCell id="c110" value="&lt;b&gt;入口54　看到 为什么方差、回归直线用平均数&lt;/b&gt;&lt;br&gt;反推：偏差平方和是二次函数，在对称轴处最小&lt;br&gt;先查：二次项系数为正&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt; 展开后配方，读出顶点：平均数处最小&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 统计与概率中的二次：方差、最小二乘 &lt;b&gt;〔R36 · F14〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 最值 &lt;b&gt;〔P03 · E8〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-2060" y="8121" width="580" height="174" as="geometry"/></mxCell>
<mxCell id="c111" value="&lt;b&gt;入口55　看到 圆锥曲线上的点到定点距离的最值&lt;/b&gt;&lt;br&gt;反推：定点在曲线的对称轴上时，用曲线方程消去一个变量，把距离的平方 \(d^{2}\) 化成 \(x\)（或 \(y\)）的二次函数 → 在变量范围上求最值&lt;br&gt;先查：变量范围（椭圆：\(x\) 在长轴两端点的横坐标之间；抛物线 \(y^{2}=2px\)（\(p&amp;gt;0\)）：\(x\ge 0\)，范围无界时看端点能否取到；双曲线：\(x\le -a\) 或 \(x\ge a\) 两段，分段求最值）&lt;br&gt;&lt;span style=&quot;color:#37474F;&quot;&gt;&lt;b&gt;用哪个工具、走哪个方向：&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#0D47A1;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;对称轴&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R04&lt;/sup&gt; 看 \(d^{2}\) 这个二次函数的对称轴是否落在变量范围内&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4E342E;&quot;&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt; 按 \(d^{2}\) 的对称轴在范围内、外分类&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00695C;font-weight:bold;&quot;&gt;去这里查：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 闭区间上的最值 &lt;b&gt;〔P05 · C9〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 含参最值 &lt;b&gt;〔P06 · C10〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#004D40;&quot;&gt;▸ 二次型复合：换元 &lt;b&gt;〔P14 · D15〕&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=2;align=left;spacingLeft=10;spacingRight=6;fontFamily=PingFang SC;fontSize=11;fontColor=#00695C;" vertex="1" parent="1"><mxGeometry x="-840" y="8121" width="580" height="246" as="geometry"/></mxCell>
<mxCell id="c112" value="" style="rounded=1;arcSize=3;html=1;fillColor=#FFFDF5;strokeColor=#B0BEC5;strokeWidth=2;dashed=1;dashPattern=10 6;" vertex="1" parent="bg"><mxGeometry x="3574" y="260" width="2714" height="325" as="geometry"/></mxCell>
