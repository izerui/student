<mxCell id="e1L" value="【前提】图像 = 所有点 \((x, f(x))\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="3991" y="425" width="277" height="28" as="geometry"/></mxCell>
<mxCell id="e21L" value="【前提】顶点式" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="2429" y="1633" width="118" height="28" as="geometry"/></mxCell>
<mxCell id="e22L" value="【前提】交点式" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="2526" y="1379" width="118" height="28" as="geometry"/></mxCell>
<mxCell id="e31L" value="【前提】单调性的定义" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="1268" y="4368" width="160" height="28" as="geometry"/></mxCell>
<mxCell id="e37L" value="【前提】最大值看离轴远的端点" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="1806" y="4790" width="216" height="28" as="geometry"/></mxCell>
<mxCell id="e43L" value="【前提】联立消元得 \(a'x^{2}+b'x+c'=0\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="7168" y="1473" width="287" height="28" as="geometry"/></mxCell>
<mxCell id="e45L" value="【前提】偏差平方和、最小二乘" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="4577" y="7818" width="216" height="28" as="geometry"/></mxCell>
<mxCell id="e98L" value="【前提】整数自变量上的最值" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="2868" y="5373" width="202" height="28" as="geometry"/></mxCell>
<mxCell id="e106L" value="【前提】\(i^{2}=-1\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="3397" y="2192" width="126" height="28" as="geometry"/></mxCell>
<mxCell id="e121L" value="【前提】三个二次的关系是 \(n=2\) 的情形" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="7193" y="4866" width="281" height="28" as="geometry"/></mxCell>
<mxCell id="e123L" value="【前提】\(f(h+t)=f(h-t)\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="3006" y="4790" width="207" height="28" as="geometry"/></mxCell>
<mxCell id="e124L" value="【前提】单调区间上不同的 \(x\) 对应不同的 \(y\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#607D8B;opacity=100;" vertex="1" parent="1"><mxGeometry x="1427" y="4790" width="309" height="28" as="geometry"/></mxCell>
<mxCell id="e3L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【列表描点】&lt;/span&gt;\(x=0,\pm 1,\pm 2\) 代入 \(y=x^{2}\)，描点连线&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;\((-x)^{2}=x^{2}\)：\((x,y)\) 在图像上 \(\iff  (-x,y)\) 也在，关于 \(y\) 轴对称" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4658" y="539" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e5L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【伸缩】&lt;/span&gt;同一个 \(x\)，纵坐标乘 \(a\)&lt;br&gt;\(a&amp;lt;0\) 时翻到 \(x\) 轴下方；\(|a|\) 越大，同一 \(x\) 处离 \(x\) 轴越远，开口越窄&lt;br&gt;\(x\) 与 \(-x\) 的纵坐标同乘 \(a\) 仍相等：对称性不变，顶点仍是 \((0,0)\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4868" y="1521" width="350" height="108" as="geometry"/></mxCell>
<mxCell id="e6L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代换法】&lt;/span&gt;\((x_{0},y_{0})\) 在 \(y=ax^{2}\) 上&lt;br&gt;\(\iff  (x_{0}+h, y_{0}+k)\) 在 \(y=a(x-h)^{2}+k\) 上" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4868" y="1833" width="331" height="48" as="geometry"/></mxCell>
<mxCell id="e8L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【因式分解】&lt;/span&gt;乘积为 \(0 \iff\) 某个因式为 0（\(uv=0 \iff  u=0\) 或 \(v=0\)）&lt;br&gt;例：\(x^{2}-5x+6=(x-2)(x-3)=0 \Rightarrow  x=2\) 或 \(x=3\)&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【开平方】&lt;/span&gt;\(x^{2}=p\)（\(p\ge 0\)）\(\Rightarrow  x=\pm \sqrt{p}\)；\((x+m)^{2}=p\) 同理 \(\Rightarrow  x=-m\pm \sqrt{p}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4073" y="556" width="350" height="140" as="geometry"/></mxCell>
<mxCell id="e9L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【同除】&lt;/span&gt;\(ax^{2}+bx+c=0\) 两边除以 \(a\)（\(a\ne 0\)）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3855" y="1561" width="322" height="28" as="geometry"/></mxCell>
<mxCell id="e10L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【移项】&lt;/span&gt;常数项 \(\frac{c}{a}\) 移到右边" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3855" y="1837" width="224" height="40" as="geometry"/></mxCell>
<mxCell id="e11L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt;两边加上一次项系数一半的平方 \((\frac{b}{2a})^{2}\)&lt;br&gt;左边凑成完全平方，右边通分：\(\frac{b^{2}-4ac}{4a^{2}}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3855" y="2144" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="e12L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;右边分母 \(4a^{2}&amp;gt;0\)，正负只看 \(\Delta\)&lt;br&gt;\(\Delta &amp;lt;0\)：右边为负，&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「平方非负」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;S05&lt;/sup&gt;\(\Rightarrow\) 无实根&lt;br&gt;\(\Delta \ge 0\)：&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【开平方】&lt;/span&gt;\(x+\frac{b}{2a}=\pm \frac{\sqrt{\Delta}}{2a} \Rightarrow  x=\frac{-b\pm \sqrt{\Delta} }{2a}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3855" y="2401" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="e14L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(\Delta \ge 0\)（有实根）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;两根相加、相乘：&lt;br&gt;\(\frac{-b+\sqrt{\Delta} }{2a} + \frac{-b-\sqrt{\Delta} }{2a} = -\frac{b}{a}\)，乘积 \(= \frac{c}{a}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3855" y="2723" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="e15L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【提取公因式】&lt;/span&gt;前两项提出 \(a\)（\(a\ne 0\)）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3985" y="838" width="267" height="28" as="geometry"/></mxCell>
<mxCell id="e16L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt;括号内加上再减去 \((\frac{b}{2a})^{2}\)&lt;br&gt;前三项凑成&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「完全平方公式」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;②&lt;/sup&gt;\((x + \frac{b}{2a})^{2}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2037" y="1505" width="313" height="72" as="geometry"/></mxCell>
<mxCell id="e17L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【展开】&lt;/span&gt;\(-\frac{b^{2}}{4a^{2}}\) 乘 \(a\) 后移出括号：\(a(x + \frac{b}{2a})^{2} + \frac{4ac-b^{2}}{4a}\)&lt;br&gt;记 \(h=-\frac{b}{2a}\)，\(k=\frac{4ac-b^{2}}{4a}=-\frac{\Delta}{4a}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2037" y="1713" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="e18L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt;一般式配方后得 \(a(x-h)^{2}+k\)，正是平移的形式&lt;br&gt;\(\Rightarrow\) 图像 \(= y=ax^{2}\) 向右平移 \(h\)、向上平移 \(k\)：顶点 \((h,k)\)，对称轴 \(x=h\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2943" y="744" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e19L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【因式分解】&lt;/span&gt;\(ax^{2}+bx+c = a[x^{2} - (x_{1}+x_{2})x + x_{1}x_{2}]\)&lt;br&gt;\(= a(x-x_{1})(x-x_{2})\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2795" y="596" width="350" height="68" as="geometry"/></mxCell>
<mxCell id="e20L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【待定系数】&lt;/span&gt;设出含未知系数的式子，每个已知条件列一个方程&lt;br&gt;已知三点 → 设 \(y=ax^{2}+bx+c\)，代入得三元一次方程组&lt;br&gt;已知顶点 \((h,k) \to\) 设 \(y=a(x-h)^{2}+k\)，再代一点求 \(a\)&lt;br&gt;已知与 \(x\) 轴交点 \(x_{1}\)、\(x_{2} \to\) 设 \(y=a(x-x_{1})(x-x_{2})\)，再代一点求 \(a\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3508" y="630" width="350" height="168" as="geometry"/></mxCell>
<mxCell id="e23L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入特定值】&lt;/span&gt;\(x=0\)：\(f(0)=c\)，图像与 \(y\) 轴交于 \((0,c)\)&lt;br&gt;对称轴 \(h=-\frac{b}{2a}\)：\(h&amp;lt;0 \iff  \frac{b}{2a}&amp;gt;0 \iff  a\)、\(b\) 同号（\(ab&amp;gt;0\)）&lt;br&gt;\(b=0 \iff  h=0\)：对称轴就是 \(y\) 轴" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="1700" y="2023" width="350" height="120" as="geometry"/></mxCell>
<mxCell id="e24L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【作差】&lt;/span&gt;\([a(x_{1}-h)^{2}+k] - [a(x_{2}-h)^{2}+k]\)，\(k\) 抵消" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2072" y="2059" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="e25L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「平方差」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;①&lt;/sup&gt;\((x_{1}-h)^{2}-(x_{2}-h)^{2} = (x_{1}-x_{2})(x_{1}+x_{2}-2h)\)&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【同除】&lt;/span&gt;\(x_{1}\ne x_{2}\) 时两边除以 \(x_{1}-x_{2}\)，得平均变化率" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2044" y="2368" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e28L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;\(x=h+t\)：\(f(h+t)=a\cdot t^{2}+k\)；\(x=h-t\)：\(f(h-t)=a\cdot (-t)^{2}+k=at^{2}+k\)&lt;br&gt;\(\Rightarrow  f(h+t)=f(h-t)\)：点 \((h+t, y)\) 与 \((h-t, y)\) 同在图像上，关于直线 \(x=h\) 对称" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2762" y="3622" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e29L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【作差】&lt;/span&gt;\(f(x_{1})=f(x_{2}) \Rightarrow  0 = a(x_{1}-x_{2})(x_{1}+x_{2}-2h)\)&lt;br&gt;\(a\ne 0\)，\(x_{1}\ne x_{2} \Rightarrow\) 只能第三个因子为 0：\(x_{1}+x_{2}-2h=0 \Rightarrow  h=\frac{x_{1}+x_{2}}{2}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2526" y="3791" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="e30L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)（\(a&amp;lt;0\) 时反向）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【作差】&lt;/span&gt;\(x_{1}&amp;lt;x_{2}\le h\)：\(x_{1}-x_{2}&amp;lt;0\)，\(x_{1}+x_{2}-2h&amp;lt;0\)&lt;br&gt;\(\Rightarrow  f(x_{1})-f(x_{2})&amp;gt;0\)，递减；\([h,+\infty )\) 同理递增" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2042" y="3535" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e32L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)（\(a&amp;lt;0\) 时反向）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「平方非负」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;S05&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;S05&lt;/sup&gt;\(a&amp;gt;0\)，\((x-h)^{2}\ge 0 \Rightarrow  a(x-h)^{2}\ge 0\)&lt;br&gt;\(\Rightarrow  f(x) \ge  k\)，\(x=h\) 取等&lt;br&gt;\((x-h)^{2}\) 可以任意大：\(a&amp;gt;0\) 时没有最大值；\(a&amp;lt;0\) 时 \(f\) 可以任意小，没有最小值" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3367" y="3716" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e34L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;任给 \(u\ge 0\)，取 \(x=h+\sqrt{u}\)，就有 \((x-h)^{2}=u\)&lt;br&gt;所以 \((x-h)^{2}\) 取遍 \([0,+\infty )\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3992" y="4764" width="350" height="80" as="geometry"/></mxCell>
<mxCell id="e35L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)（\(a&amp;lt;0\) 时反向）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「平方保序」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;⑭&lt;/sup&gt;\(0\le |x_{2}-h|&amp;lt;|x_{1}-h| \Rightarrow  (x_{2}-h)^{2}&amp;lt;(x_{1}-h)^{2}\)&lt;br&gt;\(a&amp;gt;0\)：差 \(f(x_{1})-f(x_{2}) &amp;gt;0\)，离轴远的函数值大" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="1055" y="3627" width="350" height="108" as="geometry"/></mxCell>
<mxCell id="e36L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(x\in [m,n]\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;按对称轴 \(h\) 与 \([m,n]\) 的位置分三类（\(a&amp;gt;0\)）&lt;br&gt;\(h&amp;lt;m\)：区间在轴右侧，递增 \(\Rightarrow\) 最小 \(f(m)\)，最大 \(f(n)\)&lt;br&gt;\(h&amp;gt;n\)：区间在轴左侧，递减 \(\Rightarrow\) 最小 \(f(n)\)，最大 \(f(m)\)&lt;br&gt;\(m\le h\le n\)：左减右增 \(\Rightarrow\) 最小 \(f(h)\)；最大在离轴远的端点（远近规律）&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;⇐ 用到工具：对称轴〔R04 · D8〕&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;&lt;/sup&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2039" y="4700" width="350" height="208" as="geometry"/></mxCell>
<mxCell id="e39L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;参数在对称轴里：轴动区间定；参数在区间里：区间动轴定&lt;br&gt;另一种最值看顶点是否落在区间内" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2039" y="5353" width="350" height="68" as="geometry"/></mxCell>
<mxCell id="e40L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;作差恒等式里取 \(x_{1}=n\)，\(x_{2}=m\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="1314" y="3757" width="279" height="28" as="geometry"/></mxCell>
<mxCell id="e41L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;\(a&amp;gt;0\)：\(h&amp;lt;\frac{m+n}{2}\) 时 \(f(n)\) 大，\(h&amp;gt;\frac{m+n}{2}\) 时 \(f(m)\) 大，相等时一样大&lt;br&gt;所以 \(a&amp;gt;0\) 的最大值、\(a&amp;lt;0\) 的最小值取离轴远的端点" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="1492" y="5337" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="e42L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(\Delta'&amp;gt;0\)（有两个交点才有弦）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「韦达」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt;\(x_{1}+x_{2}=-\frac{b'}{a'}\)，不用求出两根&lt;br&gt;中点 \(x_{0}=\frac{x_{1}+x_{2}}{2}\)，再代入直线得 \(y_{0}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5822" y="876" width="308" height="92" as="geometry"/></mxCell>
<mxCell id="e44L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【判别式法】&lt;/span&gt;二次项系数 \(&amp;gt;0\) 的二次式对一切 \(t\) 恒 \(\ge 0 \iff  \Delta \le 0\)&lt;br&gt;\(4(\sum u_{i}v_{i})^{2} - 4\sum u_{i}^{2}\cdot \sum v_{i}^{2} \le  0\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6478" y="7024" width="350" height="68" as="geometry"/></mxCell>
<mxCell id="e46L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)（\(a&amp;lt;0\) 时反向）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【作差】&lt;/span&gt;记 \(u=x_{1}-h\)，\(v=x_{2}-h\)：&lt;br&gt;\(\frac{f(x_{1})+f(x_{2})}{2} - f(\frac{x_{1}+x_{2}}{2}) = \frac{a(u^{2}+v^{2})}{2} - a(\frac{u+v}{2})^{2}\)&lt;br&gt;\(= a(u-v)\frac{^{2}}{4} = a(x_{1}-x_{2})\frac{^{2}}{4}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4374" y="3814" width="350" height="132" as="geometry"/></mxCell>
<mxCell id="e48L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;取 \(x\ne \frac{q-p}{2}\)：\(x_{1}=p+x\) 与 \(x_{2}=q-x\) 不同且函数值相等&lt;br&gt;二次函数由两点同高：\(h=\frac{x_{1}+x_{2}}{2}=\frac{p+q}{2}\)（一般函数的对称性由“点在图像上”证）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3531" y="4748" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="e50L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配方法】&lt;/span&gt;\(Q(t)=[(x_{1}-t)^{2}+\ldots +(x_{n}-t)^{2}]/n\) 展开：\(Q(t)=t^{2} - 2\cdot (\)平均数\()\cdot t + (\)平方的平均数)&lt;br&gt;二次项系数 \(1&amp;gt;0\)，对称轴 \(t=\)平均数 \(\Rightarrow\) 在平均数处最小&lt;br&gt;最小值 = 平方的平均数 − 平均数\(^{2} =\) 方差" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4941" y="6748" width="350" height="140" as="geometry"/></mxCell>
<mxCell id="e52L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：定义域关于原点对称&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;\(f(-x)=f(x) \iff  2bx=0\) 对定义域内一切 \(x \iff  b=0\)（定义域含非零的 \(x\)）&lt;br&gt;奇函数需 \(2ax^{2}+2c=0\) 对定义域内一切 \(x\)；定义域含两个 \(x^{2}\) 不同的 \(x\)（如区间）时得 \(a=c=0\)，与 \(a\ne 0\) 矛盾" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="552" y="4740" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e53L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【定义】&lt;/span&gt;零点 = 方程的根&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt;= 图像与 \(x\) 轴交点（\(y=0\)）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6822" y="4564" width="297" height="48" as="geometry"/></mxCell>
<mxCell id="e55L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt;开口向上的抛物线：两根之外在 \(x\) 轴上方，之间在下方&lt;br&gt;\(\Delta &amp;lt;0\)：最小值 \(-\frac{\Delta}{4a}&amp;gt;0\)，整条在上方&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;⇐ 用到工具：求根公式与判别式〔R34 · E5〕&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;&lt;/sup&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6822" y="5097" width="350" height="120" as="geometry"/></mxCell>
<mxCell id="e58L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【同乘法】&lt;/span&gt;\(a&amp;lt;0\) 时两边乘 \(-1\)：系数化正，不等号反向&lt;br&gt;化成 \(a&amp;gt;0\) 后：求 \(\Delta\) 和两根，按三个二次的关系读出解集&lt;br&gt;例：\(-x^{2}+x+2&amp;gt;0 \iff  x^{2}-x-2&amp;lt;0 \iff  (x-2)(x+1)&amp;lt;0 \iff  -1&amp;lt;x&amp;lt;2\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6822" y="5519" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e60L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【因式分解】&lt;/span&gt;\((x-x_{1})(x-x_{2})&amp;gt;0 \iff\) 两个因式同号&lt;br&gt;\(\iff  x-x_{1}\)、\(x-x_{2}\) 同正，或同负：两个一元一次不等式组" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5479" y="3824" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e62L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;第一层：二次项系数是否为 0？为 0 时不是二次不等式，按一次处理&lt;br&gt;第二层：系数不为 0 时化正，看 \(\Delta &amp;lt;0\)、\(\Delta =0\)、\(\Delta &amp;gt;0\)&lt;br&gt;第三层：有两根时比较两根大小；例 \((x-1)(x-m)&amp;lt;0\)：\(m&amp;gt;1\) 时 \(1&amp;lt;x&amp;lt;m\)，\(m=1\) 时无解，\(m&amp;lt;1\) 时 \(m&amp;lt;x&amp;lt;1\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6501" y="6001" width="350" height="148" as="geometry"/></mxCell>
<mxCell id="e64L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：对一切 \(x\in \mathbb{R}\) 恒成立（系数含参数时先分 \(a=0\) 与 \(a\ne 0\)）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【等价变形】&lt;/span&gt;\(a&amp;gt;0\)：恒 \(&amp;gt;0 \iff\) 最小值 \(&amp;gt;0 \iff  -\frac{\Delta}{4a}&amp;gt;0 \iff  \Delta &amp;lt;0\)&lt;br&gt;\(a&amp;lt;0\)：\(f\) 可以任意小（没有最小值），不可能恒正&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;⇐ 用到工具：求根公式与判别式〔R34 · E5〕&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;&lt;/sup&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5922" y="3840" width="350" height="140" as="geometry"/></mxCell>
<mxCell id="e66L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(x\) 只在某个区间内&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【等价变形】&lt;/span&gt;恒成立 \(\iff\) 最不利的值也满足&lt;br&gt;能成立 \(\iff\) 最有利的值满足" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="7202" y="3946" width="289" height="68" as="geometry"/></mxCell>
<mxCell id="e67L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分离参数】&lt;/span&gt;化成 λ 与 \(g(x)\) 比较，先求 \(g\) 的取值范围&lt;br&gt;有最值用最值；边界取不到看边界值（恒成立可取等，能成立不可取等）；无界单独判断&lt;br&gt;两边除以含 \(x\) 的式子时，先定它的正负（除以负数要变号）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="8709" y="4524" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e68L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt;看三样：判别式、对称轴位置、\(f(k)\) 的符号&lt;br&gt;必要：有两根 \(\Rightarrow  \Delta \ge 0\)；两根都 \(&amp;gt;k \Rightarrow\) 中点 \(h&amp;gt;k\)；\(k\) 在两根之外 \(\Rightarrow  f(k)&amp;gt;0\)&lt;br&gt;充分：\(f(k)&amp;gt;0 \Rightarrow  k\) 在两根之外；若 \(k\) 在右侧则 \(h\le x_{2}&amp;lt;k\)，与 \(h&amp;gt;k\) 矛盾，所以 \(k&amp;lt;x_{1}\)&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;⇐ 用到工具：求根公式与判别式〔R34 · E5〕、对称轴〔R04 · D8〕&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;&lt;/sup&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5602" y="6903" width="350" height="188" as="geometry"/></mxCell>
<mxCell id="e72L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt;\(a&amp;gt;0\) 时 \(f(k)&amp;lt;0 \Rightarrow\) 最小值 \(&amp;lt;0 \Rightarrow  \Delta &amp;gt;0\)，必有两根，且 \(k\) 在两根之间；反之亦然&lt;br&gt;\(a&amp;lt;0\) 时对 \(-f\)（开口向上）用同一结论：\(f(k)&amp;gt;0\)，即 \(a\cdot f(k)&amp;lt;0\)&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;⇐ 用到工具：求根公式与判别式〔R34 · E5〕&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;&lt;/sup&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6102" y="6746" width="350" height="108" as="geometry"/></mxCell>
<mxCell id="e73L" value="【同理】两根都 \(&amp;gt;m\)：\(\Delta \ge 0\)，\(h&amp;gt;m\)，\(f(m)&amp;gt;0\)（上一条）&lt;br&gt;两根都 \(&amp;lt;n\)：对称地 \(\Delta \ge 0\)，\(h&amp;lt;n\)，\(f(n)&amp;gt;0\)&lt;br&gt;两组同时成立 \(\Rightarrow  \Delta \ge 0\)，\(m&amp;lt;h&amp;lt;n\)，\(f(m)&amp;gt;0\)，\(f(n)&amp;gt;0\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5990" y="7839" width="350" height="108" as="geometry"/></mxCell>
<mxCell id="e74L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：只看区间 \((m,n)\) 内的根&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「零点存在定理」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;S08&lt;/sup&gt;二次函数处处连续，\(f(m)\cdot f(n)&amp;lt;0 \Rightarrow  (m,n)\) 内至少一个零点" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6499" y="6888" width="350" height="68" as="geometry"/></mxCell>
<mxCell id="e75L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【反证法】&lt;/span&gt;若两个不同实根都在 \((m,n)\) 内：由交点式，\(f(m)\)、\(f(n)\) 都与 \(a\) 同号，与 \(f(m)f(n)&amp;lt;0\) 矛盾&lt;br&gt;重根 \(x_{0}\) 在 \((m,n)\) 内：\(f=a(x-x_{0})^{2}\) 不变号，同样矛盾 \(\Rightarrow\) 恰有一个&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;\(f(m)f(n)=0\)（端点是根）时单独检验" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="7081" y="7819" width="350" height="148" as="geometry"/></mxCell>
<mxCell id="e77L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「韦达」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt;两根同号 \(\iff  x_{1}x_{2}&amp;gt;0\)；同正再要 \(x_{1}+x_{2}&amp;gt;0\)&lt;br&gt;一正一负：\(\frac{c}{a}&amp;lt;0 \Rightarrow  ac&amp;lt;0 \Rightarrow  \Delta =b^{2}-4ac&amp;gt;0\)，自动有两个实根" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6895" y="7026" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="e78L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【判别式法】&lt;/span&gt;把 \(y\) 当已知数，化成关于 \(x\) 的方程&lt;br&gt;二次项系数 \(\ne 0\) 时：\(x\) 有实根 \(\Rightarrow  \Delta \ge 0\)，得到候选 \(y\)&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;二次项系数为 0 时单独判断" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5399" y="642" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e79L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【检验】&lt;/span&gt;候选 \(y\) 回代：对应的 \(x\) 要在定义域内、分母 \(\ne 0\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5818" y="1743" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="e80L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【展开】&lt;/span&gt;\((t-x_{1})(t-x_{2}) = t^{2} - st + p\)，所以 \(x_{1}\)、\(x_{2}\) 是 \(t^{2}-st+p=0\) 的两根&lt;br&gt;\(x_{1}\)、\(x_{2}\) 是实数 \(\Rightarrow\) 判别式 \(s^{2}-4p = (x_{1}+x_{2})^{2}-4x_{1}x_{2} = (x_{1}-x_{2})^{2} \ge  0\)&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;⇐ 用到工具：求根公式与判别式〔R34 · E5〕&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;&lt;/sup&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="5815" y="656" width="350" height="108" as="geometry"/></mxCell>
<mxCell id="e82L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(t\) 的取值范围&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【换元法】&lt;/span&gt;令 \(t=g(x)\)，原式变成 \(t\) 的二次函数&lt;br&gt;先求 \(t\) 的范围：\(2^{x}&amp;gt;0\)，\(\cos  x\in [-1,1]\)，\(\log _{2}u\) 递增（工具⑥⑦）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="1156" y="6834" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e83L" value="在 \(t\) 的范围上求最值：闭区间用闭区间最值&lt;br&gt;开区间、无界时看端点能否取到" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2570" y="8177" width="303" height="48" as="geometry"/></mxCell>
<mxCell id="e84L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;\(y=|f(x)|\)：\(f(x)\ge 0\) 的部分不变，\(f(x)&amp;lt;0\) 的部分取相反数 \(\Rightarrow  x\) 轴下方的部分翻到上方&lt;br&gt;\(y=f(|x|)\)：\(x\ge 0\) 时就是 \(f(x)\)；\(x&amp;lt;0\) 时 \(f(|x|)=f(-x)\)，与 \(x&amp;gt;0\) 处的值相同 \(\Rightarrow\) 保留右侧，再关于 \(y\) 轴对称" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3395" y="3512" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e86L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【定义】&lt;/span&gt;函数每个 \(x\) 只对应一个 \(y\)：竖直直线 \(x=t\) 与图像恰有一个交点&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入消元】&lt;/span&gt;\(y=kx+m\) 代入，得关于 \(x\) 的二次方程，交点个数 = 实根个数" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6255" y="812" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e87L" value="【前提】两点距离公式、点到直线的距离（课本）&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【距离验证】&lt;/span&gt;令 \(q=\frac{1}{4a}\)，点 \((x,y)\) 满足 \(y=ax^{2}\) 时：&lt;br&gt;\(x^{2}+(y-q)^{2} = (y+q)^{2}\)（两边相减得 \(x^{2} - 4qy = x^{2} - \frac{y}{a} = 0\)）&lt;br&gt;即到 \((0,q)\) 的距离 = 到直线 \(y=-q\) 的距离；反过来展开即得 \(y=ax^{2}\)（\(a&amp;lt;0\) 时同样成立）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6663" y="762" width="350" height="172" as="geometry"/></mxCell>
<mxCell id="e89L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【求导】&lt;/span&gt;\(F(x)=Ax^{3}+Bx^{2}+Cx+D\)（\(A\ne 0\)），用求导法则⑤：\(F'(x)=3Ax^{2}+2Bx+C\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3694" y="7010" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="e90L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「三个二次的关系」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P07&lt;/sup&gt;读出 \(F'\) 的正负区间（\(3A&amp;lt;0\) 时先乘 \(-1\) 化正）&lt;br&gt;【前提】\(F'&amp;gt;0\) 的区间递增，\(F'&amp;lt;0\) 的区间递减；导数为 0 且左右变号的点是极值点（课本）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3180" y="8157" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e92L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【移项通分】&lt;/span&gt;把不等式化成 \(\frac{f(x)}{g(x)}\) 与 0 比较" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6857" y="6045" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="e93L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【同乘法】&lt;/span&gt;\(g(x)\ne 0\) 时 \(g(x)^{2}&amp;gt;0\)，两边乘 \(g(x)^{2}\) 方向不变：\(\frac{f}{g}&amp;gt;0 \iff  f\cdot g&amp;gt;0\)&lt;br&gt;\(\ge 0\) 时 \(\frac{f}{g}=0 \iff  f=0\) 且 \(g\ne 0\)，所以要单独保证 \(g\ne 0\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6884" y="6385" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="e95L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)（\(a&amp;lt;0\) 先乘 \(-1\) 化正）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【同除】&lt;/span&gt;\(f(x)=a(x-h)^{2}-\frac{\Delta}{4a}&amp;gt;0\)，两边除以正数 \(a\)&lt;br&gt;\(\iff  (x-h)^{2} &amp;gt; \frac{\Delta}{4a^{2}}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6322" y="3936" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="e96L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【开平方】&lt;/span&gt;两边非负：\((x-h)^{2} &amp;gt; r^{2} \iff  |x-h| &amp;gt; r\)（\(r=\frac{\sqrt{\Delta}}{2a}\)）&lt;br&gt;即 \(x&amp;lt;h-r\) 或 \(x&amp;gt;h+r\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="9284" y="4548" width="350" height="80" as="geometry"/></mxCell>
<mxCell id="e97L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：实际意义给出的定义域&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【建模】&lt;/span&gt;设自变量 \(x\)，按题意列函数，如靠墙矩形面积 \(S=x(20-2x)\)&lt;br&gt;由实际意义写定义域：长度为正 \(\Rightarrow  0&amp;lt;x&amp;lt;10\)&lt;br&gt;在定义域上求最值：对称轴 \(x=5\) 在区间内，\(a&amp;lt;0 \Rightarrow  x=5\) 时最大 50；整数自变量见整数最值" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2498" y="5317" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e100L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：自变量只取整数&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「远近规律」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P04&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P04&lt;/sup&gt;\(a&amp;gt;0\)：\(|x-h|\) 越小，\(f(x)\) 越小&lt;br&gt;自变量只取整数 \(\Rightarrow\) 只需比较 \(h\) 左右最近的两个整数&lt;br&gt;两个一样近（\(h\) 是某整数加 0.5）时都取到；例 \(h=7.5 \Rightarrow  n=7\)、8" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="1043" y="4740" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e102L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(\Delta'=b'^{2}-4a'c'&amp;gt;0\)（有两个交点才有弦）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「两点距离」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;③&lt;/sup&gt;\(|PQ|=\sqrt{(x_{1}-x_{2})^{2}+(y_{1}-y_{2})^{2}}\)&lt;br&gt;\(y_{1}-y_{2}=k(x_{1}-x_{2}) \Rightarrow  |PQ|=\sqrt{1+k^{2}}\cdot |x_{1}-x_{2}|\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6686" y="1691" width="350" height="152" as="geometry"/></mxCell>
<mxCell id="e103L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「韦达」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt;用于联立后的方程：\((x_{1}-x_{2})^{2}=(x_{1}+x_{2})^{2}-4x_{1}x_{2}=\frac{\Delta'}{a'^{2}}\)&lt;br&gt;\(\Rightarrow  |x_{1}-x_{2}|=\frac{\sqrt{\Delta'}}{|a'|}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6683" y="2143" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="e104L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(\Delta &amp;lt;0\)，在复数范围内求根&lt;/span&gt;&lt;br&gt;\(\Delta &amp;lt;0\)：右边为负，实数范围内开不了平方&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「复数」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;S10&lt;/sup&gt;\(i^{2}=-1 \Rightarrow  \frac{\Delta}{4a^{2}} = (\sqrt{-\Delta }\cdot \frac{i}{2a})^{2}\)&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【开平方】&lt;/span&gt;\(x + \frac{b}{2a} = \pm \sqrt{-\Delta }\cdot \frac{i}{2a}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4380" y="2374" width="350" height="132" as="geometry"/></mxCell>
<mxCell id="e105L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【代入】&lt;/span&gt;两根相加：虚部抵消，得 \(-\frac{b}{a}\)&lt;br&gt;两根相乘：\(\frac{b^{2} + (-\Delta )}{4a^{2}} = \frac{4ac}{4a^{2}} = \frac{c}{a}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4729" y="2727" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="e107L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【取极限】&lt;/span&gt;\(x_{2}=x_{1}+\Delta x\)：平均变化率 \(= a(2x_{1}+\Delta x-2h)\)&lt;br&gt;\(\Delta x\to 0\) 得 \(f'(x_{1})=2a(x_{1}-h)=2ax_{1}+b\)（由导数的定义，课本）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3879" y="3790" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e108L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【求导】&lt;/span&gt;\((ax^{2}+bx+c)' = 2ax+b\)（工具：\((x^{n})'=nx^{n-1}\)，和差、常数倍的求导法则）&lt;br&gt;【前提】导数判单调（同见不等式大厦〔S04〕）：\(f'&amp;lt;0\) 递减，\(f'&amp;gt;0\) 递增" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3845" y="3518" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e109L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【分类讨论】&lt;/span&gt;\(a&amp;lt;0\)：解集在两根之外或为全体实数；\(a=0\)：一次不等式的解集是半直线、全体实数或空集&lt;br&gt;所以解集是有界区间 \((x_{1},x_{2}) \Rightarrow  a&amp;gt;0\)，且 \(x_{1}\)、\(x_{2}\) 是方程的两根" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="7272" y="5539" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e110L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「韦达」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;P21&lt;/sup&gt;\(x_{1}+x_{2}=-\frac{b}{a}\)，\(x_{1}x_{2}=\frac{c}{a}\)，解出 \(b\)、\(c\)（用 \(a\) 表示）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="7391" y="6045" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="e112L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：\(a&amp;gt;0\)（\(a&amp;lt;0\) 时三处符号全反）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【数形结合】&lt;/span&gt;\(f(n)&amp;lt;0 \Rightarrow  n\) 在两根之间（\(a\cdot f(n)&amp;lt;0\)）&lt;br&gt;\(f(m)&amp;gt;0\) 且 \(m&amp;lt;n \Rightarrow  m\) 在两根之外的左侧，\(x_{1}\in (m,n)\)；同理 \(x_{2}\in (n,p)\)&lt;br&gt;反之两根如此分布，三处函数值符号必如上" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6543" y="7829" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e114L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【展开】&lt;/span&gt;\((a_{1}x+c_{1})(a_{2}x+c_{2})\) 逐项相乘，合并同类项" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4235" y="1551" width="350" height="48" as="geometry"/></mxCell>
<mxCell id="e115L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【比较系数】&lt;/span&gt;与 \(ax^{2}+bx+c\) 对照：\(a=a_{1}a_{2}\)，\(c=c_{1}c_{2}\)，\(b=a_{1}c_{2}+a_{2}c_{1}\)&lt;br&gt;能找到这样的 \(a_{1}\)、\(a_{2}\)、\(c_{1}\)、\(c_{2}\) 就能分解；交叉相乘再相加等于 \(b\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4297" y="1813" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e116L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【配凑】&lt;/span&gt;\(x_{1}^{2}+x_{2}^{2}=(x_{1}+x_{2})^{2}-2x_{1}x_{2}\)，代入韦达&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【通分】&lt;/span&gt;\(\frac{1}{x_{1}}+\frac{1}{x_{2}}=\frac{x_{1}+x_{2}}{x_{1}x_{2}}\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="3831" y="3095" width="350" height="80" as="geometry"/></mxCell>
<mxCell id="e117L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：新变量 \(t\) 的取值范围&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【换元法】&lt;/span&gt;令 \(t=\sqrt{x}\) 或 \(t=x^{2}\)，原方程变成 \(t\) 的一元二次方程" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4274" y="2733" width="350" height="80" as="geometry"/></mxCell>
<mxCell id="e118L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「求根公式」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R34&lt;/sup&gt;解出 \(t\)&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【检验】&lt;/span&gt;舍去不在 \(t\) 范围内的根，再由 \(t\) 还原 \(x\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4383" y="3101" width="350" height="68" as="geometry"/></mxCell>
<mxCell id="e119L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「零点存在定理」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;S08&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;S08&lt;/sup&gt;\(f(m)\cdot f(n)&amp;lt;0 \Rightarrow  (m,n)\) 内有零点&lt;br&gt;取中点 \(c\)：\(f(c)=0\) 即找到；否则 \(f(m)\cdot f(c)&amp;lt;0\) 与 \(f(c)\cdot f(n)&amp;lt;0\) 必有一个成立&lt;br&gt;保留端点值异号的一半，零点仍在其中；区间长度每次减半，\(k\) 次后为 \(\frac{n-m}{2^{k}}\)，可以小于任意精确度" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="7785" y="4508" width="350" height="160" as="geometry"/></mxCell>
<mxCell id="e120L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「符号规则」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;⑮&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;⑮&lt;/sup&gt;\(x-x_{i}\) 在 \(x_{i}\) 右边为正、左边为负&lt;br&gt;乘积的正负由负因式的个数决定：从最右（全为正）往左，每过一个根多一个负因式" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="6146" y="3742" width="350" height="68" as="geometry"/></mxCell>
<mxCell id="e122L" value="&lt;span style=&quot;color:#E65100;font-weight:bold;&quot;&gt;▼ 加条件：限制在一个单调区间上&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【定义】&lt;/span&gt;反函数要求每个 \(y\) 只对应一个 \(x\)&lt;br&gt;\(f(x)=f(2h-x)\)：轴两侧成对的 \(x\) 对应同一个 \(y \Rightarrow\) 在 \(\mathbb{R}\) 上没有反函数&lt;br&gt;限制在 \(x\ge h\)（或 \(x\le h\)）上，函数单调，每个 \(y\) 只对应一个 \(x \Rightarrow\) 有反函数；解 \(x\) 时开平方按这一侧取符号&lt;br&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;⇐ 用到工具：对称轴〔R04 · D8〕&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;&lt;/sup&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="2556" y="4720" width="350" height="168" as="geometry"/></mxCell>
<mxCell id="e125L" value="&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;&lt;span style=&quot;background-color:#BBDEFB;color:#0D47A1;font-weight:bold;&quot;&gt;「相切」&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R15&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;color:#0D47A1;font-weight:bold;font-size:10px;&quot;&gt;R15&lt;/sup&gt;设公切线 \(y=kx+m\)，与第一条抛物线联立得二次方程，令 \(\Delta _{1}=0\)&lt;br&gt;与第二条抛物线联立，令 \(\Delta _{2}=0\)&lt;br&gt;两个关于 \(k\)、\(m\) 的方程联立求解；例 \(y=x^{2}\) 与 \(y=-(x-2)^{2}\)：\(k^{2}+4m=0\)，\(k^{2}-8k-4m=0 \Rightarrow  k=0\)、\(m=0\) 或 \(k=4\)、\(m=-4\)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="7067" y="1703" width="350" height="128" as="geometry"/></mxCell>
<mxCell id="e126L" value="&lt;span style=&quot;background-color:#EFEBE9;color:#4E342E;font-weight:bold;&quot;&gt;【切线】&lt;/span&gt;在 \((x_{k}, f(x_{k}))\) 处切线 \(y=f(x_{k})+f'(x_{k})(x-x_{k})\)，令 \(y=0\) 得 \(x_{k+1}\)&lt;br&gt;需 \(f'(x_{k})\ne 0\)&lt;br&gt;【前提】导数的几何意义：\(f'(x_{k})\) 是切线斜率（选择性必修 6.1.2，由切线的定义得到）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;fontFamily=PingFang SC;fontSize=13;fontColor=#263238;opacity=100;" vertex="1" parent="1"><mxGeometry x="4120" y="6916" width="350" height="108" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>